extern {
    const fn __f32_from_i32(_: i32) -> f32
}

const MAX_MESH_LOD: u32 = 5
const VERTICES_PER_PATCH: u32 = 3072
const MAX_SURFACE_VERTICES: usize = 12288

struct PatchSubdivisionParams {
    split_mode: Param,
    center_mode: Param,
    center_goal: Param,
    center_u: Param,
    center_v: Param,
    split_threshold: Param,
    mesh_lod: Param,
    show_triangles: Param,
    resolve_weight_constraint: Param,
    w00: Param,
    w10: Param,
    w01: Param,
    w11: Param,
    orbit_yaw: Param,
    orbit_pitch: Param,
    orbit_distance: Param,
    wire_px: Param,
    res_x: Param,
    res_y: Param,
    orbiting: Param,
    difficulty: Param,
    center_score: Param,
}

struct PatchSubdivisionState {
    split_mode: f32,
    center_mode: f32,
    center_goal: f32,
    center_u: f32,
    center_v: f32,
    split_threshold: f32,
    mesh_lod: f32,
    show_triangles: f32,
    resolve_weight_constraint: f32,
    w00: f32,
    w10: f32,
    w01: f32,
    w11: f32,
    orbit_yaw: f32,
    orbit_pitch: f32,
    orbit_distance: f32,
    wire_px: f32,
    res_x: f32,
    res_y: f32,
    orbiting: f32,
    difficulty: f32,
    center_score: f32,
}
impl Copy for PatchSubdivisionState {}

impl SurfaceState for PatchSubdivisionState {
    type Params = PatchSubdivisionParams
}

derive ApplyParamBindings for PatchSubdivisionState using ParamBindingsProvider

const fn patch_subdivision_params() -> PatchSubdivisionParams {
    PatchSubdivisionParams {
        split_mode: Param::choice(
            options: ChoiceOptions::three(
                first: "always use four",
                second: "estimate need to split",
                third: "do not subdivide",
            ),
            init: 0.0,
        ),
        center_mode: Param::choice(
            options: ChoiceOptions::two(first: "place center", second: "find center"),
            init: 0.0,
        ),
        center_goal: Param::choice(
            options: ChoiceOptions::three(
                first: "avoid skinny pieces",
                second: "balance estimated area",
                third: "balance both",
            ),
            init: 2.0,
        ),
        center_u: Param::range(min: 0.001, max: 0.999, init: 0.5),
        center_v: Param::range(min: 0.001, max: 0.999, init: 0.5),
        split_threshold: Param::unit(init: 0.32),
        mesh_lod: Param::int(min: 0.0, max: 5.0, init: 3.0),
        show_triangles: Param::toggle(init: true),
        resolve_weight_constraint: Param::toggle(init: true),
        w00: Param::log(min: 0.02, max: 8.0, init: 1.0),
        w10: Param::log(min: 0.02, max: 8.0, init: 1.0),
        w01: Param::log(min: 0.02, max: 8.0, init: 1.0),
        w11: Param::log(min: 0.02, max: 8.0, init: 1.0),
        orbit_yaw: Param::range(min: -3.14159265, max: 3.14159265, init: -0.72),
        orbit_pitch: Param::range(min: -1.35, max: 1.35, init: 0.12),
        orbit_distance: Param::log(min: 2.5, max: 16.0, init: 6.2),
        wire_px: Param::range(min: 0.0, max: 1.6, init: 0.42),
        res_x: Param::extent_x(),
        res_y: Param::extent_y(),
        orbiting: Param::fixed(0.0),
        difficulty: Param::fixed(1.0),
        center_score: Param::fixed(0.0),
    }
}

fn state(
    _ split_mode: f32,
    _ center_mode: f32,
    _ center_goal: f32,
    _ center_u: f32,
    _ center_v: f32,
    _ split_threshold: f32,
    _ mesh_lod: f32,
    _ show_triangles: f32,
    _ resolve_weight_constraint: f32,
    _ w00: f32,
    _ w10: f32,
    _ w01: f32,
    _ w11: f32,
    _ orbit_yaw: f32,
    _ orbit_pitch: f32,
    _ orbit_distance: f32,
    _ wire_px: f32,
    _ res_x: f32,
    _ res_y: f32,
    _ orbiting: f32,
    _ difficulty: f32,
    _ center_score: f32,
) -> PatchSubdivisionState {
    PatchSubdivisionState {
        split_mode: split_mode,
        center_mode: center_mode,
        center_goal: center_goal,
        center_u: center_u,
        center_v: center_v,
        split_threshold: split_threshold,
        mesh_lod: mesh_lod,
        show_triangles: show_triangles,
        resolve_weight_constraint: resolve_weight_constraint,
        w00: w00,
        w10: w10,
        w01: w01,
        w11: w11,
        orbit_yaw: orbit_yaw,
        orbit_pitch: orbit_pitch,
        orbit_distance: orbit_distance,
        wire_px: wire_px,
        res_x: res_x,
        res_y: res_y,
        orbiting: orbiting,
        difficulty: difficulty,
        center_score: center_score,
    }
}

/// For this fixed authored patch, separable positive scales cancel the extra
/// Clifford component. The correction belongs to input state, not each vertex.
fn resolve_weights(_ state: own PatchSubdivisionState) -> PatchSubdivisionState {
    let mut next = state
    if next.resolve_weight_constraint > 0.5 {
        let weights = BilinearCornerScales {
            w00: clamp(next.w00, 0.02, 8.0), w10: clamp(next.w10, 0.02, 8.0),
            w01: clamp(next.w01, 0.02, 8.0), w11: clamp(next.w11, 0.02, 8.0),
        }.separable()
        // Projection cannot increase the log span beyond the original bounds.
        // A common scale brings the representative back inside slider limits;
        // separately clamping the corrected corners would break the constraint.
        let low = min(min(weights.w00, weights.w10), min(weights.w01, weights.w11))
        let high = max(max(weights.w00, weights.w10), max(weights.w01, weights.w11))
        let fitted = weights.scaled(clamp(1.0, 0.02 / low, 8.0 / high))
        next.w00 = fitted.w00
        next.w10 = fitted.w10
        next.w01 = fitted.w01
        next.w11 = fitted.w11
    }
    next
}

fn patch_value(_ state: PatchSubdivisionState) -> IsotropicBilinearPatch {
    patch(
        control(
            vec3f(0.0, 2.0, 0.0),
            scale_weight(even(1.0, 0.0, 0.0, 0.0), state.w00),
        ),
        control(
            vec3f(0.0, 1.0, 0.0),
            scale_weight(even(0.0, 1.0, 0.0, -1.0), state.w10),
        ),
        control(
            vec3f(0.0, -2.0, 0.0),
            scale_weight(even(0.0, 2.0, 0.0, 1.0), state.w01),
        ),
        control(
            vec3f(0.0, -1.0, 0.0),
            scale_weight(even(-6.0, 0.0, -3.0, 0.0), state.w11),
        ),
    )
}

fn policy() -> IsotropicPolicy {
    IsotropicPolicy {
        minimum_denominator_norm_squared: 0.000000000001,
        maximum_trivector_residual: 0.00001,
    }
}

fn as_f32(_ value: u32) -> f32 {
    __f32_from_i32(value.downcast_unchecked())
}

fn admitted_lod(_ value: f32) -> u32 {
    let mut lod: u32 = 0
    while lod < MAX_MESH_LOD && value >= as_f32(lod) + 0.5 {
        lod = lod + 1
    }
    lod
}

fn minimum(_ first: f32, _ second: f32) -> f32 {
    if first < second { first } else { second }
}

fn maximum(_ first: f32, _ second: f32) -> f32 {
    if first > second { first } else { second }
}

fn minimum_barycentric(_ value: Bary3F) -> f32 {
    minimum(value.a, minimum(value.b, value.c))
}

fn fan_domain(_ child: u32, _ center: Vec2F) -> TriangleDomain2 {
    if child == 0 {
        TriangleDomain2 { a: vec2f(0.0, 0.0), b: vec2f(1.0, 0.0), c: center }
    } else if child == 1 {
        TriangleDomain2 { a: vec2f(1.0, 0.0), b: vec2f(1.0, 1.0), c: center }
    } else if child == 2 {
        TriangleDomain2 { a: vec2f(1.0, 1.0), b: vec2f(0.0, 1.0), c: center }
    } else {
        TriangleDomain2 { a: vec2f(0.0, 1.0), b: vec2f(0.0, 0.0), c: center }
    }
}

fn whole_patch_domain(_ child: u32) -> TriangleDomain2 {
    if child == 0 {
        TriangleDomain2 {
            a: vec2f(0.0, 0.0), b: vec2f(1.0, 0.0), c: vec2f(1.0, 1.0),
        }
    } else {
        TriangleDomain2 {
            a: vec2f(0.0, 0.0), b: vec2f(1.0, 1.0), c: vec2f(0.0, 1.0),
        }
    }
}

struct ChildMeasure {
    area: f32,
    shape: f32,
    valid: bool,
}
impl Copy for ChildMeasure {}

/// Four equal-area subtriangles' centers, in parent barycentric coordinates.
/// Their Jacobians provide a quadrature estimate, not a surface-area bound.
fn child_probe(_ index: u32) -> Bary3F {
    if index == 0 {
        bary3f(0.66666667, 0.16666667, 0.16666667)
    } else if index == 1 {
        bary3f(0.16666667, 0.66666667, 0.16666667)
    } else if index == 2 {
        bary3f(0.16666667, 0.16666667, 0.66666667)
    } else {
        bary3f(0.33333334, 0.33333334, 0.33333334)
    }
}

/// Estimate area across each exact child and retain the worst sampled shape.
/// Finite sampling can miss narrow hazards; this never certifies a leaf.
fn child_measure(
    _ value: IsotropicBilinearPatch,
    _ domain: TriangleDomain2,
) -> ChildMeasure {
    let controls = triangular_projective_controls(value, domain)
    let mut area: f32 = 0.0
    let mut worst_shape: f32 = 1.0
    let mut probe: u32 = 0
    while probe < 4 {
        let differential = evaluate_triangular_projective_differential(
            controls, child_probe(probe), policy(), 0.000000000001,
        )
        let measure = measure_tangent_triangle3(differential.tangent_b, differential.tangent_c)
        if !differential.sample.conditioned || !differential.sample.vector_valued || !measure.defined {
            return ChildMeasure { area: 0.0, shape: 0.0, valid: false }
        }
        area = area + measure.area * 0.25
        worst_shape = minimum(worst_shape, measure.quality)
        probe = probe + 1
    }
    ChildMeasure {
        area: area,
        shape: worst_shape,
        valid: true,
    }
}

struct FanMeasure {
    worst_shape: f32,
    area_balance: f32,
    valid: bool,
}
impl Copy for FanMeasure {}

fn fan_measure(_ value: IsotropicBilinearPatch, _ center: Vec2F) -> FanMeasure {
    let first = child_measure(value, fan_domain(0, center))
    if !first.valid {
        return FanMeasure { worst_shape: 0.0, area_balance: 0.0, valid: false }
    }
    let mut smallest_area = first.area
    let mut largest_area = first.area
    let mut worst_shape = first.shape
    let mut child: u32 = 1
    while child < 4 {
        let measure = child_measure(value, fan_domain(child, center))
        if !measure.valid {
            return FanMeasure { worst_shape: 0.0, area_balance: 0.0, valid: false }
        }
        smallest_area = minimum(smallest_area, measure.area)
        largest_area = maximum(largest_area, measure.area)
        worst_shape = minimum(worst_shape, measure.shape)
        child = child + 1
    }
    FanMeasure {
        worst_shape: worst_shape,
        area_balance: smallest_area / largest_area,
        valid: true,
    }
}

fn fan_score(
    _ value: IsotropicBilinearPatch,
    _ center: Vec2F,
    _ goal: f32,
) -> f32 {
    let measure = fan_measure(value, center)
    if !measure.valid {
        0.0
    } else if goal < 0.5 {
        measure.worst_shape
    } else if goal < 1.5 {
        measure.area_balance
    } else {
        measure.worst_shape * (0.25 + 0.75 * measure.area_balance)
    }
}

struct CenterSearch {
    point: Vec2F,
    score: f32,
}
impl Copy for CenterSearch {}

fn search_offset(_ index: u32) -> f32 {
    if index == 0 { -1.0 } else if index == 2 { 1.0 } else { 0.0 }
}

/// Deterministic coarse-to-fine search over the exact analytic patch.
/// Candidates never leave the patch: each one is a `(u,v)` coordinate and is
/// assessed through four exact triangular restrictions.
fn find_center(_ value: IsotropicBilinearPatch, _ goal: f32) -> CenterSearch {
    let mut best = CenterSearch {
        point: vec2f(0.5, 0.5),
        score: fan_score(value, vec2f(0.5, 0.5), goal),
    }
    let mut step: f32 = 0.28
    let mut round: u32 = 0
    while round < 7 {
        let anchor = best.point
        let mut y: u32 = 0
        while y < 3 {
            let mut x: u32 = 0
            while x < 3 {
                let candidate = vec2f(
                    clamp(anchor.x + search_offset(x) * step, 0.04, 0.96),
                    clamp(anchor.y + search_offset(y) * step, 0.04, 0.96),
                )
                let score = fan_score(value, candidate, goal)
                if score > best.score {
                    best = CenterSearch { point: candidate, score: score }
                }
                x = x + 1
            }
            y = y + 1
        }
        step = step * 0.5
        round = round + 1
    }
    best
}

fn local_shape(_ tangent_u: Vec3F, _ tangent_v: Vec3F) -> f32 {
    measure_tangent_triangle3(tangent_u, tangent_v).quality
}

/// A one-step split heuristic, not a certificate. It combines the worst
/// local stretch shape with the largest normal change at four interior probes.
/// Later hierarchy levels can reuse the same policy independently per child.
fn patch_difficulty(_ value: IsotropicBilinearPatch) -> f32 {
    let center = evaluate_differential(
        value, vec2f(0.5, 0.5), policy(), 0.000000000001,
    )
    if !center.sample.conditioned || !center.sample.vector_valued { return 1.0 }
    let mut worst_shape = local_shape(center.tangent_s, center.tangent_t)
    let mut closest_normal = 1.0
    let mut probe: u32 = 0
    while probe < 4 {
        let u = if probe == 0 || probe == 3 { 0.16 } else { 0.84 }
        let v = if probe < 2 { 0.16 } else { 0.84 }
        let sample = evaluate_differential(
            value, vec2f(u, v), policy(), 0.000000000001,
        )
        if !sample.sample.conditioned || !sample.sample.vector_valued { return 1.0 }
        worst_shape = minimum(worst_shape, local_shape(sample.tangent_s, sample.tangent_t))
        closest_normal = minimum(closest_normal, dot3(center.normal, sample.normal))
        probe = probe + 1
    }
    let stretch_difficulty = 1.0 - clamp(worst_shape, 0.0, 1.0)
    let bend_difficulty = 1.0 - clamp(closest_normal, 0.0, 1.0)
    clamp(maximum(stretch_difficulty, bend_difficulty), 0.0, 1.0)
}

fn analyze(_ current: PatchSubdivisionState) -> PatchSubdivisionState {
    let mut next = current
    let value = patch_value(next)
    next.difficulty = patch_difficulty(value)
    if next.center_mode > 0.5 {
        let found = find_center(value, next.center_goal)
        next.center_u = found.point.x
        next.center_v = found.point.y
        next.center_score = found.score
    } else {
        next.center_score = fan_score(
            value, vec2f(next.center_u, next.center_v), next.center_goal,
        )
    }
    next
}

fn uses_four_patches(_ state: PatchSubdivisionState) -> bool {
    if state.split_mode < 0.5 {
        true
    } else if state.split_mode < 1.5 {
        state.difficulty > state.split_threshold
    } else {
        false
    }
}

fn displayed_domain(
    _ patch_index: u32,
    _ state: PatchSubdivisionState,
) -> TriangleDomain2 {
    if uses_four_patches(state) {
        fan_domain(patch_index, vec2f(state.center_u, state.center_v))
    } else {
        whole_patch_domain(patch_index)
    }
}

fn active_patch_count(_ state: PatchSubdivisionState) -> u32 {
    if uses_four_patches(state) { 4 } else { 2 }
}

struct TriangleCell {
    row: u32,
    column: u32,
    upper: bool,
}
impl Copy for TriangleCell {}

fn triangle_cell(_ triangle: u32, _ side: u32) -> TriangleCell {
    let mut remaining = triangle
    let mut row: u32 = 0
    while row < side {
        let count = 2 * (side - row) - 1
        if remaining < count {
            return TriangleCell {
                row: row,
                column: remaining / 2,
                upper: remaining % 2 == 1,
            }
        }
        remaining = remaining - count
        row = row + 1
    }
    TriangleCell { row: 0, column: 0, upper: false }
}

fn grid_barycentric(_ column: u32, _ row: u32, _ side: u32) -> Bary3F {
    let b = as_f32(column) / as_f32(side)
    let c = as_f32(row) / as_f32(side)
    bary3f(1.0 - b - c, b, c)
}

fn patch_barycentric(_ patch_vertex: u32, _ side: u32) -> Bary3F {
    let triangle = patch_vertex / 3
    let corner = patch_vertex % 3
    let cell = triangle_cell(triangle, side)
    if !cell.upper {
        if corner == 0 {
            grid_barycentric(cell.column, cell.row, side)
        } else if corner == 1 {
            grid_barycentric(cell.column + 1, cell.row, side)
        } else {
            grid_barycentric(cell.column, cell.row + 1, side)
        }
    } else if corner == 0 {
        grid_barycentric(cell.column + 1, cell.row, side)
    } else if corner == 1 {
        grid_barycentric(cell.column + 1, cell.row + 1, side)
    } else {
        grid_barycentric(cell.column, cell.row + 1, side)
    }
}

fn triangle_corner(_ corner: u32) -> Bary3F {
    if corner == 0 {
        bary3f(1.0, 0.0, 0.0)
    } else if corner == 1 {
        bary3f(0.0, 1.0, 0.0)
    } else {
        bary3f(0.0, 0.0, 1.0)
    }
}

fn extent(_ state: PatchSubdivisionState) -> ScreenExtent {
    ScreenExtent { width: state.res_x, height: state.res_y }
}

fn camera(_ state: PatchSubdivisionState) -> CameraFrame {
    orbit_camera(
        OrbitCamera {
            target: vec3f(1.1, 0.0, 0.0),
            yaw: state.orbit_yaw,
            pitch: state.orbit_pitch,
            distance: state.orbit_distance,
            focal: 1.62,
            near: 0.05,
            far: 100.0,
        },
        extent(state),
    )
}

pub struct SurfaceVarying {
    pub triangle_edge: Bary3F,
    pub patch_edge: Bary3F,
    pub normal: Vec3F,
    pub patch_index: f32,
    pub view_depth: f32,
    pub valid: f32,
}
impl Copy for SurfaceVarying {}

fn invalid_surface_vertex() -> RasterVertex<SurfaceVarying> {
    RasterVertex {
        position: ClipPosition { x: 2.0, y: 2.0, z: 0.0, w: 1.0 },
        varying: SurfaceVarying {
            triangle_edge: bary3f(0.0, 0.0, 0.0),
            patch_edge: bary3f(0.0, 0.0, 0.0),
            normal: vec3f(0.0, 0.0, 1.0),
            patch_index: 0.0,
            view_depth: 1.0,
            valid: 0.0,
        },
    }
}

fn patch_color(_ patch_index: f32, _ split: bool) -> DisplayRgb {
    let base = if !split {
        if patch_index < 0.5 { oklch(0.74, 0.075, 0.72) } else { oklch(0.72, 0.070, 0.92) }
    } else if patch_index < 0.5 {
        oklch(0.75, 0.095, 0.48)
    } else if patch_index < 1.5 {
        oklch(0.76, 0.085, 1.38)
    } else if patch_index < 2.5 {
        oklch(0.72, 0.080, 5.72)
    } else {
        oklch(0.73, 0.090, 4.88)
    }
    to_display_rgb(base)
}

fn shade(_ varying: SurfaceVarying, _ split: bool) -> DisplayRgb {
    let normal = normalize3_or(varying.normal, vec3f(0.0, 0.0, 1.0), 0.0000001)
    let light = normalize3_or(vec3f(-0.35, 0.48, 0.82), vec3f(0.0, 0.0, 1.0), 0.0000001)
    let facing = absf(dot3(normal, light))
    let base = if !split {
        if varying.patch_index < 0.5 { oklch(0.74, 0.075, 0.72) } else { oklch(0.72, 0.070, 0.92) }
    } else if varying.patch_index < 0.5 {
        oklch(0.75, 0.095, 0.48)
    } else if varying.patch_index < 1.5 {
        oklch(0.76, 0.085, 1.38)
    } else if varying.patch_index < 2.5 {
        oklch(0.72, 0.080, 5.72)
    } else {
        oklch(0.73, 0.090, 4.88)
    }
    to_display_rgb(scale_lightness_chroma(base, 0.72 + 0.30 * facing, 1.0))
}

pub struct DiagramVarying {
    pub edge: Bary3F,
    pub patch_index: f32,
}
impl Copy for DiagramVarying {}

fn diagram_clip(
    _ parameter: Vec2F,
    _ state: PatchSubdivisionState,
) -> ClipPosition {
    let aspect = if state.res_y > 0.0 { state.res_x / state.res_y } else { 1.0 }
    ClipPosition {
        x: -0.93 + parameter.x * 0.34,
        y: -0.91 + parameter.y * 0.34 * aspect,
        z: 0.002,
        w: 1.0,
    }
}

pub struct MarkerVarying { pub automatic: f32 }
impl Copy for MarkerVarying {}

fn marker_clip(
    _ center: Vec2F,
    _ corner: u32,
    _ state: PatchSubdivisionState,
) -> ClipPosition {
    let base = diagram_clip(center, state)
    let mut dx: f32 = -0.010
    let mut dy: f32 = -0.010
    if corner == 1 || corner == 2 || corner == 4 { dx = 0.010 }
    if corner == 2 || corner == 3 || corner == 4 { dy = 0.010 }
    ClipPosition { x: base.x + dx, y: base.y + dy, z: 0.001, w: 1.0 }
}

actor ExactPatchSubdivision uses (
    GpuProgram<WebGpuBackend>,
    SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    split_mode: f32,
    center_mode: f32,
    center_goal: f32,
    center_u: f32,
    center_v: f32,
    split_threshold: f32,
    mesh_lod: f32,
    show_triangles: f32,
    resolve_weight_constraint: f32,
    w00: f32,
    w10: f32,
    w01: f32,
    w11: f32,
    orbit_yaw: f32,
    orbit_pitch: f32,
    orbit_distance: f32,
    wire_px: f32,
    res_x: f32,
    res_y: f32,
    orbiting: f32,
    difficulty: f32,
    center_score: f32,

    const fn raster() -> RasterPlan uses (RasterConfiguration) {
        raster_plan<Depth24LessEqualMsaa4>()
    }

    const fn view() -> Surface<PatchSubdivisionParams> {
        Surface { extent: Extent::square(768), params: patch_subdivision_params() }
    }

    fn navigate(self, event: own SurfaceEvent) -> PatchSubdivisionState
        uses (SurfaceTransition, SurfaceScheduling<LatestPerFrame>)
    {
        let mut next = state(
            self.split_mode,
            self.center_mode,
            self.center_goal,
            self.center_u,
            self.center_v,
            self.split_threshold,
            self.mesh_lod,
            self.show_triangles,
            self.resolve_weight_constraint,
            self.w00,
            self.w10,
            self.w01,
            self.w11,
            self.orbit_yaw,
            self.orbit_pitch,
            self.orbit_distance,
            self.wire_px,
            self.res_x,
            self.res_y,
            self.orbiting,
            self.difficulty,
            self.center_score,
        ).apply_param_bindings(patch_subdivision_params(), event)
        let constraint_changed = next.resolve_weight_constraint != self.resolve_weight_constraint
        let weights_changed = next.w00 != self.w00 || next.w10 != self.w10
            || next.w01 != self.w01 || next.w11 != self.w11
        if event.is_param_edit() && (weights_changed || constraint_changed) {
            next = resolve_weights(next)
        }
        let geometry_changed = next.w00 != self.w00 || next.w10 != self.w10
            || next.w01 != self.w01 || next.w11 != self.w11
        let center_changed = next.center_u != self.center_u || next.center_v != self.center_v
            || next.center_mode != self.center_mode || next.center_goal != self.center_goal
        if event.is_param_edit() && (geometry_changed || center_changed || next.split_mode != self.split_mode) {
            next = analyze(next)
        }
        if event.is_pointer_down() { next.orbiting = 1.0 }
        if event.is_pointer_move() && event.buttons != 0 && next.orbiting > 0.5 {
            next.orbit_yaw = wrap_pi(next.orbit_yaw - event.delta_x * 0.008)
            next.orbit_pitch = clamp(next.orbit_pitch - event.delta_y * 0.008, -1.35, 1.35)
        }
        if event.is_pointer_up() { next.orbiting = 0.0 }
        if event.wheel_delta < 0.0 {
            next.orbit_distance = clamp(next.orbit_distance * 0.90, 2.5, 16.0)
        } else if event.wheel_delta > 0.0 {
            next.orbit_distance = clamp(next.orbit_distance * 1.10, 2.5, 16.0)
        }
        next
    }

    fn background(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        -15396337
    }

    fn surface_vertices(self, vertex_index: u32) -> RasterVertex<SurfaceVarying>
        uses (VertexStage<SurfaceVarying, TriangleList<MAX_SURFACE_VERTICES>>)
    {
        let current = state(
            self.split_mode,
            self.center_mode,
            self.center_goal,
            self.center_u,
            self.center_v,
            self.split_threshold,
            self.mesh_lod,
            self.show_triangles,
            self.resolve_weight_constraint,
            self.w00,
            self.w10,
            self.w01,
            self.w11,
            self.orbit_yaw,
            self.orbit_pitch,
            self.orbit_distance,
            self.wire_px,
            self.res_x,
            self.res_y,
            self.orbiting,
            self.difficulty,
            self.center_score,
        )
        let patch_index = vertex_index / VERTICES_PER_PATCH
        let patch_vertex = vertex_index % VERTICES_PER_PATCH
        let lod = admitted_lod(current.mesh_lod)
        let side = 1 << lod
        let active_vertices = side * side * 3
        if patch_index >= active_patch_count(current) || patch_vertex >= active_vertices {
            return invalid_surface_vertex()
        }
        let domain = displayed_domain(patch_index, current)
        let controls = triangular_projective_controls(patch_value(current), domain)
        let bary = patch_barycentric(patch_vertex, side)
        let differential = evaluate_triangular_projective_differential(
            controls, bary, policy(), 0.000000000001,
        )
        if !differential.sample.conditioned {
            return invalid_surface_vertex()
        }
        let triangle_start = patch_vertex / 3 * 3
        let bary0 = patch_barycentric(triangle_start, side)
        let bary1 = patch_barycentric(triangle_start + 1, side)
        let bary2 = patch_barycentric(triangle_start + 2, side)
        let sample0 = evaluate_triangular_projective_controls(controls, bary0, policy())
        let sample1 = evaluate_triangular_projective_controls(controls, bary1, policy())
        let sample2 = evaluate_triangular_projective_controls(controls, bary2, policy())
        let camera_value = camera(current)
        let projected = project(camera_value, differential.sample.position)
        let projected0 = project(camera_value, sample0.position)
        let projected1 = project(camera_value, sample1.position)
        let projected2 = project(camera_value, sample2.position)
        if projected.depth <= 0.05 {
            return invalid_surface_vertex()
        }
        let altitude = triangle_pixel_altitude(
            projected0,
            projected1,
            projected2,
            patch_vertex % 3,
            extent(current),
        )
        let corner = triangle_corner(patch_vertex % 3)
        RasterVertex {
            position: projected.clip,
            varying: SurfaceVarying {
                triangle_edge: bary3f(
                    corner.a * altitude * projected.depth,
                    corner.b * altitude * projected.depth,
                    corner.c * altitude * projected.depth,
                ),
                patch_edge: bary,
                normal: differential.normal,
                patch_index: as_f32(patch_index),
                view_depth: projected.depth,
                valid: if differential.sample.vector_valued { 1.0 } else { 0.0 },
            },
        }
    }

    fn surface_fragment(self, varying: SurfaceVarying) -> i32
        uses (FragmentStage<SurfaceVarying>)
    {
        let split = if self.split_mode < 0.5 {
            true
        } else if self.split_mode < 1.5 {
            self.difficulty > self.split_threshold
        } else {
            false
        }
        let surface = if varying.valid > 0.5 {
            shade(varying, split)
        } else {
            to_display_rgb(oklch(0.64, 0.21, 0.39))
        }
        let triangle_pixels = minimum_barycentric(varying.triangle_edge) / varying.view_depth
        let triangle_line = if self.show_triangles > 0.5 {
            1.0 - smoothstep(self.wire_px - 0.70, self.wire_px + 0.70, triangle_pixels)
        } else {
            0.0
        }
        let patch_line = 1.0 - smoothstep(0.0, 0.012, minimum_barycentric(varying.patch_edge))
        let coverage = maximum(triangle_line * 0.62, patch_line)
        pack_rgba8(mix_display_rgb(surface, display_rgb(0.018, 0.025, 0.043), coverage))
    }

    fn diagram_vertices(self, vertex_index: u32) -> RasterVertex<DiagramVarying>
        uses (VertexStage<DiagramVarying, TriangleList<12>>)
    {
        let current = state(
            self.split_mode,
            self.center_mode,
            self.center_goal,
            self.center_u,
            self.center_v,
            self.split_threshold,
            self.mesh_lod,
            self.show_triangles,
            self.resolve_weight_constraint,
            self.w00,
            self.w10,
            self.w01,
            self.w11,
            self.orbit_yaw,
            self.orbit_pitch,
            self.orbit_distance,
            self.wire_px,
            self.res_x,
            self.res_y,
            self.orbiting,
            self.difficulty,
            self.center_score,
        )
        let patch_index = vertex_index / 3
        let corner = vertex_index % 3
        if patch_index >= active_patch_count(current) {
            return RasterVertex {
                position: ClipPosition { x: 2.0, y: 2.0, z: 0.0, w: 1.0 },
                varying: DiagramVarying { edge: bary3f(0.0, 0.0, 0.0), patch_index: 0.0 },
            }
        }
        let domain = displayed_domain(patch_index, current)
        let parameter = if corner == 0 { domain.a } else if corner == 1 { domain.b } else { domain.c }
        RasterVertex {
            position: diagram_clip(parameter, current),
            varying: DiagramVarying {
                edge: triangle_corner(corner),
                patch_index: as_f32(patch_index),
            },
        }
    }

    fn diagram_fragment(self, varying: DiagramVarying) -> i32
        uses (FragmentStage<DiagramVarying>)
    {
        let split = if self.split_mode < 0.5 {
            true
        } else if self.split_mode < 1.5 {
            self.difficulty > self.split_threshold
        } else {
            false
        }
        let line = 1.0 - smoothstep(0.0, 0.035, minimum_barycentric(varying.edge))
        pack_rgba8(mix_display_rgb(
            patch_color(varying.patch_index, split),
            display_rgb(0.018, 0.025, 0.043),
            line,
        ))
    }

    fn center_marker_vertices(self, vertex_index: u32) -> RasterVertex<MarkerVarying>
        uses (VertexStage<MarkerVarying, TriangleList<6>>)
    {
        let current = state(
            self.split_mode,
            self.center_mode,
            self.center_goal,
            self.center_u,
            self.center_v,
            self.split_threshold,
            self.mesh_lod,
            self.show_triangles,
            self.resolve_weight_constraint,
            self.w00,
            self.w10,
            self.w01,
            self.w11,
            self.orbit_yaw,
            self.orbit_pitch,
            self.orbit_distance,
            self.wire_px,
            self.res_x,
            self.res_y,
            self.orbiting,
            self.difficulty,
            self.center_score,
        )
        if !uses_four_patches(current) {
            return RasterVertex {
                position: ClipPosition { x: 2.0, y: 2.0, z: 0.0, w: 1.0 },
                varying: MarkerVarying { automatic: 0.0 },
            }
        }
        RasterVertex {
            position: marker_clip(
                vec2f(current.center_u, current.center_v), vertex_index, current,
            ),
            varying: MarkerVarying {
                automatic: if current.center_mode > 0.5 { 1.0 } else { 0.0 },
            },
        }
    }

    fn center_marker_fragment(self, varying: MarkerVarying) -> i32
        uses (FragmentStage<MarkerVarying>)
    {
        if varying.automatic > 0.5 { -12736273 } else { -3834783 }
    }
}
