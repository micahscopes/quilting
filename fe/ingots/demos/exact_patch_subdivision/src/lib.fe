//! One Clifford patch split into exact curved triangular patches.
//!
//! The movable center always remains on the authored patch: it is a point in
//! the patch's parameter domain, never an independently fitted 3D handle.
//! Restricting the homogeneous numerator and weight fields to each of the four
//! surrounding triangles produces exact quadratic triangular patches. Their
//! shared curves and tangent planes therefore agree by construction; the
//! optional wireframe is only a temporary mesh used to display them.

use core::marker::Copy
use fmath::{clamp, min, max, smoothstep, wrap_pi}
use quilting_clifford_bezier::{
    IsotropicBilinearPatch,
    IsotropicPolicy,
    control,
    even,
    evaluate_differential,
    evaluate_triangular_projective_controls,
    evaluate_triangular_projective_differential,
    patch,
    scale_weight,
    triangular_projective_controls,
}
use quilting_demo_view::{
    CameraFrame,
    OrbitCamera,
    ScreenExtent,
    orbit_camera,
    project,
    triangle_pixel_altitude,
}
use quilting_domain::{
    Bary3F,
    Vec2F,
    Vec3F,
    absf,
    bary3f,
    dot3,
    normalize3_or,
    vec2f,
    vec3f,
}
use quilting_oklch::{
    DisplayRgb,
    display_rgb,
    mix_display_rgb,
    oklch,
    pack_rgba8,
    scale_lightness_chroma,
