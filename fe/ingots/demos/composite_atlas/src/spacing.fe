//! One canonical density map per shared boundary, sampled by the Wasm actor.
//! Boundary evaluation bypasses interior extension to preserve shared arithmetic.
use core::{BrowserBytes,BrowserPtr,alloc_browser_object}
use core::marker::Copy
use quilting_atlas::composition::SquareBoundaryUse
use core::option::Option
use fmath::sqrt
use quilting_patch::arc_length::{CumulativeLengthSamples,SampledCumulativeLength}
use quilting_patch::arc_spacing::{dyadic_arc_samples,interpolate_parameters,IntervalMapSamples}
use quilting_patch::sampling_warp::{InverseCumulativeMap,IntervalSamplingMap,OrientedIntervalMap}
use quilting_clifford_bezier::euclidean::EuclideanArcMeasure
use quilting_domain::{Bary3F,Vec3F}
use std::webgpu::{StorageBuffer,BufferPublication,PublicationVersion}
use ingot::model::{initial_controls,corner,edge_measure,redistribute_edge}
use ingot::residency::{Scene,State,ChildDraw}

pub const SAMPLES:usize=65
/// One 2^8+1 table per outer side. Because the construction is nested, every
/// coarser LoD reads its own samples out of this one table exactly, so a single
/// published size serves LoD0 through LoD8 without a second resolution.
pub const ARC_SAMPLES:usize=257
pub const ARC_SLOTS:usize=4
pub const ARC_BASE:usize=10*SAMPLES
pub const MAP_WORDS:usize=ARC_BASE+ARC_SLOTS*ARC_SAMPLES
pub type Maps=StorageBuffer<f32,MAP_WORDS>
/// Substeps per published span. The interior curves have no closed-form arc
/// law here, so their length is integrated; this keeps the table from being a
/// sixteen-chord approximation of a curve that bends inside each span.
const SUBSTEPS:usize=2
extern {const fn __f32_from_i32(_:i32)->f32}
fn fraction(_ index:usize,_ count:usize)->f32 {
    let a:i32=index.downcast_unchecked()
    let b:i32=count.downcast_unchecked()
    __f32_from_i32(a)/__f32_from_i32(b)
}
struct MeasuredPoint {position:Vec3F,valid:bool}
impl Copy for MeasuredPoint {}
fn measured_point(_ net:ingot::surface::Net,_ warp:ingot::composition_warp::CompositionWarp,
    _ a:ingot::model::Point,_ b:ingot::model::Point,_ q:f32)->MeasuredPoint {
    let reference=ingot::model::Point {x:a.x*(1.0-q)+b.x*q,y:a.y*(1.0-q)+b.y*q}
    let sample=ingot::surface::evaluate(net,warp.apply(reference))
    MeasuredPoint {position:sample.point,valid:sample.valid}
}
/// Measured surface length along one reference segment, through the same warp
/// and patch evaluation the renderer applies. This is the general law: it needs
/// no affine rotor path and therefore covers the interior diagonals and spokes
/// that the exact circular construction cannot admit. It is an integration, so
/// unlike the outer-side tables it carries a quadrature error.
pub fn measured_cumulative(_ net:ingot::surface::Net,_ warp:ingot::composition_warp::CompositionWarp,
    _ center_x:f32,_ center_y:f32,_ from:u32,_ to:u32)->core::option::Option<SampledCumulativeLength<65>> {
    let a=corner(from,center_x,center_y)
    let b=corner(to,center_x,center_y)
    let steps=64*SUBSTEPS
    let mut values=[0.0;65]
    let mut previous=measured_point(net,warp,a,b,0.0)
    if !previous.valid {return core::option::Option::None}
    let mut total:f32=0.0
    for i in 0 .. steps {
        let current=measured_point(net,warp,a,b,fraction(i+1,steps))
        if !current.valid {return core::option::Option::None}
        let dx=current.position.x-previous.position.x
        let dy=current.position.y-previous.position.y
        let dz=current.position.z-previous.position.z
        total=total+sqrt(dx*dx+dy*dy+dz*dz)
        previous=current
        if (i+1)%SUBSTEPS==0 {values[(i+1)/SUBSTEPS]=total}
    }
    // A collapsed or non-finite segment must not be published as a map.
    if !(total>0.0) || !(1.0/total>0.0) {return core::option::Option::None}
    core::option::Option::Some(SampledCumulativeLength {values:values})
}
pub struct PublishSpacing {}
impl PublishSpacing {
    pub fn publication(_ state:State)->BufferPublication<Maps> {
        // The publication arena owns this temporary staging allocation. It is
        // derived from the supplied immutable scene, never a mutable newer edit.
        let scene=state.scene
        let version=PublicationVersion {epoch:1,revision:scene.spacing_revision}
        if scene.spacing_revision==0 {
            return BufferPublication {version:version,source:BrowserBytes {ptr:0,len:0},target_byte_offset:0}
        }
        let p=alloc_browser_object<[f32;MAP_WORDS]>()
        if p.address()==0 {
            return BufferPublication {version:version,source:BrowserBytes {ptr:0,len:0},target_byte_offset:0}
        }
        let mut c=initial_controls()
        c.bottom_lod=scene.active_bottom
        c.right_lod=scene.active_right
        c.top_lod=scene.active_top
        c.left_lod=scene.active_left
        c.center_x=scene.active_center_x
        c.center_y=scene.active_center_y
        for slot in 0 .. 10 {
            let from:u32=if slot<3 {slot.downcast_truncate()} else if slot<6 {if slot==5 {1} else {0}}
                else {(slot-6).downcast_truncate()}
            let to:u32=if slot<3 {(slot+1).downcast_truncate()} else if slot==3 || slot==5 {3}
                else if slot==4 {2} else {4}
            // Neutral skew now means uniform surface spacing rather than
            // uniform reference spacing; the slider stays a deliberate bias.
            let raw=if scene.active_automatic_density>0.5 && scene.surface.patch_valid>0.5
                && scene.surface.circular_edges {
                match measured_cumulative(scene.surface,scene.composition_warp,
                    scene.active_center_x,scene.active_center_y,from,to) {
                    Option::Some(measured)=>measured,
                    Option::None=>edge_measure(c,from,to),
                }
            } else {edge_measure(c,from,to)}
            let cdf=redistribute_edge(raw,scene.active_skews.at(slot))
            for i in 0 .. SAMPLES {
                let dst:BrowserPtr<f32>=BrowserPtr::from_u32(p.address()+((slot*SAMPLES+i)*4).downcast_truncate())
                dst.write(cdf.values[i])
            }
        }
        // Measured surface spacing for the four outer sides. This replaces the
        // reference-domain map only where the authored weights admit the exact
        // circular construction; a rejected or disabled side writes the leading
        // sentinel and keeps the reference map in use.
        for slot in 0 .. ARC_SLOTS {
            let base=ARC_BASE+slot*ARC_SAMPLES
            let samples=if scene.active_automatic_density>0.5 && scene.surface.patch_valid>0.5
                && scene.surface.circular_edges {
                dyadic_arc_samples<EuclideanArcMeasure,ARC_SAMPLES>(
                    ingot::surface::outer_arc(scene.surface,slot.downcast_truncate()))
            } else {Option::None}
            match samples {
                Option::Some(table)=>{
                    for i in 0 .. ARC_SAMPLES {
                        let dst:BrowserPtr<f32>=BrowserPtr::from_u32(p.address()+((base+i)*4).downcast_truncate())
                        dst.write(table.parameter(i.downcast_truncate()))
                    }
                },
                Option::None=>{
                    for i in 0 .. ARC_SAMPLES {
                        let dst:BrowserPtr<f32>=BrowserPtr::from_u32(p.address()+((base+i)*4).downcast_truncate())
                        dst.write(if i==0 {-1.0} else {identity_fraction(i.downcast_truncate())})
                    }
                },
            }
        }
        BufferPublication {version:version,source:BrowserBytes {ptr:p.address(),len:(MAP_WORDS*4).downcast_truncate()},target_byte_offset:0}
    }
}

pub struct EdgeSamples {pub maps:Maps,pub slot:u32}
impl Copy for EdgeSamples {}
impl CumulativeLengthSamples for EdgeSamples {
    fn segments(self)->u32 {64}
    fn cumulative(self,_ index:u32)->f32 {self.maps.load(index:self.slot.wrapping_mul(65).wrapping_add(index))}
}
fn arc_segments()->u32 {(ARC_SAMPLES-1).downcast_truncate()}
fn identity_fraction(_ index:u32)->f32 {
    let last:i32=(ARC_SAMPLES-1).downcast_unchecked()
    __f32_from_i32(index.downcast_unchecked())/__f32_from_i32(last)
}
/// A published outer-side arc table read directly out of shared storage. Its
/// values are already the inverse map, so exact dyadic inputs select a stored
/// sample rather than interpolating between two of them.
pub struct ArcSamples {pub maps:Maps,pub slot:u32}
impl Copy for ArcSamples {}
impl IntervalMapSamples for ArcSamples {
    fn segments(self)->u32 {arc_segments()}
    fn parameter(self,_ index:u32)->f32 {
        let base:u32=ARC_BASE.downcast_truncate()
        let stride:u32=ARC_SAMPLES.downcast_truncate()
        self.maps.load(index:base.wrapping_add(self.slot.wrapping_mul(stride)).wrapping_add(index))
    }
}
/// One canonical law per boundary. Both neighbouring uses of a shared edge
/// resolve the same branch from the same published table, so the choice cannot
/// desynchronize a seam.
pub struct EdgeSpacing {pub maps:Maps,pub slot:u32,pub measured:bool}
impl Copy for EdgeSpacing {}
impl IntervalSamplingMap for EdgeSpacing {
    fn map(self,_ t:f32)->f32 {
        if self.measured {interpolate_parameters(ArcSamples {maps:self.maps,slot:self.slot},t)}
        else {InverseCumulativeMap {samples:EdgeSamples {maps:self.maps,slot:self.slot}}.map(t)}
    }
}
pub type DirectedMap=OrientedIntervalMap<EdgeSpacing>
fn edge_map(_ maps:Maps,_ edge:SquareBoundaryUse)->DirectedMap {
    let slot=edge.slot()
    let outer:u32=ARC_SLOTS.downcast_truncate()
    let table=ArcSamples {maps:maps,slot:slot}
    // A published table always starts at zero; the sentinel marks a side that
    // was disabled or whose arc the measure refused.
    let measured=slot<outer && table.parameter(0)==0.0
    OrientedIntervalMap {law:EdgeSpacing {maps:maps,slot:slot,measured:measured},reversed:edge.reversed()}
}
pub fn canonical_parameter(_ maps:Maps,_ edge:SquareBoundaryUse,_ t:f32,_ enabled:bool)->f32 {
    let m=edge_map(maps,edge)
    let q=if m.reversed {1.0-t} else {t}
    if enabled {m.canonical(t)} else {q}
}
pub fn place(_ maps:Maps,_ scene:Scene,_ d:ChildDraw,_ p:Bary3F)->ingot::model::Point {
    ingot::placement::place(scene,d,p,edge_map(maps,d.boundaries.ab),edge_map(maps,d.boundaries.bc),edge_map(maps,d.boundaries.ca))
}
