//! Authored controls and pure composition planning, independent of residency.
use core::marker::Copy
use fmath::sqrt
use quilting_atlas::lod_as_f32
use quilting_atlas::composition::{SquareSplit, SquareEdgeLods}
use quilting_patch::arc_length::{SampledCumulativeLength, CumulativeLengthSamples}
use quilting_patch::sampling_warp::InteriorRedistribution
use quilting_domain::{Bary3F,bary3f}
use std::web::view::{Param, ChoiceOptions, SurfaceState, SurfaceEvent, ApplyParamBindings, ParamBindingsProvider}

pub struct Controls {
    pub bottom_lod:f32, pub right_lod:f32, pub top_lod:f32, pub left_lod:f32,
    pub automatic_interior:f32, pub diagonal_lod:f32,
    pub spoke_0_lod:f32, pub spoke_1_lod:f32, pub spoke_2_lod:f32, pub spoke_3_lod:f32,
    pub split:f32, pub center_x:f32, pub center_y:f32, pub compensate_density:f32,
    pub interior_enabled:f32, pub interior_concentration:f32, pub interior_twist:f32,
    pub focus_a:f32, pub focus_b:f32, pub focus_c:f32,
    pub width:f32, pub height:f32,
}
impl Copy for Controls {}
pub struct Params {
    pub bottom_lod:Param, pub right_lod:Param, pub top_lod:Param, pub left_lod:Param,
    pub automatic_interior:Param, pub diagonal_lod:Param,
    pub spoke_0_lod:Param, pub spoke_1_lod:Param, pub spoke_2_lod:Param, pub spoke_3_lod:Param,
    pub split:Param, pub center_x:Param, pub center_y:Param, pub compensate_density:Param,
    /// Redistribute each child's interior; all outer edges and spokes stay fixed.
    pub interior_enabled:Param,
    /// One is neutral. Larger values concentrate samples near the child focus.
    pub interior_concentration:Param,
    /// Twist within each child; red triangles indicate folds in the finite mesh.
    pub interior_twist:Param,
    /// Relative pull of the focus toward child corner A, B or C; not a corner position.
    pub focus_a:Param, pub focus_b:Param, pub focus_c:Param,
    pub width:Param, pub height:Param,
}
impl SurfaceState for Controls { type Params = Params }
derive ApplyParamBindings for Controls using ParamBindingsProvider
pub const fn params() -> Params {
    Params {
        bottom_lod:Param::int(min:0.0,max:8.0,init:4.0),
        right_lod:Param::int(min:0.0,max:8.0,init:4.0),
        top_lod:Param::int(min:0.0,max:8.0,init:4.0),
        left_lod:Param::int(min:0.0,max:8.0,init:4.0),
        automatic_interior:Param::toggle(init:true),
        diagonal_lod:Param::int(min:0.0,max:8.0,init:4.0),
        spoke_0_lod:Param::int(min:0.0,max:8.0,init:4.0),
        spoke_1_lod:Param::int(min:0.0,max:8.0,init:4.0),
        spoke_2_lod:Param::int(min:0.0,max:8.0,init:4.0),
        spoke_3_lod:Param::int(min:0.0,max:8.0,init:4.0),
        split:Param::choice(options:ChoiceOptions::three(first:"two triangles: diagonal 0–2",
            second:"two triangles: diagonal 1–3",third:"four triangles: movable center"),init:2.0),
        center_x:Param::range(min:0.02,max:0.98,init:0.5),
        center_y:Param::range(min:0.02,max:0.98,init:0.5),
        compensate_density:Param::toggle(init:true),
        interior_enabled:Param::toggle(init:true),
        interior_concentration:Param::range(min:0.25,max:4.0,init:1.0),
        interior_twist:Param::range(min:-3.14159265,max:3.14159265,init:0.0),
        focus_a:Param::range(min:0.1,max:4.0,init:1.0),
        focus_b:Param::range(min:0.1,max:4.0,init:1.0),
        focus_c:Param::range(min:0.1,max:4.0,init:1.0),
        width:Param::extent_x(),height:Param::extent_y(),
    }
}
pub fn initial_controls() -> Controls {
    Controls {bottom_lod:4.0,right_lod:4.0,top_lod:4.0,left_lod:4.0,
        automatic_interior:1.0,diagonal_lod:4.0,spoke_0_lod:4.0,spoke_1_lod:4.0,
        spoke_2_lod:4.0,spoke_3_lod:4.0,split:2.0,center_x:0.5,center_y:0.5,
        compensate_density:1.0,interior_enabled:1.0,interior_concentration:1.0,interior_twist:0.0,
        focus_a:1.0,focus_b:1.0,focus_c:1.0,width:1200.0,height:1200.0}
}
/// An immutable visible interior policy, published with its child geometry.
pub struct InteriorPolicy {pub enabled:f32,pub map:InteriorRedistribution,pub focus:Bary3F}
impl Copy for InteriorPolicy {}
impl InteriorPolicy {
    pub fn apply(self,_ p:Bary3F)->Bary3F {
        if self.enabled>0.5 {self.map.triangle(p,self.focus)} else {p}
    }
}
pub fn interior_policy(_ c:Controls)->InteriorPolicy {
    let sum=c.focus_a+c.focus_b+c.focus_c
    InteriorPolicy {enabled:c.interior_enabled,
        map:InteriorRedistribution {concentration:c.interior_concentration,twist:c.interior_twist},
        focus:bary3f(c.focus_a/sum,c.focus_b/sum,c.focus_c/sum)}
}
pub fn level(_ value:f32) -> u32 {
    let mut n:u32=0
    while n<8 && value>=lod_as_f32(n)+0.5 { n+=1 }
    n
}
pub fn recipe(_ value:f32) -> SquareSplit {
    if value<0.5 {SquareSplit::Diagonal02}
    else if value<1.5 {SquareSplit::Diagonal13}
    else {SquareSplit::InteriorFan}
}
pub struct Point {pub x:f32,pub y:f32}
impl Copy for Point {}
pub fn corner(_ id:u32,_ x:f32,_ y:f32) -> Point {
    if id==4 {Point{x:x,y:y}}
    else {Point{x:if id==1 || id==2 {1.0} else {0.0},y:if id==2 || id==3 {1.0} else {0.0}}}
}

/// A reference-domain density heuristic, not an interior-uniformity proof.
/// The straight outer edges integrate to exactly their requested counts.
pub fn edge_cdf(_ controls:Controls,_ from:u32,_ to:u32) -> SampledCumulativeLength<17> {
    let a=corner(from,controls.center_x,controls.center_y)
    let b=corner(to,controls.center_x,controls.center_y)
    let dx=b.x-a.x
    let dy=b.y-a.y
    let bottom=lod_as_f32(1<<level(controls.bottom_lod))
    let top=lod_as_f32(1<<level(controls.top_lod))
    let left=lod_as_f32(1<<level(controls.left_lod))
    let right=lod_as_f32(1<<level(controls.right_lod))
    let mut values=[0.0;17]
    for i in 0 .. 16 {
        let t=(lod_as_f32(i.downcast_truncate())+0.5)/16.0
        let x=a.x+dx*t
        let y=a.y+dy*t
        let vx=((1.0-y)*bottom+y*top)*dx
        let vy=((1.0-x)*left+x*right)*dy
        values[i+1]=values[i]+sqrt(vx*vx+vy*vy)/16.0
    }
    SampledCumulativeLength {values:values}
}
pub fn edge_demand(_ controls:Controls,_ from:u32,_ to:u32) -> f32 {
    edge_cdf(controls,from,to).cumulative(16)
}
fn automatic_level(_ controls:Controls,_ from:u32,_ to:u32) -> u32 {
    let demand=edge_demand(controls,from,to)
    let mut n:u32=0
    let mut covered=1.0
    while n<8 && covered<demand {
        covered=covered*2.0
        n+=1
    }
    n
}
pub fn edge_lods(_ controls:Controls) -> SquareEdgeLods {
    let mut levels=[level(controls.bottom_lod),level(controls.right_lod),level(controls.top_lod),level(controls.left_lod),
        level(controls.diagonal_lod),level(controls.diagonal_lod),level(controls.spoke_0_lod),level(controls.spoke_1_lod),
        level(controls.spoke_2_lod),level(controls.spoke_3_lod)]
    if controls.automatic_interior>0.5 {
        levels[4]=automatic_level(controls,0,2)
        levels[5]=automatic_level(controls,1,3)
        for i in 0 .. 4 { levels[6+i]=automatic_level(controls,i.downcast_truncate(),4) }
    }
    SquareEdgeLods {levels:levels}
}
