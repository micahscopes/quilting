//! Authored controls and pure composition planning, independent of residency.
use core::marker::Copy
use fmath::sqrt
use quilting_atlas::lod_as_f32
use quilting_atlas::composition::{SquareSplit, SquareEdgeLods,BoundaryUse,ChildTriangle}
use quilting_patch::arc_length::{SampledCumulativeLength, CumulativeLengthSamples}
use quilting_patch::sampling_warp::{InteriorRedistribution,RedistributedCumulative,ProjectiveIntervalBias}
use quilting_domain::{Bary3F,bary3f}
use std::web::view::{Param,ParamReadout,ChoiceOptions,SurfaceState,SurfaceEvent,ApplyParamBindings,ParamBindingsProvider}

pub struct Controls {
    pub composition_enabled:f32,pub composition_focus_x:f32,pub composition_focus_y:f32,
    pub composition_concentration:f32,pub composition_twist:f32,pub composition_falloff:f32,
    pub surface_kind:f32,pub arc_edge:f32,
    pub p0x:f32,pub p0y:f32,pub p0z:f32,pub p1x:f32,pub p1y:f32,pub p1z:f32,
    pub p2x:f32,pub p2y:f32,pub p2z:f32,pub p3x:f32,pub p3y:f32,pub p3z:f32,
    pub midpoint_x:f32,pub midpoint_y:f32,pub midpoint_z:f32,
    pub orbit_yaw:f32,pub orbit_pitch:f32,pub orbit_distance:f32,
    pub selected:f32,pub dragging:f32,pub wires:f32,pub color_view:f32,pub error_scale:f32,
    pub bottom_lod:f32, pub right_lod:f32, pub top_lod:f32, pub left_lod:f32,
    pub automatic_interior:f32,
    /// Saved manual LoD exponent, used only when automatic interior selection is off.
    pub diagonal_lod:f32,
    /// Saved manual spoke exponents. Automatic mode preserves these requests.
    pub spoke_0_lod:f32, pub spoke_1_lod:f32, pub spoke_2_lod:f32, pub spoke_3_lod:f32,
    pub split:f32, pub center_x:f32, pub center_y:f32, pub compensate_density:f32,
    pub interior_enabled:f32, pub interior_concentration:f32, pub interior_twist:f32,
    pub focus_a:f32, pub focus_b:f32, pub focus_c:f32,
    pub width:f32, pub height:f32,
    pub bottom_skew:f32,pub right_skew:f32,pub top_skew:f32,pub left_skew:f32,
    pub diagonal_02_skew:f32,pub diagonal_13_skew:f32,
    pub spoke_0_skew:f32,pub spoke_1_skew:f32,pub spoke_2_skew:f32,pub spoke_3_skew:f32,
    pub boundary_reach:f32,
    pub automatic_density:f32,pub interior_area_correction:f32,
    pub free_weights:f32,pub weight_freedom:f32,
}
impl Copy for Controls {}
pub struct Params {
    /// Applied once across the whole assembled domain, including internal seams.
    pub composition_enabled:Param,
    pub composition_focus_x:Param,
    /// In triangle mode this is the fraction of the available height at focus X.
    pub composition_focus_y:Param,
    pub composition_concentration:Param,pub composition_twist:Param,pub composition_falloff:Param,
    /// Patch modes share the same generated primaries and composition maps.
    pub surface_kind:Param,
    /// One means this finite-pole family accepts the authored arc; zero is not
    /// repaired by projecting weights or inventing a replacement pole.
    pub patch_valid:Param,
    /// Certified lower bound on the denominator norm across the patch. Zero
    /// means the pole reaches the domain and part of the patch is unbounded.
    pub pole_margin:Param,
    /// Editing this arc changes the other arcs through one common pole.
    pub arc_edge:Param,
    pub p0x:Param,pub p0y:Param,pub p0z:Param,pub p1x:Param,pub p1y:Param,pub p1z:Param,
    pub p2x:Param,pub p2y:Param,pub p2z:Param,pub p3x:Param,pub p3y:Param,pub p3z:Param,
    pub midpoint_x:Param,pub midpoint_y:Param,pub midpoint_z:Param,
    pub orbit_yaw:Param,pub orbit_pitch:Param,pub orbit_distance:Param,
    pub selected:Param,pub dragging:Param,pub wires:Param,
    /// Shape and sampled correspondence error are distinct measurements.
    pub color_view:Param,
    /// World-space centroid error shown as warm at or above this value. This is
    /// a fixed comparison scale, not an adaptive range or an accuracy bound.
    pub error_scale:Param,
    pub bottom_lod:Param, pub right_lod:Param, pub top_lod:Param, pub left_lod:Param,
    pub automatic_interior:Param, pub diagonal_lod:Param,
    pub spoke_0_lod:Param, pub spoke_1_lod:Param, pub spoke_2_lod:Param, pub spoke_3_lod:Param,
    pub split:Param, pub center_x:Param, pub center_y:Param,
    /// Apply the shared density maps, including edge skew controls. Off bypasses both.
    pub compensate_density:Param,
    /// Redistribute each child's interior; all outer edges and spokes stay fixed.
    pub interior_enabled:Param,
    /// One is neutral. Larger values concentrate samples near the child focus.
    pub interior_concentration:Param,
    /// Twist within each child; red triangles indicate folds in the finite mesh.
    pub interior_twist:Param,
    /// Relative pull of the focus toward child corner A, B or C; not a corner position.
    pub focus_a:Param, pub focus_b:Param, pub focus_c:Param,
    pub width:Param, pub height:Param,
    /// One is neutral; larger values concentrate toward the first named endpoint.
    /// Corner order: 0 bottom-left, 1 bottom-right, 2 top-right, 3 top-left, 4 center.
    /// Outer directions are bottom 0→1, right 1→2, top 2→3, left 0→3.
    pub bottom_skew:Param,pub right_skew:Param,pub top_skew:Param,pub left_skew:Param,
    /// Density redistribution along fixed diagonals 0→2 and 1→3, not midpoint motion.
    pub diagonal_02_skew:Param,pub diagonal_13_skew:Param,
    /// Each spoke runs from its numbered corner toward the fixed fan center.
    pub spoke_0_skew:Param,pub spoke_1_skew:Param,pub spoke_2_skew:Param,pub spoke_3_skew:Param,
    /// One preserves the original extension. Smaller values localize edge
    /// warps; very small values can create skinny triangles. Boundaries stay fixed.
    pub boundary_reach:Param,
    /// Space the four outer sides by measured surface arc length instead of the
    /// reference-domain density. Applies only where an authored patch admits the
    /// exact circular map; diagonals, spokes and the flat view are unaffected.
    pub automatic_density:Param,
    /// Compare corrected area slices against edge-only extension. Both keep
    /// identical measured boundary samples and counts. Requires measured mode.
    pub interior_area_correction:Param,
    /// Leave the paper's point-space condition. The authoring family derives
    /// every weight from one pole, which is what keeps all edges circular. This
    /// admits the wider Clifford-Bezier surfaces instead, whose edges are not
    /// arcs. Off by default because those shapes are unwieldy, not because they
    /// are wrong.
    pub free_weights:Param,
    /// Bivector added to the corner weights once free weights are admitted, in
    /// three distinct planes so no corner stays on the family. Zero reproduces
    /// the constrained patch exactly, so the toggle alone changes nothing.
    pub weight_freedom:Param,
    /// Visible segment counts, not saved manual requests. Zero means inactive.
    pub diagonal_02_segments:Param,pub diagonal_13_segments:Param,
    pub spoke_0_segments:Param,pub spoke_1_segments:Param,pub spoke_2_segments:Param,pub spoke_3_segments:Param,
    /// Visible edges whose declared density demand exceeds their segment count.
    pub unmet_edges:Param,
    /// Visible edges still below demand at the maximum LoD8 count.
    pub capped_edges:Param,
    /// Largest demand minus actual count among visible edges.
    pub max_unmet_segments:Param,
    /// Requested primaries still pending; counts above describe the retained visible scene.
    pub pending:Param,
}
impl SurfaceState for Controls { type Params = Params }
derive ApplyParamBindings for Controls using ParamBindingsProvider<Params>
pub const fn params() -> Params {
    Params {
        composition_enabled:Param::toggle(init:true),
        composition_focus_x:Param::range(min:0.02,max:0.98,init:0.5),
        composition_focus_y:Param::range(min:0.02,max:0.98,init:0.5),
        composition_concentration:Param::log(min:0.0625,max:16.0,init:1.0),
        pole_margin:Param::readout(ParamReadout::Scalar),
        composition_twist:Param::range(min:-6.2831853,max:6.2831853,init:0.0),
        composition_falloff:Param::choice(options:ChoiceOptions::three(first:"quadratic",second:"smoothstep",third:"smootherstep"),init:1.0),
        surface_kind:Param::choice(options:ChoiceOptions::three(first:"flat composition",
            second:"curved triangle",third:"curved quad"),init:0.0),
        patch_valid:Param::readout(ParamReadout::Scalar),
        arc_edge:Param::choice(options:ChoiceOptions::four(first:"first boundary",second:"second boundary",
            third:"third boundary",fourth:"fourth boundary (quad)"),init:0.0),
        // Hidden again now that the authored net can be reproduced another way.
        // The parameter API has no grouping, so a visible readout cannot be
        // collapsed; flip these to `Param::readout(ParamReadout::Scalar)` when a
        // running configuration needs to be read back, and hide them after.
        p0x:Param::fixed(-1.0),p0y:Param::fixed(-0.7),p0z:Param::fixed(0.0),
        p1x:Param::fixed(1.0),p1y:Param::fixed(-0.7),p1z:Param::fixed(0.0),
        p2x:Param::fixed(1.0),p2y:Param::fixed(0.7),p2z:Param::fixed(0.0),
        p3x:Param::fixed(-1.0),p3y:Param::fixed(0.7),p3z:Param::fixed(0.0),
        midpoint_x:Param::fixed(0.0),midpoint_y:Param::fixed(-0.7),midpoint_z:Param::fixed(0.6),
        orbit_yaw:Param::range(min:-3.14159,max:3.14159,init:0.25),
        orbit_pitch:Param::range(min:-1.35,max:1.35,init:0.15),
        orbit_distance:Param::log(min:1.0,max:40.0,init:5.0),
        selected:Param::fixed(-1.0),dragging:Param::fixed(0.0),wires:Param::toggle(init:true),
        color_view:Param::choice(options:ChoiceOptions::four(first:"surface shading",
            second:"triangle shape: 0 warm / 1 cool",third:"poor triangles: shape below 0.1",
            fourth:"sampled error: world units"),init:0.0),
        error_scale:Param::log(min:0.0001,max:10.0,init:0.1),
        bottom_lod:Param::int(min:0.0,max:8.0,init:4.0),
        right_lod:Param::int(min:0.0,max:8.0,init:4.0),
        top_lod:Param::int(min:0.0,max:8.0,init:4.0),
        left_lod:Param::int(min:0.0,max:8.0,init:4.0),
        automatic_interior:Param::toggle(init:true),
        diagonal_lod:Param::int(min:0.0,max:8.0,init:4.0),
        spoke_0_lod:Param::int(min:0.0,max:8.0,init:4.0),
        spoke_1_lod:Param::int(min:0.0,max:8.0,init:4.0),
        spoke_2_lod:Param::int(min:0.0,max:8.0,init:4.0),
        spoke_3_lod:Param::int(min:0.0,max:8.0,init:4.0),
        split:Param::choice(options:ChoiceOptions::three(first:"two triangles: diagonal 0–2",
            second:"two triangles: diagonal 1–3",third:"four triangles: movable center"),init:2.0),
        center_x:Param::range(min:0.02,max:0.98,init:0.5),
        center_y:Param::range(min:0.02,max:0.98,init:0.5),
        compensate_density:Param::toggle(init:true),
        interior_enabled:Param::toggle(init:true),
        interior_concentration:Param::log(min:0.0625,max:16.0,init:1.0),
        interior_twist:Param::range(min:-3.14159265,max:3.14159265,init:0.0),
        focus_a:Param::range(min:0.1,max:4.0,init:1.0),
        focus_b:Param::range(min:0.1,max:4.0,init:1.0),
        focus_c:Param::range(min:0.1,max:4.0,init:1.0),
        width:Param::extent_x(),height:Param::extent_y(),
        bottom_skew:skew_param(),right_skew:skew_param(),top_skew:skew_param(),left_skew:skew_param(),
        diagonal_02_skew:skew_param(),diagonal_13_skew:skew_param(),
        spoke_0_skew:skew_param(),spoke_1_skew:skew_param(),spoke_2_skew:skew_param(),spoke_3_skew:skew_param(),
        boundary_reach:Param::log(min:0.0625,max:16.0,init:1.0),
        automatic_density:Param::toggle(init:true),
        interior_area_correction:Param::toggle(init:true),
        free_weights:Param::toggle(init:false),
        weight_freedom:Param::range(min:-1.5,max:1.5,init:0.0),
        diagonal_02_segments:Param::readout(ParamReadout::Integer),
        diagonal_13_segments:Param::readout(ParamReadout::Integer),
        spoke_0_segments:Param::readout(ParamReadout::Integer),
        spoke_1_segments:Param::readout(ParamReadout::Integer),
        spoke_2_segments:Param::readout(ParamReadout::Integer),
        spoke_3_segments:Param::readout(ParamReadout::Integer),
        unmet_edges:Param::readout(ParamReadout::Integer),
        capped_edges:Param::readout(ParamReadout::Integer),
        max_unmet_segments:Param::readout(ParamReadout::Scalar),
        pending:Param::readout(ParamReadout::Integer),
    }
}
/// Logarithmic so neutral sits at the centre of its track, and wide because a
/// deliberate bias is no longer competing with an uncorrected dilation.
const fn skew_param()->Param {Param::log(min:0.0625,max:16.0,init:1.0)}
/// Named spacing laws for the square's four sides, two diagonals and four spokes.
pub struct EdgeSkews {
    pub bottom:f32,pub right:f32,pub top:f32,pub left:f32,
    pub diagonal02:f32,pub diagonal13:f32,
    pub spoke0:f32,pub spoke1:f32,pub spoke2:f32,pub spoke3:f32,
}
impl Copy for EdgeSkews {}
impl EdgeSkews {
    pub fn at(self,_ slot:usize)->f32 {
        [self.bottom,self.right,self.top,self.left,self.diagonal02,self.diagonal13,
            self.spoke0,self.spoke1,self.spoke2,self.spoke3][slot]
    }
}
pub fn edge_skews(_ c:Controls)->EdgeSkews {
    EdgeSkews {bottom:c.bottom_skew,right:c.right_skew,top:c.top_skew,left:c.left_skew,
        diagonal02:c.diagonal_02_skew,diagonal13:c.diagonal_13_skew,
        spoke0:c.spoke_0_skew,spoke1:c.spoke_1_skew,spoke2:c.spoke_2_skew,spoke3:c.spoke_3_skew}
}
pub fn initial_controls() -> Controls {
    Controls {bottom_lod:4.0,right_lod:4.0,top_lod:4.0,left_lod:4.0,
        composition_enabled:1.0,composition_focus_x:0.5,composition_focus_y:0.5,
        composition_concentration:1.0,composition_twist:0.0,composition_falloff:1.0,
        surface_kind:0.0,arc_edge:0.0,
        p0x:-1.0,p0y:-0.7,p0z:0.0,p1x:1.0,p1y:-0.7,p1z:0.0,
        p2x:1.0,p2y:0.7,p2z:0.0,p3x:-1.0,p3y:0.7,p3z:0.0,
        midpoint_x:0.0,midpoint_y:-0.7,midpoint_z:0.6,
        orbit_yaw:0.25,orbit_pitch:0.15,orbit_distance:5.0,selected:-1.0,dragging:0.0,wires:1.0,color_view:0.0,error_scale:0.1,
        automatic_interior:1.0,diagonal_lod:4.0,spoke_0_lod:4.0,spoke_1_lod:4.0,
        spoke_2_lod:4.0,spoke_3_lod:4.0,split:2.0,center_x:0.5,center_y:0.5,
        compensate_density:1.0,interior_enabled:1.0,interior_concentration:1.0,interior_twist:0.0,
        focus_a:1.0,focus_b:1.0,focus_c:1.0,width:1200.0,height:1200.0,
        bottom_skew:1.0,right_skew:1.0,top_skew:1.0,left_skew:1.0,diagonal_02_skew:1.0,diagonal_13_skew:1.0,
        spoke_0_skew:1.0,spoke_1_skew:1.0,spoke_2_skew:1.0,spoke_3_skew:1.0,boundary_reach:1.0,
        automatic_density:1.0,interior_area_correction:1.0,free_weights:0.0,weight_freedom:0.0}
}
/// An immutable visible interior policy, published with its child geometry.
pub struct InteriorPolicy {pub enabled:f32,pub map:InteriorRedistribution,pub focus:Bary3F}
impl Copy for InteriorPolicy {}
impl InteriorPolicy {
    pub fn apply(self,_ p:Bary3F)->Bary3F {
        if self.enabled>0.5 {self.map.triangle(p,self.focus)} else {p}
    }
}
pub fn interior_policy(_ c:Controls)->InteriorPolicy {
    let sum=c.focus_a+c.focus_b+c.focus_c
    InteriorPolicy {enabled:c.interior_enabled,
        map:InteriorRedistribution {concentration:c.interior_concentration,twist:c.interior_twist},
        focus:bary3f(c.focus_a/sum,c.focus_b/sum,c.focus_c/sum)}
}
// The loop condition bounds the counter, so it cannot overflow. Say so:
// the trap a checked add would emit has no channel in a raster stage.
#[arithmetic(unchecked)]
pub fn level(_ value:f32) -> u32 {
    let mut n:u32=0
    while n<8 && value>=lod_as_f32(n)+0.5 { n+=1 }
    n
}
pub fn recipe(_ value:f32) -> SquareSplit {
    if value<0.5 {SquareSplit::Diagonal02}
    else if value<1.5 {SquareSplit::Diagonal13}
    else {SquareSplit::InteriorFan}
}
pub fn is_triangle(_ c:Controls)->bool {c.surface_kind>0.5 && c.surface_kind<1.5}
pub fn child_count(_ c:Controls)->u32 {if is_triangle(c) {1} else {recipe(c.split).child_count()}}
pub fn child(_ c:Controls,_ index:u32)->ChildTriangle {
    if is_triangle(c) {ChildTriangle {a:0,b:1,c:3}}
    else {recipe(c.split).child(index).unwrap()}
}
pub struct Point {pub x:f32,pub y:f32}
impl Copy for Point {}
/// The reference square's interpolated directional segment densities.
pub struct DirectionalDensity {pub bottom:f32,pub right:f32,pub top:f32,pub left:f32}
impl Copy for DirectionalDensity {}
impl DirectionalDensity {
    pub fn at(self,_ p:Point)->Point {
        Point {x:(1.0-p.y)*self.bottom+p.y*self.top,y:(1.0-p.x)*self.left+p.x*self.right}
    }
    pub fn area_density(self,_ p:Point)->f32 {
        let d=self.at(p)
        d.x*d.y
    }
}
pub fn density_field(_ c:Controls)->DirectionalDensity {
    DirectionalDensity {bottom:lod_as_f32(1<<level(c.bottom_lod)),right:lod_as_f32(1<<level(c.right_lod)),
        top:lod_as_f32(1<<level(c.top_lod)),left:lod_as_f32(1<<level(c.left_lod))}
}
pub fn corner(_ id:u32,_ x:f32,_ y:f32) -> Point {
    if id==4 {Point{x:x,y:y}}
    else {Point{x:if id==1 || id==2 {1.0} else {0.0},y:if id==2 || id==3 {1.0} else {0.0}}}
}

/// A reference-domain density heuristic, not an interior-uniformity proof.
/// The straight outer edges integrate to exactly their requested counts.
pub fn edge_cdf(_ controls:Controls,_ from:u32,_ to:u32) -> SampledCumulativeLength<65> {
    let raw=edge_measure(controls,from,to)
    let edge=BoundaryUse::between(from,to)
    let skew=edge_skews(controls).at(edge.square_slot().unwrap() as usize)
    redistribute_edge(raw,if edge.reversed {1.0/skew} else {skew})
}
pub fn redistribute_edge(_ raw:SampledCumulativeLength<65>,_ skew:f32)->SampledCumulativeLength<65> {
    if skew==1.0 {return raw}
    let measure=RedistributedCumulative {samples:raw,law:ProjectiveIntervalBias {strength:skew}}
    let mut values=[0.0;65]
    for i in 0 .. 65 {values[i]=measure.cumulative(i.downcast_truncate())}
    SampledCumulativeLength {values:values}
}
/// The integrated reference density controls the count; skew redistributes
/// that same total rather than silently promoting the requested edge LoD.
pub fn edge_measure(_ controls:Controls,_ from:u32,_ to:u32) -> SampledCumulativeLength<65> {
    let a=corner(from,controls.center_x,controls.center_y)
    let b=corner(to,controls.center_x,controls.center_y)
    let dx=b.x-a.x
    let dy=b.y-a.y
    let field=density_field(controls)
    let mut values=[0.0;65]
    for i in 0 .. 64 {
        let t=(lod_as_f32(i.downcast_truncate())+0.5)/64.0
        let x=a.x+dx*t
        let y=a.y+dy*t
        let density=field.at(Point {x:x,y:y})
        let vx=density.x*dx
        let vy=density.y*dy
        values[i+1]=values[i]+sqrt(vx*vx+vy*vy)/64.0
    }
    SampledCumulativeLength {values:values}
}
pub fn edge_demand(_ controls:Controls,_ from:u32,_ to:u32) -> f32 {
    edge_measure(controls,from,to).cumulative(64)
}
fn automatic_level(_ controls:Controls,_ from:u32,_ to:u32) -> u32 {
    let demand=edge_demand(controls,from,to)
    let mut n:u32=0
    let mut covered=1.0
    while n<8 && covered<demand {
        covered=covered*2.0
        n+=1
    }
    n
}
pub fn edge_lods(_ controls:Controls) -> SquareEdgeLods {
    let mut levels=[level(controls.bottom_lod),level(controls.right_lod),level(controls.top_lod),level(controls.left_lod),
        level(controls.diagonal_lod),level(controls.diagonal_lod),level(controls.spoke_0_lod),level(controls.spoke_1_lod),
        level(controls.spoke_2_lod),level(controls.spoke_3_lod)]
    if controls.automatic_interior>0.5 {
        levels[4]=automatic_level(controls,0,2)
        levels[5]=automatic_level(controls,1,3)
        for i in 0 .. 4 { levels[6+i]=automatic_level(controls,i.downcast_truncate(),4) }
    }
    // In triangle mode 1–3 is an OUTER edge, controlled by the right LoD;
    // it must not be promoted by the square's automatic diagonal heuristic.
    if is_triangle(controls) {levels[5]=level(controls.right_lod)}
    SquareEdgeLods {levels:levels}
}

/// Observations of one resolved visible topology, separate from input state.
pub struct EdgeResolution {
    /// Visible segment count; zero means this diagonal is inactive.
    pub diagonal_02_segments:u32,pub diagonal_13_segments:u32,
    /// Visible segment counts; zero means the four-child fan is inactive.
    pub spoke_0_segments:u32,pub spoke_1_segments:u32,pub spoke_2_segments:u32,pub spoke_3_segments:u32,
    /// Edges below the reference density demand, including manual under-resolution.
    pub unmet_edges:u32,
    /// Edges below demand even at LoD8 (256 segments).
    pub capped_edges:u32,
    /// Largest demand-minus-count shortfall; numerical noise below 0.0001 is ignored.
    pub max_unmet_segments:f32,
}
impl Copy for EdgeResolution {}
impl EdgeResolution {
    pub fn empty()->Self {
        Self {diagonal_02_segments:0,diagonal_13_segments:0,spoke_0_segments:0,spoke_1_segments:0,
            spoke_2_segments:0,spoke_3_segments:0,unmet_edges:0,capped_edges:0,max_unmet_segments:0.0}
    }
}
pub fn edge_resolution(_ controls:Controls,_ edges:SquareEdgeLods)->EdgeResolution {
    let mut counts=[0;10]
    let mut result=EdgeResolution::empty()
    for i in 0 .. (child_count(controls) as usize) {
        let triangle=child(controls,i.downcast_truncate())
        for side in 0 .. 3 {
            let boundary=triangle.boundary(side.downcast_truncate()).unwrap()
            let slot=boundary.square_slot().unwrap() as usize
            if counts[slot]!=0 {continue}
            let segments:u32=1<<edges.levels[slot]
            counts[slot]=segments
            let shortfall=edge_demand(controls,boundary.low,boundary.high)-lod_as_f32(segments)
            if shortfall>0.0001 {
                result.unmet_edges+=1
                if segments==256 {result.capped_edges+=1}
                if shortfall>result.max_unmet_segments {result.max_unmet_segments=shortfall}
            }
        }
    }
    result.diagonal_02_segments=counts[4]
    result.diagonal_13_segments=counts[5]
    result.spoke_0_segments=counts[6]
    result.spoke_1_segments=counts[7]
    result.spoke_2_segments=counts[8]
    result.spoke_3_segments=counts[9]
    result
}
