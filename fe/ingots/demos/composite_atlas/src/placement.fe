//! Shared host/shader placement. Storage and atlas decoding are separate.
use quilting_domain::Bary3F
use quilting_atlas::composition::BoundaryUse
use quilting_patch::sampling_warp::{IntervalSamplingMap,OrientedIntervalMap,TriangleEdgeMaps,ProjectiveIntervalBias}
use quilting_patch::depth_field::segment_parameter
use ingot::model::{Point,corner}
use ingot::residency::{Scene,ChildDraw}

/// Uniform placement for the midpoint-square experiment. Domain construction
/// is shared by the measured mesh and the viewer; it does not fit a new surface.
pub fn midpoint_parameter(_ index:u32,_ p:Bary3F)->core::option::Option<Point> {
    use core::option::Option
    use quilting_atlas::midpoint_square::MidpointSquare
    use quilting_atlas::lod_as_f32
    let t=match MidpointSquare::child(index) {Option::Some(t)=>t,Option::None=>return Option::None}
    let a=MidpointSquare::vertex(t.a).unwrap()
    let b=MidpointSquare::vertex(t.b).unwrap()
    let c=MidpointSquare::vertex(t.c).unwrap()
    Option::Some(Point {
        x:(lod_as_f32(a.0)*p.a+lod_as_f32(b.0)*p.b+lod_as_f32(c.0)*p.c)*0.5,
        y:(lod_as_f32(a.1)*p.a+lod_as_f32(b.1)*p.b+lod_as_f32(c.1)*p.c)*0.5,
    })
}

/// Bisection budget for on-demand interior placement. Eight levels agree with
/// the published boundary tables to f32 rounding; six leave 0.000765.
const PLACEMENT_LEVELS:u32=8

fn boundary<M:IntervalSamplingMap>(_ scene:Scene,_ from:u32,_ to:u32,_ t:f32,_ map:OrientedIntervalMap<M>)->Point {
    let edge=BoundaryUse::between(from,to)
    let q=if scene.active_compensation>0.5 {map.canonical(t)} else if map.reversed {1.0-t} else {t}
    let a=corner(edge.low,scene.active_center_x,scene.active_center_y)
    let b=corner(edge.high,scene.active_center_x,scene.active_center_y)
    Point {x:a.x*(1.0-q)+b.x*q,y:a.y*(1.0-q)+b.y*q}
}
/// Ring-ordered AB/BC/CA laws; the boundary bypass keeps canonical arithmetic
/// shared exactly. Interior extension uses opposite-corner A/B/C ordering.
pub fn place<M:IntervalSamplingMap>(_ scene:Scene,_ d:ChildDraw,_ p:Bary3F,
    _ ab:OrientedIntervalMap<M>,_ bc:OrientedIntervalMap<M>,_ ca:OrientedIntervalMap<M>)->Point {
    place_with_locality(scene,d,p,ab,bc,ca,ProjectiveIntervalBias {strength:scene.active_boundary_reach})
}
pub fn place_with_locality<M:IntervalSamplingMap,L:IntervalSamplingMap>(_ scene:Scene,_ d:ChildDraw,_ p:Bary3F,
    _ ab:OrientedIntervalMap<M>,_ bc:OrientedIntervalMap<M>,_ ca:OrientedIntervalMap<M>,_ locality:L)->Point {
    scene.composition_warp.apply(assemble(scene,d,p,ab,bc,ca,locality))
}
/// Undisplaced position of a boundary sample, in the edge's canonical low to
/// high direction so both adjacent uses feed identical inputs downstream.
fn boundary_raw(_ scene:Scene,_ from:u32,_ to:u32,_ t:f32,_ reversed:bool)->Point {
    let edge=BoundaryUse::between(from,to)
    let q=if reversed {1.0-t} else {t}
    let a=corner(edge.low,scene.active_center_x,scene.active_center_y)
    let b=corner(edge.high,scene.active_center_x,scene.active_center_y)
    Point {x:a.x*(1.0-q)+b.x*q,y:a.y*(1.0-q)+b.y*q}
}
/// A boundary sample placed along its own edge, in the edge's canonical low to
/// high direction so both adjacent uses agree bit for bit. This is a different
/// map from the interior's two slice laws, so the interior is corrected to meet
/// it rather than being left to step away; see `edge_corrected`.
fn boundary_density(_ scene:Scene,_ from:u32,_ to:u32,_ t:f32,_ reversed:bool)->Point {
    let edge=BoundaryUse::between(from,to)
    let q=if reversed {1.0-t} else {t}
    let a=corner(edge.low,scene.active_center_x,scene.active_center_y)
    let b=corner(edge.high,scene.active_center_x,scene.active_center_y)
    let placed=segment_parameter(scene.domain_norm,a.x,a.y,b.x,b.y,q,PLACEMENT_LEVELS)
    Point {x:a.x*(1.0-placed)+b.x*placed,y:a.y*(1.0-placed)+b.y*placed}
}
/// One law for the whole domain. Boundary and interior differ only in how the
/// undisplaced point is found; both are then placed by the same two slice laws.
/// That is what removes the seam step: an internal seam is not a separate law
/// meeting the interior, it is the same map restricted to a line, and the two
/// sides evaluate it at bit-identical inputs because the raw point is built in
/// the edge's canonical direction.
fn density_place(_ scene:Scene,_ raw:Point)->Point {
    // Edge-only comparison: the same edge correction below now extends each
    // edge displacement from the identity map. Boundary targets never change.
    if !scene.apply_area_slices {return raw}
    // Two axis-aligned passes. A third pass along the diagonal was measured and
    // is strictly worse: each pass equalizes along its own direction as if the
    // others had not acted, so composing more of them interferes rather than
    // refines. On the quad at midpoint offset 2.4 the area ratio went from 10.96
    // to 174.78. Closing the remaining residual needs a map that is not a
    // product of one-dimensional corrections at all.
    let x=segment_parameter(scene.domain_norm,0.0,raw.y,1.0,raw.y,raw.x,PLACEMENT_LEVELS)
    let y=segment_parameter(scene.domain_norm,x,0.0,x,1.0,raw.y,PLACEMENT_LEVELS)
    Point {x:x,y:y}
}
/// The interior placement corrected to meet every child edge exactly.
///
/// The two slice laws equalize the interior but preserve only lines that are
/// axis-parallel, so on any other edge they land somewhere other than the
/// edge's own segment law. Placing boundary samples by the edge law and leaving
/// the interior alone fixes the edge and creates a step: measured at 0.0331 of
/// the domain across a spoke, against 0.00008 across an outer side.
///
/// So correct instead of choosing. On each edge the correction is where that
/// edge's law puts the sample minus where the slice laws put it, blended inward
/// by weights that are one on their own edge and zero on the other two. On an
/// edge the blend collapses to that edge's law exactly; inside it decays; the
/// map is continuous and every edge still renders as its own curve.
fn edge_corrected<M:IntervalSamplingMap>(_ scene:Scene,_ d:ChildDraw,_ p:Bary3F,_ raw:Point,
    _ ab:OrientedIntervalMap<M>,_ bc:OrientedIntervalMap<M>,_ ca:OrientedIntervalMap<M>)->Point {
    let base=density_place(scene,raw)
    // A partition of unity on the triangle: each product vanishes on the two
    // edges that are not its own. The displacements vanish at the corners,
    // where the total would otherwise be zero.
    let w_ab=p.a*p.b
    let w_bc=p.b*p.c
    let w_ca=p.c*p.a
    let total=w_ab+w_bc+w_ca
    if !(total>0.0) {return base}
    let mut x=base.x
    let mut y=base.y
    // Edge parameters chosen to equal the ones the boundary branches pass, so
    // the correction is exactly the edge law where the weight reaches one.
    if w_ab>0.0 {
        let t=p.b/(p.a+p.b)
        let target=boundary_density(scene,d.corner_a,d.corner_b,t,ab.reversed)
        let here=density_place(scene,boundary_raw(scene,d.corner_a,d.corner_b,t,ab.reversed))
        let k=w_ab/total
        x=x+(target.x-here.x)*k
        y=y+(target.y-here.y)*k
    }
    if w_bc>0.0 {
        let t=p.c/(p.b+p.c)
        let target=boundary_density(scene,d.corner_b,d.corner_c,t,bc.reversed)
        let here=density_place(scene,boundary_raw(scene,d.corner_b,d.corner_c,t,bc.reversed))
        let k=w_bc/total
        x=x+(target.x-here.x)*k
        y=y+(target.y-here.y)*k
    }
    if w_ca>0.0 {
        let t=p.a/(p.c+p.a)
        let target=boundary_density(scene,d.corner_c,d.corner_a,t,ca.reversed)
        let here=density_place(scene,boundary_raw(scene,d.corner_c,d.corner_a,t,ca.reversed))
        let k=w_ca/total
        x=x+(target.x-here.x)*k
        y=y+(target.y-here.y)*k
    }
    Point {x:x,y:y}
}
fn assemble<M:IntervalSamplingMap,L:IntervalSamplingMap>(_ scene:Scene,_ d:ChildDraw,_ p:Bary3F,
    _ ab:OrientedIntervalMap<M>,_ bc:OrientedIntervalMap<M>,_ ca:OrientedIntervalMap<M>,_ locality:L)->Point {
    if scene.density_placement {
        // A boundary sample must stay ON its own edge. The two slice laws are
        // independent, so composing them moves a point off any edge that is not
        // axis-parallel: the square's sides survive it, its diagonal does not,
        // and that diagonal is the triangle patch's third edge. Place boundary
        // samples along the edge itself instead, which is the same law
        // restricted to that line and keeps the edge exactly where it is.
        if p.b==0.0 {return boundary_density(scene,d.corner_c,d.corner_a,p.a,ca.reversed)}
        if p.c==0.0 {return boundary_density(scene,d.corner_a,d.corner_b,p.b,ab.reversed)}
        if p.a==0.0 {return boundary_density(scene,d.corner_b,d.corner_c,p.c,bc.reversed)}
        let a=corner(d.corner_a,scene.active_center_x,scene.active_center_y)
        let b=corner(d.corner_b,scene.active_center_x,scene.active_center_y)
        let c=corner(d.corner_c,scene.active_center_x,scene.active_center_y)
        let raw=Point {x:a.x*p.a+b.x*p.b+c.x*p.c,y:a.y*p.a+b.y*p.b+c.y*p.c}
        return edge_corrected(scene,d,p,raw,ab,bc,ca)
    }
    if p.b==0.0 {boundary(scene,d.corner_c,d.corner_a,p.a,ca)}
    else if p.c==0.0 {boundary(scene,d.corner_a,d.corner_b,p.b,ab)}
    else if p.a==0.0 {boundary(scene,d.corner_b,d.corner_c,p.c,bc)}
    else {
        let spaced=if scene.active_compensation>0.5 {TriangleEdgeMaps {a:bc,b:ca,c:ab}.map_with_locality(p,locality)} else {p}
        let warped=scene.interior.apply(spaced)
        let a=corner(d.corner_a,scene.active_center_x,scene.active_center_y)
        let b=corner(d.corner_b,scene.active_center_x,scene.active_center_y)
        let c=corner(d.corner_c,scene.active_center_x,scene.active_center_y)
        Point {x:a.x*warped.a+b.x*warped.b+c.x*warped.c,y:a.y*warped.a+b.y*warped.b+c.y*warped.c}
    }
}
