//! Runtime mixed-edge primaries and coherent child draw snapshots.
use core::{Worker, BrowserBytes}
use core::marker::Copy
use core::actor::{ActorInstance, InitialState, ResidentTransition, ScopedTaskFamily}
use fmath::{min,max,sqrt,abs,smoothstep}
use quilting_atlas_wasm::packed_triangle
use quilting_atlas_wasm::pool::{PoolHandle,RetainedCursor,RetainedUpdate,RETAINED_CAPACITY}
use quilting_atlas_workers::{Request,Response,CompletionMessage,supervise,run}
use quilting_domain::{bary3f,Vec3F,vec3f,sub3,cross3,normalize3_or,dot3}
use quilting_demo_view::project
use quilting_qb::{remap_barycentric,permutation_parity}
use quilting_oklch::{display_rgb,mix_display_rgb,pack_rgba8}
use std::web::view::{Surface,Extent,SurfaceEvent,ApplyParamBindings}
use std::webgpu::{GpuProgram,WebGpuBackend,StorageBuffer,DrawIndirectBuffer,
    ClipPosition,RasterVertex,VertexStage,FragmentStage,FragmentSurface,
    IndirectTriangleList,ComputeSurface,Workgroup,FixedDispatch,
    BufferPublication,PublicationVersion,PublishBuffer,
    SurfaceTransition,SurfaceScheduling,LatestPerFrame,SurfaceQuality,ResponsiveBacking}
use std::webgpu::{RasterConfiguration,RasterPlan,RasterState,DepthTest,Depth24Plus,
    CompareLessEqual,DepthWrite,ClearThenLoadStore,Samples4,CullNone,ColorTarget,
    OpaqueBlack,StraightAlpha,COLOR_WRITE_ALL,raster_plan,TriangleList}
use ingot::model::{Controls,Params,Point,params}
use ingot::residency::{State,Scene,ChildDraw,WORKERS,CAPACITY,refresh,refresh_completion,child_at}
use ingot::spacing::{Maps,PublishSpacing,place}

type Atlas=StorageBuffer<u32,RETAINED_CAPACITY>
struct Draw {}
struct Slot<const I:u32> {}
struct Event {changed:bool}
impl CompletionMessage for Event {fn completed()->Self {Self {changed:true}}}
actor TileWorker {
    fn generate(request:Request)->Response uses (Worker) {
        let k=request.key
        Response {lease:request.lease,tile:packed_triangle(k.a,k.b,k.c,42)}
    }
}
extern {const fn __f32_from_i32(_:i32)->f32}
fn number(_ n:u32)->f32 {__f32_from_i32(n.downcast_unchecked())}
type PatchRaster=RasterState<DepthTest<Depth24Plus,CompareLessEqual,DepthWrite,ClearThenLoadStore>,
    Samples4,CullNone,ColorTarget<OpaqueBlack<ClearThenLoadStore>,StraightAlpha,COLOR_WRITE_ALL>>
struct PublishAtlas {}
impl PublishAtlas {
    pub fn publication(_ state:State)->BufferPublication<Atlas> {
        let empty=BufferPublication {version:PublicationVersion {epoch:1,revision:0},
            source:BrowserBytes {ptr:0,len:0},target_byte_offset:0}
        if state.address==0 || state.required_words==0 || state.status!=0 {return empty}
        let pool:PoolHandle<CAPACITY> = PoolHandle::from_address(state.address)
        match pool.updates_since(RetainedCursor {epoch:0,words:0}) {
            RetainedUpdate::Ready(range)=>BufferPublication {
                // Background arrivals alone do not republish geometry. This
                // monotone prefix grows only for a compatible visible request.
                // Device recovery can replay it; suffix acknowledgments remain
                // a separate optimization of the shared publication provider.
                version:PublicationVersion {epoch:range.epoch,revision:state.required_words},
                source:BrowserBytes {ptr:range.words.ptr.address(),len:state.required_words*4},target_byte_offset:0},
            _=>empty,
        }
    }
}
fn point(_ atlas:Atlas,_ maps:Maps,_ scene:Scene,_ d:ChildDraw,_ index:u32)->Point {
    let indices=d.offset.wrapping_add(d.points)
    let id=if d.points<=65536 {
        (atlas.load(index:indices.wrapping_add(index/2))>>((index%2).wrapping_mul(16)))&65535
    } else {atlas.load(index:indices.wrapping_add(index))}
    let packed=atlas.load(index:d.offset.wrapping_add(id))
    let u=number(packed&65535)/16384.0
    let v=number(packed>>16)/16384.0
    let p=remap_barycentric(d.permutation,bary3f(1.0-u-v,u,v))
    place(maps,scene,d,p)
}
struct Projected {clip:ClipPosition,screen:Point,world:Vec3F,valid:bool}
fn projected(_ scene:Scene,_ c:Controls,_ p:Point)->Projected {
    if scene.surface.kind<0.5 {
        let scale=1.7*min(c.width,c.height)
        let x=(p.x-0.5)*scale/max(c.width,1.0)
        let y=(p.y-0.5)*scale/max(c.height,1.0)
        Projected {clip:ClipPosition {x:x,y:y,z:0.0,w:1.0},screen:Point {x:x,y:y},world:vec3f(p.x,p.y,0.0),valid:true}
    } else {
        let sample=ingot::surface::evaluate(scene.surface,p)
        let result=project(ingot::surface::camera(c),sample.point)
        let w=if abs(result.clip.w)>0.000001 {result.clip.w} else {0.000001}
        Projected {clip:result.clip,screen:Point {x:result.clip.x/w,y:result.clip.y/w},
            world:sample.point,valid:sample.valid}
    }
}
fn length(_ a:Point,_ b:Point,_ width:f32,_ height:f32)->f32 {
    let x=(a.x-b.x)*width*0.5
    let y=(a.y-b.y)*height*0.5
    sqrt(x*x+y*y)
}
struct Varying {a:f32,b:f32,c:f32,signed:f32,light:f32,quality:f32}
impl Copy for Varying {}
struct HandleVarying {kind:f32,selected:f32}
impl Copy for HandleVarying {}
actor CompositeAtlas uses (GpuProgram<WebGpuBackend>,SurfaceQuality<ResponsiveBacking>) {
    controls:Controls,scene:Scene,address:u32,completed:u32,status:u32,pending:u32,required_words:u32,
    atlas:Atlas,maps:Maps,draw:DrawIndirectBuffer<Draw>,
    const fn raster()->RasterPlan uses (RasterConfiguration) {raster_plan<PatchRaster>()}
    const fn view()->Surface<Params> {Surface {extent:Extent::square(1200),params:params()}}
    fn initial()->State uses (InitialState) {ingot::residency::initial()}
    fn receive(self,event:Event)->State uses (ResidentTransition) {
        refresh_completion(State {controls:self.controls,scene:self.scene,address:self.address,
            completed:self.completed,status:self.status,pending:self.pending,required_words:self.required_words})
    }
    fn control(self,event:own SurfaceEvent)->State uses (SurfaceTransition,SurfaceScheduling<LatestPerFrame>) {
        let changed=self.controls.apply_param_bindings(params(),event)
        refresh(State {controls:ingot::surface::transition(self.controls,changed,event),scene:self.scene,address:self.address,
            completed:self.completed,status:self.status,pending:self.pending,required_words:self.required_words})
    }
    fn supervision<const I:u32>()->u32 uses (ScopedTaskFamily<WORKERS>) {
        supervise(ActorInstance<TileWorker,Slot<I>> {})
    }
    fn work<const I:u32>(state:State)->u32 uses (ScopedTaskFamily<WORKERS>) {
        run<CAPACITY,ActorInstance<TileWorker,Slot<I>>,Event>(state.address,I)
    }
    fn prepare(self) uses (ComputeSurface<Workgroup<1,1,1>,FixedDispatch<1,1,1>>,PublishBuffer<PublishSpacing>) {
        self.draw.store(index:0,value:self.scene.vertices)
        self.draw.store(index:1,value:1)
        self.draw.store(index:2,value:0)
        self.draw.store(index:3,value:0)
    }
    fn background(self,px:i32,py:i32)->i32 uses (FragmentSurface) {
        if py<5 && px>=0 && __f32_from_i32(px)<self.controls.width*number(self.completed)/165.0 {
            return if self.status!=0 {-3394796} else if self.pending!=0 {-6529} else {-11365973}
        }
        (-15460836)
    }
    fn vertices(self,vertex_index:u32,instance_index:u32)->RasterVertex<Varying>
        uses (VertexStage<Varying,IndirectTriangleList<DrawIndirectBuffer<Draw>>>,PublishBuffer<PublishAtlas>) {
        let d=child_at(self.scene,vertex_index)
        let base=(vertex_index.wrapping_sub(d.begin)/3).wrapping_mul(3)
        let reversed=permutation_parity(d.permutation)<0.0
        let width=self.controls.width
        let height=self.controls.height
        let a=projected(self.scene,self.controls,point(self.atlas,self.maps,self.scene,d,base))
        let b=projected(self.scene,self.controls,point(self.atlas,self.maps,self.scene,d,base.wrapping_add(if reversed {2} else {1})))
        let c=projected(self.scene,self.controls,point(self.atlas,self.maps,self.scene,d,base.wrapping_add(if reversed {1} else {2})))
        let signed=(b.screen.x-a.screen.x)*(c.screen.y-a.screen.y)-(b.screen.y-a.screen.y)*(c.screen.x-a.screen.x)
        let area=abs(signed)*width*height*0.25
        let local=vertex_index%3
        let p=if local==0 {a.clip} else if local==1 {b.clip} else {c.clip}
        let normal=normalize3_or(cross3(sub3(b.world,a.world),sub3(c.world,a.world)),vec3f(0.0,0.0,1.0),0.000000000001)
        let light=if self.scene.surface.kind<0.5 {1.0} else {0.45+0.55*abs(dot3(normal,ingot::surface::camera(self.controls).forward))}
        // All three positions are already evaluated for the finite face normal.
        // Identical per-face values at all vertices keep the heatmap independent
        // of camera lighting and perspective interpolation.
        let quality=if self.controls.color_view>0.5 {
            let q=quilting_patch::triangle_quality::measure3(a.world,b.world,c.world)
            if q.defined {q.quality} else {-1.0}
        } else {1.0}
        RasterVertex {position:if a.valid && b.valid && c.valid {p} else {ClipPosition{x:2.0,y:2.0,z:0.0,w:1.0}},varying:Varying {
            a:if local==0 {area/max(length(b.screen,c.screen,width,height),0.00001)} else {0.0},
            b:if local==1 {area/max(length(c.screen,a.screen,width,height),0.00001)} else {0.0},
            c:if local==2 {area/max(length(a.screen,b.screen,width,height),0.00001)} else {0.0},signed:signed,light:light,quality:quality}}
    }
    fn shade(self,v:Varying)->i32 uses (FragmentStage<Varying>) {
        let fill=if self.controls.color_view>0.5 {ingot::diagnostics::shape_color(v.quality,self.controls.color_view>1.5)}
            else if v.signed<=0.0 && self.scene.surface.kind<0.5 {display_rgb(0.9,0.3,0.25)}
            else {display_rgb(0.65*v.light,0.77*v.light,0.78*v.light)}
        let coverage=if self.controls.wires>0.5 {0.4+0.6*smoothstep(0.10,0.65,min(v.a,min(v.b,v.c)))} else {1.0}
        pack_rgba8(mix_display_rgb(display_rgb(0.08,0.12,0.16),fill,coverage))
    }
    fn handles(self,index:u32)->RasterVertex<HandleVarying> uses (VertexStage<HandleVarying,TriangleList<30>>) {
        let c=self.controls
        let i=index/6
        let hidden=c.surface_kind<0.5 || (i==2 && ingot::model::is_triangle(c))
        let clip=project(ingot::surface::camera(c),ingot::surface::point(c,i)).clip
        let selected=c.selected==number(i)
        let radius=if selected {8.5} else {6.5}
        RasterVertex {position:quilting_demo_view::handles::square_glyph(clip,
            quilting_demo_view::ScreenExtent {width:c.width,height:c.height},index%6,radius,!hidden),
            varying:HandleVarying {kind:number(i),selected:if selected {1.0} else {0.0}}}
    }
    fn handle_color(self,v:HandleVarying)->i32 uses (FragmentStage<HandleVarying>) {
        let color=if v.kind>3.5 {display_rgb(0.95,0.65,0.48)} else {display_rgb(0.7,0.8,0.95)}
        pack_rgba8(mix_display_rgb(color,display_rgb(1.0,0.96,0.87),v.selected*0.3))
    }
}
