//! Runtime mixed-edge primaries and coherent child draw snapshots.
use core::{Worker, BrowserBytes}
use core::marker::Copy
use core::actor::{ActorInstance, InitialState, ResidentTransition, ScopedTaskFamily}
use fmath::{min,max,sqrt,abs,smoothstep}
use quilting_atlas_wasm::packed_triangle
use quilting_atlas::composition::{BoundaryUse,SquareBoundaryUse}
use quilting_atlas_wasm::pool::{PoolHandle,RetainedCursor,RetainedUpdate,RETAINED_CAPACITY}
use quilting_atlas_workers::{Request,Response,CompletionMessage,supervise,run}
use quilting_domain::bary3f
use quilting_qb::{remap_barycentric,permutation_parity}
use quilting_oklch::{display_rgb,mix_display_rgb,pack_rgba8}
use std::web::view::{Surface,Extent,SurfaceEvent,ApplyParamBindings}
use std::webgpu::{GpuProgram,WebGpuBackend,StorageBuffer,DrawIndirectBuffer,
    ClipPosition,RasterVertex,VertexStage,FragmentStage,FragmentSurface,
    IndirectTriangleList,ComputeSurface,Workgroup,FixedDispatch,
    BufferPublication,PublicationVersion,PublishBuffer,
    SurfaceTransition,SurfaceScheduling,LatestPerFrame,SurfaceQuality,ResponsiveBacking}
use ingot::model::{Controls,Params,Point,params,corner}
use ingot::residency::{State,Scene,ChildDraw,WORKERS,CAPACITY,refresh,child_at}
use ingot::spacing::{Maps,PublishSpacing,canonical_parameter,interior}

type Atlas=StorageBuffer<u32,RETAINED_CAPACITY>
struct Draw {}
struct Slot<const I:u32> {}
struct Event {changed:bool}
impl CompletionMessage for Event {fn completed()->Self {Self {changed:true}}}
actor TileWorker {
    fn generate(request:Request)->Response uses (Worker) {
        let k=request.key
        Response {lease:request.lease,tile:packed_triangle(k.a,k.b,k.c,42)}
    }
}
extern {const fn __f32_from_i32(_:i32)->f32}
fn number(_ n:u32)->f32 {__f32_from_i32(n.downcast_unchecked())}
struct PublishAtlas {}
impl PublishAtlas {
    pub fn publication(_ state:State)->BufferPublication<Atlas> {
        let empty=BufferPublication {version:PublicationVersion {epoch:1,revision:0},
            source:BrowserBytes {ptr:0,len:0},target_byte_offset:0}
        if state.address==0 || state.required_words==0 || state.status!=0 {return empty}
        let pool:PoolHandle<CAPACITY> = PoolHandle::from_address(state.address)
        match pool.updates_since(RetainedCursor {epoch:0,words:0}) {
            RetainedUpdate::Ready(range)=>BufferPublication {
                // Background arrivals alone do not republish geometry. This
                // monotone prefix grows only for a compatible visible request.
                // Device recovery can replay it; suffix acknowledgments remain
                // a separate optimization of the shared publication provider.
                version:PublicationVersion {epoch:range.epoch,revision:state.required_words},
                source:BrowserBytes {ptr:range.words.ptr.address(),len:state.required_words*4},target_byte_offset:0},
            _=>empty,
        }
    }
}
fn shared_edge(_ maps:Maps,_ admitted:SquareBoundaryUse,_ from:u32,_ to:u32,_ parameter:f32,_ scene:Scene)->Point {
    let edge=BoundaryUse::between(from,to)
    let t=canonical_parameter(maps,admitted,parameter,scene.active_compensation>0.5)
    let a=corner(edge.low,scene.active_center_x,scene.active_center_y)
    let b=corner(edge.high,scene.active_center_x,scene.active_center_y)
    Point {x:a.x*(1.0-t)+b.x*t,y:a.y*(1.0-t)+b.y*t}
}
fn point(_ atlas:Atlas,_ maps:Maps,_ scene:Scene,_ d:ChildDraw,_ index:u32,_ width:f32,_ height:f32)->Point {
    let indices=d.offset.wrapping_add(d.points)
    let id=if d.points<=65536 {
        (atlas.load(index:indices.wrapping_add(index/2))>>((index%2).wrapping_mul(16)))&65535
    } else {atlas.load(index:indices.wrapping_add(index))}
    let packed=atlas.load(index:d.offset.wrapping_add(id))
    let u=number(packed&65535)/16384.0
    let v=number(packed>>16)/16384.0
    let p=remap_barycentric(d.permutation,bary3f(1.0-u-v,u,v))
    let placed=if p.b==0.0 {shared_edge(maps,d.boundaries.ca,d.corner_c,d.corner_a,p.a,scene)}
        else if p.c==0.0 {shared_edge(maps,d.boundaries.ab,d.corner_a,d.corner_b,p.b,scene)}
        else if p.a==0.0 {shared_edge(maps,d.boundaries.bc,d.corner_b,d.corner_c,p.c,scene)}
        else {
            let warped=if scene.active_compensation>0.5 {interior(maps,d,p)} else {p}
            let a=corner(d.corner_a,scene.active_center_x,scene.active_center_y)
            let b=corner(d.corner_b,scene.active_center_x,scene.active_center_y)
            let c=corner(d.corner_c,scene.active_center_x,scene.active_center_y)
            Point {x:a.x*warped.a+b.x*warped.b+c.x*warped.c,y:a.y*warped.a+b.y*warped.b+c.y*warped.c}
        }
    let scale=1.7*min(width,height)
    Point {x:(placed.x-0.5)*scale/max(width,1.0),y:(placed.y-0.5)*scale/max(height,1.0)}
}
fn length(_ a:Point,_ b:Point,_ width:f32,_ height:f32)->f32 {
    let x=(a.x-b.x)*width*0.5
    let y=(a.y-b.y)*height*0.5
    sqrt(x*x+y*y)
}
struct Varying {a:f32,b:f32,c:f32,signed:f32}
impl Copy for Varying {}
actor CompositeAtlas uses (GpuProgram<WebGpuBackend>,SurfaceQuality<ResponsiveBacking>) {
    controls:Controls,scene:Scene,address:u32,completed:u32,status:u32,pending:u32,required_words:u32,
    atlas:Atlas,maps:Maps,draw:DrawIndirectBuffer<Draw>,
    const fn view()->Surface<Params> {Surface {extent:Extent::square(1200),params:params()}}
    fn initial()->State uses (InitialState) {ingot::residency::initial()}
    fn receive(self,event:Event)->State uses (ResidentTransition) {
        refresh(State {controls:self.controls,scene:self.scene,address:self.address,
            completed:self.completed,status:self.status,pending:self.pending,required_words:self.required_words})
    }
    fn control(self,event:own SurfaceEvent)->State uses (SurfaceTransition,SurfaceScheduling<LatestPerFrame>) {
        refresh(State {controls:self.controls.apply_param_bindings(params(),event),scene:self.scene,address:self.address,
            completed:self.completed,status:self.status,pending:self.pending,required_words:self.required_words})
    }
    fn supervision<const I:u32>()->u32 uses (ScopedTaskFamily<WORKERS>) {
        supervise(ActorInstance<TileWorker,Slot<I>> {})
    }
    fn work<const I:u32>(state:State)->u32 uses (ScopedTaskFamily<WORKERS>) {
        run<CAPACITY,ActorInstance<TileWorker,Slot<I>>,Event>(state.address,I)
    }
    fn prepare(self) uses (ComputeSurface<Workgroup<1,1,1>,FixedDispatch<1,1,1>>,PublishBuffer<PublishSpacing>) {
        self.draw.store(index:0,value:self.scene.vertices)
        self.draw.store(index:1,value:1)
        self.draw.store(index:2,value:0)
        self.draw.store(index:3,value:0)
    }
    fn background(self,px:i32,py:i32)->i32 uses (FragmentSurface) {
        if py<5 && px>=0 && __f32_from_i32(px)<self.controls.width*number(self.completed)/165.0 {
            return if self.status!=0 {-3394796} else if self.pending!=0 {-6529} else {-11365973}
        }
        (-15460836)
    }
    fn vertices(self,vertex_index:u32,instance_index:u32)->RasterVertex<Varying>
        uses (VertexStage<Varying,IndirectTriangleList<DrawIndirectBuffer<Draw>>>,PublishBuffer<PublishAtlas>) {
        let d=child_at(self.scene,vertex_index)
        let base=(vertex_index.wrapping_sub(d.begin)/3).wrapping_mul(3)
        let reversed=permutation_parity(d.permutation)<0.0
        let width=self.controls.width
        let height=self.controls.height
        let a=point(self.atlas,self.maps,self.scene,d,base,width,height)
        let b=point(self.atlas,self.maps,self.scene,d,base.wrapping_add(if reversed {2} else {1}),width,height)
        let c=point(self.atlas,self.maps,self.scene,d,base.wrapping_add(if reversed {1} else {2}),width,height)
        let signed=(b.x-a.x)*(c.y-a.y)-(b.y-a.y)*(c.x-a.x)
        let area=abs(signed)*width*height*0.25
        let local=vertex_index%3
        let p=if local==0 {a} else if local==1 {b} else {c}
        RasterVertex {position:ClipPosition{x:p.x,y:p.y,z:0.0,w:1.0},varying:Varying {
            a:if local==0 {area/max(length(b,c,width,height),0.00001)} else {0.0},
            b:if local==1 {area/max(length(c,a,width,height),0.00001)} else {0.0},
            c:if local==2 {area/max(length(a,b,width,height),0.00001)} else {0.0},signed:signed}}
    }
    fn shade(self,v:Varying)->i32 uses (FragmentStage<Varying>) {
        let fill=if v.signed<=0.0 {display_rgb(0.9,0.3,0.25)} else {display_rgb(0.65,0.77,0.78)}
        pack_rgba8(mix_display_rgb(display_rgb(0.08,0.12,0.16),fill,smoothstep(0.15,0.85,min(v.a,min(v.b,v.c)))))
    }
}
