//! One direct blue-noise patch generated, triangulated, and rendered without
//! leaving WebGPU storage.
//!
//! Sampling and topology construction are separate immutable-generation actor
//! cycles. Their only handoff is the checked resident point buffer and receipt;
//! no GPU-to-CPU-to-GPU trip or host-side topology authority exists.

use core::marker::Copy
use quilting_atlas::{AtlasKey, canonical_key_ordinal}
use quilting_atlas::scan::balanced_block_size
use quilting_atlas_webgpu::compaction::{rank_candidate_block, prefix_candidate_blocks, scatter_candidate_lane}
use quilting_atlas_webgpu::topology_scan::{rank_topology_block, prefix_topology_blocks, relocate_topology_offset, SUMMARY_WORDS}
use quilting_atlas_webgpu::repair
use quilting_atlas_webgpu::incidence
use quilting_atlas_webgpu::candidate_index::{self,IndexedConflict}
use quilting_atlas_webgpu::{
    advance_candidate_generation,
    advance_parallel_topology_generation,
    arbitrate_parallel_topology_point_lane,
    initialize_parallel_topology_claim_lane,
    claim_parallel_topology_point_lane,
    AtlasBoundaryPoints,
    AtlasInteriorEdgeFlip,
    DelaunayRestoration,
    initialize_candidate_lane,
    initialize_parallel_topology_lane,
    locate_parallel_topology_point_lane,
    parallel_topology_progress,
    plan_parallel_topology_face_lane,
    propose_candidate_lane_with_policy,
    AtlasCandidateConflict,
    publish_parallel_topology_triangle_lane,
    rebuild_parallel_topology_face_lane,
    resident_point,
    resident_triangle,
    retire_candidate_lane_with_policy,
    retire_parallel_topology_point_lane,
}
use quilting_domain::{Bary3F, Vec3F, bary3f, vec3f}
use quilting_quaternion::quatf
use quilting_qb::{QbTriPatch, control, evaluate_differential, patch}
use std::web::view::{Extent, Surface, Param}
use std::webgpu::{
    ClipPosition,
    ComputeInvocation,
    ComputeSurface as Kernel,
    CycledDispatch as Cycle,
    FixedDispatch as Once,
    FragmentStage,
    FragmentSurface,
    GpuProgram as Program,
    RasterVertex,
    StorageBuffer as Shared,
    AtomicStorageBuffer,
    IndirectTriangleList,
    DrawIndirectBuffer,
    VertexStage,
    WebGpuBackend,
    Workgroup as Threads,
}

extern {
    const fn __f32_from_i32(_: i32) -> f32
}

const CANDIDATE_COUNT: u32 = quilting_atlas::sampling::candidate_slot_count(maximum_key())
const CANDIDATES: usize = CANDIDATE_COUNT as usize
const SEARCH_LEAVES: usize = quilting_atlas::candidate_index::leaf_count(CANDIDATE_COUNT) as usize
const SEARCH_LEVELS: usize = quilting_atlas::candidate_index::level_count(quilting_atlas::candidate_index::leaf_count(CANDIDATE_COUNT)) as usize
const SEARCH_WORDS: usize = quilting_atlas::candidate_index::storage_words(CANDIDATE_COUNT) as usize
const SEARCH_GROUPS: usize = (SEARCH_LEAVES+127)/128
const BOUNDARY: usize = quilting_atlas::boundary_vertices(maximum_key()) as usize
const SAMPLING_WORKSPACE_WORDS: usize = CANDIDATES * 8 + 1
const POINTS: usize = CANDIDATES + BOUNDARY
const POINT_WORDS: usize = POINTS * 3
const TRIANGLES: usize = POINTS * 2 - BOUNDARY - 2
const TRIANGLE_WORDS: usize = TRIANGLES * 4
const TOPOLOGY_WORKSPACE_WORDS: usize = POINTS * 7 + TRIANGLES * 3 + 8
const THREADS: usize = 128
const WORKGROUPS: usize = (TRIANGLES + THREADS - 1) / THREADS
const COMPACT_TILE: usize = balanced_block_size(CANDIDATE_COUNT) as usize
const COMPACT_BLOCKS: usize = (CANDIDATES + COMPACT_TILE - 1) / COMPACT_TILE
const COMPACT_WORDS: usize = COMPACT_BLOCKS * 3
const COMPACT_GROUPS: usize = (COMPACT_BLOCKS + THREADS - 1) / THREADS
const SCAN_TILE: usize = balanced_block_size(CANDIDATE_COUNT*2+quilting_atlas::boundary_vertices(maximum_key())-2) as usize
const SCAN_BLOCKS: usize = (TRIANGLES+SCAN_TILE-1)/SCAN_TILE
const SCAN_WORDS: usize = SCAN_BLOCKS*SUMMARY_WORDS
const SCAN_GROUPS: usize = (SCAN_BLOCKS+THREADS-1)/THREADS
const SAMPLING_ROUNDS: usize = 64
const INSERTION_ROUNDS: usize = 64
const TWINS: usize = TRIANGLES*3
const EDGE_INDEX: usize = POINTS+1+TWINS
const REPAIR_TILE: usize = balanced_block_size((CANDIDATE_COUNT*2+quilting_atlas::boundary_vertices(maximum_key())-2)*3) as usize
const REPAIR_WORDS: usize = ((TWINS+REPAIR_TILE-1)/REPAIR_TILE)*repair::SUMMARY_WORDS
const REPAIR_GROUPS: usize = (TWINS+THREADS-1)/THREADS
const REPAIR_BLOCK_GROUPS: usize = (((TWINS+REPAIR_TILE-1)/REPAIR_TILE)+THREADS-1)/THREADS
const SEED: u32 = 0x51c32a97

pub struct SamplingRound {}
pub struct CandidateIndexLevel {}
pub struct InsertionRound {}
pub struct RepairRound {}
pub struct Draw {}

pub struct MeshVarying { pub edge: Bary3F, pub normal: Vec3F }
impl Copy for MeshVarying {}

struct GeneratedParams { a: Param, b: Param, c: Param }

fn flag(_ value: bool) -> u32 {
    if value { 1 } else { 0 }
}

fn store_delaunay_receipt(
    _ receipt: Shared<u32, 23>,
    _ restored: DelaunayRestoration,
) {
    receipt.store(index: 16, value: flag(restored.valid))
    receipt.store(index: 17, value: flag(restored.converged))
    receipt.store(index: 18, value: restored.resident_points)
    receipt.store(index: 19, value: restored.resident_triangles)
    receipt.store(index: 20, value: restored.flips)
    receipt.store(index: 21, value: restored.remaining_violations)
    receipt.store(index: 22, value: restored.invariant_failures)
}

const fn maximum_key() -> AtlasKey {
    AtlasKey { a: quilting_atlas::MAX_LOD, b: quilting_atlas::MAX_LOD, c: quilting_atlas::MAX_LOD }
}

fn level(_ x: f32) -> u32 {
    let mut n: u32 = 0
    while n < quilting_atlas::MAX_LOD && x >= __f32_from_i32(n.downcast_unchecked()) + 0.5 {
        n = n + 1
    }
    n
}

fn request(_ a: f32, _ b: f32, _ c: f32) -> AtlasKey {
    quilting_atlas::canonicalize(AtlasKey {a:level(a),b:level(b),c:level(c)}).key
}

fn local_corner(_ corner: u32) -> Bary3F {
    if corner == 0 {
        bary3f(1.0, 0.0, 0.0)
    } else if corner == 1 {
        bary3f(0.0, 1.0, 0.0)
    } else {
        bary3f(0.0, 0.0, 1.0)
    }
}

fn minimum3(_ value: Bary3F) -> f32 {
    let mut result = value.a
    if value.b < result {
        result = value.b
    }
    if value.c < result {
        result = value.c
    }
    result
}

fn fixed_lane(_ value: u32) -> f32 {
    __f32_from_i32(value.downcast_unchecked()) / 16384.0
}

fn curved_patch() -> QbTriPatch {
    patch(
        control(vec3f(-0.75, -0.25, 0.1), quatf(1.0, 0.2, -0.1, 0.05)),
        control(vec3f(0.8, -0.15, -0.2), quatf(0.9, -0.15, 0.25, 0.1)),
        control(vec3f(0.05, 0.9, 0.35), quatf(1.1, 0.1, 0.05, -0.2)),
    )
}

fn invalid_vertex() -> RasterVertex<MeshVarying> {
    RasterVertex {
        position: ClipPosition { x: 2.0, y: 2.0, z: 0.0, w: 1.0 },
        varying: MeshVarying { edge: bary3f(0.0, 0.0, 0.0), normal: vec3f(0.0, 0.0, 1.0) },
    }
}

actor ClassicQuiltingGenerated uses (Program<WebGpuBackend>) {
    a:f32,b:f32,c:f32,
    draw: DrawIndirectBuffer<Draw>,
    sampling_workspace: Shared<u32, SAMPLING_WORKSPACE_WORDS>,
    candidate_bounds: Shared<u32, SEARCH_WORDS>,
    compaction: Shared<u32, COMPACT_WORDS>,
    points: Shared<u32, POINT_WORDS>,
    triangles_a: Shared<u32, TRIANGLE_WORDS>,
    triangles_b: Shared<u32, TRIANGLE_WORDS>,
    triangles: Shared<u32, TRIANGLE_WORDS>,
    topology_workspace: Shared<u32, TOPOLOGY_WORKSPACE_WORDS>,
    topology_blocks: Shared<u32, SCAN_WORDS>,
    face_claims: AtomicStorageBuffer<TRIANGLES>,
    twins: Shared<u32,TWINS>, edge_index: Shared<u32,EDGE_INDEX>,
    repair_flags: Shared<u32,TWINS>, repair_results: Shared<u32,TWINS>,
    repair_blocks: Shared<u32,REPAIR_WORDS>, repair_state: Shared<u32,8>,
    receipt: Shared<u32, 23>,

    const fn view() -> Surface<GeneratedParams> {
        Surface { extent: Extent::square(768), params: GeneratedParams {
            a: Param::int(min:0.0,max:8.0,init:1.0),
            b: Param::int(min:0.0,max:8.0,init:2.0),
            c: Param::int(min:0.0,max:8.0,init:3.0),
        } }
    }

    fn sample_initialize(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        let atlas_key = request(self.a,self.b,self.c)
        initialize_candidate_lane<CANDIDATES, SAMPLING_WORKSPACE_WORDS>(
            atlas_key,
            canonical_key_ordinal(atlas_key),
            SEED,
            self.sampling_workspace,
            invocation,
        )
    }

    fn candidate_index_leaves(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<SEARCH_GROUPS,1,1>>) {
        candidate_index::initialize<AtlasKey,CANDIDATES,SAMPLING_WORKSPACE_WORDS,SEARCH_LEAVES,SEARCH_WORDS>(
            request(self.a,self.b,self.c),self.sampling_workspace,self.candidate_bounds,i)
    }
    fn candidate_index_reduce(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Cycle<CandidateIndexLevel,Once<SEARCH_GROUPS,1,1>,SEARCH_LEVELS>>) {
        candidate_index::reduce_level<SEARCH_LEAVES,SEARCH_WORDS>(self.candidate_bounds,i)
    }
    fn candidate_index_advance(self) uses (Kernel<Threads<1,1,1>,Cycle<CandidateIndexLevel,Once<1,1,1>,SEARCH_LEVELS>>) {
        candidate_index::advance_level<SEARCH_WORDS>(self.candidate_bounds)
    }
    fn sample_propose(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<SamplingRound, Once<WORKGROUPS, 1, 1>, SAMPLING_ROUNDS>,
            >
        )
    {
        propose_candidate_lane_with_policy<IndexedConflict<AtlasCandidateConflict,SEARCH_LEAVES,SEARCH_WORDS>,CANDIDATES,SAMPLING_WORKSPACE_WORDS>(
            request(self.a,self.b,self.c),
            IndexedConflict {policy:AtlasCandidateConflict {},tree:self.candidate_bounds},
            self.sampling_workspace,
            invocation,
        )
    }

    fn sample_retire(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<SamplingRound, Once<WORKGROUPS, 1, 1>, SAMPLING_ROUNDS>,
            >
        )
    {
        retire_candidate_lane_with_policy<IndexedConflict<AtlasCandidateConflict,SEARCH_LEAVES,SEARCH_WORDS>,CANDIDATES,SAMPLING_WORKSPACE_WORDS>(
            request(self.a,self.b,self.c),
            IndexedConflict {policy:AtlasCandidateConflict {},tree:self.candidate_bounds},
            self.sampling_workspace,
            invocation,
        )
    }

    fn sample_advance(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<SamplingRound, Once<WORKGROUPS, 1, 1>, SAMPLING_ROUNDS>,
            >
        )
    {
        advance_candidate_generation<CANDIDATES, SAMPLING_WORKSPACE_WORDS>(
            self.sampling_workspace,
            invocation,
        )
    }

    fn sample_compact_rank(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<COMPACT_GROUPS, 1, 1>>)
    {
        rank_candidate_block<AtlasKey,CANDIDATES,COMPACT_TILE,SAMPLING_WORKSPACE_WORDS,COMPACT_WORDS>(
            request(self.a,self.b,self.c),self.sampling_workspace,self.compaction,invocation,
        )
    }

    fn sample_compact(self) uses (Kernel<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let compacted = prefix_candidate_blocks<AtlasKey,CANDIDATES,COMPACT_TILE,POINT_WORDS,COMPACT_WORDS>(
            request(self.a,self.b,self.c),self.compaction,
        )
        self.receipt.store(index: 0, value: if compacted.valid { 1 } else { 0 })
        self.receipt.store(index: 1, value: if compacted.converged { 1 } else { 0 })
        self.receipt.store(index: 2, value: if compacted.overflowed { 1 } else { 0 })
        self.receipt.store(index: 3, value: compacted.candidate_slots)
        self.receipt.store(index: 4, value: compacted.accepted_candidates)
        self.receipt.store(index: 5, value: compacted.boundary_points)
        self.receipt.store(index: 6, value: compacted.resident_points)
    }

    fn sample_compact_scatter(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        scatter_candidate_lane<AtlasBoundaryPoints,CANDIDATES,COMPACT_TILE,SAMPLING_WORKSPACE_WORDS,POINT_WORDS,COMPACT_WORDS>(
            request(self.a,self.b,self.c),AtlasBoundaryPoints {},self.sampling_workspace,self.compaction,self.points,invocation,
        )
    }

    fn topology_initialize(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        initialize_parallel_topology_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            request(self.a,self.b,self.c),
            self.receipt.load(index: 0) != 0,
            self.receipt.load(index: 6),
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_locate(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        locate_parallel_topology_point_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_reset_claims(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>>)
    {
        initialize_parallel_topology_claim_lane<TRIANGLES>(self.face_claims, invocation)
    }

    fn topology_claim(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>>)
    {
        claim_parallel_topology_point_lane<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace, self.face_claims, invocation,
        )
    }

    fn topology_arbitrate(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        arbitrate_parallel_topology_point_lane<
            POINTS,
            TRIANGLES,
            TOPOLOGY_WORKSPACE_WORDS,
        >(self.topology_workspace, self.face_claims, invocation)
    }

    fn topology_plan(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        plan_parallel_topology_face_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            self.face_claims,
            invocation,
        )
    }

    fn topology_rank(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS,1,1>,Cycle<InsertionRound,Once<SCAN_GROUPS,1,1>,INSERTION_ROUNDS>>)
    {
        rank_topology_block<POINTS,TRIANGLES,TOPOLOGY_WORKSPACE_WORDS,SCAN_TILE,SCAN_WORDS>(
            self.topology_workspace,self.topology_blocks,invocation)
    }
    fn topology_scan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1,1,1>,Cycle<InsertionRound,Once<1,1,1>,INSERTION_ROUNDS>>)
    {
        prefix_topology_blocks<POINTS,TRIANGLES,TOPOLOGY_WORKSPACE_WORDS,SCAN_TILE,SCAN_WORDS>(
            self.topology_workspace,self.topology_blocks,invocation)
    }
    fn topology_offsets(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS,1,1>,Cycle<InsertionRound,Once<WORKGROUPS,1,1>,INSERTION_ROUNDS>>)
    {
        relocate_topology_offset<POINTS,TRIANGLES,TOPOLOGY_WORKSPACE_WORDS,SCAN_TILE,SCAN_WORDS>(
            self.topology_workspace,self.topology_blocks,invocation)
    }

    fn topology_rebuild(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        rebuild_parallel_topology_face_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_retire(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        retire_parallel_topology_point_lane<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_advance(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        advance_parallel_topology_generation<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_publish(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        publish_parallel_topology_triangle_lane<
            POINTS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            self.triangles,
            invocation,
        )
    }

    fn topology_restore(self) uses (Kernel<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let resident_points = self.receipt.load(index: 6)
        let boundary = self.receipt.load(index: 5)
        let resident_triangles = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            2,
        )
        let pending = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            3,
        )
        let locations = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            6,
        )
        let invariants = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            7,
        )
        let expected = if resident_points + resident_points > boundary + 2 {
            resident_points + resident_points - boundary - 2
        } else {
            0
        }
        let source_valid = self.receipt.load(index: 0) != 0
            && resident_triangles == expected
            && pending == 0
            && locations == 0
            && invariants == 0
        incidence::begin<POINTS,TRIANGLES>(source_valid,resident_points,resident_triangles,self.repair_state)
    }
    fn index_reset(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<WORKGROUPS,1,1>>) {
        incidence::reset<POINTS,TRIANGLES>(self.face_claims,i)
    }
    fn index_count(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<WORKGROUPS,1,1>>) {
        incidence::count<AtlasInteriorEdgeFlip,POINTS,TRIANGLES,POINT_WORDS,TRIANGLE_WORDS,TWINS>(
            self.points,self.triangles,self.face_claims,self.repair_flags,self.repair_state,i)
    }
    fn index_rank(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<SCAN_GROUPS,1,1>>) {
        incidence::rank<POINTS,TRIANGLES,TWINS,EDGE_INDEX,SCAN_TILE,SCAN_WORDS>(
            self.face_claims,self.repair_flags,self.edge_index,self.topology_blocks,self.repair_state,i)
    }
    fn index_prefix(self) uses (Kernel<Threads<1,1,1>,Once<1,1,1>>) {
        incidence::prefix<POINTS,TRIANGLES,TWINS,EDGE_INDEX,SCAN_TILE,SCAN_WORDS>(self.edge_index,self.topology_blocks,self.repair_state)
    }
    fn index_offsets(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<WORKGROUPS,1,1>>) {
        incidence::offsets<POINTS,TRIANGLES,TWINS,EDGE_INDEX,SCAN_TILE,SCAN_WORDS>(
            self.face_claims,self.edge_index,self.topology_blocks,self.repair_state,i)
    }
    fn index_scatter(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<REPAIR_GROUPS,1,1>>) {
        incidence::scatter<POINTS,TRIANGLES,TRIANGLE_WORDS,TWINS,EDGE_INDEX>(
            self.triangles,self.face_claims,self.edge_index,self.repair_results,self.repair_state,i)
    }
    fn index_lookup(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<REPAIR_GROUPS,1,1>>) {
        incidence::lookup<AtlasInteriorEdgeFlip,POINTS,TRIANGLES,TRIANGLE_WORDS,TWINS,EDGE_INDEX>(request(self.a,self.b,self.c),
            self.triangles,self.edge_index,self.twins,self.repair_flags,self.repair_state,i)
    }
    fn index_check(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<REPAIR_GROUPS,1,1>>) {
        incidence::check<POINTS,TRIANGLES,TWINS,EDGE_INDEX>(
            self.face_claims,self.edge_index,self.twins,self.repair_flags,self.repair_results,self.repair_state,i)
    }
    fn index_summarize(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<REPAIR_BLOCK_GROUPS,1,1>>) {
        repair::summarize<TWINS,REPAIR_TILE,REPAIR_WORDS>(self.repair_flags,self.repair_results,self.repair_state,self.repair_blocks,i)
    }
    fn index_seal(self) uses (Kernel<Threads<1,1,1>,Once<1,1,1>>) {
        incidence::seal<TWINS,REPAIR_TILE,REPAIR_WORDS>(self.repair_blocks,self.repair_state)
    }
    fn repair_reset(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Cycle<RepairRound,Once<WORKGROUPS,1,1>,64>>) {
        repair::reset_claims<TRIANGLES>(self.repair_state,self.face_claims,i)
    }
    fn repair_propose(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Cycle<RepairRound,Once<REPAIR_GROUPS,1,1>,64>>) {
        repair::propose<AtlasInteriorEdgeFlip,POINT_WORDS,TRIANGLE_WORDS,TWINS>(
            request(self.a,self.b,self.c),AtlasInteriorEdgeFlip {},self.points,self.triangles,self.twins,
            self.repair_flags,self.repair_results,self.repair_state,i)
    }
    fn repair_claim(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Cycle<RepairRound,Once<REPAIR_GROUPS,1,1>,64>>) {
        repair::claim<TRIANGLES,TWINS>(self.twins,self.repair_flags,self.repair_state,self.face_claims,i)
    }
    fn repair_select(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Cycle<RepairRound,Once<REPAIR_GROUPS,1,1>,64>>) {
        repair::select<TRIANGLES,TWINS>(self.twins,self.repair_flags,self.repair_results,self.repair_state,self.face_claims,i)
    }
    fn repair_apply(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Cycle<RepairRound,Once<REPAIR_GROUPS,1,1>,64>>) {
        repair::apply<AtlasInteriorEdgeFlip,POINT_WORDS,TRIANGLE_WORDS,TWINS>(
            request(self.a,self.b,self.c),AtlasInteriorEdgeFlip {},self.points,self.triangles,self.twins,
            self.repair_results,self.repair_state,i)
    }
    fn repair_summarize(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Cycle<RepairRound,Once<REPAIR_BLOCK_GROUPS,1,1>,64>>) {
        repair::summarize<TWINS,REPAIR_TILE,REPAIR_WORDS>(self.repair_flags,self.repair_results,self.repair_state,self.repair_blocks,i)
    }
    fn repair_advance(self) uses (Kernel<Threads<1,1,1>,Cycle<RepairRound,Once<1,1,1>,64>>) {
        repair::advance<TWINS,REPAIR_TILE,REPAIR_WORDS>(self.repair_state,self.repair_blocks,false)
    }
    fn repair_certify(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<REPAIR_GROUPS,1,1>>) {
        repair::propose<AtlasInteriorEdgeFlip,POINT_WORDS,TRIANGLE_WORDS,TWINS>(
            request(self.a,self.b,self.c),AtlasInteriorEdgeFlip {},self.points,self.triangles,self.twins,
            self.repair_flags,self.repair_results,self.repair_state,i)
    }
    fn repair_certificate_blocks(self,i:ComputeInvocation) uses (Kernel<Threads<THREADS,1,1>,Once<REPAIR_BLOCK_GROUPS,1,1>>) {
        repair::summarize<TWINS,REPAIR_TILE,REPAIR_WORDS>(self.repair_flags,self.repair_results,self.repair_state,self.repair_blocks,i)
    }
    fn repair_finish(self) uses (Kernel<Threads<1,1,1>,Once<1,1,1>>) {
        repair::advance<TWINS,REPAIR_TILE,REPAIR_WORDS>(self.repair_state,self.repair_blocks,true)
        store_delaunay_receipt(self.receipt,repair::receipt(self.repair_state))
    }

    fn topology_seal(self) uses (Kernel<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let points = self.receipt.load(index: 6)
        let boundary = self.receipt.load(index: 5)
        let triangles = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            2,
        )
        let pending = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            3,
        )
        let locations = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            6,
        )
        let invariants = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            7,
        )
        let expected = if points + points > boundary + 2 {
            points + points - boundary - 2
        } else {
            0
        }
        let valid = self.receipt.load(index: 0) != 0
            && self.receipt.load(index: 16) != 0
            && triangles == expected
            && pending == 0
            && locations == 0
            && invariants == 0
        self.receipt.store(index: 7, value: if valid { 1 } else { 0 })
        self.receipt.store(index: 8, value: points)
        self.receipt.store(index: 9, value: boundary)
        self.receipt.store(index: 10, value: triangles)
        self.receipt.store(index: 11, value: pending)
        self.receipt.store(index: 12, value: locations)
        self.receipt.store(index: 13, value: invariants)
        self.receipt.store(
            index: 14,
            value: parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
                self.topology_workspace,
                0,
            ),
        )
        self.receipt.store(index: 15, value: 1)
        self.draw.store(index:0,value:if valid {triangles*3} else {0})
        self.draw.store(index:1,value:1)
        self.draw.store(index:2,value:0)
        self.draw.store(index:3,value:0)
    }

    fn background(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        -15396337
    }

    fn mesh_vertices(self, vertex_index: u32) -> RasterVertex<MeshVarying>
        uses (VertexStage<MeshVarying, IndirectTriangleList<DrawIndirectBuffer<Draw>>>)
    {
        let mut result = invalid_vertex()
        if self.receipt.load(index: 7) != 0 {
            let face = vertex_index / 3
            let corner = vertex_index % 3
                let triangle = resident_triangle<TRIANGLE_WORDS>(self.triangles, face)
            if triangle.valid {
                let point_id = if corner == 0 {
                    triangle.first
                } else if corner == 1 {
                    triangle.second
                } else {
                    triangle.third
                }
                let fixed = resident_point<POINT_WORDS>(self.points, point_id)
                let bary = bary3f(fixed_lane(fixed.a), fixed_lane(fixed.b), fixed_lane(fixed.c))
                let differential = evaluate_differential(
                    curved_patch(),
                    bary,
                    0.00000000000000000001,
                    0.000000000001,
                )
                result = RasterVertex {
                    position: ClipPosition {
                        x: differential.sample.position.x * 0.75,
                        y: differential.sample.position.y * 0.75,
                        z: 0.5 + differential.sample.position.z * 0.05,
                        w: 1.0,
                    },
                    varying: MeshVarying {
                        edge: local_corner(corner),
                        normal: differential.normal,
                    },
                }
            }
        }
        result
    }

    fn mesh_fragment(self, varying: MeshVarying) -> u32
        uses (FragmentStage<MeshVarying>)
    {
        if minimum3(varying.edge) < 0.035 {
            4281543976
        } else if varying.normal.z > 0.0 {
            4292985706
        } else {
            4286476244
        }
    }
}
