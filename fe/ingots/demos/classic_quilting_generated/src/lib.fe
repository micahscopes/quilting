//! One direct blue-noise patch generated, triangulated, and rendered without
//! leaving WebGPU storage.
//!
//! Sampling and topology construction are separate immutable-generation actor
//! cycles. Their only handoff is the checked resident point buffer and receipt;
//! no GPU-to-CPU-to-GPU trip or host-side topology authority exists.

use core::marker::Copy
use quilting_atlas::{AtlasKey, canonical_key_ordinal}
use quilting_atlas::scan::balanced_block_size
use quilting_atlas_webgpu::compaction::{rank_candidate_block, prefix_candidate_blocks, scatter_candidate_lane}
use quilting_atlas_webgpu::topology_scan::{rank_topology_block, prefix_topology_blocks, relocate_topology_offset, SUMMARY_WORDS}
use quilting_atlas_webgpu::{
    advance_candidate_generation,
    advance_parallel_topology_generation,
    arbitrate_parallel_topology_point_lane,
    initialize_parallel_topology_claim_lane,
    claim_parallel_topology_point_lane,
    AtlasBoundaryPoints,
    DelaunayRestoration,
    initialize_candidate_lane,
    initialize_parallel_topology_lane,
    locate_parallel_topology_point_lane,
    parallel_topology_progress,
    plan_parallel_topology_face_lane,
    propose_candidate_lane,
    publish_parallel_topology_triangle_lane,
    rebuild_parallel_topology_face_lane,
    resident_point,
    resident_triangle,
    restore_constrained_delaunay,
    retire_candidate_lane,
    retire_parallel_topology_point_lane,
}
use quilting_domain::{Bary3F, Vec3F, bary3f, vec3f}
use quilting_quaternion::quatf
use quilting_qb::{QbTriPatch, control, evaluate_differential, patch}
use std::web::view::{Extent, Surface}
use std::webgpu::{
    ClipPosition,
    ComputeInvocation,
    ComputeSurface as Kernel,
    CycledDispatch as Cycle,
    FixedDispatch as Once,
    FragmentStage,
    FragmentSurface,
    GpuProgram as Program,
    RasterVertex,
    StorageBuffer as Shared,
    AtomicStorageBuffer,
    TriangleList,
    VertexStage,
    WebGpuBackend,
    Workgroup as Threads,
}

extern {
    const fn __f32_from_i32(_: i32) -> f32
}

const CANDIDATE_COUNT: u32 = quilting_atlas::sampling::candidate_slot_count(key())
const CANDIDATES: usize = CANDIDATE_COUNT as usize
const BOUNDARY: usize = quilting_atlas::boundary_vertices(key()) as usize
const SAMPLING_WORKSPACE_WORDS: usize = CANDIDATES * 8 + 1
const POINTS: usize = CANDIDATES + BOUNDARY
const POINT_WORDS: usize = POINTS * 3
const TRIANGLES: usize = POINTS * 2 - BOUNDARY - 2
const TRIANGLE_WORDS: usize = TRIANGLES * 4
const DRAW_VERTICES: usize = TRIANGLES * 3
const TOPOLOGY_WORKSPACE_WORDS: usize = POINTS * 7 + TRIANGLES * 3 + 8
const THREADS: usize = 128
const WORKGROUPS: usize = (TRIANGLES + THREADS - 1) / THREADS
const COMPACT_TILE: usize = balanced_block_size(CANDIDATE_COUNT) as usize
const COMPACT_BLOCKS: usize = (CANDIDATES + COMPACT_TILE - 1) / COMPACT_TILE
const COMPACT_WORDS: usize = COMPACT_BLOCKS * 3
const COMPACT_GROUPS: usize = (COMPACT_BLOCKS + THREADS - 1) / THREADS
const SCAN_TILE: usize = balanced_block_size(CANDIDATE_COUNT*2+quilting_atlas::boundary_vertices(key())-2) as usize
const SCAN_BLOCKS: usize = (TRIANGLES+SCAN_TILE-1)/SCAN_TILE
const SCAN_WORDS: usize = SCAN_BLOCKS*SUMMARY_WORDS
const SCAN_GROUPS: usize = (SCAN_BLOCKS+THREADS-1)/THREADS
const SAMPLING_ROUNDS: usize = 64
const INSERTION_ROUNDS: usize = 64
const FLIP_LIMIT: usize = 512
const SEED: u32 = 0x51c32a97

pub struct SamplingRound {}
pub struct InsertionRound {}

pub struct MeshVarying { pub edge: Bary3F, pub normal: Vec3F }
impl Copy for MeshVarying {}

struct GeneratedParams {}

fn flag(_ value: bool) -> u32 {
    if value { 1 } else { 0 }
}

fn store_delaunay_receipt(
    _ receipt: Shared<u32, 23>,
    _ restored: DelaunayRestoration,
) {
    receipt.store(index: 16, value: flag(restored.valid))
    receipt.store(index: 17, value: flag(restored.converged))
    receipt.store(index: 18, value: restored.resident_points)
    receipt.store(index: 19, value: restored.resident_triangles)
    receipt.store(index: 20, value: restored.flips)
    receipt.store(index: 21, value: restored.remaining_violations)
    receipt.store(index: 22, value: restored.invariant_failures)
}

const fn key() -> AtlasKey {
    AtlasKey { a: 1, b: 2, c: 3 }
}

fn local_corner(_ corner: u32) -> Bary3F {
    if corner == 0 {
        bary3f(1.0, 0.0, 0.0)
    } else if corner == 1 {
        bary3f(0.0, 1.0, 0.0)
    } else {
        bary3f(0.0, 0.0, 1.0)
    }
}

fn minimum3(_ value: Bary3F) -> f32 {
    let mut result = value.a
    if value.b < result {
        result = value.b
    }
    if value.c < result {
        result = value.c
    }
    result
}

fn fixed_lane(_ value: u32) -> f32 {
    __f32_from_i32(value.downcast_unchecked()) / 16384.0
}

fn curved_patch() -> QbTriPatch {
    patch(
        control(vec3f(-0.75, -0.25, 0.1), quatf(1.0, 0.2, -0.1, 0.05)),
        control(vec3f(0.8, -0.15, -0.2), quatf(0.9, -0.15, 0.25, 0.1)),
        control(vec3f(0.05, 0.9, 0.35), quatf(1.1, 0.1, 0.05, -0.2)),
    )
}

fn invalid_vertex() -> RasterVertex<MeshVarying> {
    RasterVertex {
        position: ClipPosition { x: 2.0, y: 2.0, z: 0.0, w: 1.0 },
        varying: MeshVarying { edge: bary3f(0.0, 0.0, 0.0), normal: vec3f(0.0, 0.0, 1.0) },
    }
}

actor ClassicQuiltingGenerated uses (Program<WebGpuBackend>) {
    sampling_workspace: Shared<u32, SAMPLING_WORKSPACE_WORDS>,
    compaction: Shared<u32, COMPACT_WORDS>,
    points: Shared<u32, POINT_WORDS>,
    triangles_a: Shared<u32, TRIANGLE_WORDS>,
    triangles_b: Shared<u32, TRIANGLE_WORDS>,
    triangles: Shared<u32, TRIANGLE_WORDS>,
    topology_workspace: Shared<u32, TOPOLOGY_WORKSPACE_WORDS>,
    topology_blocks: Shared<u32, SCAN_WORDS>,
    face_claims: AtomicStorageBuffer<TRIANGLES>,
    receipt: Shared<u32, 23>,

    const fn view() -> Surface<GeneratedParams> {
        Surface { extent: Extent::square(768), params: GeneratedParams {} }
    }

    fn sample_initialize(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        let atlas_key = key()
        initialize_candidate_lane<CANDIDATES, SAMPLING_WORKSPACE_WORDS>(
            atlas_key,
            canonical_key_ordinal(atlas_key),
            SEED,
            self.sampling_workspace,
            invocation,
        )
    }

    fn sample_propose(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<SamplingRound, Once<WORKGROUPS, 1, 1>, SAMPLING_ROUNDS>,
            >
        )
    {
        propose_candidate_lane<CANDIDATES, SAMPLING_WORKSPACE_WORDS>(
            key(),
            self.sampling_workspace,
            invocation,
        )
    }

    fn sample_retire(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<SamplingRound, Once<WORKGROUPS, 1, 1>, SAMPLING_ROUNDS>,
            >
        )
    {
        retire_candidate_lane<CANDIDATES, SAMPLING_WORKSPACE_WORDS>(
            key(),
            self.sampling_workspace,
            invocation,
        )
    }

    fn sample_advance(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<SamplingRound, Once<WORKGROUPS, 1, 1>, SAMPLING_ROUNDS>,
            >
        )
    {
        advance_candidate_generation<CANDIDATES, SAMPLING_WORKSPACE_WORDS>(
            self.sampling_workspace,
            invocation,
        )
    }

    fn sample_compact_rank(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<COMPACT_GROUPS, 1, 1>>)
    {
        rank_candidate_block<AtlasKey,CANDIDATES,COMPACT_TILE,SAMPLING_WORKSPACE_WORDS,COMPACT_WORDS>(
            key(),self.sampling_workspace,self.compaction,invocation,
        )
    }

    fn sample_compact(self) uses (Kernel<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let compacted = prefix_candidate_blocks<AtlasKey,CANDIDATES,COMPACT_TILE,POINT_WORDS,COMPACT_WORDS>(
            key(),self.compaction,
        )
        self.receipt.store(index: 0, value: if compacted.valid { 1 } else { 0 })
        self.receipt.store(index: 1, value: if compacted.converged { 1 } else { 0 })
        self.receipt.store(index: 2, value: if compacted.overflowed { 1 } else { 0 })
        self.receipt.store(index: 3, value: compacted.candidate_slots)
        self.receipt.store(index: 4, value: compacted.accepted_candidates)
        self.receipt.store(index: 5, value: compacted.boundary_points)
        self.receipt.store(index: 6, value: compacted.resident_points)
    }

    fn sample_compact_scatter(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        scatter_candidate_lane<AtlasBoundaryPoints,CANDIDATES,COMPACT_TILE,SAMPLING_WORKSPACE_WORDS,POINT_WORDS,COMPACT_WORDS>(
            key(),AtlasBoundaryPoints {},self.sampling_workspace,self.compaction,self.points,invocation,
        )
    }

    fn topology_initialize(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        initialize_parallel_topology_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            key(),
            self.receipt.load(index: 0) != 0,
            self.receipt.load(index: 6),
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_locate(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        locate_parallel_topology_point_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_reset_claims(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>>)
    {
        initialize_parallel_topology_claim_lane<TRIANGLES>(self.face_claims, invocation)
    }

    fn topology_claim(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>>)
    {
        claim_parallel_topology_point_lane<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace, self.face_claims, invocation,
        )
    }

    fn topology_arbitrate(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        arbitrate_parallel_topology_point_lane<
            POINTS,
            TRIANGLES,
            TOPOLOGY_WORKSPACE_WORDS,
        >(self.topology_workspace, self.face_claims, invocation)
    }

    fn topology_plan(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        plan_parallel_topology_face_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            self.face_claims,
            invocation,
        )
    }

    fn topology_rank(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS,1,1>,Cycle<InsertionRound,Once<SCAN_GROUPS,1,1>,INSERTION_ROUNDS>>)
    {
        rank_topology_block<POINTS,TRIANGLES,TOPOLOGY_WORKSPACE_WORDS,SCAN_TILE,SCAN_WORDS>(
            self.topology_workspace,self.topology_blocks,invocation)
    }
    fn topology_scan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1,1,1>,Cycle<InsertionRound,Once<1,1,1>,INSERTION_ROUNDS>>)
    {
        prefix_topology_blocks<POINTS,TRIANGLES,TOPOLOGY_WORKSPACE_WORDS,SCAN_TILE,SCAN_WORDS>(
            self.topology_workspace,self.topology_blocks,invocation)
    }
    fn topology_offsets(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS,1,1>,Cycle<InsertionRound,Once<WORKGROUPS,1,1>,INSERTION_ROUNDS>>)
    {
        relocate_topology_offset<POINTS,TRIANGLES,TOPOLOGY_WORKSPACE_WORDS,SCAN_TILE,SCAN_WORDS>(
            self.topology_workspace,self.topology_blocks,invocation)
    }

    fn topology_rebuild(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        rebuild_parallel_topology_face_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_retire(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        retire_parallel_topology_point_lane<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_advance(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        advance_parallel_topology_generation<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            invocation,
        )
    }

    fn topology_publish(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        publish_parallel_topology_triangle_lane<
            POINTS,
            TRIANGLES,
            TRIANGLE_WORDS,
            TOPOLOGY_WORKSPACE_WORDS,
        >(
            self.triangles_a,
            self.triangles_b,
            self.topology_workspace,
            self.triangles,
            invocation,
        )
    }

    fn topology_restore(self) uses (Kernel<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let resident_points = self.receipt.load(index: 6)
        let boundary = self.receipt.load(index: 5)
        let resident_triangles = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            2,
        )
        let pending = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            3,
        )
        let locations = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            6,
        )
        let invariants = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            7,
        )
        let expected = if resident_points + resident_points > boundary + 2 {
            resident_points + resident_points - boundary - 2
        } else {
            0
        }
        let source_valid = self.receipt.load(index: 0) != 0
            && resident_triangles == expected
            && pending == 0
            && locations == 0
            && invariants == 0
        let restored = restore_constrained_delaunay<
            POINT_WORDS,
            TRIANGLE_WORDS,
            FLIP_LIMIT,
        >(
            key(),
            source_valid,
            resident_points,
            resident_triangles,
            self.points,
            self.triangles,
        )
        store_delaunay_receipt(self.receipt, restored)
    }

    fn topology_seal(self) uses (Kernel<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let points = self.receipt.load(index: 6)
        let boundary = self.receipt.load(index: 5)
        let triangles = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            2,
        )
        let pending = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            3,
        )
        let locations = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            6,
        )
        let invariants = parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
            self.topology_workspace,
            7,
        )
        let expected = if points + points > boundary + 2 {
            points + points - boundary - 2
        } else {
            0
        }
        let valid = self.receipt.load(index: 0) != 0
            && self.receipt.load(index: 16) != 0
            && triangles == expected
            && pending == 0
            && locations == 0
            && invariants == 0
        self.receipt.store(index: 7, value: if valid { 1 } else { 0 })
        self.receipt.store(index: 8, value: points)
        self.receipt.store(index: 9, value: boundary)
        self.receipt.store(index: 10, value: triangles)
        self.receipt.store(index: 11, value: pending)
        self.receipt.store(index: 12, value: locations)
        self.receipt.store(index: 13, value: invariants)
        self.receipt.store(
            index: 14,
            value: parallel_topology_progress<POINTS, TRIANGLES, TOPOLOGY_WORKSPACE_WORDS>(
                self.topology_workspace,
                0,
            ),
        )
        self.receipt.store(index: 15, value: 1)
    }

    fn background(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        -15396337
    }

    fn mesh_vertices(self, vertex_index: u32) -> RasterVertex<MeshVarying>
        uses (VertexStage<MeshVarying, TriangleList<DRAW_VERTICES>>)
    {
        let mut result = invalid_vertex()
        if self.receipt.load(index: 7) != 0 {
            let face = vertex_index / 3
            let corner = vertex_index % 3
                let triangle = resident_triangle<TRIANGLE_WORDS>(self.triangles, face)
            if triangle.valid {
                let point_id = if corner == 0 {
                    triangle.first
                } else if corner == 1 {
                    triangle.second
                } else {
                    triangle.third
                }
                let fixed = resident_point<POINT_WORDS>(self.points, point_id)
                let bary = bary3f(fixed_lane(fixed.a), fixed_lane(fixed.b), fixed_lane(fixed.c))
                let differential = evaluate_differential(
                    curved_patch(),
                    bary,
                    0.00000000000000000001,
                    0.000000000001,
                )
                result = RasterVertex {
                    position: ClipPosition {
                        x: differential.sample.position.x * 0.75,
                        y: differential.sample.position.y * 0.75,
                        z: 0.5 + differential.sample.position.z * 0.05,
                        w: 1.0,
                    },
                    varying: MeshVarying {
                        edge: local_corner(corner),
                        normal: differential.normal,
                    },
                }
            }
        }
        result
    }

    fn mesh_fragment(self, varying: MeshVarying) -> u32
        uses (FragmentStage<MeshVarying>)
    {
        if minimum3(varying.edge) < 0.035 {
            4281543976
        } else if varying.normal.z > 0.0 {
            4292985706
        } else {
            4286476244
        }
    }
}
