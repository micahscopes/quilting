use quilting_atlas::{AtlasKey, canonical_key_ordinal, canonicalize, edge_permutation_index}
use quilting_domain::{
    Bary3F,
    Vec2F,
    Vec3F,
    add3,
    bary3f,
    cross3,
    dot3,
    length2,
    normalize3_or,
    scale3,
    sub3,
    vec2f,
    vec3f,
}
use quilting_oklch::{
    DisplayRgb,
    HuePath,
    display_rgb,
