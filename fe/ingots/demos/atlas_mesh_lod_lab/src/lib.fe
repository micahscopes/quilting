}

extern {
    const fn __f32_from_i32(_: i32) -> f32
}

const PATCH_COLUMNS: u32 = 8
const PATCH_ROWS: u32 = 6
const PATCH_INSTANCES: usize = 96
const ATLAS_MAX_LOD: u32 = 5
const ATLAS_VERTEX_LIMIT: usize = 4926
const SHEET_WIDTH: f32 = 5.6
const SHEET_DEPTH: f32 = 3.8

pub struct TerrainVarying {
    pub edge_seed: Bary3F,
    pub normal: Vec3F,
    pub heat: f32,
    pub focus: f32,
    pub view_depth: f32,
}

impl Copy for TerrainVarying {}

