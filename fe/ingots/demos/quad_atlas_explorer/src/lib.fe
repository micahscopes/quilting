//! One canonical square tile, generated and triangulated in GPU storage.
//! Bounded integration preview, not yet the full resident LoD 0–8 atlas.
use core::marker::Copy
use fmath::{abs, sqrt, smoothstep, min}
use quilting_atlas::quad::{QuadAtlasKey, canonicalize}
use quilting_atlas::quad_sampling::candidate_slot_count
use quilting_atlas::planar::FixedPoint2
use quilting_atlas::scan::balanced_block_size
use quilting_atlas_webgpu::compaction::{rank_candidate_block, prefix_candidate_blocks, scatter_candidate_lane}
use quilting_atlas_webgpu::{
    propose_candidate_lane_with_policy,
    retire_candidate_lane_with_policy,
    advance_candidate_generation,
    initialize_parallel_topology_lane_with_domain,
    locate_parallel_topology_point_lane_with_point,
    arbitrate_parallel_topology_point_lane,
    initialize_parallel_topology_claim_lane,
    claim_parallel_topology_point_lane,
    plan_parallel_topology_face_lane_with_point,
    scan_parallel_topology_face_plan,
    rebuild_parallel_topology_face_lane_with_point,
    retire_parallel_topology_point_lane,
    advance_parallel_topology_generation,
    publish_parallel_topology_triangle_lane,
    parallel_topology_progress,
    restore_indexed_constrained_delaunay_with_policy,
    resident_triangle,
    load_packed_point,
}
use quilting_atlas_webgpu::quad::{
    QuadCandidateConflict,
    QuadBoundaryPoints,
    QuadAtlasDomain,
    QuadInteriorEdgeFlip,
    initialize_quad_candidate_lane,
}
use quilting_domain::{Vec3F, vec3f}
use quilting_oklch::{display_rgb, mix_display_rgb, pack_rgba8}
use std::web::view::{Param, Surface, Extent}
use std::webgpu::{
    GpuProgram,
    WebGpuBackend,
    StorageBuffer,
    AtomicStorageBuffer,
    DrawIndirectBuffer,
    ComputeSurface,
    ComputeInvocation,
    Workgroup,
    FixedDispatch,
    CycledDispatch,
    FragmentSurface,
    FragmentStage,
    VertexStage,
    RasterVertex,
    ClipPosition,
    IndirectTriangleList,
    RasterConfiguration,
    RasterPlan,
    Depth24LessEqualMsaa4,
    raster_plan,
}

// Capacities follow the candidate policy and Euler's disk relation, rather
// than a handwritten tile table. Increase only with measured bounded jobs.
const PREVIEW_LOD: u32 = 3
const MAX_KEY: QuadAtlasKey = QuadAtlasKey {
    bottom: PREVIEW_LOD,
    right: PREVIEW_LOD,
    top: PREVIEW_LOD,
    left: PREVIEW_LOD,
}
const CANDIDATE_COUNT: u32 = candidate_slot_count(MAX_KEY)
const CANDIDATES: usize = CANDIDATE_COUNT as usize
const SAMPLING: usize = CANDIDATES * 8 + 1
const POINTS: usize = CANDIDATES + (MAX_KEY.boundary_count() as usize)
const POINT_WORDS: usize = POINTS * 3
const TRIANGLES: usize = POINTS * 2 - (MAX_KEY.boundary_count() as usize) - 2
const TRIANGLE_WORDS: usize = TRIANGLES * 4
const TWINS: usize = TRIANGLES * 3
const EDGE_INDEX: usize = POINTS + TWINS
const PROPOSALS: usize = (TWINS + 31) / 32
const THREADS: usize = 64
const GROUPS: usize = (CANDIDATES + THREADS - 1) / THREADS
const COMPACT_TILE: usize = balanced_block_size(CANDIDATE_COUNT) as usize
const COMPACT_BLOCKS: usize = (CANDIDATES + COMPACT_TILE - 1) / COMPACT_TILE
const COMPACT_WORDS: usize = COMPACT_BLOCKS * 3
const COMPACT_GROUPS: usize = (COMPACT_BLOCKS + THREADS - 1) / THREADS
const TOPOLOGY_WORDS: usize = POINTS*7+TRIANGLES*3+8
const TOPOLOGY_GROUPS: usize = (TRIANGLES+THREADS-1)/THREADS
pub struct SampleRound {}
pub struct InsertionRound {}
pub struct Draw {}
pub struct Varying { pub edge: Vec3F }
impl Copy for Varying {}
struct Params { bottom: Param, right: Param, top: Param, left: Param, seed: Param, wire_px: Param }
const fn params() -> Params {
    Params {
        bottom: Param::int(min: 0.0, max: 3.0, init: 2.0),
        right: Param::int(min: 0.0, max: 3.0, init: 3.0),
        top: Param::int(min: 0.0, max: 3.0, init: 2.0),
        left: Param::int(min: 0.0, max: 3.0, init: 3.0),
        seed: Param::int(min: 0.0, max: 255.0, init: 42.0),
        wire_px: Param::range(min: 0.0, max: 2.0, init: 0.65),
    }
}
extern {
    const fn __f32_from_i32(_: i32) -> f32
}
fn number(_ n: u32) -> f32 {
    __f32_from_i32(n.downcast_unchecked())
}
fn level(_ x: f32) -> u32 {
    if x < 0.5 {
        0
    } else if x < 1.5 { 1 } else if x < 2.5 { 2 } else { 3 }
}
fn request(_ a: f32, _ b: f32, _ c: f32, _ d: f32) -> QuadAtlasKey {
    QuadAtlasKey { bottom: level(a), right: level(b), top: level(c), left: level(d) }
}
fn seed_value(_ value: f32) -> u32 {
    let mut n: u32 = 0
    while n < 255 && value >= number(n) + 0.5 {
        n = n + 1
    }
    n
}
fn flag(_ value: bool) -> u32 {
    if value { 1 } else { 0 }
}
fn position(_ p: FixedPoint2) -> Vec3F {
    vec3f(
        (number(p.x) / 16384.0 - 0.5) * 1.6,
        (number(p.y) / 16384.0 - 0.5) * 1.6,
        0.5,
    )
}
fn altitude(_ p: Vec3F, _ a: Vec3F, _ b: Vec3F) -> f32 {
    abs((b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x))
        / (sqrt((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y)) + 0.00000001)
        * 384.0
}

actor QuadAtlasExplorer uses (GpuProgram<WebGpuBackend>) {
    bottom:f32,right:f32,top:f32,left:f32,seed:f32,wire_px:f32,
    sampling:StorageBuffer<u32,SAMPLING>,points:StorageBuffer<u32,POINT_WORDS>,
    compaction:StorageBuffer<u32,COMPACT_WORDS>,
    triangles:StorageBuffer<u32,TRIANGLE_WORDS>,twins:StorageBuffer<u32,TWINS>,
    triangles_a:StorageBuffer<u32,TRIANGLE_WORDS>,triangles_b:StorageBuffer<u32,TRIANGLE_WORDS>,
    topology:StorageBuffer<u32,TOPOLOGY_WORDS>,
    face_claims:AtomicStorageBuffer<TRIANGLES>,
    edge_index:StorageBuffer<u32,EDGE_INDEX>,proposals:StorageBuffer<u32,PROPOSALS>,
    receipt:StorageBuffer<u32,16>,draw:DrawIndirectBuffer<Draw>,
    const fn view()->Surface<Params> {Surface {extent:Extent::square(768),params:params()}}
    const fn raster()->RasterPlan uses (RasterConfiguration) {raster_plan<Depth24LessEqualMsaa4>()}

    fn initialize(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,FixedDispatch<GROUPS,1,1>>) {
        initialize_quad_candidate_lane<CANDIDATES,SAMPLING>(
            canonicalize(request(self.bottom,self.right,self.top,self.left)).key,
            seed_value(self.seed),self.sampling,i,
        )
    }
    fn propose(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<SampleRound,FixedDispatch<GROUPS,1,1>,64>>) {
        propose_candidate_lane_with_policy<QuadCandidateConflict,CANDIDATES,SAMPLING>(
            canonicalize(request(self.bottom,self.right,self.top,self.left)).key,
            QuadCandidateConflict {},self.sampling,i,
        )
    }
    fn retire(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<SampleRound,FixedDispatch<GROUPS,1,1>,64>>) {
        retire_candidate_lane_with_policy<QuadCandidateConflict,CANDIDATES,SAMPLING>(
            canonicalize(request(self.bottom,self.right,self.top,self.left)).key,
            QuadCandidateConflict {},self.sampling,i,
        )
    }
    fn advance(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<1,1,1>,CycledDispatch<SampleRound,FixedDispatch<1,1,1>,64>>) {
        advance_candidate_generation<CANDIDATES,SAMPLING>(self.sampling,i)
    }
    fn compact_rank(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,FixedDispatch<COMPACT_GROUPS,1,1>>) {
        rank_candidate_block<QuadAtlasKey,CANDIDATES,COMPACT_TILE,SAMPLING,COMPACT_WORDS>(
            canonicalize(request(self.bottom,self.right,self.top,self.left)).key,
            self.sampling,self.compaction,i,
        )
    }
    fn compact(self) uses (ComputeSurface<Workgroup<1,1,1>,FixedDispatch<1,1,1>>) {
        let r=prefix_candidate_blocks<QuadAtlasKey,CANDIDATES,COMPACT_TILE,POINT_WORDS,COMPACT_WORDS>(
            canonicalize(request(self.bottom,self.right,self.top,self.left)).key,self.compaction,
        )
        self.receipt.store(index:0,value:flag(r.valid))
        self.receipt.store(index:1,value:flag(r.converged))
        self.receipt.store(index:2,value:flag(r.overflowed))
        self.receipt.store(index:3,value:r.accepted_candidates)
        self.receipt.store(index:4,value:r.boundary_points)
        self.receipt.store(index:5,value:r.resident_points)
    }
    fn compact_scatter(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,FixedDispatch<GROUPS,1,1>>) {
        scatter_candidate_lane<QuadBoundaryPoints,CANDIDATES,COMPACT_TILE,SAMPLING,POINT_WORDS,COMPACT_WORDS>(
            canonicalize(request(self.bottom,self.right,self.top,self.left)).key,
            QuadBoundaryPoints {},self.sampling,self.compaction,self.points,i,
        )
    }
    fn topology_initialize(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,FixedDispatch<TOPOLOGY_GROUPS,1,1>>) {
        initialize_parallel_topology_lane_with_domain<QuadAtlasDomain,POINTS,POINT_WORDS,TRIANGLES,TRIANGLE_WORDS,TOPOLOGY_WORDS>(
            QuadAtlasDomain {},canonicalize(request(self.bottom,self.right,self.top,self.left)).key,
            self.receipt.load(index:0)!=0,self.receipt.load(index:5),self.points,
            self.triangles_a,self.triangles_b,self.topology,i,
        )
    }
    fn topology_locate(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<InsertionRound,FixedDispatch<TOPOLOGY_GROUPS,1,1>,64>>) {
        locate_parallel_topology_point_lane_with_point<FixedPoint2,POINTS,POINT_WORDS,TRIANGLES,TRIANGLE_WORDS,TOPOLOGY_WORDS>(
            self.points,self.triangles_a,self.triangles_b,self.topology,i,
        )
    }
    fn topology_reset_claims(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<InsertionRound,FixedDispatch<TOPOLOGY_GROUPS,1,1>,64>>) {
        initialize_parallel_topology_claim_lane<TRIANGLES>(self.face_claims,i)
    }
    fn topology_claim(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<InsertionRound,FixedDispatch<TOPOLOGY_GROUPS,1,1>,64>>) {
        claim_parallel_topology_point_lane<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,self.face_claims,i)
    }
    fn topology_arbitrate(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<InsertionRound,FixedDispatch<TOPOLOGY_GROUPS,1,1>,64>>) {
        arbitrate_parallel_topology_point_lane<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,self.face_claims,i)
    }
    fn topology_plan(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<InsertionRound,FixedDispatch<TOPOLOGY_GROUPS,1,1>,64>>) {
        plan_parallel_topology_face_lane_with_point<FixedPoint2,POINTS,POINT_WORDS,TRIANGLES,TRIANGLE_WORDS,TOPOLOGY_WORDS>(
            self.points,self.triangles_a,self.triangles_b,self.topology,self.face_claims,i,
        )
    }
    fn topology_scan(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<1,1,1>,CycledDispatch<InsertionRound,FixedDispatch<1,1,1>,64>>) {
        scan_parallel_topology_face_plan<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,i)
    }
    fn topology_rebuild(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<InsertionRound,FixedDispatch<TOPOLOGY_GROUPS,1,1>,64>>) {
        rebuild_parallel_topology_face_lane_with_point<FixedPoint2,POINTS,POINT_WORDS,TRIANGLES,TRIANGLE_WORDS,TOPOLOGY_WORDS>(
            self.points,self.triangles_a,self.triangles_b,self.topology,i,
        )
    }
    fn topology_retire(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,CycledDispatch<InsertionRound,FixedDispatch<TOPOLOGY_GROUPS,1,1>,64>>) {
        retire_parallel_topology_point_lane<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,i)
    }
    fn topology_advance(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<1,1,1>,CycledDispatch<InsertionRound,FixedDispatch<1,1,1>,64>>) {
        advance_parallel_topology_generation<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,i)
    }
    fn topology_publish(self,i:ComputeInvocation) uses (ComputeSurface<Workgroup<THREADS,1,1>,FixedDispatch<TOPOLOGY_GROUPS,1,1>>) {
        publish_parallel_topology_triangle_lane<POINTS,TRIANGLES,TRIANGLE_WORDS,TOPOLOGY_WORDS>(
            self.triangles_a,self.triangles_b,self.topology,self.triangles,i,
        )
    }
    fn delaunay(self) uses (ComputeSurface<Workgroup<1,1,1>,FixedDispatch<1,1,1>>) {
        let count=parallel_topology_progress<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,2)
        let pending=parallel_topology_progress<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,3)
        let locations=parallel_topology_progress<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,6)
        let invariants=parallel_topology_progress<POINTS,TRIANGLES,TOPOLOGY_WORDS>(self.topology,7)
        let expected=self.receipt.load(index:5)*2-self.receipt.load(index:4)-2
        let valid=self.receipt.load(index:0)!=0 && pending==0 && locations==0 && invariants==0 && count==expected
        self.receipt.store(index:6,value:flag(valid))
        self.receipt.store(index:7,value:count)
        self.receipt.store(index:8,value:locations)
        self.receipt.store(index:9,value:invariants)
        let r=restore_indexed_constrained_delaunay_with_policy<QuadInteriorEdgeFlip,
            POINT_WORDS,TRIANGLE_WORDS,TWINS,EDGE_INDEX,PROPOSALS,4096>(
            canonicalize(request(self.bottom,self.right,self.top,self.left)).key,
            QuadInteriorEdgeFlip {},self.receipt.load(index:6)!=0,
            self.receipt.load(index:5),self.receipt.load(index:7),
            self.points,self.triangles,self.twins,self.edge_index,self.proposals,
        )
        self.receipt.store(index:10,value:flag(r.valid))
        self.receipt.store(index:11,value:flag(r.converged))
        self.receipt.store(index:12,value:r.flips)
        self.receipt.store(index:13,value:r.remaining_violations)
        self.receipt.store(index:14,value:r.invariant_failures)
    }
    fn publish(self) uses (ComputeSurface<Workgroup<1,1,1>,FixedDispatch<1,1,1>>) {
        self.draw.store(index:0,value:if self.receipt.load(index:10)!=0 {self.receipt.load(index:7)*3} else {0})
        self.draw.store(index:1,value:1)
        self.draw.store(index:2,value:0)
        self.draw.store(index:3,value:0)
    }
    fn background(self,x:i32,y:i32)->i32 uses (FragmentSurface) {
        // Three stage lamps: sampling, insertion, Delaunay; no success inferred
        // merely from having emitted a draw. Amber/red are explicit failures.
        if y<14 && x>=12 && x<108 {
            let stage=if x<44 {0} else if x<76 {6} else {10}
            return pack_rgba8(if self.receipt.load(index:stage)!=0 {display_rgb(0.25,0.7,0.52)} else {display_rgb(0.9,0.3,0.2)})
        }
        pack_rgba8(display_rgb(0.055,0.065,0.08))
    }
    fn vertices(self,index:u32,instance:u32)->RasterVertex<Varying> uses (VertexStage<Varying,IndirectTriangleList<DrawIndirectBuffer<Draw>>>) {
        let triangle=resident_triangle<TRIANGLE_WORDS>(self.triangles,index/3)
        let symmetry=canonicalize(request(self.bottom,self.right,self.top,self.left)).to_canonical.inverse()
        let a=position(symmetry.point(load_packed_point<FixedPoint2,POINT_WORDS>(self.points,triangle.first)))
        let b=position(symmetry.point(load_packed_point<FixedPoint2,POINT_WORDS>(self.points,triangle.second)))
        let c=position(symmetry.point(load_packed_point<FixedPoint2,POINT_WORDS>(self.points,triangle.third)))
        let corner=index%3
        let p=if corner==0 {a} else if corner==1 {b} else {c}
        let edge=if corner==0 {vec3f(altitude(a,b,c),0.0,0.0)}
            else if corner==1 {vec3f(0.0,altitude(b,c,a),0.0)}
            else {vec3f(0.0,0.0,altitude(c,a,b))}
        RasterVertex {position:ClipPosition {x:p.x,y:p.y,z:p.z,w:1.0},varying:Varying {edge:edge}}
    }
    fn fragment(self,v:Varying)->i32 uses (FragmentStage<Varying>) {
        let d=min(v.edge.x,min(v.edge.y,v.edge.z))
        let wire=if self.wire_px<=0.0 {0.0} else {1.0-smoothstep(self.wire_px*0.5,self.wire_px*0.5+0.8,d)}
        pack_rgba8(mix_display_rgb(display_rgb(0.61,0.75,0.73),display_rgb(0.09,0.15,0.19),wire))
    }
}
