    atlas_lod: f32,
    res_x: f32,
    res_y: f32,
    selected: f32,
    dragging: f32,
    orbiting: f32,
}

/// The user-facing scalar remains compact browser/GPU state, while the mode
/// semantics are a proper Fe sum at the effect boundary.
enum SamplingPipeline {
    AnalyticAtlas,
    AdaptiveTopology,
}

impl Copy for SamplingPipeline {}

fn sampling_pipeline(_ mode: f32) -> SamplingPipeline {
    if mode < 2.5 {
        SamplingPipeline::AnalyticAtlas
    } else {
        SamplingPipeline::AdaptiveTopology
    }
}

struct AnalyticPatchPipeline {}

impl AnalyticPatchPipeline {
    pub fn active(_ state: CliffordLabState) -> bool {
        match sampling_pipeline(state.sampler_mode) {
            SamplingPipeline::AnalyticAtlas => true,
            SamplingPipeline::AdaptiveTopology => false,
        }
    }
}

struct PullbackPatchPipeline {}

impl PullbackPatchPipeline {
    pub fn active(_ state: CliffordLabState) -> bool {
        match sampling_pipeline(state.sampler_mode) {
            SamplingPipeline::AnalyticAtlas => false,
            SamplingPipeline::AdaptiveTopology => true,
        }
    }
}

/// Geometry-sensitive work settles after a direct manipulation gesture.
/// During the gesture the resident topology is still valid in parameter space
/// and the vertex stage deforms it immediately with the current Fe state.
struct PullbackPatchTopology {}

impl PullbackPatchTopology {
    pub fn active(_ state: CliffordLabState) -> bool {
        match sampling_pipeline(state.sampler_mode) {
            SamplingPipeline::AnalyticAtlas => false,
            SamplingPipeline::AdaptiveTopology => {
                state.dragging < 0.5 && state.orbiting < 0.5
            },
        }
    }
}

/// Compile the complete pullback topology/render subgraph once the lab is
/// visible and the browser has an idle opportunity. This changes physical
/// residency only; the two activation policies above remain the sole
/// authority over whether any pullback pass executes.
struct PullbackPipelinePreparation {}

impl PullbackPipelinePreparation {
    pub fn residency(_ state: CliffordLabState) -> PassPreparationMode {
        PassPreparationMode::VisibleIdle
    }
}

impl SurfaceState for CliffordLabState {
    type Params = CliffordLabParams
}

derive ApplyParamBindings for CliffordLabState using ParamBindingsProvider

const fn lab_params() -> CliffordLabParams {
    CliffordLabParams {
        p00_x: Param::fixed(0.0),
        p00_y: Param::fixed(2.0),
        p00_z: Param::fixed(0.0),
        p10_x: Param::fixed(0.0),
        p10_y: Param::fixed(1.0),
        p10_z: Param::fixed(0.0),
        p01_x: Param::fixed(0.0),
        p01_y: Param::fixed(-2.0),
        p01_z: Param::fixed(0.0),
        p11_x: Param::fixed(0.0),
        p11_y: Param::fixed(-1.0),
        p11_z: Param::fixed(0.0),
        // These are canonical relative weights: every transition projects
        // them back onto w00 + w10 + w01 + w11 = 4. Common projective scale
        // therefore cannot masquerade as a fourth geometric degree of freedom.
        w00: Param::range(min: 0.0, max: 4.0, init: 1.0),
        w10: Param::range(min: 0.0, max: 4.0, init: 1.0),
        w01: Param::range(min: 0.0, max: 4.0, init: 1.0),
        w11: Param::range(min: 0.0, max: 4.0, init: 1.0),
        orbit_yaw: Param::range(min: -3.14159265, max: 3.14159265, init: -0.72),
        orbit_pitch: Param::range(min: -1.35, max: 1.35, init: 0.12),
        orbit_distance: Param::log(min: 2.5, max: 16.0, init: 6.2),
        wire_px: Param::range(min: 0.0, max: 2.5, init: 0.72),
        depth_cue: Param::unit(init: 0.82),
        // 0 = regular UV grid, 1 = two atlas charts, 2 = recursively measured
        // dyadic QuiltPatch leaves, 3 = compact exact-quotient frontier whose
        // leaf centers seed constrained short-edge restoration in each
        // parameter chart. The former projective-blue-noise placement remains
        // compiled at scalar mode 4 as a diagnostic comparison while the
        // control surface is expanded beyond four choices upstream.
        sampler_mode: Param::choice(
            options: ChoiceOptions::four(
                first: "regular grid",
                second: "atlas charts",
                third: "twist-aware quilt",
                fourth: "adaptive frontier",
            ),
            init: 2.0,
        ),
        // The shared permutation atlas is complete through LoD 8. The
        // analytic path uses an indirect draw, so exposing that complete range
        // no longer pays the maximum vertex envelope at every lower level.
        atlas_lod: Param::int(min: 0.0, max: 8.0, init: 7.0),
        res_x: Param::extent_x(),
        res_y: Param::extent_y(),
        selected: Param::fixed(-1.0),
        dragging: Param::fixed(0.0),
        orbiting: Param::fixed(0.0),
    }
}

fn as_f32(_ value: u32) -> f32 {
    __f32_from_i32(value.downcast_unchecked())
}

fn positions(_ state: CliffordLabState) -> ControlPositions {
    ControlPositions {
        p00: vec3f(state.p00_x, state.p00_y, state.p00_z),
        p10: vec3f(state.p10_x, state.p10_y, state.p10_z),
        p01: vec3f(state.p01_x, state.p01_y, state.p01_z),
        p11: vec3f(state.p11_x, state.p11_y, state.p11_z),
    }
}

fn weights(_ state: CliffordLabState) -> CornerWeights {
    CornerWeights { w00: state.w00, w10: state.w10, w01: state.w01, w11: state.w11 }
}

fn normalize_weight_state(_ state: own CliffordLabState) -> CliffordLabState {
    let sum = state.w00 + state.w10 + state.w01 + state.w11
    let mut result = state
    if sum > 0.000001 {
        let scale = 4.0 / sum
        result.w00 = result.w00 * scale
        result.w10 = result.w10 * scale
        result.w01 = result.w01 * scale
        result.w11 = result.w11 * scale
    } else {
        result.w00 = 1.0
        result.w10 = 1.0
        result.w01 = 1.0
        result.w11 = 1.0
    }
    result
}

fn weight_at(_ weights: CornerWeights, _ index: u32) -> f32 {
    if index == 0 {
        weights.w00
    } else if index == 1 {
        weights.w10
    } else if index == 2 { weights.w01 } else { weights.w11 }
}

fn set_weight(_ state: own CliffordLabState, _ index: u32, _ value: f32) -> CliffordLabState {
    let mut result = state
    let bounded = clamp(value, 0.0, 4.0)
    if index == 0 {
        result.w00 = bounded
    } else if index == 1 {
        result.w10 = bounded
    } else if index == 2 {
        result.w01 = bounded
    } else {
        result.w11 = bounded
    }
    normalize_weight_state(result)
}

fn selected_weight(_ state: CliffordLabState) -> f32 {
    if state.selected < 4.5 {
        state.w00
    } else if state.selected < 5.5 {
        state.w10
    } else if state.selected < 6.5 {
        state.w01
    } else {
        state.w11
    }
}

fn set_selected_weight(_ state: own CliffordLabState, _ value: f32) -> CliffordLabState {
    let selected = state.selected
    if selected < 4.5 {
        set_weight(state, 0, value)
    } else if selected < 5.5 {
        set_weight(state, 1, value)
    } else if selected < 6.5 {
        set_weight(state, 2, value)
    } else {
        set_weight(state, 3, value)
    }
}

fn controlled_patch(
    _ positions: ControlPositions,
    _ weights: CornerWeights,
) -> IsotropicBilinearPatch {
    patch(
        control(
            positions.p00,
            scale_weight(even(1.0, 0.0, 0.0, 0.0), weights.w00),
        ),
        control(
            positions.p10,
            scale_weight(even(0.0, 1.0, 0.0, -1.0), weights.w10),
        ),
        // This is 2e12 + e23. The paper's coefficient matrix disambiguates
        // the punctuation lost by one PDF text extraction.
        control(
            positions.p01,
            scale_weight(even(0.0, 2.0, 0.0, 1.0), weights.w01),
        ),
        control(
            positions.p11,
            scale_weight(even(-6.0, 0.0, -3.0, 0.0), weights.w11),
        ),
    )
}

fn policy() -> IsotropicPolicy {
    IsotropicPolicy {
        minimum_denominator_norm_squared: 0.000000000001,
        maximum_trivector_residual: 0.00001,
    }
}

fn camera_target() -> Vec3F {
    vec3f(1.1, 0.0, 0.0)
}

fn orbit_camera_frame(
    _ yaw: f32,
    _ pitch: f32,
    _ distance: f32,
    _ res_x: f32,
    _ res_y: f32,
) -> CameraFrame {
    let cp = cos(pitch)
    let sp = sin(pitch)
    let cy = cos(yaw)
    let sy = sin(yaw)
    let offset = vec3f(cp * sy, sp, cp * cy)
    let target = camera_target()
    let eye = add3(target, scale3(offset, distance))
    let forward = normalize3_or(sub3(target, eye), vec3f(0.0, 0.0, -1.0), 0.00000001)
    let right = normalize3_or(
        cross3(forward, vec3f(0.0, 1.0, 0.0)),
        vec3f(1.0, 0.0, 0.0),
        0.00000001,
    )
    let up = normalize3_or(cross3(right, forward), vec3f(0.0, 1.0, 0.0), 0.00000001)
    let aspect = if res_y > 0.0 { res_x / res_y } else { 1.0 }
    CameraFrame {
        eye: eye,
        right: right,
        up: up,
        forward: forward,
        focal: 1.75,
        aspect: aspect,
        near: 0.05,
        far: 80.0,
    }
}

fn camera_frame(_ state: CliffordLabState) -> CameraFrame {
    orbit_camera_frame(
        state.orbit_yaw,
        state.orbit_pitch,
        state.orbit_distance,
        state.res_x,
        state.res_y,
    )
}

fn project(_ camera: CameraFrame, _ position: Vec3F) -> Projection {
    let relative = sub3(position, camera.eye)
    let view_x = dot3(relative, camera.right)
    let view_y = dot3(relative, camera.up)
    let depth = dot3(relative, camera.forward)
    let depth_scale = camera.far / (camera.far - camera.near)
    Projection {
        clip: ClipPosition {
            x: camera.focal * view_x / camera.aspect,
            y: camera.focal * view_y,
            z: depth_scale * depth - depth_scale * camera.near,
            w: depth,
        },
        depth: depth,
        view_x: view_x,
        view_y: view_y,
    }
}

/// Differential of perspective projection, returned in physical backing
/// pixels per unit patch parameter. This makes wire coverage resolution-exact.
fn screen_tangent(
    _ camera: CameraFrame,
    _ projection: Projection,
    _ tangent: Vec3F,
    _ res_x: f32,
    _ res_y: f32,
) -> Vec2F {
    let tangent_x = dot3(tangent, camera.right)
    let tangent_y = dot3(tangent, camera.up)
    let tangent_z = dot3(tangent, camera.forward)
    let inverse_depth_squared = 1.0 / (projection.depth * projection.depth)
    vec2f(
        0.5
            * res_x
            * camera.focal
            / camera.aspect
            * (tangent_x * projection.depth - projection.view_x * tangent_z)
            * inverse_depth_squared,
        0.5
            * res_y
            * camera.focal
            * (tangent_y * projection.depth - projection.view_y * tangent_z)
            * inverse_depth_squared,
    )
}

fn corner_parameter(_ local_vertex: u32) -> Vec2F {
    if local_vertex == 0 {
        vec2f(0.0, 0.0)
    } else if local_vertex == 1 {
        vec2f(1.0, 0.0)
    } else if local_vertex == 2 {
        vec2f(0.0, 1.0)
    } else if local_vertex == 3 {
        vec2f(1.0, 0.0)
    } else if local_vertex == 4 {
        vec2f(1.0, 1.0)
    } else {
        vec2f(0.0, 1.0)
    }
}

fn local_barycentric(_ local_vertex: u32) -> Bary3F {
    if local_vertex == 0 || local_vertex == 3 {
        bary3f(1.0, 0.0, 0.0)
    } else if local_vertex == 1 || local_vertex == 4 {
        bary3f(0.0, 1.0, 0.0)
    } else {
        bary3f(0.0, 0.0, 1.0)
    }
}

fn grid_parameter(_ vertex_index: u32) -> Vec2F {
    let cell = vertex_index / 6
    let local_vertex = vertex_index % 6
    let x = cell % GRID
    let y = cell / GRID
    let corner = corner_parameter(local_vertex)
    vec2f(
        (as_f32(x) + corner.x) / as_f32(GRID),
        (as_f32(y) + corner.y) / as_f32(GRID),
    )
}

fn invalid_parameter_triangle() -> ParameterTriangle {
    ParameterTriangle {
        p0: vec2f(0.0, 0.0),
        p1: vec2f(0.0, 0.0),
        p2: vec2f(0.0, 0.0),
        valid: false,
    }
}

fn split_parameter_triangle(_ triangle: u32) -> ParameterTriangle {
    if triangle == 0 {
        ParameterTriangle {
            p0: vec2f(0.0, 0.0),
            p1: vec2f(1.0, 0.0),
            p2: vec2f(0.0, 1.0),
            valid: true,
        }
    } else if triangle == 1 {
        ParameterTriangle {
            p0: vec2f(1.0, 0.0),
            p1: vec2f(1.0, 1.0),
            p2: vec2f(0.0, 1.0),
            valid: true,
        }
    } else {
        invalid_parameter_triangle()
    }
}

fn midpoint_parameter(_ first: Vec2F, _ second: Vec2F) -> Vec2F {
    vec2f((first.x + second.x) * 0.5, (first.y + second.y) * 0.5)
}

fn map_macro_parameter(_ triangle: ParameterTriangle, _ bary: Bary3F) -> Vec2F {
    vec2f(
        triangle.p0.x * bary.a + triangle.p1.x * bary.b + triangle.p2.x * bary.c,
        triangle.p0.y * bary.a + triangle.p1.y * bary.b + triangle.p2.y * bary.c,
    )
}

fn admitted_atlas_lod(_ value: f32) -> u32 {
    let mut lod: u32 = 0
    while lod < MAX_LOD {
        if value < as_f32(lod) + 0.5 {
            return lod
        }
        lod = lod + 1
    }
    MAX_LOD
}

fn atlas_triangle_count_at_lod(_ fixture: FixtureBuffer, _ lod: u32) -> u32 {
    patch_triangle_count(
        fixture,
        canonical_key_ordinal(AtlasKey { a: lod, b: lod, c: lod }),
    )
}

/// Pixel altitude at the current triangle vertex. The two dyadic triangles
/// share one Jacobian parallelogram; their six altitudes reduce to three edge
/// lengths, selected here without sampling neighboring surface points.
fn pixel_altitude(
    _ differential: IsotropicDifferential,
    _ projection: Projection,
    _ camera: CameraFrame,
    _ local_vertex: u32,
    _ res_x: f32,
    _ res_y: f32,
) -> f32 {
    let inverse_grid = 1.0 / as_f32(GRID)
    let ds = screen_tangent(camera, projection, differential.tangent_s, res_x, res_y)
    let dt = screen_tangent(camera, projection, differential.tangent_t, res_x, res_y)
    let s = vec2f(ds.x * inverse_grid, ds.y * inverse_grid)
    let t = vec2f(dt.x * inverse_grid, dt.y * inverse_grid)
    let diagonal = vec2f(t.x - s.x, t.y - s.y)
    let twice_area = abs(s.x * t.y - s.y * t.x)
    let opposite_length = if local_vertex == 0 || local_vertex == 4 {
        length2(diagonal)
    } else if local_vertex == 1 || local_vertex == 5 {
        length2(t)
    } else {
        length2(s)
    }
    twice_area / (opposite_length + 0.00001)
}

fn parameter_screen_delta(
    _ tangent_s: Vec2F,
    _ tangent_t: Vec2F,
    _ origin: Vec2F,
    _ target: Vec2F,
) -> Vec2F {
    let ds = target.x - origin.x
    let dt = target.y - origin.y
    vec2f(
        tangent_s.x * ds + tangent_t.x * dt,
        tangent_s.y * ds + tangent_t.y * dt,
    )
}

/// First-order screen-space altitude for an arbitrary atlas microtriangle.
/// The exact Clifford differential supplies the pullback metric at this
/// vertex; topology remains in parameter space while wire width is measured
/// in physical backing pixels.
fn atlas_pixel_altitude(
    _ differential: IsotropicDifferential,
    _ projection: Projection,
    _ camera: CameraFrame,
    _ p0: Vec2F,
    _ p1: Vec2F,
    _ p2: Vec2F,
    _ corner: u32,
    _ res_x: f32,
    _ res_y: f32,
) -> f32 {
    let mut origin = p0
    let mut first = p1
    let mut second = p2
    if corner == 1 {
        origin = p1
        first = p2
        second = p0
    } else if corner == 2 {
        origin = p2
        first = p0
        second = p1
    }
    let tangent_s = screen_tangent(camera, projection, differential.tangent_s, res_x, res_y)
    let tangent_t = screen_tangent(camera, projection, differential.tangent_t, res_x, res_y)
    let edge_first = parameter_screen_delta(tangent_s, tangent_t, origin, first)
    let edge_second = parameter_screen_delta(tangent_s, tangent_t, origin, second)
    let opposite = vec2f(edge_second.x - edge_first.x, edge_second.y - edge_first.y)
    let twice_area = abs(
        edge_first.x * edge_second.y - edge_first.y * edge_second.x,
    )
    twice_area / (length2(opposite) + 0.00001)
}

fn edge_seed(_ local: Bary3F, _ altitude_pixels: f32, _ view_depth: f32) -> Bary3F {
    let seed = altitude_pixels * view_depth
    bary3f(local.a * seed, local.b * seed, local.c * seed)
}

fn invalid_patch_vertex() -> RasterVertex<PatchVarying> {
    RasterVertex {
        position: ClipPosition { x: 2.0, y: 2.0, z: 0.0, w: 1.0 },
        varying: PatchVarying {
            edge_seed: bary3f(0.0, 0.0, 0.0),
            normal: vec3f(0.0, 0.0, 1.0),
            residual: 0.0,
            parameter: vec2f(0.0, 0.0),
            view_depth: 1.0,
        },
    }
}

fn face_score_offset(_ face: u32, _ edge: u32) -> u32 {
    face * 3 + edge
}

fn face_plan_offset(_ face: u32) -> u32 {
    face * DEFORMED_FACE_PLAN_LANES.downcast_truncate()
}

fn face_plan_meta_offset(_ lane: u32) -> u32 {
    let base: u32 = DEFORMED_FACE_PLAN_ENTRY_WORDS.downcast_truncate()
    base + lane
}

fn raster_screen_sample(
    _ patch: IsotropicBilinearPatch,
    _ parameter: Vec2F,
    _ camera: CameraFrame,
    _ res_x: f32,
    _ res_y: f32,
) -> ScreenSample {
    let sample = evaluate(patch, parameter, policy())
    if !sample.conditioned {
        return ScreenSample { position: vec2f(0.0, 0.0), defined: false }
    }
    let projected = project(camera, sample.position)
    if projected.depth <= camera.near {
        return ScreenSample { position: vec2f(0.0, 0.0), defined: false }
    }
    ScreenSample {
        position: vec2f(
            0.5 * res_x * clamp(projected.clip.x / projected.clip.w, -2.0, 2.0),
            0.5 * res_y * clamp(projected.clip.y / projected.clip.w, -2.0, 2.0),
        ),
        defined: true,
    }
}

/// Screen-space edge demand in physical backing pixels.
///
/// Chord length controls ordinary projected density. Four times the midpoint
/// deviation catches a curved edge whose endpoints happen to project close
/// together. The finite guard band makes offscreen geometry cheap while a
/// near-plane crossing receives the maximum visible demand.
fn projected_edge_score(
    _ patch: IsotropicBilinearPatch,
    _ first: Vec2F,
    _ second: Vec2F,
    _ camera: CameraFrame,
    _ res_x: f32,
    _ res_y: f32,
) -> f32 {
    let middle = midpoint_parameter(first, second)
    let p0 = raster_screen_sample(patch, first, camera, res_x, res_y)
    let p1 = raster_screen_sample(patch, second, camera, res_x, res_y)
    let pm = raster_screen_sample(patch, middle, camera, res_x, res_y)
    if !p0.defined || !p1.defined || !pm.defined {
        let extent = if res_x > res_y { res_x } else { res_y }
        return extent * 2.0
    }
    let chord = length2(
        vec2f(
            p1.position.x - p0.position.x,
            p1.position.y - p0.position.y,
        ),
    )
    let chord_middle = vec2f(
        (p0.position.x + p1.position.x) * 0.5,
        (p0.position.y + p1.position.y) * 0.5,
    )
    let bend = 4.0 * length2(
            vec2f(
                pm.position.x - chord_middle.x,
                pm.position.y - chord_middle.y,
            ),
        )
    if chord > bend { chord } else { bend }
}

fn fractal_cell_parameters(_ cell: DyadicPatchCell2) -> FractalCellParameters {
    let divisions = as_f32(1 << cell.depth)
    let u0 = as_f32(cell.x) / divisions
    let v0 = as_f32(cell.y) / divisions
    let u1 = as_f32(cell.x + 1) / divisions
    let v1 = as_f32(cell.y + 1) / divisions
    FractalCellParameters {
        p00: vec2f(u0, v0),
        p10: vec2f(u1, v0),
        p01: vec2f(u0, v1),
        p11: vec2f(u1, v1),
        center: vec2f((u0 + u1) * 0.5, (v0 + v1) * 0.5),
    }
}

fn maximum4(_ first: f32, _ second: f32, _ third: f32, _ fourth: f32) -> f32 {
    let first_pair = if first > second { first } else { second }
    let second_pair = if third > fourth { third } else { fourth }
    if first_pair > second_pair {
        first_pair
    } else {
        second_pair
    }
}

fn fractal_cell_evidence(
    _ patch: IsotropicBilinearPatch,
    _ cell: DyadicPatchCell2,
    _ camera: CameraFrame,
    _ res_x: f32,
    _ res_y: f32,
) -> FractalCellEvidence {
    let parameters = fractal_cell_parameters(cell)
    let differential00 = evaluate_differential(patch, parameters.p00, policy(), 0.000000000001)
    let differential10 = evaluate_differential(patch, parameters.p10, policy(), 0.000000000001)
    let differential01 = evaluate_differential(patch, parameters.p01, policy(), 0.000000000001)
    let differential11 = evaluate_differential(patch, parameters.p11, policy(), 0.000000000001)
    let differential_center = evaluate_differential(
        patch,
        parameters.center,
        policy(),
        0.000000000001,
    )
    let transform = patch_transform_profile3(
        patch_transform_sample3(
            differential00.tangent_s,
            differential00.tangent_t,
            0.000000000001,
            differential00.sample.conditioned,
        ),
        patch_transform_sample3(
            differential10.tangent_s,
            differential10.tangent_t,
            0.000000000001,
            differential10.sample.conditioned,
        ),
        patch_transform_sample3(
            differential01.tangent_s,
            differential01.tangent_t,
            0.000000000001,
            differential01.sample.conditioned,
        ),
        patch_transform_sample3(
            differential11.tangent_s,
            differential11.tangent_t,
            0.000000000001,
            differential11.sample.conditioned,
        ),
        patch_transform_sample3(
            differential_center.tangent_s,
            differential_center.tangent_t,
            0.000000000001,
            differential_center.sample.conditioned,
        ),
        0.000000000001,
    )
    let chart = denominator_cell_profile(
        patch,
        parameters.p00,
        parameters.p10,
        parameters.p01,
        parameters.p11,
        policy(),
    )
    let diagonal = quad_diagonal_profile2<Euclidean3Points, Euclidean3Metric>(
        denotation_sample<Euclidean3Points>(
            differential00.sample.position,
            differential00.sample.conditioned,
        ),
        denotation_sample<Euclidean3Points>(
            differential10.sample.position,
            differential10.sample.conditioned,
        ),
        denotation_sample<Euclidean3Points>(
            differential01.sample.position,
            differential01.sample.conditioned,
        ),
        denotation_sample<Euclidean3Points>(
            differential11.sample.position,
            differential11.sample.conditioned,
        ),
        denotation_sample<Euclidean3Points>(
            differential_center.sample.position,
            differential_center.sample.conditioned,
        ),
        Euclidean3Metric {},
        0.0000001,
    )
    let bottom_score = projected_edge_score(
        patch,
        parameters.p00,
        parameters.p10,
        camera,
        res_x,
        res_y,
    )
    let right_score = projected_edge_score(
        patch,
        parameters.p10,
        parameters.p11,
        camera,
        res_x,
        res_y,
    )
    let top_score = projected_edge_score(
        patch,
        parameters.p11,
        parameters.p01,
        camera,
        res_x,
        res_y,
    )
    let left_score = projected_edge_score(
        patch,
        parameters.p01,
        parameters.p00,
        camera,
        res_x,
        res_y,
    )
    let diagonal00_11_score = projected_edge_score(
        patch,
        parameters.p00,
        parameters.p11,
        camera,
        res_x,
        res_y,
    )
    let diagonal10_01_score = projected_edge_score(
        patch,
        parameters.p10,
        parameters.p01,
        camera,
        res_x,
        res_y,
    )
    // A chart can be geometrically violent between otherwise innocent point
    // samples.  Its certified norm variation becomes an atlas demand at a
    // terminal leaf, so the depth bound never silently turns a missed narrow
    // feature into a giant triangle fan.
    let chart_score = if chart.defined { 12.0 * chart.measure_variation } else { 0.0 }
    FractalCellEvidence {
        transform: transform,
        chart: chart,
        diagonal: diagonal,
        bottom_score: if bottom_score > chart_score { bottom_score } else { chart_score },
        right_score: if right_score > chart_score { right_score } else { chart_score },
        top_score: if top_score > chart_score { top_score } else { chart_score },
        left_score: if left_score > chart_score { left_score } else { chart_score },
        screen_error: maximum4(
            maximum4(
                if bottom_score > chart_score { bottom_score } else { chart_score },
                if right_score > chart_score { right_score } else { chart_score },
                if top_score > chart_score { top_score } else { chart_score },
                if left_score > chart_score { left_score } else { chart_score },
            ),
            diagonal00_11_score,
            diagonal10_01_score,
            0.0,
        ),
    }
}

fn fractal_lod_policy(_ requested_lod: u32) -> FractalPatchLodPolicy3 {
    FractalPatchLodPolicy3 {
        // The requested atlas LoD establishes a baseline density; it must not
        // cap geometric refinement. A locally stretched or twisted region may
        // descend farther while quiet regions retain a coarser chart.
        maximum_depth: FRACTAL_MAX_DEPTH,
        maximum_screen_error: 48.0,
        maximum_stretch_variation: 2.8,
        maximum_area_variation: 3.6,
        maximum_anisotropy: 8.0,
        maximum_metric_shape_variation: 0.24,
        maximum_chart_measure_variation: 4.0,
        maximum_normal_turn: 0.32,
        maximum_mixed_turn: 0.48,
    }
}

fn maximum_u32(_ first: u32, _ second: u32) -> u32 {
    if first > second { first } else { second }
}

fn minimum_u32(_ first: u32, _ second: u32) -> u32 {
    if first < second { first } else { second }
}

fn fractal_local_lod(_ global_lod: u32, _ depth: u32) -> u32 {
    minimum_u32(
        MAX_LOD,
        if global_lod > depth {
            global_lod - depth
        } else {
            0
        },
    )
}

fn fractal_edge_global_lod(_ score: f32, _ requested_lod: u32, _ depth: u32) -> u32 {
    minimum_u32(
        MAX_LOD,
        maximum_u32(requested_lod, depth + score_lod(score, 12.0)),
    )
}

fn fractal_interior_local_lod(_ score: f32, _ requested_lod: u32, _ depth: u32) -> u32 {
    minimum_u32(
        MAX_LOD,
        maximum_u32(
            fractal_local_lod(requested_lod, depth),
            score_lod(score, 12.0),
        ),
    )
}

fn fractal_effective_screen_error(_ screen_error: f32, _ requested_lod: u32, _ depth: u32) -> f32 {
    screen_error / as_f32(edge_resolution(MAX_LOD))
}

fn fractal_face_plan_offset(_ face: u32) -> u32 {
    face * FRACTAL_FACE_PLAN_LANES.downcast_truncate()
}

fn fractal_face_plan_meta_offset(_ lane: u32) -> u32 {
    let base: u32 = FRACTAL_FACE_PLAN_ENTRY_WORDS.downcast_truncate()
    base + lane
}

fn fractal_node_plan_offset(_ node: u32) -> u32 {
    node * FRACTAL_NODE_PLAN_LANES.downcast_truncate()
}

fn fractal_decision_code(_ decision: FractalPatchLeafDecision) -> u32 {
    match decision {
        FractalPatchLeafDecision::Reject => 0,
        FractalPatchLeafDecision::Draw => 1,
        FractalPatchLeafDecision::Refine => 2,
    }
}

fn classify_fractal_node(
    _ plan: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>,
    _ node: u32,
    _ patch: IsotropicBilinearPatch,
    _ camera: CameraFrame,
    _ res_x: f32,
    _ res_y: f32,
    _ atlas_lod: f32,
) {
    if node >= FRACTAL_NODE_COUNT.downcast_truncate() {
        return
    }
    let requested_lod = admitted_atlas_lod(atlas_lod)
    let cell = dyadic_patch_cell_at_node(node)
    let evidence = fractal_cell_evidence(patch, cell, camera, res_x, res_y)
    let decision = fractal_patch_leaf_decision3(
        cell,
        FractalPatchEvidence3 {
            transform: evidence.transform,
            chart: evidence.chart,
            screen_error: fractal_effective_screen_error(
                evidence.screen_error,
                requested_lod,
                cell.depth,
            ),
        },
        fractal_lod_policy(requested_lod),
    )
    let offset = fractal_node_plan_offset(node)
    plan.store(index: offset, value: fractal_decision_code(decision))
    plan.store(
        index: offset + 1,
        value: fractal_diagonal_code(
            choose_quad_diagonal2(evidence.diagonal, 1.0, 0.18, 0.001),
        ),
    )
    plan.store(
        index: offset + 2,
        value: fractal_interior_local_lod(evidence.screen_error, requested_lod, cell.depth),
    )
    plan.store(
        index: offset + 3,
        value: fractal_edge_global_lod(evidence.bottom_score, requested_lod, cell.depth),
    )
    plan.store(
        index: offset + 4,
        value: fractal_edge_global_lod(evidence.right_score, requested_lod, cell.depth),
    )
    plan.store(
        index: offset + 5,
        value: fractal_edge_global_lod(evidence.top_score, requested_lod, cell.depth),
    )
    plan.store(
        index: offset + 6,
        value: fractal_edge_global_lod(evidence.left_score, requested_lod, cell.depth),
    )
}

fn fractal_diagonal_code(_ diagonal: QuadDiagonal2) -> u32 {
    match diagonal {
        QuadDiagonal2::Corner00To11 => 0,
        QuadDiagonal2::Corner10To01 => 1,
    }
}

fn fractal_node_is_leaf(_ plan: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>, _ node: u32) -> bool {
    if node >= FRACTAL_NODE_COUNT.downcast_truncate()
        || plan.load(index: fractal_node_plan_offset(node)) != 1 {
        return false
    }
    let mut cell = dyadic_patch_cell_at_node(node)
    while cell.depth > 0 {
        cell = dyadic_patch_parent2(cell)
        if plan.load(
                index: fractal_node_plan_offset(dyadic_patch_node_index(cell)),
            ) != 2 {
            return false
        }
    }
    true
}

fn load_fractal_node_side(
    _ plan: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>,
    _ node: u32,
    _ lane: u32,
) -> u32 {
    if node == FRACTAL_OCCUPANCY_EMPTY {
        0
    } else {
        plan.load(index: fractal_node_plan_offset(node) + lane)
    }
}

fn materialize_fractal_occupancy_lane(
    _ plan: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>,
    _ occupancy: StorageBuffer<u32, FRACTAL_OCCUPANCY_WORDS>,
    _ index: u32,
) {
    if index >= FRACTAL_OCCUPANCY_WORDS.downcast_truncate() {
        return
    }
    let fine_x = index % FRACTAL_FINE_SIDE
    let fine_y = index / FRACTAL_FINE_SIDE
    let mut cell = dyadic_patch_root2()
    let mut owner = FRACTAL_OCCUPANCY_EMPTY
    let mut searching = true
    while searching {
        let node = dyadic_patch_node_index(cell)
        let decision = plan.load(index: fractal_node_plan_offset(node))
        if decision == 1 {
            owner = node
            searching = false
        } else if decision != 2 || cell.depth >= FRACTAL_MAX_DEPTH {
            searching = false
        } else {
            let bit = FRACTAL_MAX_DEPTH - cell.depth - 1
            let child = ((fine_x >> bit) & 1) + 2 * ((fine_y >> bit) & 1)
            cell = dyadic_patch_child2(cell, child)
        }
    }
    occupancy.store(index: index, value: owner)
}

fn horizontal_fractal_edge_index(_ x: u32, _ y: u32) -> u32 {
    y * FRACTAL_FINE_SIDE + x
}

fn vertical_fractal_edge_index(_ x: u32, _ y: u32) -> u32 {
    (FRACTAL_FINE_SIDE + 1) * FRACTAL_FINE_SIDE + x * FRACTAL_FINE_SIDE + y
}

fn materialize_fractal_edge_segment(
    _ plan: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>,
    _ occupancy: StorageBuffer<u32, FRACTAL_OCCUPANCY_WORDS>,
    _ edges: StorageBuffer<u32, FRACTAL_EDGE_SEGMENT_WORDS>,
    _ index: u32,
) {
    if index >= FRACTAL_EDGE_SEGMENT_WORDS.downcast_truncate() {
        return
    }
    let horizontal_words = (FRACTAL_FINE_SIDE + 1) * FRACTAL_FINE_SIDE
    let mut demand: u32 = 0
    if index < horizontal_words {
        let x = index % FRACTAL_FINE_SIDE
        let y = index / FRACTAL_FINE_SIDE
        if y > 0 {
            let below = occupancy.load(index: (y - 1) * FRACTAL_FINE_SIDE + x)
            demand = maximum_u32(demand, load_fractal_node_side(plan, below, 5))
        }
        if y < FRACTAL_FINE_SIDE {
            let above = occupancy.load(index: y * FRACTAL_FINE_SIDE + x)
            demand = maximum_u32(demand, load_fractal_node_side(plan, above, 3))
        }
    } else {
        let local = index - horizontal_words
        let x = local / FRACTAL_FINE_SIDE
        let y = local % FRACTAL_FINE_SIDE
        if x > 0 {
            let left = occupancy.load(index: y * FRACTAL_FINE_SIDE + x - 1)
            demand = maximum_u32(demand, load_fractal_node_side(plan, left, 4))
        }
        if x < FRACTAL_FINE_SIDE {
            let right = occupancy.load(index: y * FRACTAL_FINE_SIDE + x)
            demand = maximum_u32(demand, load_fractal_node_side(plan, right, 6))
        }
    }
    edges.store(index: index, value: demand)
}

fn gather_fractal_leaf_edges(
    _ plan: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>,
    _ edges: StorageBuffer<u32, FRACTAL_EDGE_SEGMENT_WORDS>,
    _ node: u32,
) {
    if !fractal_node_is_leaf(plan, node) {
        return
    }
    let cell = dyadic_patch_cell_at_node(node)
    let span = 1 << (FRACTAL_MAX_DEPTH - cell.depth)
    let x0 = cell.x * span
    let y0 = cell.y * span
    let x1 = x0 + span
    let y1 = y0 + span
    let offset = fractal_node_plan_offset(node)
    let mut bottom = plan.load(index: offset + 3)
    let mut right = plan.load(index: offset + 4)
    let mut top = plan.load(index: offset + 5)
    let mut left = plan.load(index: offset + 6)
    let mut cursor = x0
    while cursor < x1 {
        bottom = maximum_u32(
            bottom,
            edges.load(index: horizontal_fractal_edge_index(cursor, y0)),
        )
        top = maximum_u32(
            top,
            edges.load(index: horizontal_fractal_edge_index(cursor, y1)),
        )
        cursor = cursor + 1
    }
    cursor = y0
    while cursor < y1 {
        left = maximum_u32(
            left,
            edges.load(index: vertical_fractal_edge_index(x0, cursor)),
        )
        right = maximum_u32(
            right,
            edges.load(index: vertical_fractal_edge_index(x1, cursor)),
        )
        cursor = cursor + 1
    }
    plan.store(index: offset + 3, value: bottom)
    plan.store(index: offset + 4, value: right)
    plan.store(index: offset + 5, value: top)
    plan.store(index: offset + 6, value: left)
}

fn fractal_node_face_key(
    _ plan: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>,
    _ node: u32,
    _ local_triangle: u32,
) -> AtlasKey {
    let offset = fractal_node_plan_offset(node)
    let depth = dyadic_patch_cell_at_node(node).depth
    let diagonal_code = plan.load(index: offset + 1)
    let diagonal = if diagonal_code == 0 {
        QuadDiagonal2::Corner00To11
    } else {
        QuadDiagonal2::Corner10To01
    }
    let faces = quad_patch_face_densities2(
        diagonal,
        QuadPatchDensity2 {
            bottom: fractal_local_lod(plan.load(index: offset + 3), depth),
            right: fractal_local_lod(plan.load(index: offset + 4), depth),
            top: fractal_local_lod(plan.load(index: offset + 5), depth),
            left: fractal_local_lod(plan.load(index: offset + 6), depth),
            interior: plan.load(index: offset + 2),
        },
    )
    let density = if local_triangle == 0 {
        faces.first
    } else {
        faces.second
    }
    AtlasKey { a: density.a, b: density.b, c: density.c }
}

fn initialize_fractal_face_scan_lane(
    _ nodes: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>,
    _ faces: StorageBuffer<u32, FRACTAL_FACE_PLAN_WORDS>,
    _ scan: StorageBuffer<u32, FRACTAL_SCAN_WORDS>,
    _ scan_progress: StorageBuffer<u32, 1>,
    _ fixture: FixtureBuffer,
    _ index: u32,
) {
    if index >= FRACTAL_SCAN_WORDS.downcast_truncate() {
        return
    }
    let mut triangle_count: u32 = 0
    if index < FRACTAL_FACE_SLOTS.downcast_truncate() {
        let node = index / 2
        let local_triangle = index % 2
        let offset = fractal_face_plan_offset(index)
        faces.store(index: offset, value: 0)
        if fractal_node_is_leaf(nodes, node) {
            let cell = dyadic_patch_cell_at_node(node)
            let node_offset = fractal_node_plan_offset(node)
            let canonical = canonicalize(fractal_node_face_key(nodes, node, local_triangle))
            let patch_index = canonical_key_ordinal(canonical.key)
            triangle_count = patch_triangle_count(fixture, patch_index)
            faces.store(index: offset + 1, value: patch_index)
            faces.store(index: offset + 2, value: cell.depth)
            faces.store(index: offset + 3, value: cell.x)
            faces.store(index: offset + 4, value: cell.y)
            faces.store(
                    index: offset + 5,
                    value: nodes.load(index: node_offset + 1),
                )
            faces.store(index: offset + 6, value: local_triangle)
            faces.store(
                    index: offset + 7,
                    value: edge_permutation_index(canonical.permutation),
                )
        }
    }
    scan.store(index: index, value: triangle_count)
    if index == 0 {
        scan_progress.store(index: 0, value: 0)
    }
}

fn advance_fractal_face_scan(
    _ first: StorageBuffer<u32, FRACTAL_SCAN_WORDS>,
    _ second: StorageBuffer<u32, FRACTAL_SCAN_WORDS>,
    _ progress: StorageBuffer<u32, 1>,
    _ index: u32,
) {
    if index >= FRACTAL_SCAN_WORDS.downcast_truncate() {
        return
    }
    let round = progress.load(index: 0)
    let distance = 1 << round
    let mut value: u32 = 0
    if round % 2 == 0 {
        value = first.load(index: index)
        if index >= distance {
            value = value + first.load(index: index - distance)
        }
        second.store(index: index, value: value)
    } else {
        value = second.load(index: index)
        if index >= distance {
            value = value + second.load(index: index - distance)
        }
        first.store(index: index, value: value)
    }
}

fn commit_fractal_face_scan_round(_ progress: StorageBuffer<u32, 1>, _ index: u32) {
    if index == 0 {
        progress.store(index: 0, value: progress.load(index: 0) + 1)
    }
}

fn finalize_fractal_face_scan_lane(
    _ faces: StorageBuffer<u32, FRACTAL_FACE_PLAN_WORDS>,
    _ scan: StorageBuffer<u32, FRACTAL_SCAN_WORDS>,
    _ index: u32,
) {
    if index < FRACTAL_FACE_SLOTS.downcast_truncate() {
        faces.store(
                index: fractal_face_plan_offset(index),
                value: scan.load(index: index),
            )
    }
    if index == 0 {
        let face_slots: u32 = FRACTAL_FACE_SLOTS.downcast_truncate()
        let final_face = face_slots - 1
        faces.store(index: fractal_face_plan_meta_offset(0), value: face_slots)
        faces.store(
                index: fractal_face_plan_meta_offset(1),
                value: scan.load(index: final_face),
            )
        faces
            .store(
                index: fractal_face_plan_meta_offset(2),
                value: FRACTAL_NODE_COUNT.downcast_truncate(),
            )
    }
}

fn fractal_face_for_micro_triangle(
    _ plan: StorageBuffer<u32, FRACTAL_FACE_PLAN_WORDS>,
    _ face_count: u32,
    _ triangle: u32,
) -> u32 {
    let mut lower: u32 = 0
    let mut upper = face_count
    while lower < upper {
        let middle = (lower + upper) / 2
        if triangle < plan.load(index: fractal_face_plan_offset(middle)) {
            upper = middle
        } else {
            lower = middle + 1
        }
    }
    lower
}

fn fractal_parameter_triangle(
    _ plan: StorageBuffer<u32, FRACTAL_FACE_PLAN_WORDS>,
    _ face: u32,
) -> ParameterTriangle {
    let offset = fractal_face_plan_offset(face)
    let cell = DyadicPatchCell2 {
        depth: plan.load(index: offset + 2),
        x: plan.load(index: offset + 3),
        y: plan.load(index: offset + 4),
    }
    let diagonal = plan.load(index: offset + 5)
    let local_triangle = plan.load(index: offset + 6)
    let parameters = fractal_cell_parameters(cell)
    if diagonal == 0 {
        if local_triangle == 0 {
            ParameterTriangle {
                p0: parameters.p00,
                p1: parameters.p10,
                p2: parameters.p11,
                valid: true,
            }
        } else {
            ParameterTriangle {
                p0: parameters.p00,
                p1: parameters.p11,
                p2: parameters.p01,
                valid: true,
            }
        }
    } else if local_triangle == 0 {
        ParameterTriangle {
            p0: parameters.p00,
            p1: parameters.p10,
            p2: parameters.p01,
            valid: true,
        }
    } else {
        ParameterTriangle {
            p0: parameters.p10,
            p1: parameters.p11,
            p2: parameters.p01,
            valid: true,
        }
    }
}

fn minimum3f(_ first: f32, _ second: f32, _ third: f32) -> f32 {
    let pair = if first < second { first } else { second }
    if pair < third { pair } else { third }
}

fn maximum3f(_ first: f32, _ second: f32, _ third: f32) -> f32 {
    let pair = if first > second { first } else { second }
    if pair > third { pair } else { third }
}

fn triangle_axis_separates_cell(
    _ p0: Vec2F,
    _ p1: Vec2F,
    _ p2: Vec2F,
    _ edge: Vec2F,
    _ center: Vec2F,
    _ half_extent: Vec2F,
) -> bool {
    let axis = vec2f(-edge.y, edge.x)
    let projection0 = (p0.x - center.x) * axis.x + (p0.y - center.y) * axis.y
    let projection1 = (p1.x - center.x) * axis.x + (p1.y - center.y) * axis.y
    let projection2 = (p2.x - center.x) * axis.x + (p2.y - center.y) * axis.y
    let minimum = minimum3f(projection0, projection1, projection2)
    let maximum = maximum3f(projection0, projection1, projection2)
    let radius = half_extent.x * abs(axis.x) + half_extent.y * abs(axis.y)
    maximum < -radius || minimum > radius
}

fn parameter_triangle_overlaps_cell(
    _ p0: Vec2F,
    _ p1: Vec2F,
    _ p2: Vec2F,
    _ cell: AnisotropicPatchCell2,
) -> bool {
    let bounds = anisotropic_cell_parameters(cell)
    let minimum_u = minimum3f(p0.x, p1.x, p2.x)
    let maximum_u = maximum3f(p0.x, p1.x, p2.x)
    let minimum_v = minimum3f(p0.y, p1.y, p2.y)
    let maximum_v = maximum3f(p0.y, p1.y, p2.y)
    let box_overlap = maximum_u >= bounds.p00.x
        && minimum_u <= bounds.p11.x
        && maximum_v >= bounds.p00.y
        && minimum_v <= bounds.p11.y
    if !box_overlap {
        return false
    }
    let center = bounds.center
    let half_extent = vec2f(
        (bounds.p11.x - bounds.p00.x) * 0.5,
        (bounds.p11.y - bounds.p00.y) * 0.5,
    )
    let edge0 = vec2f(p1.x - p0.x, p1.y - p0.y)
    let edge1 = vec2f(p2.x - p1.x, p2.y - p1.y)
    let edge2 = vec2f(p0.x - p2.x, p0.y - p2.y)
    !triangle_axis_separates_cell(p0, p1, p2, edge0, center, half_extent)
        && !triangle_axis_separates_cell(p0, p1, p2, edge1, center, half_extent)
        && !triangle_axis_separates_cell(p0, p1, p2, edge2, center, half_extent)
}

/// Exclude a macro face whenever its parameter triangle intersects a frontier
/// cell whose exact quotient could not certify one finite affine chart. The
/// separating-axis test is exact for the triangle and rectangular cell, so it
/// cannot bridge a projective pole or discard faces merely because their
/// bounding boxes overlap. A future constrained-hole triangulator can consume
/// the same hazard frontier while preserving triangles tangent to its boundary.
fn parameter_triangle_overlaps_frontier_hazard(
    _ hazards: StorageBuffer<u32, PROJECTIVE_HAZARD_WORDS>,
    _ hazard_receipt: StorageBuffer<u32, PROJECTIVE_HAZARD_RECEIPT_WORDS>,
    _ p0: Vec2F,
    _ p1: Vec2F,
    _ p2: Vec2F,
) -> bool {
    let count = hazard_receipt.load(index: 0)
    let mut overlaps = false
    let mut index: u32 = 0
    while index < count {
        let cell = projective_hazard_cell(hazards, index)
        if parameter_triangle_overlaps_cell(p0, p1, p2, cell) {
            overlaps = true
        }
        index = index + 1
    }
    overlaps
}

fn macro_face_scores(
    _ points: StorageBuffer<u32, DEFORMED_POINT_WORDS>,
    _ triangles: StorageBuffer<u32, DEFORMED_TRIANGLE_WORDS>,
    _ hazards: StorageBuffer<u32, PROJECTIVE_HAZARD_WORDS>,
    _ hazard_receipt: StorageBuffer<u32, PROJECTIVE_HAZARD_RECEIPT_WORDS>,
    _ chart: u32,
    _ face: u32,
    _ patch: IsotropicBilinearPatch,
    _ camera: CameraFrame,
    _ res_x: f32,
    _ res_y: f32,
) -> Bary3F {
    let triangle = resident_triangle(triangles, face)
    if !triangle.valid {
        return bary3f(0.0, 0.0, 0.0)
    }
    let point0 = resident_point(points, triangle.first)
    let point1 = resident_point(points, triangle.second)
    let point2 = resident_point(points, triangle.third)
    let p0 = fixed_parameter(chart, point0)
    let p1 = fixed_parameter(chart, point1)
    let p2 = fixed_parameter(chart, point2)
    if parameter_triangle_overlaps_frontier_hazard(
        hazards,
        hazard_receipt,
        p0,
        p1,
        p2,
    ) {
        return bary3f(-1.0, -1.0, -1.0)
    }
    // Atlas lane a lies opposite p0, b opposite p1, and c opposite p2.
    bary3f(
        projected_edge_score(patch, p1, p2, camera, res_x, res_y),
        projected_edge_score(patch, p2, p0, camera, res_x, res_y),
        projected_edge_score(patch, p0, p1, camera, res_x, res_y),
    )
}

fn store_face_scores(
    _ scores: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ face: u32,
    _ value: Bary3F,
) {
    scores.store(index: face_score_offset(face, 0), value: value.a)
    scores.store(index: face_score_offset(face, 1), value: value.b)
    scores.store(index: face_score_offset(face, 2), value: value.c)
}

fn load_face_scores(
    _ scores: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ face: u32,
) -> Bary3F {
    bary3f(
        scores.load(index: face_score_offset(face, 0)),
        scores.load(index: face_score_offset(face, 1)),
        scores.load(index: face_score_offset(face, 2)),
    )
}

fn face_scores_admitted(_ scores: Bary3F) -> bool {
    scores.a >= 0.0 && scores.b >= 0.0 && scores.c >= 0.0
}

fn score_lod(_ score: f32, _ threshold: f32) -> u32 {
    let mut lod: u32 = 0
    let mut span = threshold
    while lod < MAX_LOD && score > span {
        lod = lod + 1
        span = span * 2.0
    }
    lod
}

fn score_key(_ scores: Bary3F, _ threshold: f32) -> AtlasKey {
    AtlasKey {
        a: score_lod(scores.a, threshold),
        b: score_lod(scores.b, threshold),
        c: score_lod(scores.c, threshold),
    }
}

fn planned_chart_triangles(
    _ scores: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ faces: u32,
    _ fixture: FixtureBuffer,
    _ threshold: f32,
) -> u32 {
    let mut total: u32 = 0
    let mut face: u32 = 0
    while face < faces {
        let face_scores = load_face_scores(scores, face)
        if face_scores_admitted(face_scores) {
            let canonical = canonicalize(score_key(face_scores, threshold))
            total = total + patch_triangle_count(fixture, canonical_key_ordinal(canonical.key))
        }
        face = face + 1
    }
    total
}

fn planned_triangles(
    _ scores_0: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ scores_1: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ faces_0: u32,
    _ faces_1: u32,
    _ fixture: FixtureBuffer,
    _ threshold: f32,
) -> u32 {
    planned_chart_triangles(scores_0, faces_0, fixture, threshold)
        + planned_chart_triangles(scores_1, faces_1, fixture, threshold)
}

fn maximum_chart_score(
    _ scores: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ faces: u32,
) -> f32 {
    let mut result = 0.0
    let mut face: u32 = 0
    while face < faces {
        let value = load_face_scores(scores, face)
        if face_scores_admitted(value) && value.a > result {
            result = value.a
        }
        if face_scores_admitted(value) && value.b > result {
            result = value.b
        }
        if face_scores_admitted(value) && value.c > result {
            result = value.c
        }
        face = face + 1
    }
    result
}

fn append_face_plans(
    _ scores: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ faces: u32,
    _ fixture: FixtureBuffer,
    _ plan: StorageBuffer<u32, DEFORMED_FACE_PLAN_WORDS>,
    _ face_base: u32,
    _ prefix_base: u32,
    _ threshold: f32,
) -> u32 {
    let mut prefix = prefix_base
    let mut face: u32 = 0
    while face < faces {
        let face_scores = load_face_scores(scores, face)
        let admitted = face_scores_admitted(face_scores)
        let canonical = canonicalize(score_key(
            if admitted { face_scores } else { bary3f(0.0, 0.0, 0.0) },
            threshold,
        ))
        let patch_index = canonical_key_ordinal(canonical.key)
        if admitted {
            prefix = prefix + patch_triangle_count(fixture, patch_index)
        }
        let offset = face_plan_offset(face_base + face)
        plan.store(index: offset, value: prefix)
        plan.store(index: offset + 1, value: patch_index)
        plan.store(
            index: offset + 2,
            value: edge_permutation_index(canonical.permutation),
        )
        face = face + 1
    }
    prefix
}

fn face_for_micro_triangle(
    _ plan: StorageBuffer<u32, DEFORMED_FACE_PLAN_WORDS>,
    _ face_count: u32,
    _ triangle: u32,
) -> u32 {
    let mut lower: u32 = 0
    let mut upper = face_count
    while lower < upper {
        let middle = (lower + upper) / 2
        if triangle < plan.load(index: face_plan_offset(middle)) {
            upper = middle
        } else {
            lower = middle + 1
        }
    }
    lower
}

/// Construction validity and invariant safety admit a resident topology for
/// drawing. Receipt word 5 separately reports whether topology optimization
/// reached its fixed point; optimization convergence is not a safety gate.
fn deformed_topology_drawable(_ receipt: StorageBuffer<u32, DEFORMED_RECEIPT_WORDS>) -> bool {
    receipt.load(index: 3) != 0 && receipt.load(index: 7) == 0
}

fn prepare_deformed_atlas_plan(
    _ plan: StorageBuffer<u32, DEFORMED_FACE_PLAN_WORDS>,
    _ scores_0: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ scores_1: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    _ receipt_0: StorageBuffer<u32, DEFORMED_RECEIPT_WORDS>,
    _ receipt_1: StorageBuffer<u32, DEFORMED_RECEIPT_WORDS>,
    _ fixture: FixtureBuffer,
    _ atlas_lod: f32,
) {
    let drawable_0 = deformed_topology_drawable(receipt_0)
    let drawable_1 = deformed_topology_drawable(receipt_1)
    let macro_triangles_0 = if drawable_0 {
        receipt_0.load(index: 4)
    } else {
        0
    }
    let macro_triangles_1 = if drawable_1 {
        receipt_1.load(index: 4)
    } else {
        0
    }
    let active_0 = drawable_0 && macro_triangles_0 > 0
    let active_1 = drawable_1 && macro_triangles_1 > 0
    let active_charts = (if active_0 { 1 } else { 0 }) + (if active_1 { 1 } else { 0 })
    let macro_triangles = macro_triangles_0 + macro_triangles_1
    let mut instances: u32 = 0
    if active_charts > 0 && macro_triangles > 0 {
        let target_lod = admitted_atlas_lod(atlas_lod)
        let target = atlas_triangle_count_at_lod(fixture, target_lod) * active_charts
        let maximum_0 = maximum_chart_score(scores_0, macro_triangles_0)
        let maximum_1 = maximum_chart_score(scores_1, macro_triangles_1)
        let maximum = if maximum_0 > maximum_1 {
            maximum_0
        } else {
            maximum_1
        }
        let mut lower = 0.0
        let mut upper = maximum + 1.0
        let mut step: u32 = 0
        while step < DEFORMED_BUDGET_SEARCH_STEPS.downcast_truncate() {
            let middle = (lower + upper) * 0.5
            let triangles = planned_triangles(
                scores_0,
                scores_1,
                macro_triangles_0,
                macro_triangles_1,
                fixture,
                middle,
            )
            if triangles > target {
                lower = middle
            } else {
                upper = middle
            }
            step = step + 1
        }
        let after_0 = append_face_plans(scores_0, macro_triangles_0, fixture, plan, 0, 0, upper)
        instances = append_face_plans(
            scores_1,
            macro_triangles_1,
            fixture,
            plan,
            macro_triangles_0,
            after_0,
            upper,
        )
    }
    plan.store(index: face_plan_meta_offset(0), value: macro_triangles_0)
    plan.store(index: face_plan_meta_offset(1), value: macro_triangles)
    plan.store(index: face_plan_meta_offset(2), value: instances)
}

fn prepare_deformed_indirect_draw(
    _ draw: DrawIndirectBuffer<DeformedAtlasDraw>,
    _ plan: StorageBuffer<u32, DEFORMED_FACE_PLAN_WORDS>,
) {
    draw.store(index: 0, value: 3)
    draw.store(
        index: 1,
        value: plan.load(index: face_plan_meta_offset(2)),
    )
    draw.store(index: 2, value: 0)
    draw.store(index: 3, value: 0)
}

/// Evaluate one atlas microtriangle inside one deformation-aware Delaunay
/// macro-triangle. The topology is resident GPU state; the canonical atlas
/// supplies a crack-free local refinement without reconstructing or reading
/// either structure on the host.
fn deformed_atlas_raster_vertex(
    _ points: StorageBuffer<u32, DEFORMED_POINT_WORDS>,
    _ triangles: StorageBuffer<u32, DEFORMED_TRIANGLE_WORDS>,
    _ fixture: FixtureBuffer,
    _ plan: StorageBuffer<u32, DEFORMED_FACE_PLAN_WORDS>,
    _ chart: u32,
    _ plan_face: u32,
    _ face: u32,
    _ vertex_index: u32,
    _ triangle_instance: u32,
    _ face_count: u32,
    _ patch: IsotropicBilinearPatch,
    _ camera: CameraFrame,
    _ res_x: f32,
    _ res_y: f32,
) -> RasterVertex<PatchVarying> {
    let corner = vertex_index % 3
    if face >= face_count {
        return invalid_patch_vertex()
    }
    let plan_offset = face_plan_offset(plan_face)
    let patch_index = plan.load(index: plan_offset + 1)
    let permutation = plan.load(index: plan_offset + 2)
    let prefix = if plan_face == 0 {
        0
    } else {
        plan.load(index: face_plan_offset(plan_face - 1))
    }
    let local_triangle = triangle_instance - prefix
    if local_triangle >= patch_triangle_count(fixture, patch_index) {
        return invalid_patch_vertex()
    }
    let triangle = resident_triangle(triangles, face)
    if !triangle.valid {
        return invalid_patch_vertex()
    }
    let point0 = resident_point(points, triangle.first)
    let point1 = resident_point(points, triangle.second)
    let point2 = resident_point(points, triangle.third)
    let macro_triangle = ParameterTriangle {
        p0: fixed_parameter(chart, point0),
        p1: fixed_parameter(chart, point1),
        p2: fixed_parameter(chart, point2),
        valid: true,
    }
    let source_triangle = patch_first_triangle(fixture, patch_index) + local_triangle
    let source0 = fixture_triangle_index(fixture, source_triangle, 0)
    let mut source1 = fixture_triangle_index(fixture, source_triangle, 1)
    let mut source2 = fixture_triangle_index(fixture, source_triangle, 2)
    if permutation_parity(permutation) < 0.0 {
        let exchange = source1
        source1 = source2
        source2 = exchange
    }
    let parameter0 = map_macro_parameter(
        macro_triangle,
        remap_barycentric(permutation, fixture_barycentric(fixture, source0)),
    )
    let parameter1 = map_macro_parameter(
        macro_triangle,
        remap_barycentric(permutation, fixture_barycentric(fixture, source1)),
    )
    let parameter2 = map_macro_parameter(
        macro_triangle,
        remap_barycentric(permutation, fixture_barycentric(fixture, source2)),
    )
    if !parameter_triangle_conditioned(patch, parameter0, parameter1, parameter2, policy()) {
        return invalid_patch_vertex()
    }
    let parameter = if corner == 0 {
        parameter0
    } else if corner == 1 { parameter1 } else { parameter2 }
    let differential = evaluate_differential(patch, parameter, policy(), 0.000000000001)
    if !differential.sample.conditioned {
        return invalid_patch_vertex()
    }
    let projected = project(camera, differential.sample.position)
    let altitude = atlas_pixel_altitude(
        differential,
        projected,
        camera,
        parameter0,
        parameter1,
        parameter2,
        corner,
        res_x,
        res_y,
    )
    RasterVertex {
        position: projected.clip,
        varying: PatchVarying {
            edge_seed: edge_seed(local_barycentric(corner), altitude, projected.depth),
            normal: differential.normal,
            residual: differential.sample.trivector_residual,
            parameter: parameter,
            view_depth: projected.depth,
        },
    }
}

fn minimum3(_ value: Bary3F) -> f32 {
    let mut result = value.a
    if value.b < result {
        result = value.b
    }
    if value.c < result {
        result = value.c
    }
    result
}

fn handle_point(_ positions: ControlPositions, _ index: u32) -> Vec3F {
    if index == 0 {
        positions.p00
    } else if index == 1 {
        positions.p10
    } else if index == 2 {
        positions.p01
    } else {
        positions.p11
    }
}

fn weight_handle_center(_ center: ClipPosition, _ weight: f32) -> ClipPosition {
    ClipPosition {
        x: center.x + 0.050 * center.w,
        y: center.y + (weight - 1.0) * 0.080 * center.w,
        z: center.z - 0.0007 * center.w,
        w: center.w,
    }
}

fn selectable_handle_center(
    _ positions: ControlPositions,
    _ weights: CornerWeights,
    _ camera: CameraFrame,
    _ index: u32,
) -> ClipPosition {
    let point_index = if index < 4 { index } else { index - 4 }
    let projected = project(camera, handle_point(positions, point_index)).clip
    if index < 4 {
        projected
    } else {
        weight_handle_center(projected, weight_at(weights, point_index))
    }
}

fn squared_distance_to_handle(
    _ positions: ControlPositions,
    _ weights: CornerWeights,
    _ camera: CameraFrame,
    _ index: u32,
    _ pointer_x: f32,
    _ pointer_y: f32,
) -> f32 {
    let clip = selectable_handle_center(positions, weights, camera, index)
    let dx = pointer_x - clip.x / clip.w
    let dy = pointer_y - clip.y / clip.w
    dx * dx + dy * dy
}

fn nearest_handle(
    _ positions: ControlPositions,
    _ weights: CornerWeights,
    _ camera: CameraFrame,
    _ pointer_x: f32,
    _ pointer_y: f32,
) -> f32 {
    let mut selected: f32 = -1.0
    let mut best: f32 = 0.0028
    let mut index: u32 = 0
    while index < 8 {
        let distance = squared_distance_to_handle(
            positions,
            weights,
            camera,
            index,
            pointer_x,
            pointer_y,
        )
        if distance < best {
            best = distance
            selected = as_f32(index)
        }
        index = index + 1
    }
    selected
}

fn handle_clip(
    _ center: ClipPosition,
    _ corner: u32,
    _ selected: bool,
    _ weight_handle: bool,
) -> ClipPosition {
    let radius = if weight_handle {
        if selected { 0.021 } else { 0.015 }
    } else if selected { 0.029 } else { 0.021 }
    let mut dx = 0.0 - radius
    let mut dy = 0.0 - radius
    if weight_handle {
        if corner == 0 {
            dx = 0.0
        } else if corner == 1 || corner == 3 {
            dx = radius
            dy = 0.0
        } else if corner == 2 || corner == 5 {
            dx = 0.0 - radius
            dy = 0.0
        } else {
            dx = 0.0
            dy = radius
        }
    } else {
        if corner == 1 || corner == 4 || corner == 5 {
            dx = radius
        }
        if corner == 2 || corner == 3 || corner == 5 {
            dy = radius
        }
    }
    ClipPosition {
        x: center.x + dx * center.w,
        y: center.y + dy * center.w,
        z: center.z - 0.0005 * center.w,
        w: center.w,
    }
}

fn moved_in_camera_plane(
    _ point: Vec3F,
    _ camera: CameraFrame,
    _ clip_dx: f32,
    _ clip_dy: f32,
) -> Vec3F {
    let depth = project(camera, point).depth
    let right_distance = clip_dx * camera.aspect * depth / camera.focal
    let up_distance = clip_dy * depth / camera.focal
    add3(
        point,
        add3(
            scale3(camera.right, right_distance),
            scale3(camera.up, up_distance),
        ),
    )
}

fn moved_in_depth(_ point: Vec3F, _ camera: CameraFrame, _ distance: f32) -> Vec3F {
    add3(point, scale3(camera.forward, distance))
}

fn set_handle(_ state: own CliffordLabState, _ point: Vec3F) -> CliffordLabState {
    let selected = state.selected
    let mut result = state
    if selected < 0.5 {
        result.p00_x = point.x
        result.p00_y = point.y
        result.p00_z = point.z
    } else if selected < 1.5 {
        result.p10_x = point.x
        result.p10_y = point.y
        result.p10_z = point.z
    } else if selected < 2.5 {
        result.p01_x = point.x
        result.p01_y = point.y
        result.p01_z = point.z
    } else {
        result.p11_x = point.x
        result.p11_y = point.y
        result.p11_z = point.z
    }
    result
}

fn selected_point(_ state: CliffordLabState) -> Vec3F {
    let current = positions(state)
    if state.selected < 0.5 {
        current.p00
    } else if state.selected < 1.5 {
        current.p10
    } else if state.selected < 2.5 {
        current.p01
    } else {
        current.p11
    }
}

fn depth_surface_color(
    _ parameter: Vec2F,
    _ view_depth: f32,
    _ normal: Vec3F,
    _ residual: f32,
    _ depth_cue: f32,
) -> DisplayRgb {
    let depth_t = clamp01(
        (view_depth - AnalyticDepthWire::near_depth())
            / (AnalyticDepthWire::far_depth() - AnalyticDepthWire::near_depth()),
    )
    let base = bilinear(
        oklch(0.78, 0.095, 0.42),
        oklch(0.82, 0.082, 0.92),
        oklch(0.76, 0.070, 5.92),
        oklch(0.73, 0.078, 5.28),
        parameter.x,
        parameter.y,
        HuePath::Shorter,
    )
    // Free control editing can intentionally leave the exactly vector-valued
    // Clifford locus. Preserve the projected surface while making that
    // algebraic residual legible instead of silently presenting it as exact.
    let residual_amount = smoothstep(policy().maximum_trivector_residual, 0.05, abs(residual))
    let diagnostic = interpolate(
        base,
        oklch(0.70, 0.105, 4.55),
        residual_amount,
        HuePath::Shorter,
    )
    let unit_normal = normalize3_or(normal, vec3f(0.0, 0.0, 1.0), 0.0000001)
    let light = normalize3_or(vec3f(-0.35, 0.48, 0.82), vec3f(0.0, 0.0, 1.0), 0.0000001)
    let diffuse = abs(dot3(unit_normal, light))
    // A continuous low-frequency depth wave is intentionally below Nyquist;
    // it reads depth without introducing another aliased contour edge.
    let depth_wave = 0.94 + 0.06 * cos(TAU * view_depth * AnalyticDepthWire::depth_frequency())
    let depth_scale = mix(1.0, 0.84, smoothstep(0.0, 1.0, depth_t) * depth_cue)
    to_display_rgb(
        scale_lightness_chroma(
            diagnostic,
            (0.72 + 0.30 * diffuse) * depth_wave * depth_scale,
            mix(1.0, 0.82, depth_t * depth_cue),
        ),
    )
}

fn shade_patch(_ varying: PatchVarying, _ wire_px: f32, _ depth_cue: f32) -> i32 {
    let edge_pixels = minimum3(varying.edge_seed) / varying.view_depth
    let feather = AnalyticDepthWire::feather_pixels()
    let wire_coverage = 1.0 - smoothstep(wire_px - feather, wire_px + feather, edge_pixels)
    let surface = depth_surface_color(
        varying.parameter,
        varying.view_depth,
        varying.normal,
        varying.residual,
        depth_cue,
    )
    let wire = display_rgb(0.018, 0.025, 0.043)
    pack_rgba8(mix_display_rgb(surface, wire, wire_coverage))
}

/// Project the browser-facing scalar uniform record into the shared patch
/// denotation. Actor stage methods are independent entry points, so this pure
/// module function is their common semantic boundary.
fn patch_from_uniforms(
    _ p00_x: f32,
    _ p00_y: f32,
    _ p00_z: f32,
    _ p10_x: f32,
    _ p10_y: f32,
    _ p10_z: f32,
    _ p01_x: f32,
    _ p01_y: f32,
    _ p01_z: f32,
    _ p11_x: f32,
    _ p11_y: f32,
    _ p11_z: f32,
    _ w00: f32,
    _ w10: f32,
    _ w01: f32,
    _ w11: f32,
) -> IsotropicBilinearPatch {
    controlled_patch(
        ControlPositions {
            p00: vec3f(p00_x, p00_y, p00_z),
            p10: vec3f(p10_x, p10_y, p10_z),
            p01: vec3f(p01_x, p01_y, p01_z),
            p11: vec3f(p11_x, p11_y, p11_z),
        },
        CornerWeights { w00: w00, w10: w10, w01: w01, w11: w11 },
    )
}

actor CliffordPatchLab uses (
    GpuProgram<WebGpuBackend>,
    SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    fixture: FixtureBuffer,
    projective_frontier_0: StorageBuffer<u32, PROJECTIVE_FRONTIER_WORDS>,
    projective_frontier_1: StorageBuffer<u32, PROJECTIVE_FRONTIER_WORDS>,
    projective_frontier_receipt: StorageBuffer<u32, PROJECTIVE_FRONTIER_RECEIPT_WORDS>,
    projective_frontier_plan: StorageBuffer<u32, PROJECTIVE_FRONTIER_PLAN_WORDS>,
    projective_hazards: StorageBuffer<u32, PROJECTIVE_HAZARD_WORDS>,
    projective_hazard_receipt: StorageBuffer<u32, PROJECTIVE_HAZARD_RECEIPT_WORDS>,
    sampling_workspace_0: StorageBuffer<u32, DEFORMED_SAMPLING_WORDS>,
    sampling_workspace_1: StorageBuffer<u32, DEFORMED_SAMPLING_WORDS>,
    surface_candidates_0: StorageBuffer<u32, DEFORMED_CANDIDATE_WORDS>,
    surface_candidates_1: StorageBuffer<u32, DEFORMED_CANDIDATE_WORDS>,
    candidate_samples_0: StorageBuffer<f32, DEFORMED_SAMPLE_WORDS>,
    candidate_samples_1: StorageBuffer<f32, DEFORMED_SAMPLE_WORDS>,
    points_0: StorageBuffer<u32, DEFORMED_POINT_WORDS>,
    points_1: StorageBuffer<u32, DEFORMED_POINT_WORDS>,
    point_samples_0: StorageBuffer<f32, DEFORMED_POINT_SAMPLE_WORDS>,
    point_samples_1: StorageBuffer<f32, DEFORMED_POINT_SAMPLE_WORDS>,
    triangles_0: StorageBuffer<u32, DEFORMED_TRIANGLE_WORDS>,
    triangles_1: StorageBuffer<u32, DEFORMED_TRIANGLE_WORDS>,
    twins_0: StorageBuffer<u32, DEFORMED_TWIN_WORDS>,
    twins_1: StorageBuffer<u32, DEFORMED_TWIN_WORDS>,
    edge_index_0: StorageBuffer<u32, DEFORMED_EDGE_INDEX_WORDS>,
    edge_index_1: StorageBuffer<u32, DEFORMED_EDGE_INDEX_WORDS>,
    proposals_0: StorageBuffer<u32, DEFORMED_PROPOSAL_WORDS>,
    proposals_1: StorageBuffer<u32, DEFORMED_PROPOSAL_WORDS>,
    receipt_0: StorageBuffer<u32, DEFORMED_RECEIPT_WORDS>,
    receipt_1: StorageBuffer<u32, DEFORMED_RECEIPT_WORDS>,
    deformed_face_scores_0: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    deformed_face_scores_1: StorageBuffer<f32, DEFORMED_FACE_SCORE_WORDS>,
    deformed_face_plan: StorageBuffer<u32, DEFORMED_FACE_PLAN_WORDS>,
    fractal_node_plan: StorageBuffer<u32, FRACTAL_NODE_PLAN_WORDS>,
    fractal_face_plan: StorageBuffer<u32, FRACTAL_FACE_PLAN_WORDS>,
    fractal_occupancy: StorageBuffer<u32, FRACTAL_OCCUPANCY_WORDS>,
    fractal_edge_segments: StorageBuffer<u32, FRACTAL_EDGE_SEGMENT_WORDS>,
    fractal_scan_0: StorageBuffer<u32, FRACTAL_SCAN_WORDS>,
    fractal_scan_1: StorageBuffer<u32, FRACTAL_SCAN_WORDS>,
    fractal_scan_progress: StorageBuffer<u32, 1>,
    analytic_lod: StorageBuffer<u32, 1>,
    analytic_draw: DrawIndirectBuffer<AnalyticAtlasDraw>,
    deformed_draw: DrawIndirectBuffer<DeformedAtlasDraw>,
