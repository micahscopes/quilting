const GRID: u32 = 56
const GRID_VERTICES: u32 = 18816
const GRID_VERTICES_PER_INSTANCE: u32 = 2352
const ATLAS_MAX_LOD: u32 = 5
const ATLAS_TRIANGLES_PER_MACRO: u32 = 1642
const ATLAS_VERTICES_PER_MACRO: u32 = ATLAS_TRIANGLES_PER_MACRO * 3
const MAX_MACRO_TRIANGLES: u32 = 8
const VERTICES_PER_INSTANCE: usize = 4926
const INSTANCE_COUNT: usize = 8


const DEFORMED_CANDIDATES: usize = 272
const DEFORMED_SAMPLING_WORDS: usize = DEFORMED_CANDIDATES * SAMPLING_WORDS_PER_CANDIDATE
    + SAMPLING_PROGRESS_WORDS
const DEFORMED_POINTS: usize = 64
const DEFORMED_POINT_WORDS: usize = DEFORMED_POINTS * 3
const DEFORMED_TRIANGLES: usize = 116
const DEFORMED_TRIANGLE_WORDS: usize = DEFORMED_TRIANGLES * TRIANGLE_WORDS
const DEFORMED_TWIN_WORDS: usize = DEFORMED_TRIANGLES * TOPOLOGY_TWIN_WORDS_PER_TRIANGLE
const DEFORMED_SAMPLE_LANES: usize = 6
const DEFORMED_SAMPLE_WORDS: usize = DEFORMED_CANDIDATES * DEFORMED_SAMPLE_LANES
const DEFORMED_POINT_SAMPLE_WORDS: usize = DEFORMED_POINTS * DEFORMED_SAMPLE_LANES
const DEFORMED_RENDER_VERTICES: usize = DEFORMED_TRIANGLES * 2 * 3
const DEFORMED_THREADS: usize = 128
const DEFORMED_WORKGROUPS: usize = 3
const DEFORMED_SAMPLING_ROUNDS: usize = 64
const DEFORMED_FLIP_LIMIT: usize = 256

const DEFORMED_RADIUS_SQUARED: f32 = 0.18
const DEFORMED_RECEIPT_WORDS: usize = 8

pub struct DeformedSamplingRound {}

fn deformed_key() -> AtlasKey {
    AtlasKey { a: 3, b: 3, c: 3 }
}

fn deformed_seed(_ chart: u32) -> u32 {
    if chart == 0 { 0x51c32a97 } else { 0xc87a4d31 }
}

fn deformed_patch_ordinal(_ chart: u32) -> u32 {
    canonical_key_ordinal(deformed_key()) + chart
}

/// The chosen visual policy is compile-time data. Changing the policy creates
/// a different specialized shader; no per-fragment quality branch survives.
struct AnalyticDepthWire {}

impl AnalyticDepthWire {
    const fn feather_pixels() -> f32 {
        0.72
    }
    const fn depth_frequency() -> f32 {
        0.32
    }
    const fn near_depth() -> f32 {
        2.0
    }
    const fn far_depth() -> f32 {
        11.0
    }
}

