struct CliffordProjectiveFrontier {
    patch: IsotropicBilinearPatch,
    quotient: IsotropicQuotientControlNet,
    camera: CameraFrame,
    res_x: f32,
    res_y: f32,
}
impl Copy for CliffordProjectiveFrontier {}

fn anisotropic_cell_parameters(_ cell: AnisotropicPatchCell2) -> FractalCellParameters {
    let u_divisions = as_f32(1 << cell.u_depth)
    let v_divisions = as_f32(1 << cell.v_depth)
    let u0 = as_f32(cell.u_index) / u_divisions
    let u1 = as_f32(cell.u_index + 1) / u_divisions
    let v0 = as_f32(cell.v_index) / v_divisions
    let v1 = as_f32(cell.v_index + 1) / v_divisions
    FractalCellParameters {
        p00: vec2f(u0, v0),
        p10: vec2f(u1, v0),
        p01: vec2f(u0, v1),
        p11: vec2f(u1, v1),
        center: vec2f((u0 + u1) * 0.5, (v0 + v1) * 0.5),
    }
}

fn projective_frontier_policy() -> ProjectivePatchFrontierPolicy2 {
    ProjectivePatchFrontierPolicy2 {
        maximum_u_depth: PROJECTIVE_FRONTIER_MAX_AXIS_DEPTH,
        maximum_v_depth: PROJECTIVE_FRONTIER_MAX_AXIS_DEPTH,
        maximum_denominator_ratio: 4.0,
        maximum_projective_variation: 32.0,
        // The atlas owns ordinary pixel density inside each macro face. The
        // frontier changes connectivity only when a whole face would be a
        // poor carrier for that atlas detail.
        maximum_screen_variation: 160.0,
    }
}

impl ProjectivePatchFrontierClassifier2 for CliffordProjectiveFrontier {
    fn classify(self, _ cell: AnisotropicPatchCell2) -> ProjectivePatchFrontierDecision2 {
        let parameters = anisotropic_cell_parameters(cell)
        let intrinsic = projective_patch_cell_profile2(
            anisotropic_quadratic_tensor_cell(self.quotient, cell),
            policy().minimum_denominator_norm_squared,
        )
        let bottom = projected_edge_score(
            self.patch,
            parameters.p00,
            parameters.p10,
            self.camera,
            self.res_x,
            self.res_y,
        )
        let top = projected_edge_score(
            self.patch,
            parameters.p01,
            parameters.p11,
            self.camera,
            self.res_x,
            self.res_y,
        )
        let left = projected_edge_score(
            self.patch,
            parameters.p00,
            parameters.p01,
            self.camera,
            self.res_x,
            self.res_y,
        )
        let right = projected_edge_score(
            self.patch,
            parameters.p10,
            parameters.p11,
            self.camera,
            self.res_x,
            self.res_y,
        )
        projective_patch_frontier_decision2(
            cell,
            ProjectivePatchFrontierEvidence2 {
                intrinsic: intrinsic,
                screen_variation_u: if bottom > top { bottom } else { top },
                screen_variation_v: if left > right { left } else { right },
            },
            projective_frontier_policy(),
        )
    }
}

struct FrontierChartPoint { point: FixedBarycentric, valid: bool }
impl Copy for FrontierChartPoint {}

fn frontier_cell_center_coordinate(_ index: u32, _ depth: u32) -> u32 {
    (2 * index + 1) << (13 - depth)
}

fn stratified_frontier_leaf(_ rank: u32, _ count: u32) -> bool {
    let budget: u32 = DEFORMED_CANDIDATES.downcast_truncate()
    count <= budget
        || (rank + 1) * budget / count > rank * budget / count
}

fn frontier_chart_point(_ cell: AnisotropicPatchCell2, _ chart: u32) -> FrontierChartPoint {
    let u = frontier_cell_center_coordinate(cell.u_index, cell.u_depth)
    let v = frontier_cell_center_coordinate(cell.v_index, cell.v_depth)
    if chart == 0 && u + v < BARYCENTRIC_SCALE {
        FrontierChartPoint {
            point: FixedBarycentric { a: BARYCENTRIC_SCALE - u - v, b: u, c: v },
            valid: true,
        }
    } else if chart == 1 && u + v > BARYCENTRIC_SCALE {
        FrontierChartPoint {
            point: FixedBarycentric {
                a: BARYCENTRIC_SCALE - v,
                b: u + v - BARYCENTRIC_SCALE,
                c: BARYCENTRIC_SCALE - u,
            },
            valid: true,
        }
    } else {
        FrontierChartPoint {
            point: FixedBarycentric { a: 0, b: 0, c: 0 },
            valid: false,
        }
    }
}

fn fixed_parameter(_ chart: u32, _ point: FixedBarycentric) -> Vec2F {
    let scale = as_f32(BARYCENTRIC_SCALE)
    map_macro_parameter(
        split_parameter_triangle(chart),
        bary3f(
            as_f32(point.a) / scale,
            as_f32(point.b) / scale,
            as_f32(point.c) / scale,
        ),
    )
}

fn fixed_midpoint(_ first: FixedBarycentric, _ second: FixedBarycentric) -> FixedBarycentric {
    FixedBarycentric {
        a: (first.a + second.a) / 2,
        b: (first.b + second.b) / 2,
        c: (first.c + second.c) / 2,
    }
}

fn root_fixed_triangle() -> FixedParameterTriangle {
    FixedParameterTriangle {
        p0: FixedBarycentric { a: BARYCENTRIC_SCALE, b: 0, c: 0 },
        p1: FixedBarycentric { a: 0, b: BARYCENTRIC_SCALE, c: 0 },
        p2: FixedBarycentric { a: 0, b: 0, c: BARYCENTRIC_SCALE },
    }
}

fn surface_point(
    _ patch: IsotropicBilinearPatch,
    _ chart: u32,
    _ point: FixedBarycentric,
) -> SurfacePoint {
    let sample = evaluate_projective(
        patch,
        fixed_parameter(chart, point),
        policy().minimum_denominator_norm_squared,
    )
    SurfacePoint { position: sample.representative, defined: sample.conditioned }
}

fn chord_triangle_area(
    _ first: SurfacePoint,
    _ second: SurfacePoint,
    _ third: SurfacePoint,
) -> f32 {
    if !first.defined || !second.defined || !third.defined {
        0.0
    } else {
        projective_triangle_area(first.position, second.position, third.position)
    }
}

/// Descend one equal-reference-area four-way split according to the actual
/// chordal areas of its mapped children. Repeating this construction is an
/// inverse area sampler: the fixed chart remains the exact topology carrier,
/// while proposal density follows the patch rather than its UV coordinates.
fn surface_area_child(
    _ patch: IsotropicBilinearPatch,
    _ chart: u32,
    _ triangle: FixedParameterTriangle,
    _ fraction: f32,
    _ fallback: u32,
) -> FixedParameterTriangle {
    let m01 = fixed_midpoint(triangle.p0, triangle.p1)
    let m12 = fixed_midpoint(triangle.p1, triangle.p2)
    let m20 = fixed_midpoint(triangle.p2, triangle.p0)
    let p0 = surface_point(patch, chart, triangle.p0)
    let p1 = surface_point(patch, chart, triangle.p1)
    let p2 = surface_point(patch, chart, triangle.p2)
    let q01 = surface_point(patch, chart, m01)
    let q12 = surface_point(patch, chart, m12)
    let q20 = surface_point(patch, chart, m20)
    let area0 = chord_triangle_area(p0, q01, q20)
    let area1 = chord_triangle_area(q01, p1, q12)
    let area2 = chord_triangle_area(q20, q12, p2)
    let area3 = chord_triangle_area(q01, q12, q20)
    let total = area0 + area1 + area2 + area3
    let choice = if total > 0.000000000001 {
        let target = fraction * total
        if target < area0 {
            0
        } else if target < area0 + area1 {
            1
        } else if target < area0 + area1 + area2 { 2 } else { 3 }
    } else {
        fallback % 4
    }
    if choice == 0 {
        FixedParameterTriangle { p0: triangle.p0, p1: m01, p2: m20 }
    } else if choice == 1 {
        FixedParameterTriangle { p0: m01, p1: triangle.p1, p2: m12 }
    } else if choice == 2 {
        FixedParameterTriangle { p0: m20, p1: m12, p2: triangle.p2 }
    } else {
        FixedParameterTriangle { p0: m01, p1: m12, p2: m20 }
    }
}

fn surface_area_candidate(
    _ patch: IsotropicBilinearPatch,
    _ chart: u32,
    _ slot: u32,
) -> InteriorCandidate {
    let seed = deformed_seed(chart)
    let ordinal = deformed_patch_ordinal(chart)
    let priority = candidate_priority(seed, ordinal, slot)
    let mut triangle = root_fixed_triangle()
    let mut depth: u32 = 0
    while depth < DEFORMED_IMPORTANCE_DEPTH.downcast_truncate() {
        let random = mix32(priority ^ mix32(depth + 1))
        let fraction = as_f32(random % 16777216) / 16777216.0
        triangle = surface_area_child(patch, chart, triangle, fraction, random)
        depth = depth + 1
    }
    let b = (triangle.p0.b + triangle.p1.b + triangle.p2.b) / 3
    let c = (triangle.p0.c + triangle.p1.c + triangle.p2.c) / 3
    let point = FixedBarycentric { a: BARYCENTRIC_SCALE - b - c, b: b, c: c }
    InteriorCandidate {
        point: point,
        radius_squared: poisson_radius_squared(deformed_key(), point),
        priority: priority,
        slot: slot,
        valid: point.a > 0 && point.b > 0 && point.c > 0,
    }
}

/// Preserve one coarse chart-covering stream while a second stream follows
/// projective surface area.
///
/// The shared atlas sampler assigns two deterministic trials to every stable
/// slot pair. Even slots use the deformation-aware inverse-area construction;
/// odd slots retain the stratified chart proposal. The former spends detail
/// where the patch stretches, while the latter prevents a sharply concentrated
/// measure from starving an otherwise valid part of the topology.
fn covered_surface_candidate(
    _ patch: IsotropicBilinearPatch,
    _ chart: u32,
    _ slot: u32,
) -> InteriorCandidate {
    if slot % 2 == 0 {
        surface_area_candidate(patch, chart, slot)
    } else {
        interior_candidate_at_slot(
            deformed_key(),
            deformed_patch_ordinal(chart),
            deformed_seed(chart),
            slot,
        )
    }
}

fn boundary_edge_point(_ edge: u32, _ distance: u32) -> FixedBarycentric {
    if edge == 2 {
        FixedBarycentric { a: BARYCENTRIC_SCALE - distance, b: distance, c: 0 }
    } else if edge == 1 {
        FixedBarycentric { a: BARYCENTRIC_SCALE - distance, b: 0, c: distance }
    } else {
        FixedBarycentric { a: 0, b: BARYCENTRIC_SCALE - distance, c: distance }
    }
}

fn boundary_edge_resolution(_ key: AtlasKey, _ edge: u32) -> u32 {
    if edge == 0 {
        edge_resolution(key.a)
    } else if edge == 1 {
        edge_resolution(key.b)
    } else {
        edge_resolution(key.c)
    }
}

/// Invert a recursively measured chord-length CDF on one mapped chart edge.
/// Endpoints remain exact and shared edges receive the same orientation in
/// both square charts, so redistributing their interior points cannot crack.
fn surface_boundary_point(
    _ patch: IsotropicBilinearPatch,
    _ chart: u32,
    _ boundary: BoundarySeed,
) -> FixedBarycentric {
    if !boundary.valid {
        return boundary.point
    }
    let resolution = boundary_edge_resolution(deformed_key(), boundary.edge)
    if boundary.step == 0 || boundary.step >= resolution {
        return boundary.point
    }
    let mut fraction = as_f32(boundary.step) / as_f32(resolution)
    let mut lower: u32 = 0
    let mut upper: u32 = BARYCENTRIC_SCALE
    let mut depth: u32 = 0
    while depth < DEFORMED_BOUNDARY_ARC_DEPTH.downcast_truncate() {
        let middle = (lower + upper) / 2
        let first = surface_point(patch, chart, boundary_edge_point(boundary.edge, lower))
        let center = surface_point(patch, chart, boundary_edge_point(boundary.edge, middle))
        let last = surface_point(patch, chart, boundary_edge_point(boundary.edge, upper))
        let left = if first.defined && center.defined {
            sqrt(
                projective_distance_squared(center.position, first.position),
            )
        } else {
            0.0
        }
        let right = if center.defined && last.defined {
            sqrt(
                projective_distance_squared(last.position, center.position),
            )
        } else {
            0.0
        }
        let total = left + right
        if total > 0.000000000001 {
            let target = fraction * total
            if target < left {
                upper = middle
                fraction = if left > 0.000000000001 {
                    target / left
                } else {
                    0.5
                }
            } else {
                lower = middle
                fraction = if right > 0.000000000001 {
                    (target - left) / right
                } else {
                    0.5
                }
            }
        } else if fraction < 0.5 {
            upper = middle
            fraction = fraction * 2.0
        } else {
            lower = middle
            fraction = (fraction - 0.5) * 2.0
        }
        depth = depth + 1
    }
    boundary_edge_point(
        boundary.edge,
        ranked_quantized_position(
            (lower + upper) / 2,
            boundary.step,
            resolution,
            BARYCENTRIC_SCALE,
        ),
    )
}

fn surface_boundary_candidate(
    _ patch: IsotropicBilinearPatch,
    _ chart: u32,
    _ ordinal: u32,
) -> InteriorCandidate {
    let boundary = boundary_seed(deformed_key(), ordinal)
    let point = surface_boundary_point(patch, chart, boundary)
    let slot = deformed_boundary_slot(ordinal)
    InteriorCandidate {
        point: point,
        radius_squared: poisson_radius_squared(deformed_key(), point),
        priority: candidate_priority(deformed_seed(chart), deformed_patch_ordinal(chart), slot),
        slot: slot,
        valid: boundary.valid,
    }
}

fn materialize_frontier_chart_points(
    _ frontier_first: StorageBuffer<u32, PROJECTIVE_FRONTIER_WORDS>,
    _ frontier_second: StorageBuffer<u32, PROJECTIVE_FRONTIER_WORDS>,
    _ frontier_receipt: StorageBuffer<u32, PROJECTIVE_FRONTIER_RECEIPT_WORDS>,
    _ points: StorageBuffer<u32, DEFORMED_POINT_WORDS>,
    _ receipt: StorageBuffer<u32, DEFORMED_RECEIPT_WORDS>,
    _ chart: u32,
) {
    let frontier = projective_patch_frontier_receipt(frontier_receipt)
    let mut valid = frontier.converged && !frontier.overflowed
    let mut resident: u32 = 0
    let boundary_count = boundary_vertices(deformed_key())
    let mut boundary: u32 = 0
    while boundary < boundary_count {
        let seed = boundary_seed(deformed_key(), boundary)
        if !seed.valid || !store_resident_point(points, resident, seed.point) {
            valid = false
        }
        resident = resident + 1
        boundary = boundary + 1
    }
    // The exact square frontier can be strongly asymmetric across the two
    // triangle charts. Count this chart first, then retain one stable leaf
    // from every equal-rank stratum of its actual point budget. This is a
    // deterministic placement change; the frontier itself remains intact.
    let mut chart_leaf_count: u32 = 0
    let mut leaf: u32 = 0
    while leaf < frontier.active_cells {
        let frontier_cell = projective_patch_frontier_cell(
            frontier_first,
            frontier_second,
            frontier_receipt,
            leaf,
        )
        let candidate = frontier_chart_point(frontier_cell.cell, chart)
        if !frontier_cell.rejected && candidate.valid {
            chart_leaf_count = chart_leaf_count + 1
        }
        leaf = leaf + 1
    }
    leaf = 0
    let mut chart_rank: u32 = 0
    while leaf < frontier.active_cells {
        let frontier_cell = projective_patch_frontier_cell(
            frontier_first,
            frontier_second,
            frontier_receipt,
            leaf,
        )
        let candidate = frontier_chart_point(frontier_cell.cell, chart)
        if !frontier_cell.rejected && candidate.valid {
            if stratified_frontier_leaf(chart_rank, chart_leaf_count) {
                if !store_resident_point(points, resident, candidate.point) {
                    valid = false
                }
                resident = resident + 1
            }
            chart_rank = chart_rank + 1
        }
        leaf = leaf + 1
    }
    receipt.store(index: 0, value: if valid { 1 } else { 0 })
    receipt.store(index: 1, value: resident)
    receipt.store(index: 2, value: boundary_count)
    receipt.store(index: 3, value: 0)
    receipt.store(index: 4, value: 0)
    receipt.store(index: 5, value: 0)
    receipt.store(index: 6, value: 0)
    receipt.store(index: 7, value: 0)
}

fn projective_hazard_cell_offset(_ index: u32) -> u32 {
    index * PROJECTIVE_HAZARD_CELL_WORDS.downcast_truncate()
}

fn store_projective_hazard_cell(
    _ hazards: StorageBuffer<u32, PROJECTIVE_HAZARD_WORDS>,
    _ index: u32,
    _ cell: AnisotropicPatchCell2,
) {
    let offset = projective_hazard_cell_offset(index)
    hazards.store(index: offset, value: cell.u_depth)
    hazards.store(index: offset + 1, value: cell.u_index)
    hazards.store(index: offset + 2, value: cell.v_depth)
    hazards.store(index: offset + 3, value: cell.v_index)
}

fn projective_hazard_cell(
    _ hazards: StorageBuffer<u32, PROJECTIVE_HAZARD_WORDS>,
    _ index: u32,
) -> AnisotropicPatchCell2 {
    let offset = projective_hazard_cell_offset(index)
    AnisotropicPatchCell2 {
        u_depth: hazards.load(index: offset),
        u_index: hazards.load(index: offset + 1),
        v_depth: hazards.load(index: offset + 2),
        v_index: hazards.load(index: offset + 3),
    }
}

/// Compact the rejected projective leaves in stable frontier order. The
/// frontier capacity is also the hazard-list capacity, so a valid frontier can
/// never overflow this representation.
fn materialize_projective_hazards(
    _ frontier_first: StorageBuffer<u32, PROJECTIVE_FRONTIER_WORDS>,
    _ frontier_second: StorageBuffer<u32, PROJECTIVE_FRONTIER_WORDS>,
    _ frontier_receipt: StorageBuffer<u32, PROJECTIVE_FRONTIER_RECEIPT_WORDS>,
    _ hazards: StorageBuffer<u32, PROJECTIVE_HAZARD_WORDS>,
    _ hazard_receipt: StorageBuffer<u32, PROJECTIVE_HAZARD_RECEIPT_WORDS>,
) {
    let receipt = projective_patch_frontier_receipt(frontier_receipt)
    if !receipt.converged || receipt.overflowed {
        hazard_receipt.store(index: 0, value: 0)
        return
    }
    let mut source: u32 = 0
    let mut resident: u32 = 0
    while source < receipt.active_cells {
        let frontier_cell = projective_patch_frontier_cell(
            frontier_first,
            frontier_second,
            frontier_receipt,
            source,
        )
        if frontier_cell.rejected {
            store_projective_hazard_cell(hazards, resident, frontier_cell.cell)
            resident = resident + 1
        }
        source = source + 1
    }
    hazard_receipt.store(index: 0, value: resident)
}

fn candidate_offset(_ slot: u32) -> u32 {
    slot * DEFORMED_CANDIDATE_LANES.downcast_truncate()
}

fn store_surface_candidate(
    _ candidates: StorageBuffer<u32, DEFORMED_CANDIDATE_WORDS>,
    _ candidate: InteriorCandidate,
) {
    let offset = candidate_offset(candidate.slot)
    candidates.store(index: offset, value: candidate.point.a)
    candidates.store(index: offset + 1, value: candidate.point.b)
    candidates.store(index: offset + 2, value: candidate.point.c)
    candidates.store(index: offset + 3, value: candidate.radius_squared)
    candidates.store(index: offset + 4, value: candidate.priority)
    candidates.store(
            index: offset + 5,
            value: if candidate.valid { 1 } else { 0 },
        )
}

fn load_surface_candidate(
    _ candidates: StorageBuffer<u32, DEFORMED_CANDIDATE_WORDS>,
    _ slot: u32,
) -> InteriorCandidate {
    let offset = candidate_offset(slot)
    InteriorCandidate {
        point: FixedBarycentric {
            a: candidates.load(index: offset),
            b: candidates.load(index: offset + 1),
            c: candidates.load(index: offset + 2),
        },
        radius_squared: candidates.load(index: offset + 3),
        priority: candidates.load(index: offset + 4),
        slot: slot,
        valid: candidates.load(index: offset + 5) != 0,
    }
}

struct SurfaceBoundaryPoints { candidates: StorageBuffer<u32, DEFORMED_CANDIDATE_WORDS> }
impl Copy for SurfaceBoundaryPoints {}

impl BoundaryPointPolicy for SurfaceBoundaryPoints {
    fn point(self, _ key: AtlasKey, _ ordinal: u32) -> FixedBarycentric {
        load_surface_candidate(self.candidates, deformed_boundary_slot(ordinal)).point
    }
}

fn projective_poisson_radius_squared() -> f32 {
    let density = as_f32(edge_resolution(deformed_key().a))
    let angular_radius = TAU * 0.25 / density
    2.0 - 2.0 * cos(angular_radius)
}

fn patch_projective_sample(
    _ patch: IsotropicBilinearPatch,
    _ parameter: Vec2F,
) -> SurfaceProjectiveSample {
    let sample = evaluate_projective(
        patch,
        parameter,
        policy().minimum_denominator_norm_squared,
    )
    SurfaceProjectiveSample {
        parameter: parameter,
        representative: sample.representative,
        defined: sample.conditioned,
    }
}

fn fixed_projective_sample(
    _ patch: IsotropicBilinearPatch,
    _ chart: u32,
    _ point: FixedBarycentric,
) -> SurfaceProjectiveSample {
    patch_projective_sample(patch, fixed_parameter(chart, point))
}

fn sample_offset(_ ordinal: u32) -> u32 {
    ordinal * DEFORMED_SAMPLE_LANES.downcast_truncate()
}

fn deformed_boundary_slot(_ ordinal: u32) -> u32 {
    let base: u32 = DEFORMED_CANDIDATES.downcast_truncate()
    base + ordinal
}

fn store_projective_sample<const WORDS: usize>(
    _ samples: StorageBuffer<f32, WORDS>,
    _ ordinal: u32,
    _ sample: SurfaceProjectiveSample,
) {
    let offset = sample_offset(ordinal)
    samples.store(index: offset, value: sample.parameter.x)
    samples.store(index: offset + 1, value: sample.parameter.y)
    samples.store(
            index: offset + 2,
            value: sample.representative.numerator_e1,
        )
    samples.store(
            index: offset + 3,
            value: sample.representative.numerator_e2,
        )
    samples.store(
            index: offset + 4,
            value: sample.representative.numerator_e3,
        )
    samples.store(
            index: offset + 5,
            value: sample.representative.numerator_e123,
        )
    samples.store(
            index: offset + 6,
            value: sample.representative.denominator_scalar,
        )
    samples.store(
            index: offset + 7,
            value: sample.representative.denominator_e12,
        )
    samples.store(
            index: offset + 8,
            value: sample.representative.denominator_e13,
        )
    samples.store(
            index: offset + 9,
            value: sample.representative.denominator_e23,
        )
    samples.store(
            index: offset + 10,
            value: if sample.defined { 1.0 } else { 0.0 },
        )
}

fn load_projective_sample<const WORDS: usize>(
    _ samples: StorageBuffer<f32, WORDS>,
    _ ordinal: u32,
) -> SurfaceProjectiveSample {
    let offset = sample_offset(ordinal)
    SurfaceProjectiveSample {
        parameter: vec2f(
            samples.load(index: offset),
            samples.load(index: offset + 1),
        ),
        representative: IsotropicProjectiveF {
            numerator_e1: samples.load(index: offset + 2),
            numerator_e2: samples.load(index: offset + 3),
            numerator_e3: samples.load(index: offset + 4),
            numerator_e123: samples.load(index: offset + 5),
            denominator_scalar: samples.load(index: offset + 6),
            denominator_e12: samples.load(index: offset + 7),
            denominator_e13: samples.load(index: offset + 8),
            denominator_e23: samples.load(index: offset + 9),
        },
        defined: samples.load(index: offset + 10) > 0.5,
    }
}

fn reference_poisson_radius_squared() -> f32 {
    let scale = as_f32(BARYCENTRIC_SCALE)
    as_f32(
            poisson_radius_squared(deformed_key(), root_fixed_triangle().p0),
        ) / (scale * scale)
}

/// Ambient distance does not encode whether two images belong to the same
/// local sheet. Bound exclusion to one nominal topology neighborhood so two
/// distant folded sheets can never participate in one Poisson comparison.
fn parameters_are_local(
    _ first: SurfaceProjectiveSample,
    _ second: SurfaceProjectiveSample,
) -> bool {
    let ds = second.parameter.x - first.parameter.x
    let dt = second.parameter.y - first.parameter.y
    3.0 * (ds * ds + dt * dt + ds * dt) < reference_poisson_radius_squared()
}

fn projective_samples_conflict(
    _ first: SurfaceProjectiveSample,
    _ second: SurfaceProjectiveSample,
) -> bool {
    let radius_squared = projective_poisson_radius_squared()
    first.defined
        && second.defined
        && parameters_are_local(first, second)
        && projective_distance_squared(first.representative, second.representative) < radius_squared
}

impl<const WORDS: usize> CandidateConflictPolicy for SurfaceCandidateConflict<WORDS> {
    fn conflicts_boundary(self, _ key: AtlasKey, _ candidate: InteriorCandidate) -> bool {
        let candidate_sample = load_projective_sample(self.samples, candidate.slot)
        let mut conflict = !candidate.valid || !candidate_sample.defined
        let mut ordinal: u32 = 0
        let count = boundary_vertices(key)
        while ordinal < count {
            if projective_samples_conflict(
                candidate_sample,
                load_projective_sample(self.samples, deformed_boundary_slot(ordinal)),
            ) {
                conflict = true
            }
            ordinal = ordinal + 1
        }
        conflict
    }

    fn conflicts(self, _ left: InteriorCandidate, _ right: InteriorCandidate) -> bool {
        projective_samples_conflict(
            load_projective_sample(self.samples, left.slot),
            load_projective_sample(self.samples, right.slot),
        )
    }
}

impl<const WORDS: usize> InteriorEdgeFlipPolicy for SurfaceShortEdgeFlip<WORDS> {
    fn decision(
        self,
        _ u_id: u32,
        _ u: FixedBarycentric,
        _ v_id: u32,
        _ v: FixedBarycentric,
        _ first_opposite_id: u32,
        _ first_opposite: FixedBarycentric,
        _ second_opposite_id: u32,
        _ second_opposite: FixedBarycentric,
    ) -> FlipDecision {
        let chart_decision = interior_edge_flip_decision(
            u_id,
            u,
            v_id,
            v,
            first_opposite_id,
            first_opposite,
            second_opposite_id,
            second_opposite,
        )
        if !chart_decision.convex {
            return chart_decision
        }
        let current = projective_distance_squared(
            load_projective_sample(self.samples, u_id).representative,
            load_projective_sample(self.samples, v_id).representative,
        )
        let alternate = projective_distance_squared(
            load_projective_sample(self.samples, first_opposite_id).representative,
            load_projective_sample(self.samples, second_opposite_id).representative,
        )
        // Projective representatives are normalized, so this absolute band
        // has a fixed geometric meaning. Strict improvements decrease the
        // global sum of resident interior-edge chord lengths. Exact ties use
        // the canonical atlas ordering and therefore cannot flip back.
        let tolerance = 0.0000001
        let sign: i32 = if current > alternate + tolerance {
            1
        } else if alternate > current + tolerance {
            -1
        } else {
            0
        }
        FlipDecision {
            incircle: sign,
            convex: true,
            flip: should_flip_edge(u_id, v_id, first_opposite_id, second_opposite_id, sign),
        }
    }
}

fn restore_deformed_topology(
    _ samples: StorageBuffer<f32, DEFORMED_POINT_SAMPLE_WORDS>,
    _ receipt: StorageBuffer<u32, DEFORMED_RECEIPT_WORDS>,
    _ points: StorageBuffer<u32, DEFORMED_POINT_WORDS>,
    _ triangles: StorageBuffer<u32, DEFORMED_TRIANGLE_WORDS>,
    _ twins: StorageBuffer<u32, DEFORMED_TWIN_WORDS>,
    _ edge_index: StorageBuffer<u32, DEFORMED_EDGE_INDEX_WORDS>,
    _ proposals: StorageBuffer<u32, DEFORMED_PROPOSAL_WORDS>,
) {
    let policy = SurfaceShortEdgeFlip { samples: samples }
    let restored = restore_indexed_constrained_delaunay_with_policy<
        SurfaceShortEdgeFlip<DEFORMED_POINT_SAMPLE_WORDS>,
        DEFORMED_POINT_WORDS,
        DEFORMED_TRIANGLE_WORDS,
        DEFORMED_TWIN_WORDS,
        DEFORMED_EDGE_INDEX_WORDS,
        DEFORMED_PROPOSAL_WORDS,
        DEFORMED_FLIP_LIMIT,
    >(
        deformed_key(),
        policy,
        receipt.load(index: 3) != 0,
        receipt.load(index: 1),
        receipt.load(index: 4),
        points,
        triangles,
        twins,
        edge_index,
        proposals,
    )
    receipt.store(index: 5, value: if restored.valid { 1 } else { 0 })
    receipt.store(index: 6, value: restored.flips)
    receipt.store(index: 7, value: restored.invariant_failures)
}

struct CliffordLabParams {
    p00_x: Param,
    p00_y: Param,
    p00_z: Param,
    p10_x: Param,
    p10_y: Param,
    p10_z: Param,
    p01_x: Param,
    p01_y: Param,
    p01_z: Param,
    p11_x: Param,
    p11_y: Param,
    p11_z: Param,
    w00: Param,
    w10: Param,
    w01: Param,
    w11: Param,
    orbit_yaw: Param,
    orbit_pitch: Param,
    orbit_distance: Param,
    wire_px: Param,
    depth_cue: Param,
    sampler_mode: Param,
    atlas_lod: Param,
    res_x: Param,
    res_y: Param,
    selected: Param,
    dragging: Param,
    orbiting: Param,
}

pub struct CliffordLabState {
    p00_x: f32,
    p00_y: f32,
    p00_z: f32,
    p10_x: f32,
    p10_y: f32,
    p10_z: f32,
    p01_x: f32,
    p01_y: f32,
    p01_z: f32,
    p11_x: f32,
    p11_y: f32,
    p11_z: f32,
    w00: f32,
    w10: f32,
    w01: f32,
    w11: f32,
    orbit_yaw: f32,
    orbit_pitch: f32,
    orbit_distance: f32,
    wire_px: f32,
    depth_cue: f32,
