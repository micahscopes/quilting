        )
        if invocation.global.y == 0 {
            let policy = SurfaceCandidateConflict {
                samples: self.candidate_samples_0,
                patch: patch,
                chart: 0,
            }
            retire_candidate_lane_with_policy<
                SurfaceCandidateConflict<DEFORMED_SAMPLE_WORDS>,
