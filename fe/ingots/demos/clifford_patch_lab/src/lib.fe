    orbit_distance: f32,
    wire_px: f32,
    depth_cue: f32,
    sampler_mode: f32,
    atlas_lod: f32,
    res_x: f32,
    res_y: f32,
    selected: f32,
    dragging: f32,
    orbiting: f32,

    fn initialize_adaptive_projective_frontier(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode >= 2.5 && self.sampler_mode < 3.5
            && invocation.global.x == 0 {
            initialize_projective_patch_frontier(
                self.projective_frontier_0,
                self.projective_frontier_receipt,
            )
        }
    }

    fn classify_adaptive_projective_frontier(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<PROJECTIVE_FRONTIER_THREADS, 1, 1>,
                CycledDispatch<
                    ProjectiveFrontierRound,
                    FixedDispatch<PROJECTIVE_FRONTIER_WORKGROUPS, 1, 1>,
                    PROJECTIVE_FRONTIER_ROUNDS,
                >,
            >,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode >= 2.5 && self.sampler_mode < 3.5 {
            let patch = patch_from_uniforms(
                self.p00_x, self.p00_y, self.p00_z,
                self.p10_x, self.p10_y, self.p10_z,
                self.p01_x, self.p01_y, self.p01_z,
                self.p11_x, self.p11_y, self.p11_z,
                self.w00, self.w10, self.w01, self.w11,
            )
            classify_projective_patch_frontier_lane<
                CliffordProjectiveFrontier,
                PROJECTIVE_FRONTIER_CAPACITY,
                PROJECTIVE_FRONTIER_WORDS,
                PROJECTIVE_FRONTIER_RECEIPT_WORDS,
                PROJECTIVE_FRONTIER_PLAN_WORDS,
            >(
                CliffordProjectiveFrontier {
                    patch: patch,
                    quotient: quotient_control_net(patch),
                    camera: orbit_camera_frame(
                        self.orbit_yaw,
                        self.orbit_pitch,
                        self.orbit_distance,
                        self.res_x,
                        self.res_y,
                    ),
                    res_x: self.res_x,
                    res_y: self.res_y,
                },
                self.projective_frontier_0,
                self.projective_frontier_1,
                self.projective_frontier_receipt,
                self.projective_frontier_plan,
                invocation.global.x,
            )
        }
    }

