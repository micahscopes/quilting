    fn deformed_sampling_advance(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<DEFORMED_THREADS, 1, 1>,
                CycledDispatch<
                    DeformedSamplingRound,
                    FixedDispatch<DEFORMED_WORKGROUPS, 2, 1>,
                    DEFORMED_SAMPLING_ROUNDS,
                >,
            >,
            PassActivation<PullbackPatchPipeline>,
        )
    {
        if self.sampler_mode < 2.5 || invocation.global.y >= 2 {
            return
        }
        if invocation.global.y == 0 {
            advance_candidate_generation<DEFORMED_CANDIDATES, DEFORMED_SAMPLING_WORDS>(
                self.sampling_workspace_0,
                invocation,
            )
        } else {
            advance_candidate_generation<DEFORMED_CANDIDATES, DEFORMED_SAMPLING_WORDS>(
                self.sampling_workspace_1,
                invocation,
            )
        }
    }

    fn deformed_sampling_compact(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 2, 1>>,
            PassActivation<PullbackPatchPipeline>,
        )
    {
        if self.sampler_mode < 2.5 || invocation.global.y >= 2 {
            return
        }
        if invocation.global.y == 0 {
            let compacted = compact_candidate_points<
                DEFORMED_CANDIDATES,
                DEFORMED_SAMPLING_WORDS,
                DEFORMED_POINT_WORDS,
            >(deformed_key(), self.sampling_workspace_0, self.points_0)
            self.receipt_0.store(index: 0, value: if compacted.valid { 1 } else { 0 })
            self.receipt_0.store(index: 1, value: compacted.resident_points)
            self.receipt_0.store(index: 2, value: compacted.boundary_points)
        } else {
            let compacted = compact_candidate_points<
                DEFORMED_CANDIDATES,
                DEFORMED_SAMPLING_WORDS,
                DEFORMED_POINT_WORDS,
            >(deformed_key(), self.sampling_workspace_1, self.points_1)
            self.receipt_1.store(index: 0, value: if compacted.valid { 1 } else { 0 })
            self.receipt_1.store(index: 1, value: compacted.resident_points)
            self.receipt_1.store(index: 2, value: compacted.boundary_points)
        }
    }

    fn deformed_point_samples(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<DEFORMED_THREADS, 1, 1>, FixedDispatch<1, 2, 1>>,
            PassActivation<PullbackPatchPipeline>,
        )
    {
        if self.sampler_mode < 2.5 || invocation.global.y >= 2 {
            return
        }
        let point = invocation.global.x
        let chart = invocation.global.y
        let patch = patch_from_uniforms(
            self.p00_x, self.p00_y, self.p00_z,
            self.p10_x, self.p10_y, self.p10_z,
            self.p01_x, self.p01_y, self.p01_z,
            self.p11_x, self.p11_y, self.p11_z,
            self.w00, self.w10, self.w01, self.w11,
        )
        if chart == 0 && point < self.receipt_0.load(index: 1) {
            store_pullback_sample(
                self.point_samples_0,
                point,
                fixed_pullback_sample(
                    patch,
                    chart,
                    resident_point(self.points_0, point),
                ),
            )
        } else if chart == 1 && point < self.receipt_1.load(index: 1) {
            store_pullback_sample(
                self.point_samples_1,
                point,
                fixed_pullback_sample(
                    patch,
                    chart,
                    resident_point(self.points_1, point),
                ),
            )
        }
    }

    fn deformed_topology_construct(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 2, 1>>,
            PassActivation<PullbackPatchPipeline>,
        )
    {
        if self.sampler_mode < 2.5 || invocation.global.y >= 2 {
            return
        }
        if invocation.global.y == 0 {
            let built = construct_constrained_triangles<
                DEFORMED_POINT_WORDS,
                DEFORMED_TRIANGLE_WORDS,
            >(
                deformed_key(),
                self.receipt_0.load(index: 0) != 0,
                self.receipt_0.load(index: 1),
                self.points_0,
                self.triangles_0,
            )
            self.receipt_0.store(index: 3, value: if built.valid { 1 } else { 0 })
            self.receipt_0.store(index: 4, value: built.resident_triangles)
        } else {
            let built = construct_constrained_triangles<
                DEFORMED_POINT_WORDS,
                DEFORMED_TRIANGLE_WORDS,
            >(
                deformed_key(),
                self.receipt_1.load(index: 0) != 0,
                self.receipt_1.load(index: 1),
                self.points_1,
                self.triangles_1,
            )
            self.receipt_1.store(index: 3, value: if built.valid { 1 } else { 0 })
            self.receipt_1.store(index: 4, value: built.resident_triangles)
        }
    }

    // Each chart is a separate pass so its four resident products remain below
    // the portable per-stage storage-binding budget. A runtime chart branch
    // would make both disjoint resource sets reachable from one shader.
    fn deformed_topology_restore_0(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchPipeline>,
        )
    {
        if self.sampler_mode < 2.5 { return }
        restore_deformed_topology(
            self.point_samples_0,
            self.receipt_0,
            self.points_0,
            self.triangles_0,
            self.twins_0,
        )
    }

    fn deformed_topology_restore_1(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchPipeline>,
        )
    {
        if self.sampler_mode < 2.5 { return }
        restore_deformed_topology(
            self.point_samples_1,
            self.receipt_1,
            self.points_1,
            self.triangles_1,
            self.twins_1,
        )
    }

    const fn raster() -> RasterPlan uses (RasterConfiguration) {
        raster_plan<Depth24LessEqualMsaa4>()
    }

    const fn view() -> Surface<CliffordLabParams> {
        Surface { extent: Extent::square(768), params: lab_params() }
    }

    fn navigate(self, event: own SurfaceEvent) -> CliffordLabState
        uses (SurfaceTransition, SurfaceScheduling<LatestPerFrame>)
    {
        let mut state = CliffordLabState {
            p00_x: self.p00_x,
            p00_y: self.p00_y,
            p00_z: self.p00_z,
            p10_x: self.p10_x,
            p10_y: self.p10_y,
            p10_z: self.p10_z,
            p01_x: self.p01_x,
            p01_y: self.p01_y,
            p01_z: self.p01_z,
            p11_x: self.p11_x,
            p11_y: self.p11_y,
            p11_z: self.p11_z,
            w00: self.w00,
            w10: self.w10,
            w01: self.w01,
            w11: self.w11,
            orbit_yaw: self.orbit_yaw,
            orbit_pitch: self.orbit_pitch,
            orbit_distance: self.orbit_distance,
            wire_px: self.wire_px,
            depth_cue: self.depth_cue,
            sampler_mode: self.sampler_mode,
            atlas_lod: self.atlas_lod,
            res_x: self.res_x,
            res_y: self.res_y,
            selected: self.selected,
            dragging: self.dragging,
            orbiting: self.orbiting,
        }.apply_param_bindings(lab_params(), event)

        if event.is_pointer_down() {
            let pointer_x = event.pointer_x * 2.0 / event.width - 1.0
            let pointer_y = 1.0 - event.pointer_y * 2.0 / event.height
            state.selected = nearest_handle(
                positions(state), weights(state), camera_frame(state), pointer_x, pointer_y,
            )
            state.dragging = if state.selected >= 0.0 { 1.0 } else { 0.0 }
            state.orbiting = if state.selected < 0.0 { 1.0 } else { 0.0 }
        }

        if event.is_pointer_move() && event.buttons != 0 {
            if state.dragging > 0.5 && state.selected >= 0.0 && state.selected < 4.0 {
                let clip_dx = event.delta_x * 2.0 / event.width
                let clip_dy = event.delta_y * -2.0 / event.height
                let moved = moved_in_camera_plane(
                    selected_point(state), camera_frame(state), clip_dx, clip_dy,
                )
                state = set_handle(state, moved)
            } else if state.dragging > 0.5 && state.selected >= 4.0 {
                let value = selected_weight(state) - event.delta_y * 2.0 / event.height / 0.080
                state = set_selected_weight(state, value)
            } else if state.orbiting > 0.5 {
                state.orbit_yaw = wrap_pi(state.orbit_yaw - event.delta_x * 0.008)
                state.orbit_pitch = clamp(
                    state.orbit_pitch - event.delta_y * 0.008, -1.35, 1.35,
                )
            }
        }

        if event.is_pointer_up() {
            state.dragging = 0.0
            state.orbiting = 0.0
        }

        if event.wheel_delta != 0.0 {
            if state.selected >= 0.0 && state.selected < 4.0 {
                let direction = if event.wheel_delta < 0.0 { -1.0 } else { 1.0 }
                let moved = moved_in_depth(
                    selected_point(state), camera_frame(state),
                    direction * state.orbit_distance * 0.018,
                )
                state = set_handle(state, moved)
            } else if state.selected >= 4.0 {
                let direction = if event.wheel_delta < 0.0 { 1.0 } else { -1.0 }
                let value = selected_weight(state) + direction * 0.12
                state = set_selected_weight(state, value)
            } else if event.wheel_delta < 0.0 {
                state.orbit_distance = clamp(state.orbit_distance * 0.90, 2.5, 16.0)
            } else {
                state.orbit_distance = clamp(state.orbit_distance * 1.10, 2.5, 16.0)
            }
        }
        normalize_weight_state(state)
    }

    fn background(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        -15396337
    }

    fn patch_vertices(
        self,
        vertex_index: u32,
        instance_index: u32,
    ) -> RasterVertex<PatchVarying>
        uses (
            VertexStage<
                PatchVarying,
                Instanced<TriangleList<VERTICES_PER_INSTANCE>, INSTANCE_COUNT>,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        let state = CliffordLabState {
            p00_x: self.p00_x,
            p00_y: self.p00_y,
            p00_z: self.p00_z,
            p10_x: self.p10_x,
            p10_y: self.p10_y,
            p10_z: self.p10_z,
            p01_x: self.p01_x,
            p01_y: self.p01_y,
            p01_z: self.p01_z,
            p11_x: self.p11_x,
            p11_y: self.p11_y,
            p11_z: self.p11_z,
            w00: self.w00,
            w10: self.w10,
            w01: self.w01,
            w11: self.w11,
            orbit_yaw: self.orbit_yaw,
            orbit_pitch: self.orbit_pitch,
            orbit_distance: self.orbit_distance,
            wire_px: self.wire_px,
            depth_cue: self.depth_cue,
            sampler_mode: self.sampler_mode,
            atlas_lod: self.atlas_lod,
            res_x: self.res_x,
            res_y: self.res_y,
            selected: self.selected,
            dragging: self.dragging,
            orbiting: self.orbiting,
        }
        let patch_value = controlled_patch(positions(state), weights(state))
        let camera = camera_frame(state)
        if self.sampler_mode >= 2.5 {
            invalid_patch_vertex()
        } else if self.sampler_mode < 0.5 {
            let grid_vertex = instance_index * GRID_VERTICES_PER_INSTANCE + vertex_index
            if vertex_index >= GRID_VERTICES_PER_INSTANCE || grid_vertex >= GRID_VERTICES {
                invalid_patch_vertex()
            } else {
                let parameter = grid_parameter(grid_vertex)
                let differential = evaluate_differential(
                    patch_value, parameter, policy(), 0.000000000001,
                )
                let projected = project(camera, differential.sample.position)
                let local_vertex = grid_vertex % 6
                let altitude = pixel_altitude(
                    differential, projected, camera, local_vertex, self.res_x, self.res_y,
                )
                RasterVertex {
                    position: projected.clip,
                    varying: PatchVarying {
                        edge_seed: edge_seed(
                            local_barycentric(local_vertex), altitude, projected.depth,
                        ),
                        normal: differential.normal,
                        residual: differential.sample.trivector_residual,
                        parameter: parameter,
                        view_depth: projected.depth,
                    },
                }
            }
        } else {
            let chart = macro_parameter_triangle(self.sampler_mode, instance_index)
            let lod = admitted_atlas_lod(self.atlas_lod)
            let atlas_key = AtlasKey { a: lod, b: lod, c: lod }
            let patch_index = canonical_key_ordinal(atlas_key)
            let local_triangle = vertex_index / 3
            if !chart.valid || local_triangle >= patch_triangle_count(self.fixture, patch_index) {
                invalid_patch_vertex()
            } else {
                let corner = vertex_index % 3
                let source_triangle = patch_first_triangle(self.fixture, patch_index) + local_triangle
                let point0 = fixture_triangle_index(self.fixture, source_triangle, 0)
                let point1 = fixture_triangle_index(self.fixture, source_triangle, 1)
                let point2 = fixture_triangle_index(self.fixture, source_triangle, 2)
                let parameter0 = map_macro_parameter(
                    chart, fixture_barycentric(self.fixture, point0),
                )
                let parameter1 = map_macro_parameter(
                    chart, fixture_barycentric(self.fixture, point1),
                )
                let parameter2 = map_macro_parameter(
                    chart, fixture_barycentric(self.fixture, point2),
                )
                let parameter = if corner == 0 {
                    parameter0
                } else if corner == 1 {
                    parameter1
                } else {
                    parameter2
                }
                let differential = evaluate_differential(
                    patch_value, parameter, policy(), 0.000000000001,
                )
                let projected = project(camera, differential.sample.position)
                let altitude = atlas_pixel_altitude(
                    differential,
                    projected,
                    camera,
                    parameter0,
                    parameter1,
                    parameter2,
                    corner,
                    self.res_x,
                    self.res_y,
                )
                RasterVertex {
                    position: projected.clip,
                    varying: PatchVarying {
                        edge_seed: edge_seed(
                            local_barycentric(corner), altitude, projected.depth,
                        ),
                        normal: differential.normal,
                        residual: differential.sample.trivector_residual,
                        parameter: parameter,
                        view_depth: projected.depth,
                    },
                }
            }
        }
    }

    fn patch_fragment(self, varying: PatchVarying) -> i32
        uses (
            FragmentStage<PatchVarying>,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        let edge_pixels = minimum3(varying.edge_seed) / varying.view_depth
        let feather = AnalyticDepthWire::feather_pixels()
        let wire_coverage = 1.0 - smoothstep(
            self.wire_px - feather, self.wire_px + feather, edge_pixels,
        )
        let surface = depth_surface_color(
            varying.parameter,
            varying.view_depth,
            varying.normal,
            varying.residual,
            self.depth_cue,
        )
        let wire = display_rgb(0.018, 0.025, 0.043)
        pack_rgba8(mix_display_rgb(surface, wire, wire_coverage))
    }

    fn deformed_vertices(self, vertex_index: u32) -> RasterVertex<PatchVarying>
        uses (
            VertexStage<PatchVarying, TriangleList<DEFORMED_RENDER_VERTICES>>,
            PassActivation<PullbackPatchPipeline>,
        )
    {
        let chart_vertices: u32 = (DEFORMED_TRIANGLES * 3).downcast_truncate()
        let chart = vertex_index / chart_vertices
        let local_vertex = vertex_index % chart_vertices
        let patch = patch_from_uniforms(
            self.p00_x, self.p00_y, self.p00_z,
            self.p10_x, self.p10_y, self.p10_z,
            self.p01_x, self.p01_y, self.p01_z,
            self.p11_x, self.p11_y, self.p11_z,
            self.w00, self.w10, self.w01, self.w11,
        )
        let state = CliffordLabState {
            p00_x: self.p00_x,
            p00_y: self.p00_y,
            p00_z: self.p00_z,
            p10_x: self.p10_x,
            p10_y: self.p10_y,
            p10_z: self.p10_z,
            p01_x: self.p01_x,
            p01_y: self.p01_y,
            p01_z: self.p01_z,
            p11_x: self.p11_x,
            p11_y: self.p11_y,
            p11_z: self.p11_z,
            w00: self.w00,
            w10: self.w10,
            w01: self.w01,
            w11: self.w11,
            orbit_yaw: self.orbit_yaw,
            orbit_pitch: self.orbit_pitch,
            orbit_distance: self.orbit_distance,
            wire_px: self.wire_px,
            depth_cue: self.depth_cue,
            sampler_mode: self.sampler_mode,
            atlas_lod: self.atlas_lod,
            res_x: self.res_x,
            res_y: self.res_y,
            selected: self.selected,
            dragging: self.dragging,
            orbiting: self.orbiting,
        }
        if self.sampler_mode < 2.5 {
            invalid_patch_vertex()
        } else if chart == 0 {
            deformed_raster_vertex(
                self.points_0,
                self.triangles_0,
                self.receipt_0,
                chart,
                local_vertex,
                patch,
                camera_frame(state),
                self.res_x,
                self.res_y,
            )
        } else if chart == 1 {
            deformed_raster_vertex(
                self.points_1,
                self.triangles_1,
                self.receipt_1,
                chart,
                local_vertex,
                patch,
                camera_frame(state),
                self.res_x,
                self.res_y,
            )
        } else {
            invalid_patch_vertex()
        }
    }

    fn deformed_fragment(self, varying: PatchVarying) -> i32
        uses (
            FragmentStage<PatchVarying>,
            PassActivation<PullbackPatchPipeline>,
        )
    {
        let edge_pixels = minimum3(varying.edge_seed) / varying.view_depth
        let feather = AnalyticDepthWire::feather_pixels()
        let wire_coverage = 1.0 - smoothstep(
            self.wire_px - feather, self.wire_px + feather, edge_pixels,
        )
        let surface = depth_surface_color(
            varying.parameter,
            varying.view_depth,
            varying.normal,
            varying.residual,
            self.depth_cue,
        )
        let wire = display_rgb(0.018, 0.025, 0.043)
        pack_rgba8(mix_display_rgb(surface, wire, wire_coverage))
    }

    fn handle_vertices(self, vertex_index: u32) -> RasterVertex<HandleVarying>
        uses (VertexStage<HandleVarying, TriangleList<48>>)
    {
        let handle_index = vertex_index / 6
        let weight_handle = handle_index >= 4
        let is_selected = self.selected >= 0.0 && as_f32(handle_index) == self.selected
        let state = CliffordLabState {
            p00_x: self.p00_x,
            p00_y: self.p00_y,
            p00_z: self.p00_z,
            p10_x: self.p10_x,
            p10_y: self.p10_y,
            p10_z: self.p10_z,
            p01_x: self.p01_x,
            p01_y: self.p01_y,
            p01_z: self.p01_z,
            p11_x: self.p11_x,
            p11_y: self.p11_y,
            p11_z: self.p11_z,
            w00: self.w00,
            w10: self.w10,
            w01: self.w01,
            w11: self.w11,
            orbit_yaw: self.orbit_yaw,
            orbit_pitch: self.orbit_pitch,
            orbit_distance: self.orbit_distance,
            wire_px: self.wire_px,
            depth_cue: self.depth_cue,
            sampler_mode: self.sampler_mode,
            atlas_lod: self.atlas_lod,
            res_x: self.res_x,
            res_y: self.res_y,
            selected: self.selected,
            dragging: self.dragging,
            orbiting: self.orbiting,
        }
        RasterVertex {
            position: handle_clip(
                selectable_handle_center(
                    positions(state), weights(state), camera_frame(state), handle_index,
                ),
                vertex_index % 6,
                is_selected,
                weight_handle,
            ),
            varying: HandleVarying {
                selected: if is_selected { 1.0 } else { 0.0 },
                weight: if weight_handle { 1.0 } else { 0.0 },
            },
        }
    }

    fn handle_fragment(self, varying: HandleVarying) -> u32
        uses (FragmentStage<HandleVarying>)
    {
        if varying.selected > 0.5 {
            4291983973
        } else if varying.weight > 0.5 {
            4294071641
        } else {
            4292985706
        }
    }
}
