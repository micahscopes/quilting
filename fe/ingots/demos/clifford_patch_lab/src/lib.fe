extern {
    const fn __f32_from_i32(_: i32) -> f32
}

const GRID: u32 = 56
const GRID_VERTICES: u32 = 18816
const GRID_VERTICES_PER_INSTANCE: u32 = 2352

// A bounded breadth-first quadtree turns every accepted leaf into either one
// atlas-backed quilt or four further measured quilts. Refinement remains
// dyadic. Independent atlas edge densities reconcile coarse/fine neighbors,
// so local screen-space refinement does not require globally refining the
// parameter chart.
const FRACTAL_DEPTH: usize = 6
const FRACTAL_MAX_DEPTH: u32 = FRACTAL_DEPTH.downcast_truncate()
const FRACTAL_FINE_SIDE_WORDS: usize = dyadic_patch_fine_side(FRACTAL_DEPTH)
const FRACTAL_FINE_SIDE: u32 = FRACTAL_FINE_SIDE_WORDS.downcast_truncate()
const FRACTAL_NODE_COUNT: usize = dyadic_patch_node_count(FRACTAL_DEPTH)
const FRACTAL_FACE_SLOTS: usize = dyadic_patch_face_slot_count(FRACTAL_DEPTH)
const FRACTAL_NODE_PLAN_LANES: usize = 7
const FRACTAL_NODE_PLAN_WORDS: usize = FRACTAL_NODE_COUNT * FRACTAL_NODE_PLAN_LANES
const FRACTAL_FACE_PLAN_LANES: usize = 8
const FRACTAL_FACE_PLAN_ENTRY_WORDS: usize = FRACTAL_FACE_SLOTS * FRACTAL_FACE_PLAN_LANES
const FRACTAL_FACE_PLAN_META_WORDS: usize = 3
const FRACTAL_FACE_PLAN_WORDS: usize = FRACTAL_FACE_PLAN_ENTRY_WORDS + FRACTAL_FACE_PLAN_META_WORDS
const FRACTAL_OCCUPANCY_WORDS: usize = FRACTAL_FINE_SIDE_WORDS * FRACTAL_FINE_SIDE_WORDS
const FRACTAL_EDGE_SEGMENT_WORDS: usize = 2
    * FRACTAL_FINE_SIDE_WORDS
    * (FRACTAL_FINE_SIDE_WORDS + 1)
const FRACTAL_SCAN_WORDS: usize = dyadic_patch_scan_capacity(FRACTAL_DEPTH)
const FRACTAL_OCCUPANCY_EMPTY: u32 = 0xffffffff
const FRACTAL_THREADS: usize = 64
const FRACTAL_NODE_WORKGROUPS: usize = (FRACTAL_NODE_COUNT + FRACTAL_THREADS - 1) / FRACTAL_THREADS
const FRACTAL_FACE_WORKGROUPS: usize = (FRACTAL_FACE_SLOTS + FRACTAL_THREADS - 1) / FRACTAL_THREADS
const FRACTAL_OCCUPANCY_WORKGROUPS: usize = (FRACTAL_OCCUPANCY_WORDS + FRACTAL_THREADS - 1)
    / FRACTAL_THREADS
const FRACTAL_EDGE_WORKGROUPS: usize = (FRACTAL_EDGE_SEGMENT_WORDS + FRACTAL_THREADS - 1)
    / FRACTAL_THREADS
const FRACTAL_SCAN_WORKGROUPS: usize = FRACTAL_SCAN_WORDS / FRACTAL_THREADS
const FRACTAL_SCAN_ROUNDS: usize = dyadic_patch_scan_rounds(FRACTAL_DEPTH)

const DEFORMED_CANDIDATES: usize = 272
const DEFORMED_SAMPLING_WORDS: usize = DEFORMED_CANDIDATES * SAMPLING_WORDS_PER_CANDIDATE
    + SAMPLING_PROGRESS_WORDS
const DEFORMED_BOUNDARY_POINTS: usize = 24
// Compaction must be total for every legal MIS result. This is the semantic
// maximum, not a tuned observation: every proposal may be accepted and every
// locked boundary point remains resident.
const DEFORMED_POINTS: usize = DEFORMED_CANDIDATES + DEFORMED_BOUNDARY_POINTS
const DEFORMED_POINT_WORDS: usize = DEFORMED_POINTS * 3
// Euler's disk relation with one locked triangular boundary ring.
const DEFORMED_TRIANGLES: usize = DEFORMED_POINTS * 2 - DEFORMED_BOUNDARY_POINTS - 2
const DEFORMED_TRIANGLE_WORDS: usize = DEFORMED_TRIANGLES * TRIANGLE_WORDS
const DEFORMED_TWIN_WORDS: usize = DEFORMED_TRIANGLES * TOPOLOGY_TWIN_WORDS_PER_TRIANGLE
const DEFORMED_EDGE_INDEX_WORDS: usize = DEFORMED_POINTS + DEFORMED_TWIN_WORDS
const DEFORMED_PROPOSAL_WORDS: usize = (DEFORMED_TWIN_WORDS + 31) / 32
// One chart parameter, one normalized projective representative, and the
// shared conditioning bit. Chart locality and ambient projective distance are
// complementary facts: the former prevents unrelated folded sheets from
// excluding one another, while the latter supplies the actual local metric.
const DEFORMED_SAMPLE_LANES: usize = 11
const DEFORMED_SAMPLE_SLOTS: usize = DEFORMED_CANDIDATES + DEFORMED_BOUNDARY_POINTS
const DEFORMED_SAMPLE_WORDS: usize = DEFORMED_SAMPLE_SLOTS * DEFORMED_SAMPLE_LANES
const DEFORMED_CANDIDATE_LANES: usize = 6
const DEFORMED_CANDIDATE_SLOTS: usize = DEFORMED_CANDIDATES + DEFORMED_BOUNDARY_POINTS
const DEFORMED_CANDIDATE_WORDS: usize = DEFORMED_CANDIDATE_SLOTS * DEFORMED_CANDIDATE_LANES
const DEFORMED_POINT_SAMPLE_WORDS: usize = DEFORMED_POINTS * DEFORMED_SAMPLE_LANES
const DEFORMED_THREADS: usize = 128
const DEFORMED_WORKGROUPS: usize = 3
const DEFORMED_POINT_WORKGROUPS: usize = (DEFORMED_POINTS + DEFORMED_THREADS - 1) / DEFORMED_THREADS
const DEFORMED_SAMPLING_ROUNDS: usize = 64
const DEFORMED_FLIP_LIMIT: usize = 256
const DEFORMED_IMPORTANCE_DEPTH: usize = 10
const DEFORMED_BOUNDARY_ARC_DEPTH: usize = 12
const DEFORMED_FACE_WORKGROUPS: usize = (DEFORMED_TRIANGLES + DEFORMED_THREADS - 1)
    / DEFORMED_THREADS

// This frontier isolates projective hazards over the complete square; it is
// not the final Delaunay point set. Seven anisotropic levels locate a pole to
// a screen-meaningful macro region, after which the resident atlas supplies
// up to eight further dyadic levels inside each admitted face.
const PROJECTIVE_FRONTIER_CAPACITY: usize = 2048
const PROJECTIVE_FRONTIER_WORDS: usize = PROJECTIVE_FRONTIER_CAPACITY
    * PROJECTIVE_FRONTIER_CELL_WORDS
const PROJECTIVE_FRONTIER_PLAN_WORDS: usize = PROJECTIVE_FRONTIER_CAPACITY
    * PROJECTIVE_FRONTIER_PLAN_WORDS_PER_CELL
    + PROJECTIVE_FRONTIER_PLAN_META_WORDS
const PROJECTIVE_FRONTIER_ROUNDS: usize = 16
const PROJECTIVE_FRONTIER_MAX_AXIS_DEPTH_WORDS: usize = 7
const PROJECTIVE_FRONTIER_MAX_AXIS_DEPTH: u32 =
    PROJECTIVE_FRONTIER_MAX_AXIS_DEPTH_WORDS.downcast_truncate()
const PROJECTIVE_FRONTIER_THREADS: usize = 128
const PROJECTIVE_FRONTIER_WORKGROUPS: usize =
    (PROJECTIVE_FRONTIER_CAPACITY + PROJECTIVE_FRONTIER_THREADS - 1)
        / PROJECTIVE_FRONTIER_THREADS
const PROJECTIVE_HAZARD_CELL_WORDS: usize = 4
const PROJECTIVE_HAZARD_WORDS: usize =
    PROJECTIVE_FRONTIER_CAPACITY * PROJECTIVE_HAZARD_CELL_WORDS
const PROJECTIVE_HAZARD_RECEIPT_WORDS: usize = 1

// One score per edge, followed by one compact prefix/atlas/permutation plan
// per possible macro face across the two projective charts.
const DEFORMED_FACE_SCORE_WORDS: usize = DEFORMED_TRIANGLES * 3
const DEFORMED_FACE_PLAN_LANES: usize = 3
const DEFORMED_FACE_PLAN_ENTRY_WORDS: usize = DEFORMED_TRIANGLES * 2 * DEFORMED_FACE_PLAN_LANES
// The plan owns the complete draw certificate: chart-zero macro faces, total
// macro faces, and total atlas microtriangles. Keeping these words beside the
// prefix stream lets planning and indirect-command emission remain separate,
// portable passes without a redundant raster metadata resource.
const DEFORMED_FACE_PLAN_META_WORDS: usize = 3
const DEFORMED_FACE_PLAN_WORDS: usize = DEFORMED_FACE_PLAN_ENTRY_WORDS
    + DEFORMED_FACE_PLAN_META_WORDS
const DEFORMED_BUDGET_SEARCH_STEPS: usize = 20

const DEFORMED_RECEIPT_WORDS: usize = 8

pub struct DeformedSamplingRound {}
pub struct FractalFaceScanRound {}
pub struct ProjectiveFrontierRound {}

/// Nominal identities keep the two independently produced chart commands
/// exact even though their four-word WebGPU representation is identical.
struct AnalyticAtlasDraw {}
struct DeformedAtlasDraw {}

const fn deformed_key() -> AtlasKey {
    AtlasKey { a: 3, b: 3, c: 3 }
}

static_assert(boundary_vertices(deformed_key()) == DEFORMED_BOUNDARY_POINTS.downcast_truncate())
static_assert(DEFORMED_POINT_WORKGROUPS * DEFORMED_THREADS >= DEFORMED_POINTS)
static_assert((DEFORMED_POINT_WORKGROUPS - 1) * DEFORMED_THREADS < DEFORMED_POINTS)
static_assert(DEFORMED_FACE_WORKGROUPS * DEFORMED_THREADS >= DEFORMED_TRIANGLES)
static_assert((DEFORMED_FACE_WORKGROUPS - 1) * DEFORMED_THREADS < DEFORMED_TRIANGLES)

fn deformed_seed(_ chart: u32) -> u32 {
    if chart == 0 { 0x51c32a97 } else { 0xc87a4d31 }
}

fn deformed_patch_ordinal(_ chart: u32) -> u32 {
    canonical_key_ordinal(deformed_key()) + chart
}

