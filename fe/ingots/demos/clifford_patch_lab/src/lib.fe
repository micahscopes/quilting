    fn deformed_sampling_advance(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<DEFORMED_THREADS, 1, 1>,
                CycledDispatch<
                    DeformedSamplingRound,
                    FixedDispatch<DEFORMED_WORKGROUPS, 2, 1>,
                    DEFORMED_SAMPLING_ROUNDS,
                >,
            >,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 3.5 || invocation.global.y >= 2 {
            return
        }
        if invocation.global.y == 0 {
            advance_candidate_generation<DEFORMED_CANDIDATES, DEFORMED_SAMPLING_WORDS>(
                self.sampling_workspace_0,
                invocation,
            )
        } else {
            advance_candidate_generation<DEFORMED_CANDIDATES, DEFORMED_SAMPLING_WORDS>(
                self.sampling_workspace_1,
                invocation,
            )
        }
    }

    fn deformed_sampling_compact_0(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 3.5 || invocation.global.x != 0 {
            return
        }
        let compacted = compact_candidate_points_with_boundary<
            SurfaceBoundaryPoints,
            DEFORMED_CANDIDATES,
            DEFORMED_SAMPLING_WORDS,
            DEFORMED_POINT_WORDS,
        >(
            deformed_key(),
            SurfaceBoundaryPoints { candidates: self.surface_candidates_0 },
            self.sampling_workspace_0,
            self.points_0,
        )
        self.receipt_0.store(index: 0, value: if compacted.valid { 1 } else { 0 })
        self.receipt_0.store(index: 1, value: compacted.resident_points)
        self.receipt_0.store(index: 2, value: compacted.boundary_points)
    }

    fn deformed_sampling_compact_1(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 3.5 || invocation.global.x != 0 {
            return
        }
        let compacted = compact_candidate_points_with_boundary<
            SurfaceBoundaryPoints,
            DEFORMED_CANDIDATES,
            DEFORMED_SAMPLING_WORDS,
            DEFORMED_POINT_WORDS,
        >(
            deformed_key(),
            SurfaceBoundaryPoints { candidates: self.surface_candidates_1 },
            self.sampling_workspace_1,
            self.points_1,
        )
        self.receipt_1.store(index: 0, value: if compacted.valid { 1 } else { 0 })
        self.receipt_1.store(index: 1, value: compacted.resident_points)
        self.receipt_1.store(index: 2, value: compacted.boundary_points)
    }

    fn deformed_point_samples(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<DEFORMED_THREADS, 1, 1>,
                FixedDispatch<DEFORMED_POINT_WORKGROUPS, 2, 1>,
            >,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 2.5 || invocation.global.y >= 2 {
            return
        }
        let point = invocation.global.x
        let chart = invocation.global.y
        let patch = patch_from_uniforms(
            self.p00_x, self.p00_y, self.p00_z,
            self.p10_x, self.p10_y, self.p10_z,
            self.p01_x, self.p01_y, self.p01_z,
            self.p11_x, self.p11_y, self.p11_z,
            self.w00, self.w10, self.w01, self.w11,
        )
        if chart == 0 && point < self.receipt_0.load(index: 1) {
            store_projective_sample(
                self.point_samples_0,
                point,
                fixed_projective_sample(
                    patch,
                    chart,
                    resident_point(self.points_0, point),
                ),
            )
        } else if chart == 1 && point < self.receipt_1.load(index: 1) {
            store_projective_sample(
                self.point_samples_1,
                point,
                fixed_projective_sample(
                    patch,
                    chart,
                    resident_point(self.points_1, point),
                ),
            )
        }
    }

    fn deformed_topology_construct(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 2, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 2.5 || invocation.global.y >= 2 {
            return
        }
        if invocation.global.y == 0 {
            let built = construct_constrained_triangles<
                DEFORMED_POINT_WORDS,
                DEFORMED_TRIANGLE_WORDS,
            >(
                deformed_key(),
                self.receipt_0.load(index: 0) != 0,
                self.receipt_0.load(index: 1),
                self.points_0,
                self.triangles_0,
            )
            self.receipt_0.store(index: 3, value: if built.valid { 1 } else { 0 })
            self.receipt_0.store(index: 4, value: built.resident_triangles)
            self.receipt_0.store(index: 5, value: 0)
            self.receipt_0.store(index: 6, value: 0)
            self.receipt_0.store(index: 7, value: 0)
        } else {
            let built = construct_constrained_triangles<
                DEFORMED_POINT_WORDS,
                DEFORMED_TRIANGLE_WORDS,
            >(
                deformed_key(),
                self.receipt_1.load(index: 0) != 0,
                self.receipt_1.load(index: 1),
                self.points_1,
                self.triangles_1,
            )
            self.receipt_1.store(index: 3, value: if built.valid { 1 } else { 0 })
            self.receipt_1.store(index: 4, value: built.resident_triangles)
            self.receipt_1.store(index: 5, value: 0)
            self.receipt_1.store(index: 6, value: 0)
            self.receipt_1.store(index: 7, value: 0)
        }
    }

    // Each chart is a separate pass so its seven resident storage resources
    // remain below WebGPU's portable eight-buffer per-stage limit. A runtime
    // chart branch would make both disjoint resource sets reachable at once.
    fn deformed_topology_restore_0(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 2.5 { return }
        restore_deformed_topology(
            self.point_samples_0,
            self.receipt_0,
            self.points_0,
            self.triangles_0,
            self.twins_0,
            self.edge_index_0,
            self.proposals_0,
        )
    }

    fn deformed_topology_restore_1(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 2.5 { return }
        restore_deformed_topology(
            self.point_samples_1,
            self.receipt_1,
            self.points_1,
            self.triangles_1,
            self.twins_1,
            self.edge_index_1,
            self.proposals_1,
        )
    }

    fn measure_deformed_faces_0(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<DEFORMED_THREADS, 1, 1>,
                FixedDispatch<DEFORMED_FACE_WORKGROUPS, 1, 1>,
            >,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 2.5 {
            return
        }
        let face = invocation.global.x
        let patch = patch_from_uniforms(
            self.p00_x, self.p00_y, self.p00_z,
            self.p10_x, self.p10_y, self.p10_z,
            self.p01_x, self.p01_y, self.p01_z,
            self.p11_x, self.p11_y, self.p11_z,
            self.w00, self.w10, self.w01, self.w11,
        )
        let camera = orbit_camera_frame(
            self.orbit_yaw,
            self.orbit_pitch,
            self.orbit_distance,
            self.res_x,
            self.res_y,
        )
        if face >= DEFORMED_TRIANGLES.downcast_truncate() {
            return
        }
        store_face_scores(
            self.deformed_face_scores_0,
            face,
            macro_face_scores(
                self.points_0,
                self.triangles_0,
                self.projective_hazards,
                self.projective_hazard_receipt,
                0,
                face,
                patch,
                camera,
                self.res_x,
                self.res_y,
            ),
        )
    }

    fn measure_deformed_faces_1(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<DEFORMED_THREADS, 1, 1>,
                FixedDispatch<DEFORMED_FACE_WORKGROUPS, 1, 1>,
            >,
            PassActivation<PullbackPatchTopology>,
