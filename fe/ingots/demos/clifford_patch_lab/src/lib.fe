    fn materialize_adaptive_projective_points(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 2, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode >= 2.5 && self.sampler_mode < 3.5
            && invocation.global.y < 2 {
            if invocation.global.y == 0 {
                materialize_frontier_chart_points(
                    self.projective_frontier_0,
                    self.projective_frontier_1,
                    self.projective_frontier_receipt,
                    self.points_0,
                    self.receipt_0,
                    0,
                )
            } else {
                materialize_frontier_chart_points(
                    self.projective_frontier_0,
                    self.projective_frontier_1,
                    self.projective_frontier_receipt,
                    self.points_1,
                    self.receipt_1,
                    1,
                )
            }
        }
    }

    fn deformed_candidate_samples(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<DEFORMED_THREADS, 1, 1>,
                FixedDispatch<DEFORMED_WORKGROUPS, 2, 1>,
            >,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 3.5 {
            return
        }
        let slot = invocation.global.x
        let chart = invocation.global.y
        if slot >= DEFORMED_CANDIDATES.downcast_truncate() || chart >= 2 {
            return
        }
        let patch = patch_from_uniforms(
            self.p00_x, self.p00_y, self.p00_z,
            self.p10_x, self.p10_y, self.p10_z,
            self.p01_x, self.p01_y, self.p01_z,
            self.p11_x, self.p11_y, self.p11_z,
            self.w00, self.w10, self.w01, self.w11,
        )
        let candidate = covered_surface_candidate(patch, chart, slot)
        let sample = fixed_projective_sample(patch, chart, candidate.point)
        if chart == 0 {
            store_surface_candidate(self.surface_candidates_0, candidate)
            store_projective_sample(self.candidate_samples_0, slot, sample)
        } else {
            store_surface_candidate(self.surface_candidates_1, candidate)
            store_projective_sample(self.candidate_samples_1, slot, sample)
        }
        if slot < DEFORMED_BOUNDARY_POINTS.downcast_truncate() {
            let boundary = surface_boundary_candidate(patch, chart, slot)
            let boundary_sample = fixed_projective_sample(patch, chart, boundary.point)
            if chart == 0 {
                store_surface_candidate(self.surface_candidates_0, boundary)
                store_projective_sample(
                    self.candidate_samples_0,
                    deformed_boundary_slot(slot),
                    boundary_sample,
                )
            } else {
                store_surface_candidate(self.surface_candidates_1, boundary)
                store_projective_sample(
                    self.candidate_samples_1,
                    deformed_boundary_slot(slot),
                    boundary_sample,
                )
            }
        }
    }

    fn deformed_sampling_initialize(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<DEFORMED_THREADS, 1, 1>,
                FixedDispatch<DEFORMED_WORKGROUPS, 2, 1>,
            >,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if self.sampler_mode < 3.5 || invocation.global.y >= 2 {
            return
        }
        let chart = invocation.global.y
        if chart == 0 {
            let policy = SurfaceCandidateConflict {
                samples: self.candidate_samples_0,
            }
            initialize_materialized_candidate_lane_with_policy<
                SurfaceCandidateConflict<DEFORMED_SAMPLE_WORDS>,
                DEFORMED_CANDIDATES,
                DEFORMED_SAMPLING_WORDS,
            >(
                deformed_key(),
                load_surface_candidate(self.surface_candidates_0, invocation.global.x),
                policy,
                self.sampling_workspace_0,
                invocation,
            )
        } else {
            let policy = SurfaceCandidateConflict {
                samples: self.candidate_samples_1,
            }
            initialize_materialized_candidate_lane_with_policy<
                SurfaceCandidateConflict<DEFORMED_SAMPLE_WORDS>,
                DEFORMED_CANDIDATES,
                DEFORMED_SAMPLING_WORDS,
            >(
                deformed_key(),
                load_surface_candidate(self.surface_candidates_1, invocation.global.x),
                policy,
                self.sampling_workspace_1,
                invocation,
            )
        }
    }

