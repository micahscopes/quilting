        store_face_scores(
            self.deformed_face_scores_1,
            face,
            macro_face_scores(
                self.points_1,
                self.triangles_1,
                self.projective_hazards,
                self.projective_hazard_receipt,
                1,
                face,
                patch,
                camera,
                self.res_x,
                self.res_y,
            ),
        )
    }

    fn prepare_deformed_plan(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if invocation.global.x == 0 {
            prepare_deformed_atlas_plan(
                self.deformed_face_plan,
                self.deformed_face_scores_0,
                self.deformed_face_scores_1,
                self.receipt_0,
                self.receipt_1,
                self.fixture,
                self.atlas_lod,
            )
        }
    }

    fn prepare_deformed_draw(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<PullbackPatchTopology>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        if invocation.global.x == 0 {
            prepare_deformed_indirect_draw(
                self.deformed_draw,
                self.deformed_face_plan,
            )
        }
    }

    /// Measure every CTFE-addressed quadtree node independently. An ancestor's
    /// decision affects leaf admission, never this geometric evidence pass.
    fn classify_fractal_patch_nodes(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<FRACTAL_THREADS, 1, 1>,
                FixedDispatch<FRACTAL_NODE_WORKGROUPS, 1, 1>,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
            let patch = patch_from_uniforms(
                self.p00_x, self.p00_y, self.p00_z,
                self.p10_x, self.p10_y, self.p10_z,
                self.p01_x, self.p01_y, self.p01_z,
                self.p11_x, self.p11_y, self.p11_z,
                self.w00, self.w10, self.w01, self.w11,
            )
            classify_fractal_node(
                self.fractal_node_plan,
                invocation.global.x,
                patch,
                orbit_camera_frame(
                    self.orbit_yaw,
                    self.orbit_pitch,
                    self.orbit_distance,
                    self.res_x,
                    self.res_y,
                ),
                self.res_x,
                self.res_y,
                self.atlas_lod,
            )
        }
    }

    /// Traverse at most `FRACTAL_DEPTH` stored decisions for each finest cell.
    /// Every invocation owns exactly one occupancy word.
    fn materialize_fractal_patch_occupancy(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<FRACTAL_THREADS, 1, 1>,
                FixedDispatch<FRACTAL_OCCUPANCY_WORKGROUPS, 1, 1>,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
            materialize_fractal_occupancy_lane(
                self.fractal_node_plan,
                self.fractal_occupancy,
                invocation.global.x,
            )
        }
    }

    /// Each finest-grid edge segment has one writer and reads at most its two
    /// incident leaf owners. This is a race-free shared-boundary reduction.
    fn materialize_fractal_patch_edge_segments(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<FRACTAL_THREADS, 1, 1>,
                FixedDispatch<FRACTAL_EDGE_WORKGROUPS, 1, 1>,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
            materialize_fractal_edge_segment(
                self.fractal_node_plan,
                self.fractal_occupancy,
                self.fractal_edge_segments,
                invocation.global.x,
            )
        }
    }

    /// Each admitted leaf gathers its own exact segment maxima. No invocation
    /// reads a density word written by another invocation in this pass.
    fn gather_fractal_patch_edges(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<FRACTAL_THREADS, 1, 1>,
                FixedDispatch<FRACTAL_NODE_WORKGROUPS, 1, 1>,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
            gather_fractal_leaf_edges(
                self.fractal_node_plan,
                self.fractal_edge_segments,
                invocation.global.x,
            )
        }
    }

    /// Lower active A/B/C/M leaf faces and seed a power-of-two triangle-count
    /// scan. Inactive and padded slots contribute the additive identity.
    fn initialize_fractal_patch_scan(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<FRACTAL_THREADS, 1, 1>,
                FixedDispatch<FRACTAL_SCAN_WORKGROUPS, 1, 1>,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
            initialize_fractal_face_scan_lane(
                self.fractal_node_plan,
                self.fractal_face_plan,
                self.fractal_scan_0,
                self.fractal_scan_progress,
                self.fixture,
                invocation.global.x,
            )
        }
    }

    /// One global inclusive-scan doubling step. Fe's typed cycle expands this
    /// denotation into exactly `FRACTAL_SCAN_ROUNDS` ordered dispatch pairs.
    fn advance_fractal_patch_scan(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<FRACTAL_THREADS, 1, 1>,
                CycledDispatch<
                    FractalFaceScanRound,
                    FixedDispatch<FRACTAL_SCAN_WORKGROUPS, 1, 1>,
                    FRACTAL_SCAN_ROUNDS,
                >,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
            advance_fractal_face_scan(
                self.fractal_scan_0,
                self.fractal_scan_1,
                self.fractal_scan_progress,
                invocation.global.x,
            )
        }
    }

    fn commit_fractal_patch_scan_round(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<FRACTAL_THREADS, 1, 1>,
                CycledDispatch<
                    FractalFaceScanRound,
                    FixedDispatch<FRACTAL_SCAN_WORKGROUPS, 1, 1>,
                    FRACTAL_SCAN_ROUNDS,
                >,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
            commit_fractal_face_scan_round(
                self.fractal_scan_progress,
                invocation.global.x,
            )
        }
    }

    /// Publish the final inclusive prefix and draw certificate. Fourteen scan
    /// rounds leave the result in the first ping-pong buffer by parity.
    fn finalize_fractal_patch_scan(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<
                Workgroup<FRACTAL_THREADS, 1, 1>,
                FixedDispatch<FRACTAL_FACE_WORKGROUPS, 1, 1>,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
            finalize_fractal_face_scan_lane(
                self.fractal_face_plan,
                self.fractal_scan_0,
                invocation.global.x,
            )
        }
    }

    /// Materialize only the selected canonical atlas patch. The previous
    /// direct draw invoked the largest declared vertex envelope for all eight
    /// macro triangles even when a much smaller LoD was selected.
    fn prepare_analytic_draw(self, invocation: ComputeInvocation)
        uses (
            ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>,
            PassActivation<AnalyticPatchPipeline>,
    )
    {
        if invocation.global.x == 0 {
            let mut vertices = GRID_VERTICES_PER_INSTANCE
            let mut instances: u32 = 8
            if self.sampler_mode >= 1.5 && self.sampler_mode < 2.5 {
                vertices = 3
                instances = self.fractal_face_plan.load(
                    index: fractal_face_plan_meta_offset(1),
                )
                self.analytic_lod.store(index: 0, value: 0)
            } else if self.sampler_mode >= 0.5 {
                let lod = admitted_atlas_lod(self.atlas_lod)
                vertices = atlas_triangle_count_at_lod(self.fixture, lod) * 3
                instances = 2
                self.analytic_lod.store(index: 0, value: lod)
            } else {
                self.analytic_lod.store(index: 0, value: 0)
            }
            self.analytic_draw.store(
                index: 0,
                value: vertices,
            )
            self.analytic_draw.store(index: 1, value: instances)
            self.analytic_draw.store(index: 2, value: 0)
            self.analytic_draw.store(index: 3, value: 0)
        }
    }

    const fn raster() -> RasterPlan uses (RasterConfiguration) {
        raster_plan<Depth24LessEqualMsaa4>()
    }

    const fn view() -> Surface<CliffordLabParams> {
        Surface { extent: Extent::square(768), params: lab_params() }
    }

    fn navigate(self, event: own SurfaceEvent) -> CliffordLabState
        uses (SurfaceTransition, SurfaceScheduling<LatestPerFrame>)
    {
        let mut state = CliffordLabState {
            p00_x: self.p00_x,
            p00_y: self.p00_y,
            p00_z: self.p00_z,
            p10_x: self.p10_x,
            p10_y: self.p10_y,
            p10_z: self.p10_z,
            p01_x: self.p01_x,
            p01_y: self.p01_y,
            p01_z: self.p01_z,
            p11_x: self.p11_x,
            p11_y: self.p11_y,
            p11_z: self.p11_z,
            w00: self.w00,
            w10: self.w10,
            w01: self.w01,
            w11: self.w11,
            orbit_yaw: self.orbit_yaw,
            orbit_pitch: self.orbit_pitch,
            orbit_distance: self.orbit_distance,
            wire_px: self.wire_px,
            depth_cue: self.depth_cue,
            sampler_mode: self.sampler_mode,
            atlas_lod: self.atlas_lod,
            res_x: self.res_x,
            res_y: self.res_y,
            selected: self.selected,
            dragging: self.dragging,
            orbiting: self.orbiting,
        }.apply_param_bindings(lab_params(), event)

        if event.is_pointer_down() {
            let pointer_x = event.pointer_x * 2.0 / event.width - 1.0
            let pointer_y = 1.0 - event.pointer_y * 2.0 / event.height
            state.selected = nearest_handle(
                positions(state), weights(state), camera_frame(state), pointer_x, pointer_y,
            )
            state.dragging = if state.selected >= 0.0 { 1.0 } else { 0.0 }
            state.orbiting = if state.selected < 0.0 { 1.0 } else { 0.0 }
        }

        if event.is_pointer_move() && event.buttons != 0 {
            if state.dragging > 0.5 && state.selected >= 0.0 && state.selected < 4.0 {
                let clip_dx = event.delta_x * 2.0 / event.width
                let clip_dy = event.delta_y * -2.0 / event.height
                let moved = moved_in_camera_plane(
                    selected_point(state), camera_frame(state), clip_dx, clip_dy,
                )
                state = set_handle(state, moved)
            } else if state.dragging > 0.5 && state.selected >= 4.0 {
                let value = selected_weight(state) - event.delta_y * 2.0 / event.height / 0.080
                state = set_selected_weight(state, value)
            } else if state.orbiting > 0.5 {
                state.orbit_yaw = wrap_pi(state.orbit_yaw - event.delta_x * 0.008)
                state.orbit_pitch = clamp(
                    state.orbit_pitch - event.delta_y * 0.008, -1.35, 1.35,
                )
            }
        }

        if event.is_pointer_up() {
            state.dragging = 0.0
            state.orbiting = 0.0
        }

        if event.wheel_delta != 0.0 {
            if state.selected >= 0.0 && state.selected < 4.0 {
                let direction = if event.wheel_delta < 0.0 { -1.0 } else { 1.0 }
                let moved = moved_in_depth(
                    selected_point(state), camera_frame(state),
                    direction * state.orbit_distance * 0.018,
                )
                state = set_handle(state, moved)
            } else if state.selected >= 4.0 {
                let direction = if event.wheel_delta < 0.0 { 1.0 } else { -1.0 }
                let value = selected_weight(state) + direction * 0.12
                state = set_selected_weight(state, value)
            } else if event.wheel_delta < 0.0 {
                state.orbit_distance = clamp(state.orbit_distance * 0.90, 2.5, 16.0)
            } else {
                state.orbit_distance = clamp(state.orbit_distance * 1.10, 2.5, 16.0)
            }
        }
        normalize_weight_state(state)
    }

    fn background(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        -15396337
    }

    fn patch_vertices(
        self,
        vertex_index: u32,
        instance_index: u32,
    ) -> RasterVertex<PatchVarying>
        uses (
            VertexStage<
                PatchVarying,
                IndirectTriangleList<DrawIndirectBuffer<AnalyticAtlasDraw>>,
            >,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        let state = CliffordLabState {
            p00_x: self.p00_x,
            p00_y: self.p00_y,
            p00_z: self.p00_z,
            p10_x: self.p10_x,
            p10_y: self.p10_y,
            p10_z: self.p10_z,
            p01_x: self.p01_x,
            p01_y: self.p01_y,
            p01_z: self.p01_z,
            p11_x: self.p11_x,
            p11_y: self.p11_y,
            p11_z: self.p11_z,
            w00: self.w00,
            w10: self.w10,
            w01: self.w01,
            w11: self.w11,
            orbit_yaw: self.orbit_yaw,
            orbit_pitch: self.orbit_pitch,
            orbit_distance: self.orbit_distance,
            wire_px: self.wire_px,
            depth_cue: self.depth_cue,
            sampler_mode: self.sampler_mode,
            atlas_lod: self.atlas_lod,
            res_x: self.res_x,
            res_y: self.res_y,
            selected: self.selected,
            dragging: self.dragging,
            orbiting: self.orbiting,
        }
        let patch_value = controlled_patch(positions(state), weights(state))
        let camera = camera_frame(state)
        if self.sampler_mode >= 2.5 {
            invalid_patch_vertex()
        } else if self.sampler_mode < 0.5 {
            let grid_vertex = instance_index * GRID_VERTICES_PER_INSTANCE + vertex_index
            if vertex_index >= GRID_VERTICES_PER_INSTANCE || grid_vertex >= GRID_VERTICES {
                invalid_patch_vertex()
            } else {
                let triangle_vertex = grid_vertex - grid_vertex % 3
                let parameter0 = grid_parameter(triangle_vertex)
                let parameter1 = grid_parameter(triangle_vertex + 1)
                let parameter2 = grid_parameter(triangle_vertex + 2)
                let parameter = grid_parameter(grid_vertex)
                if !parameter_triangle_conditioned(
                    patch_value, parameter0, parameter1, parameter2, policy(),
                ) {
                    invalid_patch_vertex()
                } else {
                    let differential = evaluate_differential(
                        patch_value, parameter, policy(), 0.000000000001,
                    )
                    let projected = project(camera, differential.sample.position)
                    let local_vertex = grid_vertex % 6
                    let altitude = pixel_altitude(
                        differential, projected, camera, local_vertex, self.res_x, self.res_y,
                    )
                    RasterVertex {
                        position: projected.clip,
                        varying: PatchVarying {
                            edge_seed: edge_seed(
                                local_barycentric(local_vertex), altitude, projected.depth,
                            ),
                            normal: differential.normal,
                            residual: differential.sample.trivector_residual,
                            parameter: parameter,
                            view_depth: projected.depth,
                        },
                    }
                }
            }
        } else {
            let mut chart = invalid_parameter_triangle()
            let mut patch_index: u32 = 0
            let mut permutation: u32 = 0
            let mut local_triangle: u32 = 0
            let mut available = false
            if self.sampler_mode < 1.5 {
                chart = split_parameter_triangle(instance_index)
                let lod = self.analytic_lod.load(index: 0)
                patch_index = canonical_key_ordinal(
                    AtlasKey { a: lod, b: lod, c: lod },
                )
                local_triangle = vertex_index / 3
                available = chart.valid
                    && local_triangle < patch_triangle_count(self.fixture, patch_index)
            } else {
                let face_count = self.fractal_face_plan.load(
                    index: fractal_face_plan_meta_offset(0),
                )
                let micro_triangles = self.fractal_face_plan.load(
                    index: fractal_face_plan_meta_offset(1),
                )
                if instance_index < micro_triangles {
                    let face = fractal_face_for_micro_triangle(
                        self.fractal_face_plan,
                        face_count,
                        instance_index,
                    )
                    if face < face_count {
                        let offset = fractal_face_plan_offset(face)
                        let prefix = if face == 0 {
                            0
                        } else {
                            self.fractal_face_plan.load(
                                index: fractal_face_plan_offset(face - 1),
                            )
                        }
                        chart = fractal_parameter_triangle(self.fractal_face_plan, face)
                        patch_index = self.fractal_face_plan.load(index: offset + 1)
                        permutation = self.fractal_face_plan.load(index: offset + 7)
                        local_triangle = instance_index - prefix
                        available = chart.valid
                            && (local_triangle
                                < patch_triangle_count(self.fixture, patch_index))
                    }
                }
            }
            if !available {
                invalid_patch_vertex()
            } else {
                let corner = vertex_index % 3
                let source_triangle = patch_first_triangle(self.fixture, patch_index) + local_triangle
                let point0 = fixture_triangle_index(self.fixture, source_triangle, 0)
                let point1 = fixture_triangle_index(self.fixture, source_triangle, 1)
                let point2 = fixture_triangle_index(self.fixture, source_triangle, 2)
                let parameter0 = map_macro_parameter(
                    chart,
                    remap_barycentric(
                        permutation,
                        fixture_barycentric(self.fixture, point0),
                    ),
                )
                let parameter1 = map_macro_parameter(
                    chart,
                    remap_barycentric(
                        permutation,
                        fixture_barycentric(self.fixture, point1),
                    ),
                )
                let parameter2 = map_macro_parameter(
                    chart,
                    remap_barycentric(
                        permutation,
                        fixture_barycentric(self.fixture, point2),
                    ),
                )
                if !parameter_triangle_conditioned(
                    patch_value, parameter0, parameter1, parameter2, policy(),
                ) {
                    invalid_patch_vertex()
                } else {
                    let parameter = if corner == 0 {
                        parameter0
                    } else if corner == 1 {
                        parameter1
                    } else {
                        parameter2
                    }
                    let differential = evaluate_differential(
                        patch_value, parameter, policy(), 0.000000000001,
                    )
                    let projected = project(camera, differential.sample.position)
                    let altitude = atlas_pixel_altitude(
                        differential,
                        projected,
                        camera,
                        parameter0,
                        parameter1,
                        parameter2,
                        corner,
                        self.res_x,
                        self.res_y,
                    )
                    RasterVertex {
                        position: projected.clip,
                        varying: PatchVarying {
                            edge_seed: edge_seed(
                                local_barycentric(corner), altitude, projected.depth,
                            ),
                            normal: differential.normal,
                            residual: differential.sample.trivector_residual,
                            parameter: parameter,
                            view_depth: projected.depth,
                        },
                    }
                }
            }
        }
    }

    fn patch_fragment(self, varying: PatchVarying) -> i32
        uses (
            FragmentStage<PatchVarying>,
            PassActivation<AnalyticPatchPipeline>,
        )
    {
        shade_patch(varying, self.wire_px, self.depth_cue)
    }

    fn deformed_vertices(
        self,
        vertex_index: u32,
        instance_index: u32,
    ) -> RasterVertex<PatchVarying>
        uses (
            VertexStage<
                PatchVarying,
                IndirectTriangleList<DrawIndirectBuffer<DeformedAtlasDraw>>,
            >,
            PassActivation<PullbackPatchPipeline>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        let patch = patch_from_uniforms(
            self.p00_x, self.p00_y, self.p00_z,
            self.p10_x, self.p10_y, self.p10_z,
            self.p01_x, self.p01_y, self.p01_z,
            self.p11_x, self.p11_y, self.p11_z,
            self.w00, self.w10, self.w01, self.w11,
        )
        let macro_triangles_0 = self.deformed_face_plan.load(
            index: face_plan_meta_offset(0),
        )
        let macro_triangles = self.deformed_face_plan.load(
            index: face_plan_meta_offset(1),
        )
        let micro_triangles = self.deformed_face_plan.load(
            index: face_plan_meta_offset(2),
        )
        let plan_face = face_for_micro_triangle(
            self.deformed_face_plan,
            macro_triangles,
            instance_index,
        )
        if self.sampler_mode < 2.5
            || instance_index >= micro_triangles
            || plan_face >= macro_triangles {
            invalid_patch_vertex()
        } else if plan_face < macro_triangles_0 {
            deformed_atlas_raster_vertex(
                self.points_0,
                self.triangles_0,
                self.fixture,
                self.deformed_face_plan,
                0,
                plan_face,
                plan_face,
                vertex_index,
                instance_index,
                macro_triangles_0,
                patch,
                orbit_camera_frame(
                    self.orbit_yaw,
                    self.orbit_pitch,
                    self.orbit_distance,
                    self.res_x,
                    self.res_y,
                ),
                self.res_x,
                self.res_y,
            )
        } else {
            deformed_atlas_raster_vertex(
                self.points_1,
                self.triangles_1,
                self.fixture,
                self.deformed_face_plan,
                1,
                plan_face,
                plan_face - macro_triangles_0,
                vertex_index,
                instance_index,
                macro_triangles - macro_triangles_0,
                patch,
                orbit_camera_frame(
                    self.orbit_yaw,
                    self.orbit_pitch,
                    self.orbit_distance,
                    self.res_x,
                    self.res_y,
                ),
                self.res_x,
                self.res_y,
            )
        }
    }

    fn deformed_fragment(self, varying: PatchVarying) -> i32
        uses (
            FragmentStage<PatchVarying>,
            PassActivation<PullbackPatchPipeline>,
            PassPreparation<PullbackPipelinePreparation>,
        )
    {
        shade_patch(varying, self.wire_px, self.depth_cue)
    }

    fn handle_vertices(self, vertex_index: u32) -> RasterVertex<HandleVarying>
        uses (VertexStage<HandleVarying, TriangleList<48>>)
    {
        let handle_index = vertex_index / 6
        let weight_handle = handle_index >= 4
        let is_selected = self.selected >= 0.0 && as_f32(handle_index) == self.selected
        let state = CliffordLabState {
            p00_x: self.p00_x,
            p00_y: self.p00_y,
            p00_z: self.p00_z,
            p10_x: self.p10_x,
            p10_y: self.p10_y,
            p10_z: self.p10_z,
            p01_x: self.p01_x,
            p01_y: self.p01_y,
            p01_z: self.p01_z,
            p11_x: self.p11_x,
            p11_y: self.p11_y,
            p11_z: self.p11_z,
            w00: self.w00,
            w10: self.w10,
            w01: self.w01,
            w11: self.w11,
            orbit_yaw: self.orbit_yaw,
            orbit_pitch: self.orbit_pitch,
            orbit_distance: self.orbit_distance,
            wire_px: self.wire_px,
            depth_cue: self.depth_cue,
            sampler_mode: self.sampler_mode,
            atlas_lod: self.atlas_lod,
            res_x: self.res_x,
            res_y: self.res_y,
            selected: self.selected,
            dragging: self.dragging,
            orbiting: self.orbiting,
        }
        RasterVertex {
            position: handle_clip(
                selectable_handle_center(
                    positions(state), weights(state), camera_frame(state), handle_index,
                ),
                vertex_index % 6,
                is_selected,
                weight_handle,
            ),
            varying: HandleVarying {
                selected: if is_selected { 1.0 } else { 0.0 },
                weight: if weight_handle { 1.0 } else { 0.0 },
            },
        }
    }

    fn handle_fragment(self, varying: HandleVarying) -> u32
        uses (FragmentStage<HandleVarying>)
    {
        if varying.selected > 0.5 {
            4291983973
        } else if varying.weight > 0.5 {
            4294071641
        } else {
            4292985706
        }
    }
}
