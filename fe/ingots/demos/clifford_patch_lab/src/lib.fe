struct SurfaceCandidateConflict<const WORDS: usize> {
    samples: StorageBuffer<f32, WORDS>,
    patch: IsotropicBilinearPatch,
    chart: u32,
}
impl<const WORDS: usize> Copy for SurfaceCandidateConflict<WORDS> {}

struct SurfaceInteriorEdgeFlip<const WORDS: usize> { samples: StorageBuffer<f32, WORDS> }
impl<const WORDS: usize> Copy for SurfaceInteriorEdgeFlip<WORDS> {}

fn fixed_parameter(_ chart: u32, _ point: FixedBarycentric) -> Vec2F {
    let scale = as_f32(BARYCENTRIC_SCALE)
    map_macro_parameter(
        split_parameter_triangle(chart),
        bary3f(
            as_f32(point.a) / scale,
            as_f32(point.b) / scale,
            as_f32(point.c) / scale,
        ),
    )
}

fn patch_pullback_sample(_ patch: IsotropicBilinearPatch, _ parameter: Vec2F) -> PullbackSample2 {
    let differential = evaluate_differential(patch, parameter, policy(), 0.000000000001)
    let raw = euclidean3_pullback_metric(differential.tangent_s, differential.tangent_t)
    pullback_sample2(
        parameter,
        pullback_metric2(
            raw.uu,
            raw.uv,
            raw.vv,
            differential.sample.conditioned && differential.sample.vector_valued,
        ),
    )
}

fn fixed_pullback_sample(
    _ patch: IsotropicBilinearPatch,
    _ chart: u32,
    _ point: FixedBarycentric,
) -> PullbackSample2 {
    patch_pullback_sample(patch, fixed_parameter(chart, point))
}

fn sample_offset(_ ordinal: u32) -> u32 {
    ordinal * DEFORMED_SAMPLE_LANES.downcast_truncate()
}

fn store_pullback_sample<const WORDS: usize>(
    _ samples: StorageBuffer<f32, WORDS>,
    _ ordinal: u32,
    _ sample: PullbackSample2,
) {
    let offset = sample_offset(ordinal)
    samples.store(index: offset, value: sample.parameter.x)
    samples.store(index: offset + 1, value: sample.parameter.y)
    samples.store(index: offset + 2, value: sample.metric.uu)
    samples.store(index: offset + 3, value: sample.metric.uv)
    samples.store(index: offset + 4, value: sample.metric.vv)
    samples.store(
            index: offset + 5,
            value: if sample.metric.defined { 1.0 } else { 0.0 },
        )
}

fn load_pullback_sample<const WORDS: usize>(
    _ samples: StorageBuffer<f32, WORDS>,
    _ ordinal: u32,
) -> PullbackSample2 {
    let offset = sample_offset(ordinal)
    pullback_sample2(
        vec2f(
            samples.load(index: offset),
            samples.load(index: offset + 1),
        ),
        pullback_metric2(
            samples.load(index: offset + 2),
            samples.load(index: offset + 3),
            samples.load(index: offset + 4),
            samples.load(index: offset + 5) > 0.5,
        ),
    )
}

impl<const WORDS: usize> CandidateConflictPolicy for SurfaceCandidateConflict<WORDS> {
    fn conflicts_boundary(self, _ key: AtlasKey, _ candidate: InteriorCandidate) -> bool {
        let candidate_sample = load_pullback_sample(self.samples, candidate.slot)
        let mut conflict = !candidate.valid || !candidate_sample.metric.defined
        let mut ordinal: u32 = 0
        let count = boundary_vertices(key)
        while ordinal < count {
            let boundary = boundary_seed(key, ordinal)
            if boundary.valid
                && pullback_poisson_conflict(
                    candidate_sample,
                    DEFORMED_RADIUS_SQUARED,
                    fixed_pullback_sample(self.patch, self.chart, boundary.point),
                    DEFORMED_RADIUS_SQUARED,
                ) {
                conflict = true
            }
            ordinal = ordinal + 1
        }
        conflict
    }

    fn conflicts(self, _ left: InteriorCandidate, _ right: InteriorCandidate) -> bool {
        pullback_poisson_conflict(
            load_pullback_sample(self.samples, left.slot),
            DEFORMED_RADIUS_SQUARED,
            load_pullback_sample(self.samples, right.slot),
            DEFORMED_RADIUS_SQUARED,
        )
    }
}

impl<const WORDS: usize> InteriorEdgeFlipPolicy for SurfaceInteriorEdgeFlip<WORDS> {
    fn decision(
        self,
        _ u_id: u32,
        _ u: FixedBarycentric,
        _ v_id: u32,
        _ v: FixedBarycentric,
        _ first_opposite_id: u32,
        _ first_opposite: FixedBarycentric,
        _ second_opposite_id: u32,
        _ second_opposite: FixedBarycentric,
    ) -> FlipDecision {
        let chart_decision = interior_edge_flip_decision(
            u_id,
            u,
            v_id,
            v,
            first_opposite_id,
            first_opposite,
            second_opposite_id,
            second_opposite,
        )
        if !chart_decision.convex {
            return chart_decision
        }
        let value = varying_pullback_incircle_value(
            load_pullback_sample(self.samples, u_id),
            load_pullback_sample(self.samples, v_id),
            load_pullback_sample(self.samples, first_opposite_id),
            load_pullback_sample(self.samples, second_opposite_id),
        )
        let sign: i32 = if value > 0.0000001 {
            1
        } else if value < -0.0000001 { -1 } else { 0 }
        FlipDecision {
            incircle: sign,
            convex: true,
            flip: should_flip_edge(u_id, v_id, first_opposite_id, second_opposite_id, sign),
        }
    }
}

fn restore_deformed_topology(
    _ samples: StorageBuffer<f32, DEFORMED_POINT_SAMPLE_WORDS>,
    _ receipt: StorageBuffer<u32, DEFORMED_RECEIPT_WORDS>,
    _ points: StorageBuffer<u32, DEFORMED_POINT_WORDS>,
    _ triangles: StorageBuffer<u32, DEFORMED_TRIANGLE_WORDS>,
    _ twins: StorageBuffer<u32, DEFORMED_TWIN_WORDS>,
) {
    let policy = SurfaceInteriorEdgeFlip { samples: samples }
    let restored = restore_indexed_constrained_delaunay_with_policy<
        SurfaceInteriorEdgeFlip<DEFORMED_POINT_SAMPLE_WORDS>,
        DEFORMED_POINT_WORDS,
        DEFORMED_TRIANGLE_WORDS,
        DEFORMED_TWIN_WORDS,
        DEFORMED_FLIP_LIMIT,
    >(
        deformed_key(),
        policy,
        receipt.load(index: 3) != 0,
        receipt.load(index: 1),
        receipt.load(index: 4),
        points,
        triangles,
        twins,
    )
    receipt.store(index: 5, value: if restored.valid { 1 } else { 0 })
    receipt.store(index: 6, value: restored.flips)
}

