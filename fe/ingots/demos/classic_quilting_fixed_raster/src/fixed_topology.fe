/// Triangle-local barycentrics for a non-indexed triangle-list stream.
pub fn local_barycentric(_ vertex_index: u32) -> Bary3F {
    let corner = vertex_index % 3
    if corner == 0 {
        bary3f(1.0, 0.0, 0.0)
    } else if corner == 1 {
        bary3f(0.0, 1.0, 0.0)
    } else {
        bary3f(0.0, 0.0, 1.0)
    }
}
