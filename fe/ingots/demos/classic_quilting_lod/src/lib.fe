//! Pointer-reactive LoD over Quilting's complete LoD 0--8 atlas.
//!
//! Pointer position is interpreted in Fe as a bipolar radial field. The
//! centroid is a dense isotropic pole, the reference triangle's incircle is a
//! low-density valley, and its circumcircle is a dense directional pole. At
//! the outer pole, angle smoothly allocates density to one edge along an edge
//! normal or to two adjacent edges toward a corner. Each continuous demand
//! becomes a dyadic exponent in 0--8; the shared atlas contract canonicalizes
//! the triple and retains its exact, tie-stable S3 permutation. The browser reports
//! pointer facts and realizes WebGPU resources; it owns neither LoD policy nor
//! topology.

use core::marker::Copy
use std::web::view::{
    ApplyParamBindings,
    Extent,
    Param,
    ParamBindingsProvider,
    Surface,
    SurfaceEvent,
    SurfaceState,
}
use quilting_atlas::{
    AtlasKey,
    MAX_LOD,
    canonical_key_ordinal,
    canonicalize,
    edge_permutation_index,
    lod_as_f32,
}
use quilting_domain::{
    Bary3F,
    Vec3F,
    bary3f,
    bary_to_cartesian,
    cartesian_to_bary,
    length2,
    vec2f,
    vec3f,
}
use quilting_quaternion::quatf
use quilting_qb::{
    QbTriPatch,
    apply_normal_parity,
    control,
    evaluate_differential,
    patch,
    remap_barycentric,
}
use std::webgpu::{
    ClipPosition,
    ContentAddressed,
    FragmentStage,
    FragmentSurface,
    GpuProgram,
    ImmutableStorageBuffer,
    LatestPerFrame,
    RasterVertex,
    ResponsiveBacking,
    StandardSurfaceRecovery,
    SurfaceQuality,
    SurfacePointerMotion,
    SurfaceRecovery,
    SurfaceScheduling,
    SurfaceTransition,
    TriangleList,
    VertexStage,
    WebGpuBackend,
}

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

pub const FIXTURE_PATCH_COUNT: u32 = 165
pub const FIXTURE_POINT_COUNT: u32 = 527523
pub const FIXTURE_TRIANGLE_COUNT: u32 = 1026611
pub const MAX_PATCH_TRIANGLE_COUNT: usize = 106600
pub const MAX_PATCH_VERTEX_COUNT: usize = MAX_PATCH_TRIANGLE_COUNT * 3
pub const FIXTURE_WORD_COUNT: usize = 6217888
pub const FIXTURE_BYTES: u32 = 24871552

const PATCH_BASE_WORD: u32 = 32
const PATCH_STRIDE_WORDS: u32 = 8
const VERTEX_STRIDE_WORDS: u32 = 4
const TRIANGLE_STRIDE_WORDS: u32 = 4
const VERTEX_BASE_WORD: u32 = PATCH_BASE_WORD + FIXTURE_PATCH_COUNT * PATCH_STRIDE_WORDS
const TRIANGLE_BASE_WORD: u32 = VERTEX_BASE_WORD + FIXTURE_POINT_COUNT * VERTEX_STRIDE_WORDS
const PATCH_SCALE: f32 = 0.72
const RADIAL_VALLEY: f32 = 0.5
const CENTROID_LANE: f32 = 0.33333334

pub type FixtureIdentity = ContentAddressed<
    0x695152ac,
    0xd242f5b8,
    0x8a6ac407,
    0x4f6855fe,
    0xa35b12bf,
    0x16436308,
    0xba925b8c,
    0xc962803e,
>

pub type FixtureBuffer = ImmutableStorageBuffer<FixtureIdentity, FIXTURE_WORD_COUNT, u32>

pub struct PatchVarying { pub edge: Bary3F, pub normal: Vec3F, pub band: f32 }
impl Copy for PatchVarying {}

pub struct FocusVarying { pub band: f32 }
impl Copy for FocusVarying {}

struct AtlasLodParams {
    pointer_x: Param,
    pointer_y: Param,
    band: Param,
    res: Param,
    atlas_depth: Param,
}

struct AtlasLodState {
    pointer_x: f32,
    pointer_y: f32,
    band: f32,
    res: f32,
    atlas_depth: f32,
}

impl SurfaceState for AtlasLodState {
    type Params = AtlasLodParams
}

derive ApplyParamBindings for AtlasLodState using ParamBindingsProvider

const fn atlas_lod_params() -> AtlasLodParams {
    AtlasLodParams {
        pointer_x: Param::fixed(0.0),
        pointer_y: Param::fixed(0.0),
        band: Param::fixed(0.0),
        res: Param::extent_x(),
        // Pointer radius and angle span a two-dimensional slice through the
        // three edge demands. This uniform offset is the missing third degree
        // of freedom: wheel up/down traverses every canonical atlas key.
        atlas_depth: Param::range(min: -1.0, max: 1.0, init: 0.0).wheel(per_notch: -0.0625),
    }
}

pub fn fixture_receipt() -> (u32, u32, u32, u32) {
    (FIXTURE_PATCH_COUNT, FIXTURE_POINT_COUNT, FIXTURE_TRIANGLE_COUNT, FIXTURE_BYTES)
}

fn word_as_f32(_ word: u32) -> f32 {
    __bitcast(word)
}

fn patch_word(_ fixture: FixtureBuffer, _ patch_index: u32, _ lane: u32) -> u32 {
    fixture.load(
            index: PATCH_BASE_WORD + patch_index * PATCH_STRIDE_WORDS + lane,
        )
}

pub fn patch_first_vertex(_ fixture: FixtureBuffer, _ patch_index: u32) -> u32 {
    patch_word(fixture, patch_index, 3)
}

pub fn patch_first_triangle(_ fixture: FixtureBuffer, _ patch_index: u32) -> u32 {
    patch_word(fixture, patch_index, 5)
}

pub fn patch_triangle_count(_ fixture: FixtureBuffer, _ patch_index: u32) -> u32 {
    patch_word(fixture, patch_index, 6)
}

pub fn fixture_barycentric(_ fixture: FixtureBuffer, _ point_index: u32) -> Bary3F {
    let base = VERTEX_BASE_WORD + point_index * VERTEX_STRIDE_WORDS
    bary3f(
        word_as_f32(fixture.load(index: base)),
        word_as_f32(fixture.load(index: base + 1)),
        word_as_f32(fixture.load(index: base + 2)),
    )
}

pub fn fixture_triangle_index(
    _ fixture: FixtureBuffer,
    _ triangle_index: u32,
    _ corner: u32,
) -> u32 {
    fixture.load(
            index: TRIANGLE_BASE_WORD + triangle_index * TRIANGLE_STRIDE_WORDS + corner,
        )
}

fn local_corner(_ corner: u32) -> Bary3F {
    if corner == 0 {
        bary3f(1.0, 0.0, 0.0)
    } else if corner == 1 {
        bary3f(0.0, 1.0, 0.0)
    } else {
        bary3f(0.0, 0.0, 1.0)
    }
}

fn minimum3(_ value: Bary3F) -> f32 {
    let mut result = value.a
    if value.b < result {
        result = value.b
    }
    if value.c < result {
        result = value.c
    }
    result
}

fn maximum3(_ value: Bary3F) -> f32 {
    let mut result = value.a
    if value.b > result {
        result = value.b
    }
    if value.c > result {
        result = value.c
    }
    result
}

fn diagnostic_wire_width(_ band: f32) -> f32 {
    // Barycentric width is relative to each resident cell. Denser slices need
    // a larger fraction to remain visible at this deliberately small teaching
    // surface; this is a diagnostic overlay, not production antialiasing.
    if band < 1.0 {
        0.018
    } else if band < 3.0 {
        0.026
    } else if band < 6.0 { 0.034 } else { 0.042 }
}

fn clamp_unit(_ value: f32) -> f32 {
    if value < 0.0 { 0.0 } else if value > 1.0 { 1.0 } else { value }
}

fn smooth_unit(_ value: f32) -> f32 {
    let admitted = clamp_unit(value)
    admitted * admitted * admitted * (
        admitted * (admitted * 6.0 - 15.0) + 10.0
    )
}

fn positive(_ value: f32) -> f32 {
    if value > 0.0 { value } else { 0.0 }
}

fn radial_distance(_ clip_x: f32, _ clip_y: f32) -> f32 {
    length2(vec2f(clip_x / PATCH_SCALE, clip_y / PATCH_SCALE))
}

/// One at either radial pole and zero on the reference incircle between them.
fn radial_pole_strength(_ radius: f32) -> f32 {
    if radius < RADIAL_VALLEY {
        return smooth_unit((RADIAL_VALLEY - radius) / RADIAL_VALLEY)
    }
    smooth_unit((radius - RADIAL_VALLEY) / (1.0 - RADIAL_VALLEY))
}

fn angular_edge_weight(_ lane: f32, _ maximum: f32) -> f32 {
    if maximum <= 0.000001 { return 0.0 }
    positive(CENTROID_LANE - lane) / maximum
}

fn lod_demands(_ clip_x: f32, _ clip_y: f32, _ atlas_depth: f32) -> Bary3F {
    let radius = radial_distance(clip_x, clip_y)
    let focus = focus_from_clip(clip_x, clip_y)
    let raw = bary3f(
        positive(CENTROID_LANE - focus.a),
        positive(CENTROID_LANE - focus.b),
        positive(CENTROID_LANE - focus.c),
    )
    let angular_maximum = maximum3(raw)
    let pole = radial_pole_strength(radius)
    // At the inner pole every lane participates equally. Directionality grows
    // with radius until the outer pole is purely edge/corner allocated.
    let angular_mix = smooth_unit(radius)
    let isotropic = 1.0 - angular_mix
    bary3f(
        clamp_unit(
            pole * (isotropic + angular_mix * angular_edge_weight(focus.a, angular_maximum))
                + atlas_depth,
        ),
        clamp_unit(
            pole * (isotropic + angular_mix * angular_edge_weight(focus.b, angular_maximum))
                + atlas_depth,
        ),
        clamp_unit(
            pole * (isotropic + angular_mix * angular_edge_weight(focus.c, angular_maximum))
                + atlas_depth,
        ),
    )
}

fn quantized_lod(_ demand: f32) -> u32 {
    let step = 1.0 / lod_as_f32(MAX_LOD)
    let mut threshold = step * 0.5
    let mut lod: u32 = 0
    while lod < MAX_LOD {
        if demand < threshold { return lod }
        lod = lod + 1
        threshold = threshold + step
    }
    MAX_LOD
}

fn requested_key(_ demands: Bary3F) -> AtlasKey {
    AtlasKey {
        a: quantized_lod(demands.a),
        b: quantized_lod(demands.b),
        c: quantized_lod(demands.c),
    }
}

fn continuous_band(_ demands: Bary3F) -> f32 {
    maximum3(demands) * lod_as_f32(MAX_LOD)
}

fn reference_clip(_ bary: Bary3F, _ z: f32) -> ClipPosition {
    let point = bary_to_cartesian(bary)
    ClipPosition { x: point.x * PATCH_SCALE, y: point.y * PATCH_SCALE, z: z, w: 1.0 }
}

fn focus_from_clip(_ clip_x: f32, _ clip_y: f32) -> Bary3F {
    cartesian_to_bary(vec2f(clip_x / PATCH_SCALE, clip_y / PATCH_SCALE))
}

fn curved_patch() -> QbTriPatch {
    patch(
        control(vec3f(-0.75, -0.25, 0.1), quatf(1.0, 0.2, -0.1, 0.05)),
        control(vec3f(0.8, -0.15, -0.2), quatf(0.9, -0.15, 0.25, 0.1)),
        control(vec3f(0.05, 0.9, 0.35), quatf(1.1, 0.1, 0.05, -0.2)),
    )
}

fn focus_marker_clip(_ pointer_x: f32, _ pointer_y: f32, _ corner: u32) -> ClipPosition {
    let radius: f32 = 0.018
    let mut dx: f32 = 0.0 - radius
    let mut dy: f32 = 0.0 - radius
    if corner == 1 || corner == 4 || corner == 5 {
        dx = radius
    }
    if corner == 2 || corner == 3 || corner == 5 {
        dy = radius
    }
    ClipPosition { x: pointer_x + dx, y: pointer_y + dy, z: 0.0, w: 1.0 }
}

actor ClassicQuiltingLod uses (
    GpuProgram<WebGpuBackend>,
    SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
    SurfacePointerMotion,
) {
    fixture: FixtureBuffer,
    pointer_x: f32,
    pointer_y: f32,
    band: f32,
    res: f32,
    atlas_depth: f32,

    const fn view() -> Surface<AtlasLodParams> {
        Surface { extent: Extent::square(768), params: atlas_lod_params() }
    }

    fn navigate(self, event: own SurfaceEvent) -> AtlasLodState
        uses (SurfaceTransition, SurfaceScheduling<LatestPerFrame>)
    {
        let driven = AtlasLodState {
            pointer_x: self.pointer_x,
            pointer_y: self.pointer_y,
            band: self.band,
            res: self.res,
            atlas_depth: self.atlas_depth,
        }.apply_param_bindings(atlas_lod_params(), event)
        let mut pointer_x = driven.pointer_x
        let mut pointer_y = driven.pointer_y
        if event.is_pointer_move() {
            pointer_x = event.pointer_x * 2.0 / event.width - 1.0
            pointer_y = 1.0 - event.pointer_y * 2.0 / event.height
        }
        AtlasLodState {
            pointer_x: pointer_x,
            pointer_y: pointer_y,
            band: continuous_band(lod_demands(pointer_x, pointer_y, driven.atlas_depth)),
            res: driven.res,
            atlas_depth: driven.atlas_depth,
        }
    }

    fn background(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        -15396337
    }

    fn patch_vertices(self, vertex_index: u32) -> RasterVertex<PatchVarying>
        uses (VertexStage<PatchVarying, TriangleList<MAX_PATCH_VERTEX_COUNT>>)
    {
        let triangle_index = vertex_index / 3
        let corner = vertex_index % 3
        let canonical = canonicalize(requested_key(lod_demands(
            self.pointer_x,
            self.pointer_y,
            self.atlas_depth,
        )))
        let patch_index = canonical_key_ordinal(canonical.key)
        let permutation = edge_permutation_index(canonical.permutation)
        let triangle_count = patch_triangle_count(self.fixture, patch_index)
        let mut point_index = patch_first_vertex(self.fixture, patch_index)
        if triangle_index < triangle_count {
            point_index = fixture_triangle_index(
                self.fixture,
                patch_first_triangle(self.fixture, patch_index) + triangle_index,
                corner,
            )
        }
        let bary = remap_barycentric(
            permutation,
            fixture_barycentric(self.fixture, point_index),
        )
        let differential = evaluate_differential(
            curved_patch(), bary, 0.00000000000000000001, 0.000000000001,
        )
        RasterVertex {
            // WebGPU's clip-depth interval is [0, w]. Keep the QB relief
            // centred inside it; raw signed surface z would clip half the
            // patch even though its x/y projection is entirely visible.
            position: reference_clip(bary, 0.5 + differential.sample.position.z * 0.05),
            varying: PatchVarying {
                edge: local_corner(corner),
                normal: apply_normal_parity(differential.normal, permutation),
                band: self.band,
            },
        }
    }

    fn patch_fragment(self, varying: PatchVarying) -> u32
        uses (FragmentStage<PatchVarying>)
    {
        if minimum3(varying.edge) < diagnostic_wire_width(varying.band) {
            4281543976
        } else if varying.band < 0.5 {
            4282004265
        } else if varying.band < 1.5 {
            4284895976
        } else if varying.band < 2.5 {
            4287210615
        } else {
            4292985706
        }
    }

    fn focus_vertices(self, vertex_index: u32) -> RasterVertex<FocusVarying>
        uses (VertexStage<FocusVarying, TriangleList<6>>)
    {
        RasterVertex {
            position: focus_marker_clip(self.pointer_x, self.pointer_y, vertex_index),
            varying: FocusVarying { band: self.band },
        }
    }

    fn focus_fragment(self, varying: FocusVarying) -> u32
        uses (FragmentStage<FocusVarying>)
    {
        if varying.band < 4.0 { 4292985706 } else { 4291983973 }
    }
}
