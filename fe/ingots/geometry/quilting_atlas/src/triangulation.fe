//! Exact, backend-portable predicates for constrained Delaunay topology.
//!
//! WebGPU does not expose 64-bit integers portably. The incircle determinant
//! nevertheless needs about 60 signed bits for Q14 barycentrics. This module
//! evaluates only that determinant in a two-word sign-magnitude accumulator;
//! every leaf product remains an exact portable 32-bit operation. Worker and
//! GPU providers therefore make identical flip decisions without floats.

use super::sampling::FixedBarycentric

use super::planar::{
    FixedPoint2,
    EquilateralMetric,
    orientation as planar_orientation,
    incircle_sign as planar_incircle_sign,
}

fn point(_ p: FixedBarycentric) -> FixedPoint2 {
    FixedPoint2 { x: p.b, y: p.c }
}

/// Triangle-compatible entry points retained for existing topology providers.
pub fn orientation(_ a: FixedBarycentric, _ b: FixedBarycentric, _ c: FixedBarycentric) -> i32 {
    planar_orientation(point(a), point(b), point(c))
}
pub fn incircle_sign(
    _ a: FixedBarycentric,
    _ b: FixedBarycentric,
    _ c: FixedBarycentric,
    _ d: FixedBarycentric,
) -> i32 {
    planar_incircle_sign(
        point(a),
        point(b),
        point(c),
        point(d),
        EquilateralMetric {},
    )
}

fn ordered_edge_precedes(
    _ left_first: u32,
    _ left_second: u32,
    _ right_first: u32,
    _ right_second: u32,
) -> bool {
    let left_low = if left_first < left_second {
        left_first
    } else {
        left_second
    }
    let left_high = if left_first < left_second {
        left_second
    } else {
        left_first
    }
    let right_low = if right_first < right_second {
        right_first
    } else {
        right_second
    }
    let right_high = if right_first < right_second {
        right_second
    } else {
        right_first
    }
    left_low < right_low || (left_low == right_low && left_high < right_high)
}

/// Decide one legal interior-edge flip. For an exact cocircular tie, topology
/// monotonically moves toward the lexicographically smaller undirected
/// diagonal, preventing provider-order oscillation.
pub fn should_flip_edge(
    _ current_first: u32,
    _ current_second: u32,
    _ proposed_first: u32,
    _ proposed_second: u32,
    _ normalized_incircle_sign: i32,
) -> bool {
    if normalized_incircle_sign > 0 {
        true
    } else if normalized_incircle_sign < 0 {
        false
    } else {
        ordered_edge_precedes(
            proposed_first,
            proposed_second,
            current_first,
            current_second,
        )
    }
}
