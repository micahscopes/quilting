//! Sparse Clifford-Bezier patch denotation for isotropic three-space.
//!
//! The first family follows Krasauskas, Zube, and Cacciola's bilinear patch
//! in Cl(2, 0, 1):
//!
//!     P(s, t) = F(s, t) W(s, t)^-1
//!
//! where points are grade-one vectors and weights belong to the even
//! subalgebra. The sparse Clifford expressions below are type data consumed by
//! Fe's FCO compiler. Runtime Wasm and shader code contain only the resulting
//! straight-line scalar arithmetic: no blade arrays, masks, loops, or AST.
//!
//! This isotropic algebra is intentionally not called standard conformal GA.
//! A future CGA authoring layer is a separate peer over Cl(4, 1).

use core::marker::Copy
use fmath::sqrt
use ga_expr::{
    CompileGaF32,
    EvaluateGaF32,
    GaProgram,
    Geometric,
    MultivectorInput,
    Reverse,
    ScalarProduct,
    SignedOrthogonalMetric,
    Strict,
}
use quilting_domain::{Vec2F, Vec3F, absf, cross3, normalize3_or, vec3f}
use quilting_patch::{
    BilinearBernstein,
    BilinearProjectiveControls,
    DenotationSample,
    Euclidean3Points,
    Patch,
    PatchKernel,
    LinearElement,
    ProjectiveAdmission,
    ProjectiveAlgebra,
    ProjectiveKernel,
    QuotientSample,
    UnitSquare,
    bilinear_projective_controls,
    denotation_sample,
    patch as typed_patch,
    projective_control,
    projective_patch,
    pullback_metric2,
    PullbackMetric2,
}

/// A weight in Cl(2, 0, 1)'s even subalgebra E0 + E2.
pub struct IsotropicEvenF { pub scalar: f32, pub e12: f32, pub e13: f32, pub e23: f32 }
impl Copy for IsotropicEvenF {}

/// The odd carrier reached by vector-even and odd-even products.
/// A genuine Euclidean-valued patch has zero `e123` residual.
pub struct IsotropicOddF { pub e1: f32, pub e2: f32, pub e3: f32, pub e123: f32 }
impl Copy for IsotropicOddF {}

pub struct IsotropicControl { pub point: Vec3F, pub weight: IsotropicEvenF }
impl Copy for IsotropicControl {}

/// Control order is the bilinear Bernstein order 00, 10, 01, 11.
pub struct IsotropicBilinearPatch {
    pub p00: IsotropicControl,
    pub p10: IsotropicControl,
    pub p01: IsotropicControl,
    pub p11: IsotropicControl,
}
impl Copy for IsotropicBilinearPatch {}

pub struct IsotropicSample {
    pub position: Vec3F,
    pub homogeneous: IsotropicOddF,
    pub denominator_norm_squared: f32,
    pub trivector_residual: f32,
    pub conditioned: bool,
    pub vector_valued: bool,
}
impl Copy for IsotropicSample {}

/// One normalized representative of the authored homogeneous Clifford map.
///
/// The first four lanes are the odd weighted numerator and the final four are
/// the even denominator. Keeping the pair, rather than the affine quotient,
/// makes points at infinity ordinary finite values and makes global rescaling
/// of every control weight observationally irrelevant. Antipodal values name
/// the same real-projective point.
pub struct IsotropicProjectiveF {
    pub numerator_e1: f32,
    pub numerator_e2: f32,
    pub numerator_e3: f32,
    pub numerator_e123: f32,
    pub denominator_scalar: f32,
    pub denominator_e12: f32,
    pub denominator_e13: f32,
    pub denominator_e23: f32,
}
impl Copy for IsotropicProjectiveF {}

pub struct IsotropicProjectiveSample {
    pub representative: IsotropicProjectiveF,
    pub lift_norm_squared: f32,
    pub conditioned: bool,
}
impl Copy for IsotropicProjectiveSample {}

pub struct IsotropicProjectiveDifferential {
    pub sample: IsotropicProjectiveSample,
    pub tangent_s: IsotropicProjectiveF,
    pub tangent_t: IsotropicProjectiveF,
}
impl Copy for IsotropicProjectiveDifferential {}

pub struct IsotropicDifferential {
    pub sample: IsotropicSample,
    pub tangent_s: Vec3F,
    pub tangent_t: Vec3F,
    pub normal: Vec3F,
}
impl Copy for IsotropicDifferential {}

struct IsotropicProjectiveLift {
    value: IsotropicProjectiveF,
    tangent_s: IsotropicProjectiveF,
    tangent_t: IsotropicProjectiveF,
}
impl Copy for IsotropicProjectiveLift {}

struct EvaluationFrame {
    sample: IsotropicSample,
    denominator: IsotropicEvenF,
    f00: IsotropicOddF,
    f10: IsotropicOddF,
    f01: IsotropicOddF,
    f11: IsotropicOddF,
}
impl Copy for EvaluationFrame {}

pub struct IsotropicPolicy {
    pub minimum_denominator_norm_squared: f32,
    pub maximum_trivector_residual: f32,
}
impl Copy for IsotropicPolicy {}

pub struct FourthWeightReconciliation {
    pub patch: IsotropicBilinearPatch,
    pub scale: f32,
    pub conditioned: bool,
}
impl Copy for FourthWeightReconciliation {}

pub struct IsotropicBilinearKernel {}
impl Copy for IsotropicBilinearKernel {}

// Basis masks are e1=1, e2=2, e3=4. A support is a bitset over
// those blade-mask ordinals, hence vector support 2|4|16 and even support
// 1|8|32|64. Only e1 and e2 have nonzero positive squares.
struct PointCoefficients { e1: f32, e2: f32, e3: f32 }
struct WeightCoefficients { scalar: f32, e12: f32, e13: f32, e23: f32 }
struct OddCoefficients { e1: f32, e2: f32, e3: f32, e123: f32 }

type PointMv = MultivectorInput<PointCoefficients, 22>
type WeightMv = MultivectorInput<WeightCoefficients, 105>
type OddMv = MultivectorInput<OddCoefficients, 150>
pub type IsotropicMetric = SignedOrthogonalMetric<3, 3, 0>

type WeightedPointExpression = Geometric<PointMv, WeightMv>
struct WeightedPointOperands { point: PointCoefficients, weight: WeightCoefficients }
derive EvaluateGaF32 for WeightedPointOperands using CompileGaF32<
    GaProgram<WeightedPointExpression, IsotropicMetric, Strict>,
>

type OddTimesReverseWeightExpression = Geometric<OddMv, Reverse<WeightMv>>
struct OddTimesReverseWeightOperands { odd: OddCoefficients, weight: WeightCoefficients }
derive EvaluateGaF32 for OddTimesReverseWeightOperands using CompileGaF32<
    GaProgram<OddTimesReverseWeightExpression, IsotropicMetric, Strict>,
>

type OddTimesWeightExpression = Geometric<OddMv, WeightMv>
struct OddTimesWeightOperands { odd: OddCoefficients, weight: WeightCoefficients }
derive EvaluateGaF32 for OddTimesWeightOperands using CompileGaF32<
    GaProgram<OddTimesWeightExpression, IsotropicMetric, Strict>,
>

type WeightNormExpression = ScalarProduct<WeightMv, Reverse<WeightMv>>
struct WeightNormOperands { weight: WeightCoefficients }
derive EvaluateGaF32 for WeightNormOperands using CompileGaF32<
    GaProgram<WeightNormExpression, IsotropicMetric, Strict>,
>

pub fn even(_ scalar: f32, _ e12: f32, _ e13: f32, _ e23: f32) -> IsotropicEvenF {
    IsotropicEvenF { scalar: scalar, e12: e12, e13: e13, e23: e23 }
}

pub fn control(_ point: Vec3F, _ weight: IsotropicEvenF) -> IsotropicControl {
    IsotropicControl { point: point, weight: weight }
}

pub fn patch(
    _ p00: IsotropicControl,
    _ p10: IsotropicControl,
    _ p01: IsotropicControl,
    _ p11: IsotropicControl,
) -> IsotropicBilinearPatch {
    IsotropicBilinearPatch { p00: p00, p10: p10, p01: p01, p11: p11 }
}

fn weight_coefficients(_ value: IsotropicEvenF) -> WeightCoefficients {
    WeightCoefficients { scalar: value.scalar, e12: value.e12, e13: value.e13, e23: value.e23 }
}

fn odd_coefficients(_ value: IsotropicOddF) -> OddCoefficients {
    OddCoefficients { e1: value.e1, e2: value.e2, e3: value.e3, e123: value.e123 }
}

/// Evaluate `point * weight` through the statically compiled sparse product.
pub fn weighted_isotropic_point(_ value: IsotropicControl) -> IsotropicOddF {
    let output = <WeightedPointOperands as EvaluateGaF32>::evaluate(
        WeightedPointOperands {
            point: PointCoefficients { e1: value.point.x, e2: value.point.y, e3: value.point.z },
            weight: weight_coefficients(value.weight),
        },
    )
    IsotropicOddF { e1: output.0, e2: output.1, e3: output.2, e123: output.3 }
}

fn odd_times_reverse_weight(_ value: IsotropicOddF, _ weight: IsotropicEvenF) -> IsotropicOddF {
    let output = <OddTimesReverseWeightOperands as EvaluateGaF32>::evaluate(
        OddTimesReverseWeightOperands {
            odd: odd_coefficients(value),
            weight: weight_coefficients(weight),
        },
    )
    IsotropicOddF { e1: output.0, e2: output.1, e3: output.2, e123: output.3 }
}

fn odd_times_weight(_ value: IsotropicOddF, _ weight: IsotropicEvenF) -> IsotropicOddF {
    let output = <OddTimesWeightOperands as EvaluateGaF32>::evaluate(
        OddTimesWeightOperands {
            odd: odd_coefficients(value),
            weight: weight_coefficients(weight),
        },
    )
    IsotropicOddF { e1: output.0, e2: output.1, e3: output.2, e123: output.3 }
}

pub fn weight_norm_squared(_ value: IsotropicEvenF) -> f32 {
    let output = <WeightNormOperands as EvaluateGaF32>::evaluate(
        WeightNormOperands { weight: weight_coefficients(value) },
    )
    output.0
}

/// Squared norm of the projective denominator at one parameter value. This
/// is the inexpensive chart-admission measure shared by sampling and raster
/// topology; callers that only need conditioning do not evaluate the full
/// Clifford quotient or its differential.
pub fn denominator_norm_squared_at(_ value: IsotropicBilinearPatch, _ parameter: Vec2F) -> f32 {
    weight_norm_squared(
        blend_even(
            value.p00.weight,
            value.p10.weight,
            value.p01.weight,
            value.p11.weight,
            parameter,
        ),
    )
}

/// Admit a parameter triangle as one coherent projective simplex. A raster
/// backend must never replace only one undefined vertex with a sentinel while
/// retaining its neighbors: that would create a large, spurious triangle
/// between unrelated charts. Interior singularities remain a refinement
/// concern, while this boundary proves all three resident vertices belong to
/// the same finite chart.
pub fn parameter_triangle_conditioned(
    _ value: IsotropicBilinearPatch,
    _ p0: Vec2F,
    _ p1: Vec2F,
    _ p2: Vec2F,
    _ policy: IsotropicPolicy,
) -> bool {
    denominator_norm_squared_at(value, p0) >= policy.minimum_denominator_norm_squared
        && denominator_norm_squared_at(value, p1) >= policy.minimum_denominator_norm_squared
        && denominator_norm_squared_at(value, p2) >= policy.minimum_denominator_norm_squared
}

fn blend_scalar(_ p00: f32, _ p10: f32, _ p01: f32, _ p11: f32, _ parameter: Vec2F) -> f32 {
    let one_minus_s = 1.0 - parameter.x
    let one_minus_t = 1.0 - parameter.y
    p00 * one_minus_s * one_minus_t
        + p10 * parameter.x * one_minus_t
        + p01 * one_minus_s * parameter.y
        + p11 * parameter.x * parameter.y
}

fn blend_even(
    _ p00: IsotropicEvenF,
    _ p10: IsotropicEvenF,
    _ p01: IsotropicEvenF,
    _ p11: IsotropicEvenF,
    _ parameter: Vec2F,
) -> IsotropicEvenF {
    even(
        blend_scalar(p00.scalar, p10.scalar, p01.scalar, p11.scalar, parameter),
        blend_scalar(p00.e12, p10.e12, p01.e12, p11.e12, parameter),
        blend_scalar(p00.e13, p10.e13, p01.e13, p11.e13, parameter),
        blend_scalar(p00.e23, p10.e23, p01.e23, p11.e23, parameter),
    )
}

fn blend_odd(
    _ p00: IsotropicOddF,
    _ p10: IsotropicOddF,
    _ p01: IsotropicOddF,
    _ p11: IsotropicOddF,
    _ parameter: Vec2F,
) -> IsotropicOddF {
    IsotropicOddF {
        e1: blend_scalar(p00.e1, p10.e1, p01.e1, p11.e1, parameter),
        e2: blend_scalar(p00.e2, p10.e2, p01.e2, p11.e2, parameter),
        e3: blend_scalar(p00.e3, p10.e3, p01.e3, p11.e3, parameter),
        e123: blend_scalar(p00.e123, p10.e123, p01.e123, p11.e123, parameter),
    }
}

fn add_odd(_ left: IsotropicOddF, _ right: IsotropicOddF) -> IsotropicOddF {
    IsotropicOddF {
        e1: left.e1 + right.e1,
        e2: left.e2 + right.e2,
        e3: left.e3 + right.e3,
        e123: left.e123 + right.e123,
    }
}

fn sub_odd(_ left: IsotropicOddF, _ right: IsotropicOddF) -> IsotropicOddF {
    IsotropicOddF {
        e1: left.e1 - right.e1,
        e2: left.e2 - right.e2,
        e3: left.e3 - right.e3,
        e123: left.e123 - right.e123,
    }
}

fn scale_odd(_ value: IsotropicOddF, _ scale: f32) -> IsotropicOddF {
    IsotropicOddF {
        e1: value.e1 * scale,
        e2: value.e2 * scale,
        e3: value.e3 * scale,
        e123: value.e123 * scale,
    }
}

fn sub_even(_ left: IsotropicEvenF, _ right: IsotropicEvenF) -> IsotropicEvenF {
    even(
        left.scalar - right.scalar,
        left.e12 - right.e12,
        left.e13 - right.e13,
        left.e23 - right.e23,
    )
}

fn tangent_odd_s(
    _ p00: IsotropicOddF,
    _ p10: IsotropicOddF,
    _ p01: IsotropicOddF,
    _ p11: IsotropicOddF,
    _ t: f32,
) -> IsotropicOddF {
    add_odd(
        scale_odd(sub_odd(p10, p00), 1.0 - t),
        scale_odd(sub_odd(p11, p01), t),
    )
}

fn tangent_odd_t(
    _ p00: IsotropicOddF,
    _ p10: IsotropicOddF,
    _ p01: IsotropicOddF,
    _ p11: IsotropicOddF,
    _ s: f32,
) -> IsotropicOddF {
    add_odd(
        scale_odd(sub_odd(p01, p00), 1.0 - s),
        scale_odd(sub_odd(p11, p10), s),
    )
}

fn tangent_even_s(
    _ p00: IsotropicEvenF,
    _ p10: IsotropicEvenF,
    _ p01: IsotropicEvenF,
    _ p11: IsotropicEvenF,
    _ t: f32,
) -> IsotropicEvenF {
    let lower = scale_weight(sub_even(p10, p00), 1.0 - t)
    let upper = scale_weight(sub_even(p11, p01), t)
    even(
        lower.scalar + upper.scalar,
        lower.e12 + upper.e12,
        lower.e13 + upper.e13,
        lower.e23 + upper.e23,
    )
}

fn tangent_even_t(
    _ p00: IsotropicEvenF,
    _ p10: IsotropicEvenF,
    _ p01: IsotropicEvenF,
    _ p11: IsotropicEvenF,
    _ s: f32,
) -> IsotropicEvenF {
    let left = scale_weight(sub_even(p01, p00), 1.0 - s)
    let right = scale_weight(sub_even(p11, p10), s)
    even(
        left.scalar + right.scalar,
        left.e12 + right.e12,
        left.e13 + right.e13,
        left.e23 + right.e23,
    )
}

fn projective_value(
    _ numerator: IsotropicOddF,
    _ denominator: IsotropicEvenF,
) -> IsotropicProjectiveF {
    IsotropicProjectiveF {
        numerator_e1: numerator.e1,
        numerator_e2: numerator.e2,
        numerator_e3: numerator.e3,
        numerator_e123: numerator.e123,
        denominator_scalar: denominator.scalar,
        denominator_e12: denominator.e12,
        denominator_e13: denominator.e13,
        denominator_e23: denominator.e23,
    }
}

fn projective_zero() -> IsotropicProjectiveF {
    projective_value(
        IsotropicOddF { e1: 0.0, e2: 0.0, e3: 0.0, e123: 0.0 },
        even(0.0, 0.0, 0.0, 0.0),
    )
}

pub fn projective_dot(_ left: IsotropicProjectiveF, _ right: IsotropicProjectiveF) -> f32 {
    left.numerator_e1 * right.numerator_e1
        + left.numerator_e2 * right.numerator_e2
        + left.numerator_e3 * right.numerator_e3
        + left.numerator_e123 * right.numerator_e123
        + left.denominator_scalar * right.denominator_scalar
        + left.denominator_e12 * right.denominator_e12
        + left.denominator_e13 * right.denominator_e13
        + left.denominator_e23 * right.denominator_e23
}

fn scale_projective(
    _ value: IsotropicProjectiveF,
    _ scale: f32,
) -> IsotropicProjectiveF {
    IsotropicProjectiveF {
        numerator_e1: value.numerator_e1 * scale,
        numerator_e2: value.numerator_e2 * scale,
        numerator_e3: value.numerator_e3 * scale,
        numerator_e123: value.numerator_e123 * scale,
        denominator_scalar: value.denominator_scalar * scale,
        denominator_e12: value.denominator_e12 * scale,
        denominator_e13: value.denominator_e13 * scale,
        denominator_e23: value.denominator_e23 * scale,
    }
}

fn sub_projective(
    _ left: IsotropicProjectiveF,
    _ right: IsotropicProjectiveF,
) -> IsotropicProjectiveF {
    IsotropicProjectiveF {
        numerator_e1: left.numerator_e1 - right.numerator_e1,
        numerator_e2: left.numerator_e2 - right.numerator_e2,
        numerator_e3: left.numerator_e3 - right.numerator_e3,
        numerator_e123: left.numerator_e123 - right.numerator_e123,
        denominator_scalar: left.denominator_scalar - right.denominator_scalar,
        denominator_e12: left.denominator_e12 - right.denominator_e12,
        denominator_e13: left.denominator_e13 - right.denominator_e13,
        denominator_e23: left.denominator_e23 - right.denominator_e23,
    }
}

fn projective_lift(
    _ value: IsotropicBilinearPatch,
    _ parameter: Vec2F,
) -> IsotropicProjectiveLift {
    let f00 = weighted_isotropic_point(value.p00)
    let f10 = weighted_isotropic_point(value.p10)
    let f01 = weighted_isotropic_point(value.p01)
    let f11 = weighted_isotropic_point(value.p11)
    IsotropicProjectiveLift {
        value: projective_value(
            blend_odd(f00, f10, f01, f11, parameter),
            blend_even(
                value.p00.weight,
                value.p10.weight,
                value.p01.weight,
                value.p11.weight,
                parameter,
            ),
        ),
        tangent_s: projective_value(
            tangent_odd_s(f00, f10, f01, f11, parameter.y),
            tangent_even_s(
                value.p00.weight,
                value.p10.weight,
                value.p01.weight,
                value.p11.weight,
                parameter.y,
            ),
        ),
        tangent_t: projective_value(
            tangent_odd_t(f00, f10, f01, f11, parameter.x),
            tangent_even_t(
                value.p00.weight,
                value.p10.weight,
                value.p01.weight,
                value.p11.weight,
                parameter.x,
            ),
        ),
    }
}

/// Evaluate the compact real-projective lift `[F(s,t) : W(s,t)]`.
///
/// Unlike the affine quotient this remains finite at a denominator zero. The
/// representative is normalized only to choose a stable metric carrier; its
/// sign has no meaning.
pub fn evaluate_projective(
    _ value: IsotropicBilinearPatch,
    _ parameter: Vec2F,
    _ minimum_lift_norm_squared: f32,
) -> IsotropicProjectiveSample {
    let lift = projective_lift(value, parameter)
    let norm_squared = projective_dot(lift.value, lift.value)
    let conditioned = norm_squared >= minimum_lift_norm_squared
    IsotropicProjectiveSample {
        representative: if conditioned {
            scale_projective(lift.value, 1.0 / sqrt(norm_squared))
        } else {
            projective_zero()
        },
        lift_norm_squared: norm_squared,
        conditioned: conditioned,
    }
}

/// Differential of the normalized homogeneous lift. Radial scale is removed,
/// leaving exactly the tangent seen by the round metric on real projective
/// space.
pub fn evaluate_projective_differential(
    _ value: IsotropicBilinearPatch,
    _ parameter: Vec2F,
    _ minimum_lift_norm_squared: f32,
) -> IsotropicProjectiveDifferential {
    let lift = projective_lift(value, parameter)
    let norm_squared = projective_dot(lift.value, lift.value)
    let conditioned = norm_squared >= minimum_lift_norm_squared
    if !conditioned {
        return IsotropicProjectiveDifferential {
            sample: IsotropicProjectiveSample {
                representative: projective_zero(),
                lift_norm_squared: norm_squared,
                conditioned: false,
            },
            tangent_s: projective_zero(),
            tangent_t: projective_zero(),
        }
    }
    let inverse_norm = 1.0 / sqrt(norm_squared)
    let representative = scale_projective(lift.value, inverse_norm)
    let tangent_s = scale_projective(
        sub_projective(
            lift.tangent_s,
            scale_projective(
                representative,
                projective_dot(representative, lift.tangent_s),
            ),
        ),
        inverse_norm,
    )
    let tangent_t = scale_projective(
        sub_projective(
            lift.tangent_t,
            scale_projective(
                representative,
                projective_dot(representative, lift.tangent_t),
            ),
        ),
        inverse_norm,
    )
    IsotropicProjectiveDifferential {
        sample: IsotropicProjectiveSample {
            representative: representative,
            lift_norm_squared: norm_squared,
            conditioned: true,
        },
        tangent_s: tangent_s,
        tangent_t: tangent_t,
    }
}

/// Squared chord distance on the unit-sphere cover of real projective space.
/// The absolute dot product makes antipodal representatives identical.
pub fn projective_distance_squared(
    _ left: IsotropicProjectiveF,
    _ right: IsotropicProjectiveF,
) -> f32 {
    let raw = projective_dot(left, right)
    let aligned = if raw < 0.0 { -raw } else { raw }
    let bounded = if aligned > 1.0 { 1.0 } else { aligned }
    2.0 - 2.0 * bounded
}

/// Chordal area of three normalized representatives in the locally aligned
/// sphere chart. This is finite across the affine pole and scale invariant.
pub fn projective_triangle_area(
    _ first: IsotropicProjectiveF,
    _ second: IsotropicProjectiveF,
    _ third: IsotropicProjectiveF,
) -> f32 {
    let aligned_second = if projective_dot(first, second) < 0.0 {
        scale_projective(second, -1.0)
    } else {
        second
    }
    let aligned_third = if projective_dot(first, third) < 0.0 {
        scale_projective(third, -1.0)
    } else {
        third
    }
    let edge_s = sub_projective(aligned_second, first)
    let edge_t = sub_projective(aligned_third, first)
    let determinant = projective_dot(edge_s, edge_s) * projective_dot(edge_t, edge_t) -
        projective_dot(edge_s, edge_t) * projective_dot(edge_s, edge_t)
    if determinant > 0.0 { sqrt(determinant) * 0.5 } else { 0.0 }
}

pub fn projective_pullback_metric(
    _ differential: IsotropicProjectiveDifferential,
) -> PullbackMetric2 {
    pullback_metric2(
        projective_dot(differential.tangent_s, differential.tangent_s),
        projective_dot(differential.tangent_s, differential.tangent_t),
        projective_dot(differential.tangent_t, differential.tangent_t),
        differential.sample.conditioned,
    )
}

fn evaluate_frame(
    _ value: IsotropicBilinearPatch,
    _ parameter: Vec2F,
    _ policy: IsotropicPolicy,
) -> EvaluationFrame {
    let f00 = weighted_isotropic_point(value.p00)
    let f10 = weighted_isotropic_point(value.p10)
    let f01 = weighted_isotropic_point(value.p01)
    let f11 = weighted_isotropic_point(value.p11)
    let numerator = blend_odd(f00, f10, f01, f11, parameter)
    let denominator = blend_even(
        value.p00.weight,
        value.p10.weight,
        value.p01.weight,
        value.p11.weight,
        parameter,
    )
    let denominator_norm_squared = weight_norm_squared(denominator)
    let conditioned = denominator_norm_squared >= policy.minimum_denominator_norm_squared
    if !conditioned {
        return EvaluationFrame {
            sample: IsotropicSample {
                position: vec3f(0.0, 0.0, 0.0),
                homogeneous: IsotropicOddF { e1: 0.0, e2: 0.0, e3: 0.0, e123: 0.0 },
                denominator_norm_squared: denominator_norm_squared,
                trivector_residual: 0.0,
                conditioned: false,
                vector_valued: false,
            },
            denominator: denominator,
            f00: f00,
            f10: f10,
            f01: f01,
            f11: f11,
        }
    }
    let homogeneous = odd_times_reverse_weight(numerator, denominator)
    let inverse_norm = 1.0 / denominator_norm_squared
    let trivector_residual = homogeneous.e123 * inverse_norm
    EvaluationFrame {
        sample: IsotropicSample {
            position: vec3f(
                homogeneous.e1 * inverse_norm,
                homogeneous.e2 * inverse_norm,
                homogeneous.e3 * inverse_norm,
            ),
            homogeneous: homogeneous,
            denominator_norm_squared: denominator_norm_squared,
            trivector_residual: trivector_residual,
            conditioned: true,
            vector_valued: absf(trivector_residual) <= policy.maximum_trivector_residual,
        },
        denominator: denominator,
        f00: f00,
        f10: f10,
        f01: f01,
        f11: f11,
    }
}

pub fn evaluate(
    _ value: IsotropicBilinearPatch,
    _ parameter: Vec2F,
    _ policy: IsotropicPolicy,
) -> IsotropicSample {
    evaluate_frame(value, parameter, policy).sample
}

fn quotient_derivative(
    _ value: IsotropicOddF,
    _ numerator_derivative: IsotropicOddF,
    _ denominator: IsotropicEvenF,
    _ denominator_derivative: IsotropicEvenF,
    _ inverse_denominator_norm_squared: f32,
) -> IsotropicOddF {
    scale_odd(
        odd_times_reverse_weight(
            sub_odd(
                numerator_derivative,
                odd_times_weight(value, denominator_derivative),
            ),
            denominator,
        ),
        inverse_denominator_norm_squared,
    )
}

/// Analytic derivatives of the same right quotient used by `evaluate`:
/// d(F W^-1) = (dF - P dW) W^-1.
pub fn evaluate_differential(
    _ patch: IsotropicBilinearPatch,
    _ parameter: Vec2F,
    _ policy: IsotropicPolicy,
    _ minimum_tangent_norm_squared: f32,
) -> IsotropicDifferential {
    let frame = evaluate_frame(patch, parameter, policy)
    let sample = frame.sample
    if !sample.conditioned {
        return IsotropicDifferential {
            sample: sample,
            tangent_s: vec3f(0.0, 0.0, 0.0),
            tangent_t: vec3f(0.0, 0.0, 0.0),
            normal: vec3f(0.0, 0.0, 1.0),
        }
    }

    let inverse_norm = 1.0 / sample.denominator_norm_squared
    let value = scale_odd(sample.homogeneous, inverse_norm)
    let derivative_s = quotient_derivative(
        value,
        tangent_odd_s(frame.f00, frame.f10, frame.f01, frame.f11, parameter.y),
        frame.denominator,
        tangent_even_s(
            patch.p00.weight,
            patch.p10.weight,
            patch.p01.weight,
            patch.p11.weight,
            parameter.y,
        ),
        inverse_norm,
    )
    let derivative_t = quotient_derivative(
        value,
        tangent_odd_t(frame.f00, frame.f10, frame.f01, frame.f11, parameter.x),
        frame.denominator,
        tangent_even_t(
            patch.p00.weight,
            patch.p10.weight,
            patch.p01.weight,
            patch.p11.weight,
            parameter.x,
        ),
        inverse_norm,
    )
    let tangent_s = vec3f(derivative_s.e1, derivative_s.e2, derivative_s.e3)
    let tangent_t = vec3f(derivative_t.e1, derivative_t.e2, derivative_t.e3)
    IsotropicDifferential {
        sample: sample,
        tangent_s: tangent_s,
        tangent_t: tangent_t,
        normal: normalize3_or(
            cross3(tangent_s, tangent_t),
            vec3f(0.0, 0.0, 1.0),
            minimum_tangent_norm_squared,
        ),
    }
}

/// Scale one even Clifford weight without exposing its sparse storage policy
/// to a patch editor. Scalar multiplication preserves every grade-support and
/// vector-valuedness relation; independently chosen corner scales may not.
pub fn scale_weight(_ value: IsotropicEvenF, _ scale: f32) -> IsotropicEvenF {
    even(
        value.scalar * scale,
        value.e12 * scale,
        value.e13 * scale,
        value.e23 * scale,
    )
}

impl LinearElement for IsotropicEvenF {
    fn plus(self, _ right: Self) -> Self {
        even(
            self.scalar + right.scalar,
            self.e12 + right.e12,
            self.e13 + right.e13,
            self.e23 + right.e23,
        )
    }

    fn scaled(self, _ scale: f32) -> Self {
        scale_weight(self, scale)
    }
}

impl LinearElement for IsotropicOddF {
    fn plus(self, _ right: Self) -> Self {
        add_odd(self, right)
    }

    fn scaled(self, _ scale: f32) -> Self {
        scale_odd(self, scale)
    }
}

/// One model instance of the generic projective-patch machinery. Its metric,
/// legal point and weight elements, and quotient carrier are all static type
/// choices. The `ga_expr` derivations above close over the same metric alias.
pub struct IsotropicCliffordAlgebra {}
impl Copy for IsotropicCliffordAlgebra {}

impl ProjectiveAlgebra for IsotropicCliffordAlgebra {
    type Metric = IsotropicMetric
    type Point = Vec3F
    type Weight = IsotropicEvenF
    type Numerator = IsotropicOddF
    type Quotient = IsotropicOddF
    type Policy = IsotropicPolicy

    fn weighted_point(self, _ point: Vec3F, _ weight: IsotropicEvenF) -> IsotropicOddF {
        weighted_isotropic_point(control(point, weight))
    }

    fn right_quotient(
        self,
        _ numerator: IsotropicOddF,
        _ denominator: IsotropicEvenF,
        _ policy: IsotropicPolicy,
    ) -> QuotientSample<IsotropicOddF> {
        let denominator_measure = weight_norm_squared(denominator)
        if denominator_measure < policy.minimum_denominator_norm_squared {
            return QuotientSample<IsotropicOddF> {
                value: IsotropicOddF { e1: 0.0, e2: 0.0, e3: 0.0, e123: 0.0 },
                denominator_measure: denominator_measure,
                defined: false,
            }
        }
        QuotientSample<IsotropicOddF> {
            value: scale_odd(
                odd_times_reverse_weight(numerator, denominator),
                1.0 / denominator_measure,
            ),
            denominator_measure: denominator_measure,
            defined: true,
        }
    }
}

/// Admit only the grade-one Euclidean chart. An independently varied weight
/// may leave a grade-three residual; that is a typed failed denotation rather
/// than a silently projected point.
pub struct IsotropicVectorAdmission {}
impl Copy for IsotropicVectorAdmission {}

impl ProjectiveAdmission<IsotropicCliffordAlgebra> for IsotropicVectorAdmission {
    type Codomain = Euclidean3Points

    fn admit(
        self,
        _ quotient: QuotientSample<IsotropicOddF>,
        _ policy: IsotropicPolicy,
    ) -> DenotationSample<Euclidean3Points> {
        denotation_sample<Euclidean3Points>(
            vec3f(quotient.value.e1, quotient.value.e2, quotient.value.e3),
            quotient.defined && absf(quotient.value.e123) <= policy.maximum_trivector_residual,
        )
    }
}

pub type IsotropicProjectiveControls = BilinearProjectiveControls<IsotropicCliffordAlgebra>
pub type IsotropicProjectiveKernel = ProjectiveKernel<
    IsotropicCliffordAlgebra,
    BilinearBernstein,
    IsotropicVectorAdmission,
    IsotropicProjectiveControls,
    UnitSquare,
>

pub fn as_projective_patch(_ value: IsotropicBilinearPatch) -> Patch<IsotropicProjectiveKernel> {
    let controls: IsotropicProjectiveControls = bilinear_projective_controls(
        projective_control(value.p00.point, value.p00.weight),
        projective_control(value.p10.point, value.p10.weight),
        projective_control(value.p01.point, value.p01.weight),
        projective_control(value.p11.point, value.p11.weight),
    )
    projective_patch(
        IsotropicCliffordAlgebra {},
        BilinearBernstein {},
        IsotropicVectorAdmission {},
        UnitSquare {},
        controls,
    )
}

fn cross_grade_three(_ left: IsotropicControl, _ right: IsotropicControl) -> f32 {
    odd_times_reverse_weight(weighted_isotropic_point(left), right.weight).e123
        + odd_times_reverse_weight(weighted_isotropic_point(right), left.weight).e123
}

/// Apply the paper's unique fourth-weight scale when its grade-three
/// denominator is sufficiently conditioned. The returned patch is unchanged
/// on failure; this function never silently substitutes an arbitrary scale.
pub fn reconcile_fourth_weight(
    _ value: IsotropicBilinearPatch,
    _ minimum_absolute_grade_three: f32,
) -> FourthWeightReconciliation {
    let numerator = cross_grade_three(value.p10, value.p01)
    let denominator = cross_grade_three(value.p00, value.p11)
    if absf(denominator) < minimum_absolute_grade_three {
        return FourthWeightReconciliation { patch: value, scale: 1.0, conditioned: false }
    }
    let lambda = -numerator / denominator
    FourthWeightReconciliation {
        patch: patch(
            value.p00,
            value.p10,
            value.p01,
            control(value.p11.point, scale_weight(value.p11.weight, lambda)),
        ),
        scale: lambda,
        conditioned: true,
    }
}

impl PatchKernel for IsotropicBilinearKernel {
    type Controls = IsotropicBilinearPatch
    type Domain = UnitSquare
    type Codomain = Euclidean3Points
    type Policy = IsotropicPolicy
    const CONTROL_COUNT: usize = 4

    fn denote(
        self,
        _ controls: IsotropicBilinearPatch,
        _ parameter: Vec2F,
        _ policy: IsotropicPolicy,
    ) -> DenotationSample<Euclidean3Points> {
        let sample = evaluate(controls, parameter, policy)
        denotation_sample<Euclidean3Points>(
            sample.position,
            sample.conditioned && sample.vector_valued,
        )
    }
}

pub fn as_patch(_ value: IsotropicBilinearPatch) -> Patch<IsotropicBilinearKernel> {
    typed_patch(IsotropicBilinearKernel {}, value)
}
