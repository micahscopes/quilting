//! Finite triangle shape, independent of sampling/backend.
use core::marker::Copy
use quilting_domain::Vec2F
use fmath::abs
use quilting_domain::{Vec3F,sub3,add3,scale3,length3}
use super::{TangentTriangleMeasure3,measure_tangent_triangle3}

/// Measure the straight rendered triangle, not a differential of its surface.
/// The three vertices must already be in the same admitted Euclidean chart.
/// Winding/coverage remain separate checks: unsigned 3D area cannot detect folds.
/// `defined=false` reports degeneracy or unrepresentable arithmetic, not a
/// sample that an aggregate audit may silently discard.
pub fn measure3(_ a:Vec3F,_ b:Vec3F,_ c:Vec3F)->TangentTriangleMeasure3 {
    measure_tangent_triangle3(sub3(b,a),sub3(c,a))
}
/// Distance between the analytical UV-centroid sample and the straight face's
/// centroid in one Euclidean chart. Not nearest-surface distance or an error
/// bound. The caller admits the samples and rejects nonfinite arithmetic.
pub fn centroid_correspondence_error(_ exact:Vec3F,_ a:Vec3F,_ b:Vec3F,_ c:Vec3F)->f32 {
    length3(sub3(exact,scale3(add3(add3(a,b),c),1.0/3.0)))
}
/// Shape of a parameter triangle under one sampled surface differential.
/// This is a local prediction, not a bound on the finite rendered triangle.
pub fn measure_differential(_ a:Vec2F,_ b:Vec2F,_ c:Vec2F,
    _ tangent_u:Vec3F,_ tangent_v:Vec3F)->TangentTriangleMeasure3 {
    measure_tangent_triangle3(
        add3(scale3(tangent_u,b.x-a.x),scale3(tangent_v,b.y-a.y)),
        add3(scale3(tangent_u,c.x-a.x),scale3(tangent_v,c.y-a.y)))
}
pub struct TriangleQuality {pub signed_double_area:f32,pub mean_ratio:f32}
impl Copy for TriangleQuality {}
/// Mean ratio is one for an equilateral triangle and zero for degeneracy.
/// Orientation is reported separately; a folded triangle can have good shape.
pub fn measure(_ a:Vec2F,_ b:Vec2F,_ c:Vec2F)->TriangleQuality {
    let ux=b.x-a.x
    let uy=b.y-a.y
    let vx=c.x-a.x
    let vy=c.y-a.y
    let wx=c.x-b.x
    let wy=c.y-b.y
    let signed=ux*vy-uy*vx
    let sum=ux*ux+uy*uy+vx*vx+vy*vy+wx*wx+wy*wy
    TriangleQuality {signed_double_area:signed,
        mean_ratio:if sum>0.0 {3.4641016151377544*abs(signed)/sum} else {0.0}}
}
