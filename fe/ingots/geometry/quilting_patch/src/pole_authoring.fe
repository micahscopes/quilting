//! A compatible geometric control net from one shared inversion pole.
//! This is a named family, not an admission rule for arbitrary arc networks.
use core::option::Option
use super::{ProjectiveAlgebra,ProjectiveControl, QuotientSample, projective_control}
use super::arc_authoring::{ArcAuthoringAlgebra,ArcConstruction,arc_through,arc_parameter_limit}

/// The model warrants that inverse-displacement weights, with one common right
/// gauge, keep partition-of-unity interpolation in its point space wherever
/// the quotient exists. Arc support alone does not warrant this surface law.
pub trait CommonPoleAlgebra: ArcAuthoringAlgebra {
    fn admit_pole(self,_ quotient:QuotientSample<<Self as ProjectiveAlgebra>::Quotient>,
        _ policy:<Self as ProjectiveAlgebra>::Policy)
        -> Option<<Self as ProjectiveAlgebra>::Point>
}

/// Edit one boundary arc by its endpoint identities and its on-arc midpoint.
/// Other boundary arcs are coupled through the resulting pole; this does not
/// pretend to preserve arbitrary independently authored arcs on other edges.
/// An infinite/ill-conditioned limit is explicit rejection of this finite-pole
/// family, not an arbitrary replacement pole or a weight-only reparameterization.
pub fn controls_from_edge<A:CommonPoleAlgebra,const N:usize>(
    _ algebra:A,_ points:[A::Point;N],_ first:usize,_ last:usize,
    _ middle:A::Point,_ minimum:f32,_ policy:A::Policy,
) -> Option<[ProjectiveControl<A>;N]> {
    if first>=N || last>=N || first==last {return Option::None}
    match arc_through(algebra,points[first],middle,points[last],minimum) {
        ArcConstruction::Degenerate=>Option::None,
        ArcConstruction::Ready(arc)=>match algebra.admit_pole(arc_parameter_limit(algebra,arc,policy),policy) {
            Option::None=>Option::None,
            Option::Some(pole)=>controls_from_pole(algebra,points,pole,points[first],minimum),
        },
    }
}

/// w_i = (p_i - pole)^-1 * (reference - pole).
/// One invertible right factor changes the weight representation, not the
/// represented surface. Callers composing nets should share this reference.
/// The pole is geometric; moving it changes boundary circles and the surface.
/// It is not an interior tessellation-density focus.
///
/// Null/nonfinite displacements reject the net. Interior singularities still
/// require the model's ordinary quotient/point admission and chart tests.
pub fn controls_from_pole<A: CommonPoleAlgebra, const N: usize>(
    _ algebra:A, _ points:[A::Point;N], _ pole:A::Point,
    _ reference:A::Point, _ minimum:f32,
) -> Option<[ProjectiveControl<A>;N]> {
    let gauge=algebra.difference(reference,pole)
    if !algebra.non_null(gauge,minimum) {return Option::None}
    let mut controls=[projective_control(reference,algebra.identity_weight());N]
    let mut i:usize=0
    while i<N {
        let weight=algebra.relative_weight(algebra.difference(points[i],pole),gauge,minimum)
        if !weight.defined {return Option::None}
        controls[i]=projective_control(points[i],weight.value)
        i=i+1
    }
    Option::Some(controls)
}
