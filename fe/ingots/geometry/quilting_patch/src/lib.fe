//! Type-directed denotation shared by distinct Quilting patch families.
//!
//! A kernel tag fixes controls, parameter domain, ambient space, and policy at
//! compile time. There is deliberately no runtime enum over patch families.
//! Family-specific diagnostics and differentials remain on the family API;
//! this common surface promises only a partial typed point.

use core::marker::Copy
use fmath::sqrt
use quilting_domain::{
    Bary3F,
    Vec2F,
    Vec3F,
    add3,
    cross3,
    dot3,
    length3,
    normalize3_or,
    scale3,
    sub3,
    vec3f,
}

/// A nominal parameter domain associates one coordinate representation.
pub trait ParameterDomain {
    type Parameter: Copy
}

/// Barycentric coordinates over a triangular parameter domain.
pub struct BarycentricTriangle {}
impl Copy for BarycentricTriangle {}
impl ParameterDomain for BarycentricTriangle {
    type Parameter = Bary3F
}

/// Tensor-product coordinates over a unit square.
pub struct UnitSquare {}
impl Copy for UnitSquare {}
impl ParameterDomain for UnitSquare {
    type Parameter = Vec2F
}

/// Tensor-product coordinates over a unit cube.
pub struct UnitCube {}
impl Copy for UnitCube {}
impl ParameterDomain for UnitCube {
    type Parameter = Vec3F
}

/// Unbounded Euclidean coordinates used to query an implicit field. This is
/// nominally distinct from `UnitCube` even though both carry three f32 lanes.
pub struct Euclidean3Coordinates {}
impl Copy for Euclidean3Coordinates {}
impl ParameterDomain for Euclidean3Coordinates {
    type Parameter = Vec3F
}

/// A codomain owns the value produced by a denotation. Point, density, and
/// richer field values remain distinct static types.
pub trait Codomain {
    type Value: Copy
}

/// Ordinary Euclidean three-space points.
pub struct Euclidean3Points {}
impl Copy for Euclidean3Points {}
impl Codomain for Euclidean3Points {
    type Value = Vec3F
}

/// Scalar density values. The domain determines whether this is a finite
/// parametric volume or an implicit field queried in ambient coordinates.
pub struct ScalarDensity {}
impl Copy for ScalarDensity {}
impl Codomain for ScalarDensity {
    type Value = f32
}

/// The smallest law shared by every patch family: a typed parameter denotes a
/// typed value or an explicit finite failure.
pub struct DenotationSample<C: Codomain> { pub value: <C as Codomain>::Value, pub defined: bool }
impl<C: Codomain> Copy for DenotationSample<C> {}

pub fn denotation_sample<C: Codomain>(
    _ value: <C as Codomain>::Value,
    _ defined: bool,
) -> DenotationSample<C> {
    DenotationSample<C> { value: value, defined: defined }
}

/// A kernel tag fixes the complete family ABI at compile time.
pub trait PatchKernel: Copy {
    type Controls: Copy
    type Domain: ParameterDomain
    type Codomain: Codomain
    type Policy: Copy
    const CONTROL_COUNT: usize

    fn denote(
        self,
        _ controls: Self::Controls,
        _ parameter: <Self::Domain as ParameterDomain>::Parameter,
        _ policy: Self::Policy,
    ) -> DenotationSample<Self::Codomain>
}

/// A patch stores its family-specific controls and kernel value. Current
/// kernels have no data fields; static dispatch avoids a runtime family switch.
pub struct Patch<K: PatchKernel> { pub kernel: K, pub controls: K::Controls }
impl<K: PatchKernel> Copy for Patch<K> {}

pub fn patch<K: PatchKernel>(_ kernel: K, _ controls: K::Controls) -> Patch<K> {
    Patch<K> { kernel: kernel, controls: controls }
}

pub fn denote<K: PatchKernel>(
    _ value: Patch<K>,
    _ parameter: <K::Domain as ParameterDomain>::Parameter,
    _ policy: K::Policy,
) -> DenotationSample<K::Codomain> {
    value.kernel.denote(value.controls, parameter, policy)
}

// ---------------------------------------------------------------------------
// Metric-parametric sampling
// ---------------------------------------------------------------------------

/// Reserve one fixed-point lane for every rank in a monotone sampled CDF.
///
/// `raw` values must be nondecreasing, lie in `0..=scale`, and use ranks in
/// `0..=count`, with `count <= scale`. The result is strictly increasing for
/// consecutive interior ranks even when their independently rounded `raw`
/// positions coincide. Endpoint ranks preserve the caller's exact endpoint.
/// Keeping this operation integer makes worker, native, and WebGPU samplers
/// share the same topology boundary.
pub const fn ranked_quantized_position(_ raw: u32, _ rank: u32, _ count: u32, _ scale: u32) -> u32 {
    if rank == 0 || rank >= count {
        raw
    } else {
        rank + raw * (scale - count) / scale
    }
}

static_assert(ranked_quantized_position(0, 0, 8, 16384) == 0)
static_assert(ranked_quantized_position(2, 1, 8, 16384) == 2)
static_assert(ranked_quantized_position(2, 2, 8, 16384) == 3)
static_assert(ranked_quantized_position(6, 3, 8, 16384) == 8)
static_assert(ranked_quantized_position(16384, 8, 8, 16384) == 16384)

/// A metric belongs to a codomain, not to a parameter chart.
///
/// The same sampler can therefore measure a QB, Clifford, CGA, PGA, QCGA, or
/// genuinely hyperbolic patch without treating its UV coordinates as
/// geometric distance. Fe specializes the selected metric and kernel together.
pub trait CodomainMetric<C: Codomain>: Copy {
    fn distance(self, _ left: <C as Codomain>::Value, _ right: <C as Codomain>::Value) -> f32
}

/// Ordinary chord distance in the admitted Euclidean chart.
pub struct Euclidean3Metric {}
impl Copy for Euclidean3Metric {}

impl CodomainMetric<Euclidean3Points> for Euclidean3Metric {
    fn distance(self, _ left: Vec3F, _ right: Vec3F) -> f32 {
        length3(sub3(right, left))
    }
}

/// Three-point image of one parameter edge under a patch.
///
/// `arc_length` is the two-chord length through the mapped midpoint. It reacts
/// to projective stretching and to first-order bending while remaining exact
/// at the three samples. More elaborate samplers may recurse using the same
/// metric contract without changing a patch family.
pub struct PatchEdgeMeasure {
    pub chord_length: f32,
    pub arc_length: f32,
    pub midpoint_excess: f32,
    pub defined: bool,
}
impl Copy for PatchEdgeMeasure {}

pub fn measure_codomain_edge<C: Codomain, M: CodomainMetric<C>>(
    _ left: DenotationSample<C>,
    _ midpoint: DenotationSample<C>,
    _ right: DenotationSample<C>,
    _ metric: M,
) -> PatchEdgeMeasure {
    let chord_length = metric.distance(left.value, right.value)
    let arc_length = metric.distance(left.value, midpoint.value)
        + metric.distance(midpoint.value, right.value)
    PatchEdgeMeasure {
        chord_length: chord_length,
        arc_length: arc_length,
        midpoint_excess: if arc_length > chord_length {
            arc_length - chord_length
        } else {
            0.0
        },
        defined: left.defined && midpoint.defined && right.defined,
    }
}

pub fn measure_patch_edge<K: PatchKernel, M: CodomainMetric<K::Codomain>>(
    _ value: Patch<K>,
    _ left: <K::Domain as ParameterDomain>::Parameter,
    _ midpoint: <K::Domain as ParameterDomain>::Parameter,
    _ right: <K::Domain as ParameterDomain>::Parameter,
    _ policy: K::Policy,
    _ metric: M,
) -> PatchEdgeMeasure {
    let left_sample = denote(value, left, policy)
    let midpoint_sample = denote(value, midpoint, policy)
    let right_sample = denote(value, right, policy)
    measure_codomain_edge(left_sample, midpoint_sample, right_sample, metric)
}

/// The two possible diagonals of one oriented parameter-space quad.
pub enum QuadDiagonal2 {
    Corner00To11,
    Corner10To01,
}
impl Copy for QuadDiagonal2 {}

/// Subdivision demand for one triangular atlas realization. The lanes follow
/// the Quilting convention: `a` lies opposite vertex 0, `b` opposite vertex
/// 1, and `c` opposite vertex 2. Keeping this geometry-level value independent
/// of an atlas artifact lets CPU, WebGPU, and future procedural realizers share
/// the same denotation.
pub struct TrianglePatchDensity3 { pub a: u32, pub b: u32, pub c: u32 }
impl Copy for TrianglePatchDensity3 {}

/// Five independent density coordinates for one quadrilateral Patch leaf.
///
/// The four boundary lanes are reconciled with neighboring leaves. `interior`
/// is the missing M coordinate: it may increase surface sampling without
/// forcing an unrelated neighbor to inherit that density. Two ordinary
/// A/B/C atlas patches realize this value by sharing the selected diagonal.
pub struct QuadPatchDensity2 {
    pub bottom: u32,
    pub right: u32,
    pub top: u32,
    pub left: u32,
    pub interior: u32,
}
impl Copy for QuadPatchDensity2 {}

pub struct QuadPatchFaceDensities2 {
    pub first: TrianglePatchDensity3,
    pub second: TrianglePatchDensity3,
}
impl Copy for QuadPatchFaceDensities2 {}

/// Lower the denotational A/B/C/M quad demand into two A/B/C triangle demands.
/// The internal M lane appears on both copies of the chosen diagonal, proving
/// that the two atlas patches request identical shared samples.
pub const fn quad_patch_face_densities2(
    _ diagonal: QuadDiagonal2,
    _ density: QuadPatchDensity2,
) -> QuadPatchFaceDensities2 {
    match diagonal {
        QuadDiagonal2::Corner00To11 => QuadPatchFaceDensities2 {
            // (00, 10, 11): a=right, b=interior, c=bottom
            first: TrianglePatchDensity3 {
                a: density.right,
                b: density.interior,
                c: density.bottom,
            },
            // (00, 11, 01): a=top, b=left, c=interior
            second: TrianglePatchDensity3 { a: density.top, b: density.left, c: density.interior },
        },
        QuadDiagonal2::Corner10To01 => QuadPatchFaceDensities2 {
            // (00, 10, 01): a=interior, b=left, c=bottom
            first: TrianglePatchDensity3 {
                a: density.interior,
                b: density.left,
                c: density.bottom,
            },
            // (10, 11, 01): a=top, b=interior, c=right
            second: TrianglePatchDensity3 { a: density.top, b: density.interior, c: density.right },
        },
    }
}

const DENSITY_WITNESS: QuadPatchDensity2 = QuadPatchDensity2 {
    bottom: 1,
    right: 2,
    top: 3,
    left: 4,
    interior: 5,
}
static_assert(quad_patch_face_densities2(QuadDiagonal2::Corner00To11, DENSITY_WITNESS).first.b == 5)
static_assert(quad_patch_face_densities2(QuadDiagonal2::Corner00To11, DENSITY_WITNESS).second.c
    == 5)
static_assert(quad_patch_face_densities2(QuadDiagonal2::Corner10To01, DENSITY_WITNESS).first.a == 5)
static_assert(quad_patch_face_densities2(QuadDiagonal2::Corner10To01, DENSITY_WITNESS).second.b
    == 5)

/// Metric-only evidence for choosing a quad diagonal.
///
/// Triangle quality is the standard dimensionless `4*sqrt(3)*area/sum(e^2)`
/// score, reduced to the worse of the two triangles. Relative center excess
/// measures how much longer the mapped diagonal is when routed through the
/// true patch center. Both are invariant under uniform scale; neither assumes
/// a Euclidean coordinate representation.
pub struct QuadDiagonalProfile2 {
    pub corner00_to_11_quality: f32,
    pub corner10_to_01_quality: f32,
    pub corner00_to_11_center_excess: f32,
    pub corner10_to_01_center_excess: f32,
    pub defined: bool,
}
impl Copy for QuadDiagonalProfile2 {}

fn triangle_quality_from_lengths(_ edge0: f32, _ edge1: f32, _ edge2: f32) -> f32 {
    let edge0_squared = edge0 * edge0
    let edge1_squared = edge1 * edge1
    let edge2_squared = edge2 * edge2
    let edge_sum = edge0_squared + edge1_squared + edge2_squared
    let doubled_products = 2.0
        * (edge0_squared * edge1_squared
            + edge1_squared * edge2_squared
            + edge2_squared * edge0_squared)
    let fourth_powers = edge0_squared * edge0_squared
        + edge1_squared * edge1_squared
        + edge2_squared * edge2_squared
    let sixteen_area_squared = nonnegative(doubled_products - fourth_powers)
    if edge_sum > 0.0 {
        sqrt(3.0 * sixteen_area_squared) / edge_sum
    } else {
        0.0
    }
}

fn relative_center_excess(
    _ first_to_center: f32,
    _ center_to_second: f32,
    _ diagonal: f32,
    _ minimum_length: f32,
) -> f32 {
    if diagonal < minimum_length {
        0.0
    } else {
        nonnegative(first_to_center + center_to_second - diagonal) / diagonal
    }
}

pub fn quad_diagonal_profile2<C: Codomain, M: CodomainMetric<C>>(
    _ corner00: DenotationSample<C>,
    _ corner10: DenotationSample<C>,
    _ corner01: DenotationSample<C>,
    _ corner11: DenotationSample<C>,
    _ center: DenotationSample<C>,
    _ metric: M,
    _ minimum_length: f32,
) -> QuadDiagonalProfile2 {
    let defined = corner00.defined
        && corner10.defined
        && corner01.defined
        && corner11.defined
        && center.defined
    let edge_bottom = metric.distance(corner00.value, corner10.value)
    let edge_right = metric.distance(corner10.value, corner11.value)
    let edge_top = metric.distance(corner11.value, corner01.value)
    let edge_left = metric.distance(corner01.value, corner00.value)
    let diagonal00_11 = metric.distance(corner00.value, corner11.value)
    let diagonal10_01 = metric.distance(corner10.value, corner01.value)
    let center00 = metric.distance(corner00.value, center.value)
    let center10 = metric.distance(corner10.value, center.value)
    let center01 = metric.distance(corner01.value, center.value)
    let center11 = metric.distance(corner11.value, center.value)
    let quality00_10_11 = triangle_quality_from_lengths(edge_bottom, edge_right, diagonal00_11)
    let quality00_11_01 = triangle_quality_from_lengths(diagonal00_11, edge_top, edge_left)
    let quality00_10_01 = triangle_quality_from_lengths(edge_bottom, diagonal10_01, edge_left)
    let quality10_11_01 = triangle_quality_from_lengths(edge_right, edge_top, diagonal10_01)
    if defined && diagonal00_11 >= minimum_length && diagonal10_01 >= minimum_length {
        QuadDiagonalProfile2 {
            corner00_to_11_quality: minimum_f32(quality00_10_11, quality00_11_01),
            corner10_to_01_quality: minimum_f32(quality00_10_01, quality10_11_01),
            corner00_to_11_center_excess: relative_center_excess(
                center00,
                center11,
                diagonal00_11,
                minimum_length,
            ),
            corner10_to_01_center_excess: relative_center_excess(
                center10,
                center01,
                diagonal10_01,
                minimum_length,
            ),
            defined: true,
        }
    } else {
        QuadDiagonalProfile2 {
            corner00_to_11_quality: 0.0,
            corner10_to_01_quality: 0.0,
            corner00_to_11_center_excess: 0.0,
            corner10_to_01_center_excess: 0.0,
            defined: false,
        }
    }
}

/// Apply an explicit, scale-free topology policy to measured diagonal facts.
/// Exact or near ties retain `00 -> 11`, giving every dyadic leaf a stable
/// answer instead of allowing floating-point noise to chatter its topology.
pub fn choose_quad_diagonal2(
    _ profile: QuadDiagonalProfile2,
    _ quality_weight: f32,
    _ center_excess_weight: f32,
    _ tie_band: f32,
) -> QuadDiagonal2 {
    if profile.defined {
        let quality00_11 = quality_weight * profile.corner00_to_11_quality
        let penalty00_11 = center_excess_weight * profile.corner00_to_11_center_excess
        let quality10_01 = quality_weight * profile.corner10_to_01_quality
        let penalty10_01 = center_excess_weight * profile.corner10_to_01_center_excess
        let diagonal00_11 = quality00_11 - penalty00_11
        let diagonal10_01 = quality10_01 - penalty10_01
        if diagonal10_01 > diagonal00_11 + tie_band {
            QuadDiagonal2::Corner10To01
        } else {
            QuadDiagonal2::Corner00To11
        }
    } else {
        QuadDiagonal2::Corner00To11
    }
}

// ---------------------------------------------------------------------------
// Pullback metrics and deformation-aware triangulation
// ---------------------------------------------------------------------------

/// Symmetric 2x2 metric tensor in one oriented parameter chart.
///
/// The tensor is deliberately separate from any patch family: it is the small
/// value shared by surface-aware sampling, anisotropic Delaunay restoration,
/// screen-space error estimation, and future native/WebGPU providers.
pub struct PullbackMetric2 { pub uu: f32, pub uv: f32, pub vv: f32, pub defined: bool }
impl Copy for PullbackMetric2 {}

/// One chart point carrying the local surface metric induced by its patch.
pub struct PullbackSample2 { pub parameter: Vec2F, pub metric: PullbackMetric2 }
impl Copy for PullbackSample2 {}

pub fn pullback_metric2(_ uu: f32, _ uv: f32, _ vv: f32, _ defined: bool) -> PullbackMetric2 {
    PullbackMetric2 { uu: uu, uv: uv, vv: vv, defined: defined }
}

pub fn pullback_sample2(_ parameter: Vec2F, _ metric: PullbackMetric2) -> PullbackSample2 {
    PullbackSample2 { parameter: parameter, metric: metric }
}

/// Principal local scale factors of one two-dimensional parameter-to-surface
/// map.
///
/// The pullback metric is `J^T J`, so its eigenvalue square roots are exactly
/// the singular values of the local transformation. This descriptor is small
/// enough to compute for every resident macro leaf and cache beside its stable
/// topology identity.
pub struct PullbackSpectrum2 {
    pub minimum_stretch: f32,
    pub maximum_stretch: f32,
    pub area_scale: f32,
    pub anisotropy: f32,
    pub defined: bool,
}
impl Copy for PullbackSpectrum2 {}

fn nonnegative(_ value: f32) -> f32 {
    if value > 0.0 { value } else { 0.0 }
}

fn minimum_f32(_ left: f32, _ right: f32) -> f32 {
    if left < right { left } else { right }
}

fn maximum_f32(_ left: f32, _ right: f32) -> f32 {
    if left > right { left } else { right }
}

/// Diagonalize one symmetric 2x2 pullback metric analytically.
///
/// `minimum_eigenvalue` is a squared-stretch floor. Degenerate, reflected,
/// and non-finite family samples should already have `metric.defined = false`;
/// the eigenvalue floor additionally prevents an unbounded anisotropy from
/// entering LoD or topology policy.
pub fn pullback_spectrum2(
    _ metric: PullbackMetric2,
    _ minimum_eigenvalue: f32,
) -> PullbackSpectrum2 {
    let trace = metric.uu + metric.vv
    let difference = metric.uu - metric.vv
    let discriminant = sqrt(
        nonnegative(difference * difference + 4.0 * metric.uv * metric.uv),
    )
    let minimum_eigen = 0.5 * (trace - discriminant)
    let maximum_eigen = 0.5 * (trace + discriminant)
    let determinant = pullback_determinant(metric)
    let defined = metric.defined
        && minimum_eigen >= minimum_eigenvalue
        && maximum_eigen >= minimum_eigen
        && determinant > 0.0
    if defined {
        let minimum_stretch = sqrt(minimum_eigen)
        let maximum_stretch = sqrt(maximum_eigen)
        PullbackSpectrum2 {
            minimum_stretch: minimum_stretch,
            maximum_stretch: maximum_stretch,
            area_scale: sqrt(determinant),
            anisotropy: maximum_stretch / minimum_stretch,
            defined: true,
        }
    } else {
        PullbackSpectrum2 {
            minimum_stretch: 0.0,
            maximum_stretch: 0.0,
            area_scale: 0.0,
            anisotropy: 0.0,
            defined: false,
        }
    }
}

/// Conservative variation summary over four leaf corners and its center.
///
/// The extrema have direct uses: maximum stretch bounds screen-space demand,
/// minimum stretch detects collapse, area range guides density allocation,
/// and maximum anisotropy chooses whether a leaf should split preferentially
/// along one parameter axis.
pub struct PullbackCellProfile2 {
    pub minimum_stretch: f32,
    pub maximum_stretch: f32,
    pub minimum_area_scale: f32,
    pub maximum_area_scale: f32,
    pub maximum_anisotropy: f32,
    pub stretch_variation: f32,
    pub area_variation: f32,
    pub metric_shape_variation: f32,
    pub defined: bool,
}
impl Copy for PullbackCellProfile2 {}

/// Frobenius distance between unit-trace metric shapes. Uniform scale drops
/// out; shear, anisotropy, and rotation of principal parameter directions do
/// not. This is the intrinsic twist signal available for every patch family
/// that can provide a positive tangent metric.
fn pullback_metric_shape_distance(
    _ left: PullbackMetric2,
    _ right: PullbackMetric2,
    _ minimum_trace: f32,
) -> f32 {
    let left_trace = left.uu + left.vv
    let right_trace = right.uu + right.vv
    if !left.defined
        || !right.defined
        || left_trace < minimum_trace
        || right_trace < minimum_trace {
        return 0.0
    }
    let delta_uu = left.uu / left_trace - right.uu / right_trace
    let delta_uv = left.uv / left_trace - right.uv / right_trace
    let delta_vv = left.vv / left_trace - right.vv / right_trace
    sqrt(
        delta_uu * delta_uu + 2.0 * delta_uv * delta_uv + delta_vv * delta_vv,
    )
}

pub fn pullback_cell_profile2(
    _ corner00: PullbackMetric2,
    _ corner10: PullbackMetric2,
    _ corner01: PullbackMetric2,
    _ corner11: PullbackMetric2,
    _ center: PullbackMetric2,
    _ minimum_eigenvalue: f32,
) -> PullbackCellProfile2 {
    let s00 = pullback_spectrum2(corner00, minimum_eigenvalue)
    let s10 = pullback_spectrum2(corner10, minimum_eigenvalue)
    let s01 = pullback_spectrum2(corner01, minimum_eigenvalue)
    let s11 = pullback_spectrum2(corner11, minimum_eigenvalue)
    let sc = pullback_spectrum2(center, minimum_eigenvalue)
    let minimum_stretch = minimum_f32(
        minimum_f32(
            minimum_f32(s00.minimum_stretch, s10.minimum_stretch),
            s01.minimum_stretch,
        ),
        minimum_f32(s11.minimum_stretch, sc.minimum_stretch),
    )
    let maximum_stretch = maximum_f32(
        maximum_f32(
            maximum_f32(s00.maximum_stretch, s10.maximum_stretch),
            s01.maximum_stretch,
        ),
        maximum_f32(s11.maximum_stretch, sc.maximum_stretch),
    )
    let minimum_area_scale = minimum_f32(
        minimum_f32(
            minimum_f32(s00.area_scale, s10.area_scale),
            s01.area_scale,
        ),
        minimum_f32(s11.area_scale, sc.area_scale),
    )
    let maximum_area_scale = maximum_f32(
        maximum_f32(
            maximum_f32(s00.area_scale, s10.area_scale),
            s01.area_scale,
        ),
        maximum_f32(s11.area_scale, sc.area_scale),
    )
    let maximum_anisotropy = maximum_f32(
        maximum_f32(
            maximum_f32(s00.anisotropy, s10.anisotropy),
            s01.anisotropy,
        ),
        maximum_f32(s11.anisotropy, sc.anisotropy),
    )
    let metric_shape_variation = maximum_f32(
        maximum_f32(
            pullback_metric_shape_distance(corner00, center, minimum_eigenvalue),
            pullback_metric_shape_distance(corner10, center, minimum_eigenvalue),
        ),
        maximum_f32(
            pullback_metric_shape_distance(corner01, center, minimum_eigenvalue),
            pullback_metric_shape_distance(corner11, center, minimum_eigenvalue),
        ),
    )
    let defined = s00.defined && s10.defined && s01.defined && s11.defined && sc.defined
    PullbackCellProfile2 {
        minimum_stretch: minimum_stretch,
        maximum_stretch: maximum_stretch,
        minimum_area_scale: minimum_area_scale,
        maximum_area_scale: maximum_area_scale,
        maximum_anisotropy: maximum_anisotropy,
        stretch_variation: if defined {
            maximum_stretch / minimum_stretch
        } else {
            0.0
        },
        area_variation: if defined {
            maximum_area_scale / minimum_area_scale
        } else {
            0.0
        },
        metric_shape_variation: if defined {
            metric_shape_variation
        } else {
            0.0
        },
        defined: defined,
    }
}

/// An oriented Euclidean differential with its already-derived pullback
/// metric. Patch families convert their native differential into this common
/// telemetry value without exposing their controls or algebra.
pub struct PatchTransformSample3 {
    pub tangent_u: Vec3F,
    pub tangent_v: Vec3F,
    pub normal: Vec3F,
    pub pullback: PullbackMetric2,
    pub defined: bool,
}
impl Copy for PatchTransformSample3 {}

pub fn patch_transform_sample3(
    _ tangent_u: Vec3F,
    _ tangent_v: Vec3F,
    _ minimum_normal_norm_squared: f32,
    _ defined: bool,
) -> PatchTransformSample3 {
    let normal_cross = cross3(tangent_u, tangent_v)
    let normal_norm_squared = dot3(normal_cross, normal_cross)
    let admitted = defined && normal_norm_squared >= minimum_normal_norm_squared
    let pullback = euclidean3_pullback_metric(tangent_u, tangent_v)
    PatchTransformSample3 {
        tangent_u: tangent_u,
        tangent_v: tangent_v,
        normal: normalize3_or(
            normal_cross,
            vec3f(0.0, 0.0, 1.0),
            minimum_normal_norm_squared,
        ),
        pullback: pullback_metric2(pullback.uu, pullback.uv, pullback.vv, admitted),
        defined: admitted,
    }
}

/// Cheap patch-leaf transformation telemetry.
///
/// `normal_turn` is zero for a planar consistently oriented leaf, one at a
/// right-angle turn, and two at an orientation reversal. `mixed_turn` is a
/// scale-normalized finite-difference estimate of the mixed derivative: it
/// detects a twisted parameter frame even when the five area scales happen to
/// agree. Neither quantity chooses topology by itself; they are stable inputs
/// to refinement and diagonal policies.
pub struct PatchTransformProfile3 {
    pub pullback: PullbackCellProfile2,
    pub minimum_normal_alignment: f32,
    pub normal_turn: f32,
    pub mixed_turn: f32,
    pub defined: bool,
}
impl Copy for PatchTransformProfile3 {}

/// Stable address of one square in a dyadic QuiltPatch hierarchy.
///
/// The address is geometry-neutral: a patch family supplies measurements for
/// the represented square, while this value supplies ancestry and boundary
/// identity. A terminal square can therefore be rendered by one pair of
/// Quilting atlas patches or replaced by its four children without changing
/// the meaning of the patch denotation.
pub struct DyadicPatchCell2 { pub depth: u32, pub x: u32, pub y: u32 }
impl Copy for DyadicPatchCell2 {}

pub const fn dyadic_patch_root2() -> DyadicPatchCell2 {
    DyadicPatchCell2 { depth: 0, x: 0, y: 0 }
}

/// Child order is lower-left, lower-right, upper-left, upper-right. The same
/// order is used by CPU, worker, and GPU planners so a leaf keeps one identity
/// when its realization backend changes.
pub const fn dyadic_patch_child2(_ parent: DyadicPatchCell2, _ child: u32) -> DyadicPatchCell2 {
    DyadicPatchCell2 {
        depth: parent.depth + 1,
        x: parent.x * 2 + child % 2,
        y: parent.y * 2 + child / 2,
    }
}

pub const fn dyadic_patch_parent2(_ child: DyadicPatchCell2) -> DyadicPatchCell2 {
    if child.depth == 0 {
        child
    } else {
        DyadicPatchCell2 { depth: child.depth - 1, x: child.x / 2, y: child.y / 2 }
    }
}

/// Number of breadth-addressed cells in a complete quadtree through `depth`.
/// This CTFE value sizes every backend realization from the same topology
/// contract; renderers do not maintain handwritten node-count tables.
pub const fn dyadic_patch_node_count(_ depth: usize) -> usize {
    let mut level: usize = 0
    let mut width: usize = 1
    let mut total: usize = 0
    while level <= depth {
        total = total + width
        width = width * 4
        level = level + 1
    }
    total
}

/// Side length of the finest dyadic occupancy lattice.
pub const fn dyadic_patch_fine_side(_ depth: usize) -> usize {
    1 << depth
}

/// First breadth-addressed node at one runtime depth.
pub const fn dyadic_patch_level_offset(_ depth: u32) -> u32 {
    let mut level: u32 = 0
    let mut width: u32 = 1
    let mut offset: u32 = 0
    while level < depth {
        offset = offset + width
        width = width * 4
        level = level + 1
    }
    offset
}

/// Stable breadth/Morton identity of one cell.
pub const fn dyadic_patch_node_index(_ cell: DyadicPatchCell2) -> u32 {
    let mut morton: u32 = 0
    let mut bit: u32 = 0
    while bit < cell.depth {
        morton = morton
            | ((cell.x >> bit) & 1) << (2 * bit)
            | ((cell.y >> bit) & 1) << (2 * bit + 1)
        bit = bit + 1
    }
    dyadic_patch_level_offset(cell.depth) + morton
}

/// Recover a dyadic cell from its breadth/Morton identity.
pub const fn dyadic_patch_cell_at_node(_ node: u32) -> DyadicPatchCell2 {
    let mut depth: u32 = 0
    let mut width: u32 = 1
    let mut offset: u32 = 0
    while node >= offset + width {
        offset = offset + width
        width = width * 4
        depth = depth + 1
    }
    let morton = node - offset
    let mut x: u32 = 0
    let mut y: u32 = 0
    let mut bit: u32 = 0
    while bit < depth {
        x = x | ((morton >> (2 * bit)) & 1) << bit
        y = y | ((morton >> (2 * bit + 1)) & 1) << bit
        bit = bit + 1
    }
    DyadicPatchCell2 { depth: depth, x: x, y: y }
}

static_assert(dyadic_patch_child2(dyadic_patch_root2(), 3).depth == 1)
static_assert(dyadic_patch_child2(dyadic_patch_root2(), 3).x == 1)
static_assert(dyadic_patch_child2(dyadic_patch_root2(), 3).y == 1)
static_assert(dyadic_patch_parent2(
        dyadic_patch_child2(dyadic_patch_child2(dyadic_patch_root2(), 2), 1),
    )
        .x
    == 0)
static_assert(dyadic_patch_node_count(0) == 1)
static_assert(dyadic_patch_node_count(4) == 341)
static_assert(dyadic_patch_node_count(6) == 5461)
static_assert(dyadic_patch_fine_side(6) == 64)
static_assert(dyadic_patch_node_index(DyadicPatchCell2 { depth: 3, x: 5, y: 2 }) == 46)
static_assert(dyadic_patch_cell_at_node(46).depth == 3)
static_assert(dyadic_patch_cell_at_node(46).x == 5)
static_assert(dyadic_patch_cell_at_node(46).y == 2)

/// Evidence consumed by recursive patch LoD.
///
/// `screen_error` is deliberately supplied by the renderer: the intrinsic
/// transformation profile is reusable across views, while projected demand
/// changes with camera and viewport. Keeping them distinct also permits an
/// offline topology bake to omit screen error entirely.
pub struct FractalPatchEvidence3 { pub transform: PatchTransformProfile3, pub screen_error: f32 }
impl Copy for FractalPatchEvidence3 {}

/// Explicit policy for deciding whether one measured square is terminal.
/// Every threshold is dimensionless except `maximum_screen_error`, whose unit
/// is chosen by the supplying renderer (normally physical backing pixels).
pub struct FractalPatchLodPolicy3 {
    pub maximum_depth: u32,
    pub maximum_screen_error: f32,
    pub maximum_stretch_variation: f32,
    pub maximum_area_variation: f32,
    pub maximum_anisotropy: f32,
    pub maximum_metric_shape_variation: f32,
    pub maximum_normal_turn: f32,
    pub maximum_mixed_turn: f32,
}
impl Copy for FractalPatchLodPolicy3 {}

/// A recursive QuiltPatch leaf is either rejected, drawn by an atlas pair, or
/// replaced by four measured children. This sum is the common contract for a
/// CPU tree, a worker planner, and a WebGPU work graph; no backend-specific
/// sentinel value leaks into topology policy.
pub enum FractalPatchLeafDecision {
    Reject,
    Draw,
    Refine,
}
impl Copy for FractalPatchLeafDecision {}

pub fn fractal_patch_leaf_decision3(
    _ cell: DyadicPatchCell2,
    _ evidence: FractalPatchEvidence3,
    _ policy: FractalPatchLodPolicy3,
) -> FractalPatchLeafDecision {
    if !evidence.transform.defined {
        if cell.depth < policy.maximum_depth {
            FractalPatchLeafDecision::Refine
        } else {
            FractalPatchLeafDecision::Reject
        }
    } else if cell.depth < policy.maximum_depth
        && (evidence.screen_error > policy.maximum_screen_error
            || evidence.transform.pullback.stretch_variation > policy.maximum_stretch_variation
            || evidence.transform.pullback.area_variation > policy.maximum_area_variation
            || evidence.transform.pullback.maximum_anisotropy > policy.maximum_anisotropy
            || evidence.transform.pullback.metric_shape_variation
                > policy.maximum_metric_shape_variation
            || evidence.transform.normal_turn > policy.maximum_normal_turn
            || evidence.transform.mixed_turn > policy.maximum_mixed_turn) {
        FractalPatchLeafDecision::Refine
    } else {
        FractalPatchLeafDecision::Draw
    }
}

fn average3(_ left: Vec3F, _ right: Vec3F) -> Vec3F {
    scale3(add3(left, right), 0.5)
}

pub fn patch_transform_profile3(
    _ corner00: PatchTransformSample3,
    _ corner10: PatchTransformSample3,
    _ corner01: PatchTransformSample3,
    _ corner11: PatchTransformSample3,
    _ center: PatchTransformSample3,
    _ minimum_eigenvalue: f32,
) -> PatchTransformProfile3 {
    let pullback = pullback_cell_profile2(
        corner00.pullback,
        corner10.pullback,
        corner01.pullback,
        corner11.pullback,
        center.pullback,
        minimum_eigenvalue,
    )
    let minimum_normal_alignment = minimum_f32(
        minimum_f32(
            minimum_f32(
                dot3(center.normal, corner00.normal),
                dot3(center.normal, corner10.normal),
            ),
            dot3(center.normal, corner01.normal),
        ),
        dot3(center.normal, corner11.normal),
    )
    let tangent_u_change = sub3(
        average3(corner01.tangent_u, corner11.tangent_u),
        average3(corner00.tangent_u, corner10.tangent_u),
    )
    let tangent_v_change = sub3(
        average3(corner10.tangent_v, corner11.tangent_v),
        average3(corner00.tangent_v, corner01.tangent_v),
    )
    let scale = center.pullback.uu + center.pullback.vv
    let defined = pullback.defined
        && corner00.defined
        && corner10.defined
        && corner01.defined
        && corner11.defined
        && center.defined
        && scale > minimum_eigenvalue
    PatchTransformProfile3 {
        pullback: pullback,
        minimum_normal_alignment: minimum_normal_alignment,
        normal_turn: if defined {
            1.0 - minimum_normal_alignment
        } else {
            0.0
        },
        mixed_turn: if defined {
            (length3(tangent_u_change) + length3(tangent_v_change)) / sqrt(scale)
        } else {
            0.0
        },
        defined: defined,
    }
}

/// Exact first fundamental form for a Euclidean three-space differential.
pub fn euclidean3_pullback_metric(_ tangent_u: Vec3F, _ tangent_v: Vec3F) -> PullbackMetric2 {
    pullback_metric2(
        dot3(tangent_u, tangent_u),
        dot3(tangent_u, tangent_v),
        dot3(tangent_v, tangent_v),
        true,
    )
}

/// First fundamental form estimated only from denotation and codomain
/// distance. The caller chooses two valid neighboring chart samples, so this
/// also serves non-Euclidean codomains without exposing tangent storage.
pub fn finite_pullback_metric<C: Codomain, M: CodomainMetric<C>>(
    _ origin: DenotationSample<C>,
    _ step_u: DenotationSample<C>,
    _ step_v: DenotationSample<C>,
    _ delta_u: f32,
    _ delta_v: f32,
    _ metric: M,
) -> PullbackMetric2 {
    if !origin.defined || !step_u.defined || !step_v.defined || delta_u <= 0.0 || delta_v <= 0.0 {
        return pullback_metric2(0.0, 0.0, 0.0, false)
    }
    let distance_u = metric.distance(origin.value, step_u.value)
    let distance_v = metric.distance(origin.value, step_v.value)
    let distance_uv = metric.distance(step_u.value, step_v.value)
    let uu = distance_u * distance_u / (delta_u * delta_u)
    let vv = distance_v * distance_v / (delta_v * delta_v)
    let uv = (distance_u * distance_u + distance_v * distance_v - distance_uv * distance_uv)
        / (2.0 * delta_u * delta_v)
    pullback_metric2(uu, uv, vv, true)
}

pub fn pullback_determinant(_ metric: PullbackMetric2) -> f32 {
    metric.uu * metric.vv - metric.uv * metric.uv
}

/// Squared local surface distance of one chart displacement.
pub fn pullback_distance_squared(_ metric: PullbackMetric2, _ delta: Vec2F) -> f32 {
    metric.uu * delta.x * delta.x
        + 2.0 * metric.uv * delta.x * delta.y
        + metric.vv * delta.y * delta.y
}

/// Symmetric quadrilateral metric used by an edge-flip decision.
///
/// Averaging the four vertex tensors makes the result independent of which
/// diagonal is currently resident. This prevents the remesher from encoding
/// its own history into a varying-metric tie.
pub fn average_pullback_metric4(
    _ first: PullbackMetric2,
    _ second: PullbackMetric2,
    _ third: PullbackMetric2,
    _ fourth: PullbackMetric2,
) -> PullbackMetric2 {
    pullback_metric2(
        (first.uu + second.uu + third.uu + fourth.uu) * 0.25,
        (first.uv + second.uv + third.uv + fourth.uv) * 0.25,
        (first.vv + second.vv + third.vv + fourth.vv) * 0.25,
        first.defined && second.defined && third.defined && fourth.defined,
    )
}

pub fn average_pullback_metric2(
    _ first: PullbackMetric2,
    _ second: PullbackMetric2,
) -> PullbackMetric2 {
    pullback_metric2(
        (first.uu + second.uu) * 0.5,
        (first.uv + second.uv) * 0.5,
        (first.vv + second.vv) * 0.5,
        first.defined && second.defined,
    )
}

/// Symmetric local-distance estimate used by deformation-aware Poisson
/// exclusion. The midpoint-rule tensor is approximated by endpoint averaging,
/// so reversing a candidate pair cannot change admission.
pub fn pullback_sample_distance_squared(
    _ first: PullbackSample2,
    _ second: PullbackSample2,
) -> f32 {
    let metric = average_pullback_metric2(first.metric, second.metric)
    pullback_distance_squared(
        metric,
        Vec2F {
            x: second.parameter.x - first.parameter.x,
            y: second.parameter.y - first.parameter.y,
        },
    )
}

pub fn pullback_poisson_conflict(
    _ first: PullbackSample2,
    _ first_radius_squared: f32,
    _ second: PullbackSample2,
    _ second_radius_squared: f32,
) -> bool {
    let radius_squared = if first_radius_squared > second_radius_squared {
        first_radius_squared
    } else {
        second_radius_squared
    }
    first.metric.defined
        && second.metric.defined
        && pullback_sample_distance_squared(first, second) < radius_squared
}

fn chart_orientation(_ first: Vec2F, _ second: Vec2F, _ third: Vec2F) -> f32 {
    (second.x - first.x) * (third.y - first.y) - (second.y - first.y) * (third.x - first.x)
}

fn metric_lift(_ metric: PullbackMetric2, _ point: Vec2F, _ query: Vec2F) -> f32 {
    pullback_distance_squared(
        metric,
        Vec2F { x: point.x - query.x, y: point.y - query.y },
    )
}

/// Anisotropic incircle determinant in an oriented chart.
///
/// For a constant positive-definite metric this is exactly ordinary Delaunay
/// after the metric's affine square-root transform. Positive means `query` is
/// inside the first triangle's metric circumellipse. A varying surface uses a
/// symmetric local tensor, normally `average_pullback_metric4`, and retains
/// chart orientation rather than projecting a possibly folded 3D quad.
pub fn pullback_incircle_value(
    _ metric: PullbackMetric2,
    _ first: Vec2F,
    _ second: Vec2F,
    _ third: Vec2F,
    _ query: Vec2F,
) -> f32 {
    if !metric.defined || pullback_determinant(metric) <= 0.0 {
        return 0.0
    }
    let first_x = first.x - query.x
    let first_y = first.y - query.y
    let second_x = second.x - query.x
    let second_y = second.y - query.y
    let third_x = third.x - query.x
    let third_y = third.y - query.y
    let first_second = first_x * second_y - second_x * first_y
    let second_third = second_x * third_y - third_x * second_y
    let third_first = third_x * first_y - first_x * third_y
    let determinant = metric_lift(metric, first, query) * second_third
        + metric_lift(metric, second, query) * third_first
        + metric_lift(metric, third, query) * first_second
    let winding = chart_orientation(first, second, third)
    if winding < 0.0 {
        -determinant
    } else if winding > 0.0 { determinant } else { 0.0 }
}

// ---------------------------------------------------------------------------
// Metric-parametric projective patches
// ---------------------------------------------------------------------------

/// Runtime coefficients that admit affine combination. A concrete sparse
/// Clifford element implements this once; every interpolation scheme can then
/// blend it without knowing its blades, metric, or physical representation.
pub trait LinearElement: Copy {
    fn plus(self, _ right: Self) -> Self
    fn scaled(self, _ scale: f32) -> Self
}

/// The algebraic half of a rational/projective patch model.
///
/// `Metric` is static type data. A CGA, PGA, QCGA, or custom model closes this
/// associated type over its named basis metric and implements the two products
/// below with `ga_expr` FCO. `Point`, `Weight`, and `Numerator` are independently
/// chosen sparse elements; the framework never assumes an even weight or a
/// grade-one point. Consequently the emitted shader carries coefficients only,
/// never a runtime metric or blade tag.
pub trait ProjectiveAlgebra: Copy {
    type Metric
    type Point: Copy
    type Weight: LinearElement
    type Numerator: LinearElement
    type Quotient: Copy
    type Policy: Copy

    fn weighted_point(self, _ point: Self::Point, _ weight: Self::Weight) -> Self::Numerator

    fn right_quotient(
        self,
        _ numerator: Self::Numerator,
        _ denominator: Self::Weight,
        _ policy: Self::Policy,
    ) -> QuotientSample<Self::Quotient>
}

/// A conditioned algebraic quotient before model-specific admission.
pub struct QuotientSample<Q: Copy> { pub value: Q, pub denominator_measure: f32, pub defined: bool }
impl<Q: Copy> Copy for QuotientSample<Q> {}

/// Project a quotient into one geometric model.
///
/// This is deliberately separate from the metric and products. CGA may
/// normalize a null point, PGA may select a finite affine chart, and QCGA may
/// admit a quadric element or field value. Failed chart/grade/null conditions
/// remain explicit in the returned denotation.
pub trait ProjectiveAdmission<A: ProjectiveAlgebra>: Copy {
    type Codomain: Codomain

    fn admit(
        self,
        _ quotient: QuotientSample<A::Quotient>,
        _ policy: A::Policy,
    ) -> DenotationSample<Self::Codomain>
}

/// One control whose point and weight element are fixed by algebra `A`.
pub struct ProjectiveControl<A: ProjectiveAlgebra> { pub point: A::Point, pub weight: A::Weight }
impl<A: ProjectiveAlgebra> Copy for ProjectiveControl<A> {}

pub fn projective_control<A: ProjectiveAlgebra>(
    _ point: A::Point,
    _ weight: A::Weight,
) -> ProjectiveControl<A> {
    ProjectiveControl<A> { point: point, weight: weight }
}

/// Tensor-product bilinear control order 00, 10, 01, 11.
pub struct BilinearProjectiveControls<A: ProjectiveAlgebra> {
    pub p00: ProjectiveControl<A>,
    pub p10: ProjectiveControl<A>,
    pub p01: ProjectiveControl<A>,
    pub p11: ProjectiveControl<A>,
}
impl<A: ProjectiveAlgebra> Copy for BilinearProjectiveControls<A> {}

pub fn bilinear_projective_controls<A: ProjectiveAlgebra>(
    _ p00: ProjectiveControl<A>,
    _ p10: ProjectiveControl<A>,
    _ p01: ProjectiveControl<A>,
    _ p11: ProjectiveControl<A>,
) -> BilinearProjectiveControls<A> {
    BilinearProjectiveControls<A> { p00: p00, p10: p10, p01: p01, p11: p11 }
}

/// Linear triangular control order A, B, C.
pub struct TriangularProjectiveControls<A: ProjectiveAlgebra> {
    pub a: ProjectiveControl<A>,
    pub b: ProjectiveControl<A>,
    pub c: ProjectiveControl<A>,
}
impl<A: ProjectiveAlgebra> Copy for TriangularProjectiveControls<A> {}

pub fn triangular_projective_controls<A: ProjectiveAlgebra>(
    _ a: ProjectiveControl<A>,
    _ b: ProjectiveControl<A>,
    _ c: ProjectiveControl<A>,
) -> TriangularProjectiveControls<A> {
    TriangularProjectiveControls<A> { a: a, b: b, c: c }
}

/// Numerator and denominator after interpolation but before division.
pub struct RationalFrame<A: ProjectiveAlgebra> {
    pub numerator: A::Numerator,
    pub denominator: A::Weight,
}
impl<A: ProjectiveAlgebra> Copy for RationalFrame<A> {}

fn bilinear_blend<T: LinearElement>(
    _ p00: T,
    _ p10: T,
    _ p01: T,
    _ p11: T,
    _ parameter: Vec2F,
) -> T {
    let one_minus_s = 1.0 - parameter.x
    let one_minus_t = 1.0 - parameter.y
    p00.scaled(one_minus_s * one_minus_t)
        .plus(p10.scaled(parameter.x * one_minus_t))
        .plus(p01.scaled(one_minus_s * parameter.y))
        .plus(p11.scaled(parameter.x * parameter.y))
}

fn triangular_blend<T: LinearElement>(_ a: T, _ b: T, _ c: T, _ parameter: Bary3F) -> T {
    a.scaled(parameter.a).plus(b.scaled(parameter.b)).plus(c.scaled(parameter.c))
}

/// An interpolation policy maps typed controls and a parameter to one rational
/// frame. Algebra and interpolation are independent static choices.
pub trait ProjectiveInterpolation<
    A: ProjectiveAlgebra,
    Controls: Copy,
    Domain: ParameterDomain,
>: Copy {
    const CONTROL_COUNT: usize

    fn frame(
        self,
        _ algebra: A,
        _ controls: Controls,
        _ parameter: <Domain as ParameterDomain>::Parameter,
    ) -> RationalFrame<A>
}

/// Degree-(1,1) tensor-product Bernstein interpolation.
pub struct BilinearBernstein {}
impl Copy for BilinearBernstein {}

impl<A: ProjectiveAlgebra> ProjectiveInterpolation<
    A,
    BilinearProjectiveControls<A>,
    UnitSquare,
> for BilinearBernstein {
    const CONTROL_COUNT: usize = 4

    fn frame(
        self,
        _ algebra: A,
        _ controls: BilinearProjectiveControls<A>,
        _ parameter: Vec2F,
    ) -> RationalFrame<A> {
        RationalFrame<A> {
            numerator: bilinear_blend<A::Numerator>(
                algebra.weighted_point(controls.p00.point, controls.p00.weight),
                algebra.weighted_point(controls.p10.point, controls.p10.weight),
                algebra.weighted_point(controls.p01.point, controls.p01.weight),
                algebra.weighted_point(controls.p11.point, controls.p11.weight),
                parameter,
            ),
            denominator: bilinear_blend<A::Weight>(
                controls.p00.weight,
                controls.p10.weight,
                controls.p01.weight,
                controls.p11.weight,
                parameter,
            ),
        }
    }
}

/// Varying-metric Delaunay value over one candidate quadrilateral.
///
/// All four tensors participate symmetrically, so the predicate is unchanged
/// when the resident and proposed diagonals trade places. The exact chart
/// topology still decides convexity and boundary constraints separately.
/// This local symmetry does not provide a global descent measure when the
/// metric varies between neighboring quadrilaterals. Do not use it alone as
/// the acceptance rule of an iterative flip loop; pair it with a terminating
/// potential or a cycle detector.
pub fn varying_pullback_incircle_value(
    _ first: PullbackSample2,
    _ second: PullbackSample2,
    _ third: PullbackSample2,
    _ query: PullbackSample2,
) -> f32 {
    pullback_incircle_value(
        average_pullback_metric4(first.metric, second.metric, third.metric, query.metric),
        first.parameter,
        second.parameter,
        third.parameter,
        query.parameter,
    )
}

/// Degree-one barycentric interpolation over a triangle.
pub struct LinearBarycentric {}
impl Copy for LinearBarycentric {}

impl<A: ProjectiveAlgebra> ProjectiveInterpolation<
    A,
    TriangularProjectiveControls<A>,
    BarycentricTriangle,
> for LinearBarycentric {
    const CONTROL_COUNT: usize = 3

    fn frame(
        self,
        _ algebra: A,
        _ controls: TriangularProjectiveControls<A>,
        _ parameter: Bary3F,
    ) -> RationalFrame<A> {
        RationalFrame<A> {
            numerator: triangular_blend<A::Numerator>(
                algebra.weighted_point(controls.a.point, controls.a.weight),
                algebra.weighted_point(controls.b.point, controls.b.weight),
                algebra.weighted_point(controls.c.point, controls.c.weight),
                parameter,
            ),
            denominator: triangular_blend<A::Weight>(
                controls.a.weight,
                controls.b.weight,
                controls.c.weight,
                parameter,
            ),
        }
    }
}

/// Static composition of algebra, interpolation, and projective admission.
/// Closing these three types is the complete shader specialization key.
pub struct ProjectiveKernel<
    A: ProjectiveAlgebra,
    I: ProjectiveInterpolation<A, Controls, Domain>,
    P: ProjectiveAdmission<A>,
    Controls: Copy,
    Domain: ParameterDomain,
> { pub algebra: A, pub interpolation: I, pub admission: P, pub domain: Domain }

impl<
    A: ProjectiveAlgebra,
    I: ProjectiveInterpolation<A, Controls, Domain>,
    P: ProjectiveAdmission<A>,
    Controls: Copy,
    Domain: ParameterDomain,
> Copy for ProjectiveKernel<A, I, P, Controls, Domain> {}

impl<
    A: ProjectiveAlgebra,
    I: ProjectiveInterpolation<A, Controls, Domain>,
    P: ProjectiveAdmission<A>,
    Controls: Copy,
    Domain: ParameterDomain,
> PatchKernel for ProjectiveKernel<A, I, P, Controls, Domain> {
    type Controls = Controls
    type Domain = Domain
    type Codomain = P::Codomain
    type Policy = A::Policy
    const CONTROL_COUNT: usize = I::CONTROL_COUNT

    fn denote(
        self,
        _ controls: Controls,
        _ parameter: <Domain as ParameterDomain>::Parameter,
        _ policy: A::Policy,
    ) -> DenotationSample<P::Codomain> {
        let frame = self.interpolation.frame(self.algebra, controls, parameter)
        let quotient = self.algebra.right_quotient(frame.numerator, frame.denominator, policy)
        self.admission.admit(quotient, policy)
    }
}

pub fn projective_patch<
    A: ProjectiveAlgebra,
    I: ProjectiveInterpolation<A, Controls, Domain>,
    P: ProjectiveAdmission<A>,
    Controls: Copy,
    Domain: ParameterDomain,
>(
    _ algebra: A,
    _ interpolation: I,
    _ admission: P,
    _ domain: Domain,
    _ controls: Controls,
) -> Patch<ProjectiveKernel<A, I, P, Controls, Domain>> {
    Patch<ProjectiveKernel<A, I, P, Controls, Domain>> {
