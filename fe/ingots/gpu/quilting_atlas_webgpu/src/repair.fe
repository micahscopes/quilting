//! Parallel constrained Delaunay repair. A winning flip owns its two faces
//! AND every neighboring face whose edge links it reads or writes.
//! Proposals, claims, winner snapshots, and mutations are separate dispatches.
use std::webgpu::{StorageBuffer, AtomicStorageBuffer, ComputeInvocation}
use quilting_atlas::scan::block_count
use quilting_atlas::planar::{PlanarCoordinates, orientation}
use super::{
    InteriorEdgeFlipPolicy, DelaunayRestoration, INVALID_VERTEX,
    POINT_WORDS, TRIANGLE_WORDS, TOPOLOGY_TWIN_WORDS_PER_TRIANGLE,
    triangle_load, triangle_store, triangle_directed_edge,
    load_packed_point, flippable_pair_with_policy, initialize_resident_twins,
    resident_face_pair_twins, disconnect_resident_face, reconnect_resident_face_pair,
}

// State: points, triangles, applied flips, remaining illegal edges,
// invariant failures, converged, rounds, source valid.
pub const STATE_WORDS:usize=8
pub const SUMMARY_WORDS:usize=3
const ACTIVE:u32=1
const FAILED:u32=2

fn running(_ state:StorageBuffer<u32,STATE_WORDS>)->bool {
    state.load(index:4)==0 && state.load(index:5)==0 && state.load(index:7)!=0
}

/// The index initializer is still scalar. It runs once, not once per flip;
/// parallel incidence construction is a separate remaining pipeline task.
pub fn initialize<P:InteriorEdgeFlipPolicy,const S:usize,const T:usize,const H:usize,const I:usize>(
    _ key:P::Key, _ valid:bool, _ point_count:u32, _ face_count:u32,
    _ points:StorageBuffer<u32,S>, _ triangles:StorageBuffer<u32,T>,
    _ twins:StorageBuffer<u32,H>, _ index:StorageBuffer<u32,I>,
    _ state:StorageBuffer<u32,STATE_WORDS>,
)
where {S%POINT_WORDS==0}, {T%TRIANGLE_WORDS==0},
    {H==T/TRIANGLE_WORDS*TOPOLOGY_TWIN_WORDS_PER_TRIANGLE}, {I>=S/POINT_WORDS+H}
{
    state.store(index:0,value:point_count)
    state.store(index:1,value:face_count)
    state.store(index:2,value:0)
    state.store(index:3,value:0)
    state.store(index:4,value:0)
    state.store(index:5,value:0)
    state.store(index:6,value:0)
    state.store(index:7,value:if valid {1} else {0})
    if !valid || point_count>(S/3).downcast_truncate() || face_count>(T/4).downcast_truncate() {
        state.store(index:4,value:1)
        return
    }
    let mut errors:u32=0
    let mut face:u32=0
    while face<face_count {
        let t=triangle_load<T>(triangles,face)
        if !t.valid || t.first>=point_count || t.second>=point_count || t.third>=point_count
            || t.first==t.second || t.first==t.third || t.second==t.third {errors=errors+1}
        else if orientation(load_packed_point<P::Point,S>(points,t.first).coordinates(),
            load_packed_point<P::Point,S>(points,t.second).coordinates(),
            load_packed_point<P::Point,S>(points,t.third).coordinates())<=0 {errors=errors+1}
        face=face+1
    }
    if errors==0 {errors=initialize_resident_twins<P::Key,S,T,H,I>(key,face_count,triangles,twins,index)}
    state.store(index:4,value:errors)
}

pub fn reset_claims<const F:usize>(
    _ state:StorageBuffer<u32,STATE_WORDS>, _ claims:AtomicStorageBuffer<F>, _ i:ComputeInvocation,
) {
    if i.global.x<F.downcast_truncate() && running(state) {claims.atomic_store(index:i.global.x,value:INVALID_VERTEX)}
}

pub fn propose<P:InteriorEdgeFlipPolicy,const S:usize,const T:usize,const H:usize>(
    _ key:P::Key, _ policy:P, _ points:StorageBuffer<u32,S>, _ triangles:StorageBuffer<u32,T>,
    _ twins:StorageBuffer<u32,H>, _ flags:StorageBuffer<u32,H>, _ results:StorageBuffer<u32,H>,
    _ state:StorageBuffer<u32,STATE_WORDS>, _ i:ComputeInvocation,
)
where {S%POINT_WORDS==0}, {T%TRIANGLE_WORDS==0}, {H==T/TRIANGLE_WORDS*TOPOLOGY_TWIN_WORDS_PER_TRIANGLE}
{
    let slot=i.global.x
    if slot>=H.downcast_truncate() {return}
    flags.store(index:slot,value:0)
    results.store(index:slot,value:0)
    if !running(state) {return}
    let edges=state.load(index:1)*3
    if slot>=edges {return}
    let twin=twins.load(index:slot)
    if twin==INVALID_VERTEX {
        let directed=triangle_directed_edge(key,triangle_load<T>(triangles,slot/3),slot/3,slot%3)
        if !directed.valid || !directed.constrained {flags.store(index:slot,value:FAILED)}
        return
    }
    if twin>=edges || twins.load(index:twin)!=slot || twin/3==slot/3 {
        flags.store(index:slot,value:FAILED)
        return
    }
    if slot>twin {return}
    let pair=flippable_pair_with_policy<P,S>(key,policy,points,
        triangle_load<T>(triangles,slot/3),slot/3,slot%3,
        triangle_load<T>(triangles,twin/3),twin/3,twin%3)
    if pair.valid {flags.store(index:slot,value:ACTIVE)}
}

/// Eight entries include duplicates: the pair and its six old neighboring
/// faces. Repeated minimum claims are harmless. Invalid boundary slots vanish.
fn neighborhood_face<const H:usize>(
    _ twins:StorageBuffer<u32,H>, _ slot:u32, _ entry:u32, _ edges:u32,
)->u32 {
    let twin=twins.load(index:slot)
    if entry==0 {return slot/3}
    if entry==1 {return twin/3}
    let local=entry-2
    let side=if local<3 {slot/3*3+local} else {twin/3*3+local-3}
    let neighbor=twins.load(index:side)
    if neighbor<edges {neighbor/3} else {INVALID_VERTEX}
}

pub fn claim<const F:usize,const H:usize>(
    _ twins:StorageBuffer<u32,H>, _ flags:StorageBuffer<u32,H>,
    _ state:StorageBuffer<u32,STATE_WORDS>, _ claims:AtomicStorageBuffer<F>, _ i:ComputeInvocation,
)
where {H==F*3}
{
    let slot=i.global.x
    if slot>=H.downcast_truncate() || !running(state) {return}
    if flags.load(index:slot)!=ACTIVE {return}
    let mut n:u32=0
    while n<8 {
        let face=neighborhood_face<H>(twins,slot,n,state.load(index:1)*3)
        if face!=INVALID_VERTEX {claims.atomic_min(index:face,value:slot)}
        n=n+1
    }
}

pub fn select<const F:usize,const H:usize>(
    _ twins:StorageBuffer<u32,H>, _ flags:StorageBuffer<u32,H>, _ results:StorageBuffer<u32,H>,
    _ state:StorageBuffer<u32,STATE_WORDS>, _ claims:AtomicStorageBuffer<F>, _ i:ComputeInvocation,
)
where {H==F*3}
{
    let slot=i.global.x
    if slot>=H.downcast_truncate() || !running(state) {return}
    if flags.load(index:slot)!=ACTIVE {return}
    let mut n:u32=0
    let mut owns=true
    while n<8 && owns {
        let face=neighborhood_face<H>(twins,slot,n,state.load(index:1)*3)
        if face!=INVALID_VERTEX && claims.atomic_load(index:face)!=slot {owns=false}
        n=n+1
    }
    results.store(index:slot,value:if owns {ACTIVE} else {0})
}

pub fn apply<P:InteriorEdgeFlipPolicy,const S:usize,const T:usize,const H:usize>(
    _ key:P::Key, _ policy:P, _ points:StorageBuffer<u32,S>, _ triangles:StorageBuffer<u32,T>,
    _ twins:StorageBuffer<u32,H>, _ results:StorageBuffer<u32,H>,
    _ state:StorageBuffer<u32,STATE_WORDS>, _ i:ComputeInvocation,
)
where {S%POINT_WORDS==0}, {T%TRIANGLE_WORDS==0}, {H==T/TRIANGLE_WORDS*TOPOLOGY_TWIN_WORDS_PER_TRIANGLE}
{
    let slot=i.global.x
    if slot>=H.downcast_truncate() || !running(state) {return}
    // Losers read no topology here: selected flips may already be mutating it.
    if results.load(index:slot)!=ACTIVE {return}
    let twin=twins.load(index:slot)
    let first=slot/3
    let second=twin/3
    let pair=flippable_pair_with_policy<P,S>(key,policy,points,
        triangle_load<T>(triangles,first),first,slot%3,
        triangle_load<T>(triangles,second),second,twin%3)
    let mut errors:u32=0
    if pair.valid {
        let previous=resident_face_pair_twins<H>(first,second,twins)
        disconnect_resident_face<H>(first,twins)
        disconnect_resident_face<H>(second,twins)
        triangle_store<T>(triangles,first,pair.first)
        triangle_store<T>(triangles,second,pair.second)
        errors=reconnect_resident_face_pair<P::Key,T,H>(key,first,second,state.load(index:1),triangles,twins,previous)
    } else {errors=1}
    results.store(index:slot,value:if errors==0 {ACTIVE} else {FAILED})
}

pub fn summarize<const H:usize,const TILE:usize,const B:usize>(
    _ flags:StorageBuffer<u32,H>, _ results:StorageBuffer<u32,H>,
    _ state:StorageBuffer<u32,STATE_WORDS>, _ blocks:StorageBuffer<u32,B>, _ i:ComputeInvocation,
)
where H>0, H<=0x3fffffff, TILE>0, TILE<=65536, {B==((H+TILE-1)/TILE)*SUMMARY_WORDS}
{
    let tile:u32=TILE.downcast_truncate()
    let edges=state.load(index:1)*3
    let block=i.global.x
    if !running(state) || block>=block_count(edges,tile) {return}
    let first=block*tile
    let end=if edges-first<tile {edges} else {first+tile}
    let mut active:u32=0
    let mut applied:u32=0
    let mut errors:u32=0
    let mut slot=first
    while slot<end {
        let flag=flags.load(index:slot)
        let result=results.load(index:slot)
        if flag==ACTIVE {active=active+1}
        if result==ACTIVE {applied=applied+1}
        if flag==FAILED {errors=errors+1}
        if result==FAILED {errors=errors+1}
        slot=slot+1
    }
    blocks.store(index:block*3,value:active)
    blocks.store(index:block*3+1,value:applied)
    blocks.store(index:block*3+2,value:errors)
}

/// A final observation round (final=true) recomputes illegality after the last
/// mutation. Exhaustion never reports the pre-flip violation count as current.
pub fn advance<const H:usize,const TILE:usize,const B:usize>(
    _ state:StorageBuffer<u32,STATE_WORDS>, _ blocks:StorageBuffer<u32,B>, _ final:bool,
)
where H>0, H<=0x3fffffff, TILE>0, TILE<=65536, {B==((H+TILE-1)/TILE)*SUMMARY_WORDS}
{
    if !running(state) {return}
    let count=block_count(state.load(index:1)*3,TILE.downcast_truncate())
    let mut active:u32=0
    let mut applied:u32=0
    let mut errors:u32=0
    let mut block:u32=0
    while block<count {
        active=active+blocks.load(index:block*3)
        applied=applied+blocks.load(index:block*3+1)
        errors=errors+blocks.load(index:block*3+2)
        block=block+1
    }
    if !final {
        if active!=0 && applied==0 && errors==0 {errors=errors+1}
        let flips=state.load(index:2)
        let rounds=state.load(index:6)
        if applied>0xffffffff-flips || rounds==0xffffffff {errors=errors+1}
        else {
            state.store(index:2,value:flips+applied)
            state.store(index:6,value:rounds+1)
        }
    }
    state.store(index:3,value:active)
    state.store(index:4,value:errors)
    if active==0 && errors==0 {state.store(index:5,value:1)}
}

pub fn receipt(_ state:StorageBuffer<u32,STATE_WORDS>)->DelaunayRestoration {
    let errors=state.load(index:4)
    let remaining=state.load(index:3)
    let converged=state.load(index:5)!=0
    DelaunayRestoration {
        valid:state.load(index:7)!=0 && converged && errors==0 && remaining==0,
        converged:converged, resident_points:state.load(index:0), resident_triangles:state.load(index:1),
        flips:state.load(index:2),remaining_violations:remaining,invariant_failures:errors,
    }
}
