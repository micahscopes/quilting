//! Main-actor ownership of independent canonical jobs and retained packed tiles.
//! Calls here must run to completion on one Wasm actor; never suspend while
//! holding this mutable provider. Worker modules own separate generation memory.
use core::{BrowserPtr, BrowserList, alloc_browser_object, alloc_browser_bytes}
use core::marker::Copy
use super::{JobQueue, Claim, Completion, Lease, PackedTile}
use quilting_atlas::canonical_key_at
use quilting_atlas::quad::QuadAtlasJobs

pub const MAX_TILES: usize = 1200
pub const RETAINED_WORDS: u32 = 16777216
pub const RETAINED_CAPACITY: usize = RETAINED_WORDS as usize

pub struct TileKey { pub square: bool, pub a: u32, pub b: u32, pub c: u32, pub d: u32 }
impl Copy for TileKey {}
pub struct TileEntry { pub offset: u32, pub words: u32, pub points: u32, pub triangles: u32 }
impl Copy for TileEntry {}
pub enum TileLookup { NotReady, OutOfRange, Ready(PackedTile) }
/// A consumer's acknowledged prefix, reset when its physical storage is lost.
pub struct RetainedCursor { pub epoch: u32, pub words: u32 }
impl Copy for RetainedCursor {}
pub struct RetainedRange {
    pub epoch: u32, pub revision: u32, pub word_offset: u32,
    pub words: BrowserList<u32, RETAINED_CAPACITY>,
}
pub enum RetainedUpdate { Unchanged, InvalidCursor, Ready(RetainedRange) }
pub struct PoolSummary {
    pub epoch: u32, pub total: u32, pub completed: u32, pub words: u32,
    pub points: u32, pub triangles: u32, pub status: u32,
}
impl Copy for PoolSummary {}

pub struct AtlasPool<const N: usize> {
    queue: JobQueue<N>,
    keys: [TileKey; MAX_TILES],
    entries: [TileEntry; MAX_TILES],
    summary: PoolSummary,
    storage: u32,
}

/// A handle into the owning actor's retained arena, not a live memory borrow.
/// Each method opens and closes its typed provider before returning. It may
/// cross an await only while that actor and arena remain alive; arena reset or
/// actor destruction invalidates it. It must never be sent to another worker.
pub struct PoolHandle<const N: usize> { address: u32 }
impl<const N: usize> Copy for PoolHandle<N> {}
impl<const N: usize> PoolHandle<N> {
    pub fn from_address(_ address: u32) -> Self { Self { address: address } }
    pub fn claim(self, _ slot: u32) -> Claim {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::claim<N>(slot) }
    }
    pub fn key(self, _ ordinal: u32) -> TileKey {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::key<N>(ordinal) }
    }
    pub fn tile(self, _ ordinal: u32) -> TileLookup {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::tile<N>(ordinal) }
    }
    pub fn entry(self, _ ordinal: u32) -> TileEntry {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::entry<N>(ordinal) }
    }
    pub fn updates_since(self, _ cursor: RetainedCursor) -> RetainedUpdate {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::updates_since<N>(cursor) }
    }
    pub fn finish(self, _ lease: Lease, _ tile: PackedTile) -> Completion {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::finish<N>(lease, tile) }
    }
    pub fn cancel(self) {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::cancel<N>() }
    }
    pub fn summary(self) -> PoolSummary {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::summary<N>() }
    }
    /// Promote a not-yet-issued key without changing any live lease or tile.
    /// Pending ordinals are queue positions, not stable cache identities.
    pub fn prioritize(self, _ requested: TileKey) -> bool {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::prioritize<N>(requested) }
    }
    pub fn find(self, _ requested: TileKey) -> u32 {
        let p: BrowserPtr<AtlasPool<N>> = BrowserPtr::from_u32(self.address)
        with (p) { ingot::pool::find<N>(requested) }
    }
}

fn same_key(_ a: TileKey, _ b: TileKey) -> bool {
    a.square == b.square && a.a == b.a && a.b == b.b && a.c == b.c && a.d == b.d
}

/// Look up by semantic key after any priority edits. Issued/retained entries
/// never move; only not-yet-issued keys can exchange queue positions.
pub fn find<const N: usize>(_ requested: TileKey) -> u32 uses (pool: AtlasPool<N>) {
    for i in 0 .. (pool.summary.total as usize) {
        if same_key(pool.keys[i], requested) { return i.downcast_truncate() }
    }
    0xffffffff
}

pub fn prioritize<const N: usize>(_ requested: TileKey) -> bool uses (pool: mut AtlasPool<N>) {
    if pool.summary.status != 0 { return false }
    let pending = pool.queue.unclaimed()
    if pending == 0 { return false }
    let last = (pending - 1) as usize
    for i in 0 .. (pending as usize) {
        if same_key(pool.keys[i], requested) {
            let displaced = pool.keys[last]
            pool.keys[last] = pool.keys[i]
            pool.keys[i] = displaced
            return true
        }
    }
    false
}

pub fn create<const N: usize>(_ epoch: u32, _ maximum_lod: u32) -> BrowserPtr<AtlasPool<N>> {
    let ptr = alloc_browser_object<AtlasPool<N>>()
    if ptr.address() == 0 { return ptr }
    with (ptr) { initialize<N>(epoch, maximum_lod) }
    ptr
}

/// Generate an explicit set of primary tiles, not the whole direct atlas.
/// Initially ordinals follow the caller's order. Explicit `prioritize` may
/// reorder unissued keys; consumers using it must resolve via `find`. No hidden
/// deduplication or density promotion occurs. The retained copy owns its input.
pub fn create_jobs<const N: usize, const M: usize>(
    _ epoch: u32, _ keys: own [TileKey; M],
) -> BrowserPtr<AtlasPool<N>> {
    let ptr = alloc_browser_object<AtlasPool<N>>()
    if ptr.address() == 0 { return ptr }
    with (ptr) { initialize_jobs<N, M>(epoch, keys) }
    ptr
}

fn initialize_jobs<const N: usize, const M: usize>(_ epoch: u32, _ keys: [TileKey; M])
uses (pool: mut AtlasPool<N>) {
    initialize_storage<N>(epoch)
    if pool.summary.status != 0 { return }
    if M == 0 || M > MAX_TILES {
        pool.summary.status = 2
        return
    }
    for i in 0 .. M {
        let k = keys[i]
        if k.a > 8 || k.b > 8 || k.c > 8 || k.d > 8 {
            pool.summary.status = 2
            return
        }
        pool.keys[i] = k
        pool.entries[i] = TileEntry { offset: 0, words: 0, points: 0, triangles: 0 }
    }
    pool.summary.total = M.downcast_truncate()
    pool.queue = JobQueue::new(epoch, pool.summary.total)
}

fn initialize_storage<const N: usize>(_ epoch: u32)
uses (pool: mut AtlasPool<N>) {
    pool.summary = PoolSummary { epoch: epoch, total: 0, completed: 0,
        words: 0, points: 0, triangles: 0, status: 0 }
    pool.storage = 0
    pool.queue = JobQueue::new(epoch, 0)
    if N == 0 {
        pool.summary.status = 2
        return
    }
    let bytes = alloc_browser_bytes(RETAINED_WORDS * 4 + 3)
    if bytes.address() == 0 {
        pool.summary.status = 3
        return
    }
    pool.storage = (bytes.address() + 3) & 0xfffffffc
}

fn initialize<const N: usize>(_ epoch: u32, _ maximum_lod: u32)
uses (pool: mut AtlasPool<N>) {
    initialize_storage<N>(epoch)
    if pool.summary.status != 0 { return }
    if maximum_lod > 8 {
        pool.summary.status = 2
        return
    }
    let mut count: u32 = 0
    for ordinal in 0 .. 165 {
        let key = canonical_key_at(ordinal)
        if key.c <= maximum_lod {
            pool.keys[count as usize] = TileKey { square: false, a: key.a, b: key.b, c: key.c, d: 0 }
            count += 1
        }
    }
    let mut jobs = QuadAtlasJobs::new(maximum_lod)
    let mut job = jobs.next()
    while job.valid {
        let key = job.key
        pool.keys[count as usize] = TileKey { square: true,
            a: key.bottom, b: key.right, c: key.top, d: key.left }
        count += 1
        job = jobs.next()
    }
    for ordinal in 0 .. (count as usize) {
        pool.entries[ordinal] = TileEntry { offset: 0, words: 0, points: 0, triangles: 0 }
    }
    pool.summary.total = count
    pool.queue = JobQueue::new(epoch, count)
}

pub fn claim<const N: usize>(_ slot: u32) -> Claim uses (pool: mut AtlasPool<N>) {
    if pool.summary.status == 1 { return Claim::Cancelled }
    if pool.summary.status != 0 { return Claim::Failed }
    pool.queue.claim(slot)
}
pub fn key<const N: usize>(_ ordinal: u32) -> TileKey uses (pool: AtlasPool<N>) {
    if ordinal >= pool.summary.total {
        return TileKey { square: false, a: 9, b: 9, c: 9, d: 9 }
    }
    pool.keys[ordinal as usize]
}
pub fn summary<const N: usize>() -> PoolSummary uses (pool: AtlasPool<N>) { pool.summary }
pub fn entry<const N: usize>(_ ordinal: u32) -> TileEntry uses (pool: AtlasPool<N>) {
    if ordinal >= pool.summary.total {
        return TileEntry { offset: 0, words: 0, points: 0, triangles: 0 }
    }
    pool.entries[ordinal as usize]
}
pub fn storage<const N: usize>() -> u32 uses (pool: AtlasPool<N>) { pool.storage }

/// Borrow all newly retained words, including updates coalesced between frames.
/// This is an append-only prefix: upload at word_offset, then acknowledge its
/// end only after successful consumption. An old epoch requests a complete
/// replay. Device recovery likewise supplies a fresh cursor, not an old GPU
/// receipt. No allocation, copy, scheduling or graphics policy occurs here.
pub fn updates_since<const N: usize>(_ cursor: RetainedCursor) -> RetainedUpdate
uses (pool: AtlasPool<N>) {
    let offset = if cursor.epoch == pool.summary.epoch { cursor.words } else { 0 }
    if offset > pool.summary.words { return RetainedUpdate::InvalidCursor }
    if offset == pool.summary.words { return RetainedUpdate::Unchanged }
    RetainedUpdate::Ready(RetainedRange {
        epoch: pool.summary.epoch, revision: pool.summary.completed, word_offset: offset,
        words: BrowserList { ptr: BrowserPtr::from_u32(pool.storage + offset * 4),
            len: pool.summary.words - offset },
    })
}

/// Borrow a published tile from the owning actor's retained storage. No copy or
/// allocation is performed. The descriptor lives only as long as this pool's
/// arena; callers must copy/finish upload before reset or actor destruction.
/// A cancelled batch retains already published tiles, but never publishes late
/// results. An unissued/unpublished ordinal is not an empty successful tile.
pub fn tile<const N: usize>(_ ordinal: u32) -> TileLookup uses (pool: AtlasPool<N>) {
    if ordinal >= pool.summary.total { return TileLookup::OutOfRange }
    let item = pool.entries[ordinal as usize]
    if item.words == 0 { return TileLookup::NotReady }
    TileLookup::Ready(PackedTile { status: 0, points: item.points, triangles: item.triangles,
        words: BrowserList { ptr: BrowserPtr::from_u32(pool.storage + item.offset * 4),
            len: item.words } })
}

pub fn cancel<const N: usize>() uses (pool: mut AtlasPool<N>) {
    if pool.summary.total > 0 && pool.summary.completed == pool.summary.total { return }
    pool.queue.cancel()
    pool.summary.status = 1
}

/// The input descriptor is borrowed only for this non-suspending call. Copy it
/// into the retained atlas before the canonical response arena can be reclaimed.
pub fn finish<const N: usize>(_ lease: Lease, _ tile: PackedTile) -> Completion
uses (pool: mut AtlasPool<N>) {
    let valid = tile.status == 0 && tile.points > 0 && tile.points <= 65536
        && tile.triangles > 0 && tile.triangles <= 131072
        && tile.words.len == tile.points + (tile.triangles * 3 + 1) / 2
        && tile.words.ptr.address() != 0 && (tile.words.ptr.address() & 3) == 0
        && pool.summary.words <= RETAINED_WORDS
        && tile.words.len <= RETAINED_WORDS - pool.summary.words
    let result = pool.queue.finish(lease, valid)
    match result {
    Completion::Accepted => {
        let offset = pool.summary.words
        let mut source = tile.words.ptr.address()
        let mut destination = pool.storage + offset * 4
        for _ in 0 .. (tile.words.len as usize) {
            let src: BrowserPtr<u32> = BrowserPtr::from_u32(source)
            let dst: BrowserPtr<u32> = BrowserPtr::from_u32(destination)
            dst.write(src.read())
            source += 4
            destination += 4
        }
        pool.entries[lease.ordinal as usize] = TileEntry { offset: offset,
            words: tile.words.len, points: tile.points, triangles: tile.triangles }
        pool.summary.words += tile.words.len
        pool.summary.points += tile.points
        pool.summary.triangles += tile.triangles
        pool.summary.completed = pool.queue.completed()
        Completion::Accepted
    },
    Completion::Failed => {
        pool.summary.status = 4
        Completion::Failed
    },
    Completion::Stale => Completion::Stale,
    Completion::Invalid => Completion::Invalid,
    }
}
