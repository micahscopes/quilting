//! Pure policy and real retained-selection Wasm acceptance exports.
use core::option::Option
use quilting_domain::bary3f
use composite_atlas::model::{initial_controls,edge_demand,edge_lods}
use quilting_atlas_wasm::{Claim,Completion,packed_triangle}
use quilting_atlas_wasm::pool::PoolHandle
use quilting_patch::arc_length::{CumulativeLengthSamples,inverse_length}
use quilting_patch::sampling_warp::{InverseCumulativeMap,OrientedIntervalMap,IntervalSamplingMap}
use quilting_atlas::composition::{BoundaryUse,ChildTriangle,SquareEdgeLods}
extern {const fn __f32_from_i32(_:i32)->f32}

pub fn whole_composition_warp_laws()->bool {
    use composite_atlas::composition_warp::policy
    use composite_atlas::model::Point
    let mut c=initial_controls()
    for kind in [0.0,1.0,2.0] {
        c.surface_kind=kind
        c.composition_concentration=1.0
        c.composition_twist=0.0
        let p=Point {x:0.2,y:0.3}
        let neutral=policy(c).apply(p)
        if neutral.x!=p.x || neutral.y!=p.y {return false}
        for mode in [0.0,1.0,2.0] {
            c.composition_falloff=mode
            c.composition_twist=2.0
            c.composition_concentration=1.7
            let warp=policy(c)
            for i in 0..17 {
                let t=__f32_from_i32(i.downcast_unchecked())/16.0
                for edge in 0..4 {
                    let b=if edge==0 {Point {x:t,y:0.0}}
                        else if edge==1 {if kind==1.0 {Point {x:1.0-t,y:t}} else {Point {x:1.0,y:t}}}
                        else if edge==2 && kind!=1.0 {Point {x:t,y:1.0}}
                        else {Point {x:0.0,y:t}}
                    let q=warp.apply(b)
                    if q.x!=b.x || q.y!=b.y {return false}
                }
            }
            // An interior point on the quad's original diagonal MUST move:
            // the post-map must not preserve every child contour separately.
            let p=Point {x:0.2,y:0.2}
            let q=warp.apply(p)
            if !(q.x>=0.0 && q.y>=0.0 && q.x<=1.0 && q.y<=1.0) {return false}
            if kind==1.0 && q.x+q.y>1.000001 {return false}
            if fmath::abs(q.x-p.x)+fmath::abs(q.y-p.y)<0.001 {return false}
        }
    }
    true
}

struct InvertedLine {first:f32,last_x:f32,last_y:f32}
impl core::marker::Copy for InvertedLine {}
impl quilting_patch::arc_spacing::CircularArcMeasure for InvertedLine {
    fn magnitude(self,_ t:f32)->f32 {
        let x=self.first*(1.0-t)+self.last_x*t
        let y=self.last_y*t
        fmath::sqrt(x*x+y*y)
    }
    fn regular(self,_ a:f32,_ b:f32)->bool {
        let ax=self.first*(1.0-a)+self.last_x*a
        let bx=self.first*(1.0-b)+self.last_x*b
        let ay=self.last_y*a
        let by=self.last_y*b
        let x=if ax*bx<=0.0 {0.0} else {fmath::min(fmath::abs(ax),fmath::abs(bx))}
        let y=if ay*by<=0.0 {0.0} else {fmath::min(fmath::abs(ay),fmath::abs(by))}
        x*x+y*y>0.000000000001
    }
}
pub fn dyadic_arc_parameter(_ first:f32,_ x:f32,_ y:f32,_ index:u32)->f32 {
    use quilting_patch::arc_spacing::{dyadic_arc_samples,IntervalMapSamples}
    match dyadic_arc_samples<InvertedLine,257>(InvertedLine {first:first,last_x:x,last_y:y}) {
        Option::Some(samples)=>samples.parameter(index),
        Option::None=>-1.0,
    }
}
pub fn dyadic_arc_nesting(_ first:f32,_ x:f32,_ y:f32)->bool {
    use quilting_patch::arc_spacing::{dyadic_arc_samples,IntervalMapSamples}
    let line=InvertedLine {first:first,last_x:x,last_y:y}
    match (dyadic_arc_samples<InvertedLine,129>(line),dyadic_arc_samples<InvertedLine,257>(line)) {
        (Option::Some(a),Option::Some(b))=>{
            for i in 0..129 {if a.parameter(i.downcast_truncate())!=b.parameter((i*2).downcast_truncate()) {return false}}
            true
        },
        _=>false,
    }
}

pub fn authored_uniform_arc(_ kind:u32,_ edge:u32,_ index:u32,_ lane:u32)->f32 {
    use quilting_patch::arc_spacing::{dyadic_arc_samples,IntervalMapSamples}
    use quilting_clifford_bezier::euclidean::EuclideanArcMeasure
    let mut c=initial_controls()
    c.surface_kind=if kind==0 {1.0} else {2.0}
    let net=composite_atlas::surface::authored(c)
    let (first,last)=if edge==0 {(net.a,net.b)}
        else if edge==1 {if kind==0 {(net.b,net.d)} else {(net.b,net.c)}}
        else if edge==2 && kind!=0 {(net.c,net.d)} else {(net.d,net.a)}
    let measure=EuclideanArcMeasure {first:first.weight,last:last.weight,minimum_denominator_norm_squared:0.000000000001}
    match dyadic_arc_samples<EuclideanArcMeasure,257>(measure) {
        Option::None=>-999.0,
        Option::Some(samples)=>{
            let t=samples.parameter(index)
            let (u,v)=if edge==0 {(t,0.0)}
                else if edge==1 {if kind==0 {(1.0-t,t)} else {(1.0,t)}}
                else if edge==2 && kind!=0 {(1.0-t,1.0)} else {(0.0,1.0-t)}
            let p=composite_atlas::surface::evaluate(net,composite_atlas::model::Point {x:u,y:v})
            if !p.valid {-999.0} else if lane==0 {p.point.x} else if lane==1 {p.point.y} else {p.point.z}
        },
    }
}

pub fn geometric_patch_view_laws()->bool {
    let mut c=initial_controls()
    for kind in [1.0,2.0] {
        c.surface_kind=kind
        let net=composite_atlas::surface::authored(c)
        if net.patch_valid!=1.0 {return false}
        let sample=composite_atlas::surface::evaluate(net,composite_atlas::model::Point {x:0.5,y:0.0})
        if !sample.valid || fmath::abs(sample.point.x-c.midpoint_x)>0.00001
            || fmath::abs(sample.point.y-c.midpoint_y)>0.00001
            || fmath::abs(sample.point.z-c.midpoint_z)>0.00001 {return false}
        for index in 0 .. 4 {
            if kind==1.0 && index==2 {continue}
            let id=index.downcast_truncate()
            let uv=composite_atlas::model::corner(id,0.5,0.5)
            let sample=composite_atlas::surface::evaluate(net,uv)
            let expected=composite_atlas::surface::point(c,id)
            if !sample.valid || fmath::abs(sample.point.x-expected.x)>0.00001
                || fmath::abs(sample.point.y-expected.y)>0.00001
                || fmath::abs(sample.point.z-expected.z)>0.00001 {return false}
        }
    }
    c.surface_kind=1.0
    c.p2x=0.0/0.0
    // The hidden fourth corner cannot invalidate a three-corner surface.
    if composite_atlas::surface::authored(c).patch_valid!=1.0 {return false}
    let child=composite_atlas::model::child(c,0)
    if child.a!=0 || child.b!=1 || child.c!=3 || composite_atlas::model::child_count(c)!=1 {return false}
    for level in 0 .. 9 {
        c.right_lod=__f32_from_i32(level.downcast_unchecked())
        if edge_lods(c).levels[5]!=level.downcast_truncate() {return false}
    }
    true
}
pub fn quality_laws()->bool {ingot::quality::laws()}
pub fn quality_case(_ case:u32,_ compensation:u32)->(u32,u32,u32,u32,f32,f32,f32,f32,f32,f32) {
    ingot::quality::audit(case,compensation)
}
pub fn quality_locality(_ case:u32,_ reach:f32)->(u32,u32,u32,u32,f32,f32,f32,f32,f32,f32) {
    ingot::quality::audit_with_locality(case,1,reach)
}
pub fn edge_skew_preserves_mass_and_shared_positions()->bool {
    let mut c=initial_controls()
    c.bottom_lod=1.0
    c.right_lod=6.0
    c.top_lod=8.0
    c.left_lod=0.0
    c.center_x=0.17
    c.center_y=0.83
    let counts=edge_lods(c)
    for skew in [0.25,1.0,4.0] {
        c.bottom_skew=skew
        c.right_skew=skew
        c.top_skew=skew
        c.left_skew=skew
        c.diagonal_02_skew=skew
        c.diagonal_13_skew=skew
        c.spoke_0_skew=skew
        c.spoke_1_skew=skew
        c.spoke_2_skew=skew
        c.spoke_3_skew=skew
        let changed=edge_lods(c)
        for slot in 0 .. 10 {if counts.levels[slot]!=changed.levels[slot] {return false}}
        for low in 0 .. 4 {
            for high in (low+1) .. 5 {
                let raw=composite_atlas::model::edge_measure(c,low.downcast_truncate(),high.downcast_truncate())
                let table=composite_atlas::model::edge_cdf(c,low.downcast_truncate(),high.downcast_truncate())
                if table.values[0]!=0.0 || table.values[16]!=raw.values[16] {return false}
                for i in 1 .. 17 {
                    if !(table.values[i]>table.values[i-1]) {return false}
                    if skew==1.0 && table.values[i]!=raw.values[i] {return false}
                }
                let law=InverseCumulativeMap {samples:table}
                let forward=OrientedIntervalMap {law:law,reversed:false}
                let reverse=OrientedIntervalMap {law:law,reversed:true}
                let mut last:f32=-1.0
                for i in 0 .. 257 {
                    let t=__f32_from_i32(i.downcast_unchecked())/256.0
                    let q=forward.canonical(t)
                    if !(q>last && q>=0.0 && q<=1.0) || q!=reverse.canonical(1.0-t) {return false}
                    last=q
                }
                let neutral=inverse_length(raw,0.5)
                let biased=law.map(0.5)
                if skew>1.0 && !(biased<neutral) {return false}
                if skew<1.0 && !(biased>neutral) {return false}
            }
        }
    }
    true
}
pub fn resolution_reports_visible_counts_and_caps()->bool {
    let mut c=initial_controls()
    c.bottom_lod=8.0
    c.right_lod=8.0
    c.top_lod=8.0
    c.left_lod=8.0
    c.split=0.0
    let r=composite_atlas::model::edge_resolution(c,edge_lods(c))
    if r.diagonal_02_segments!=256 || r.diagonal_13_segments!=0 || r.spoke_0_segments!=0
        || r.capped_edges!=1 || r.unmet_edges!=1 || !(r.max_unmet_segments>106.0 && r.max_unmet_segments<107.0) {return false}
    c.split=2.0
    let fan=composite_atlas::model::edge_resolution(c,edge_lods(c))
    if fan.diagonal_02_segments!=0 || fan.diagonal_13_segments!=0 || fan.spoke_0_segments!=256
        || fan.spoke_1_segments!=256 || fan.spoke_2_segments!=256 || fan.spoke_3_segments!=256
        || fan.capped_edges!=0 || fan.unmet_edges!=0 {return false}
    c.split=0.0
    c.automatic_interior=0.0
    c.diagonal_lod=0.0
    let manual=composite_atlas::model::edge_resolution(c,edge_lods(c))
    manual.diagonal_02_segments==1 && manual.capped_edges==0 && manual.unmet_edges==1
        && manual.max_unmet_segments>361.0
}
pub fn interior_policy_preserves_boundaries()->bool {
    let mut c=initial_controls()
    for focus in 0 .. 4 {
        c.focus_a=if focus==1 {4.0} else if focus==2 {0.1} else {1.0}
        c.focus_b=if focus==2 {4.0} else if focus==3 {0.1} else {1.0}
        c.focus_c=if focus==3 {4.0} else if focus==1 {0.1} else {1.0}
        for strength in [0.25,1.0,4.0] {
            for twist in [-3.14159265,0.0,3.14159265] {
                c.interior_concentration=strength
                c.interior_twist=twist
                let policy=composite_atlas::model::interior_policy(c)
                for i in 0 .. 257 {
                    let t=__f32_from_i32(i.downcast_unchecked())/256.0
                    for p in [bary3f(0.0,1.0-t,t),bary3f(t,0.0,1.0-t),bary3f(1.0-t,t,0.0)] {
                        let q=policy.apply(p)
                        if q.a!=p.a || q.b!=p.b || q.c!=p.c {return false}
                    }
                }
                for i in 0 .. 33 {
                    for j in 0 .. (33-i) {
                        let b=__f32_from_i32(i.downcast_unchecked())/32.0
                        let d=__f32_from_i32(j.downcast_unchecked())/32.0
                        let p=bary3f(1.0-b-d,b,d)
                        let q=policy.apply(p)
                        if !(q.a>=-0.00001 && q.b>=-0.00001 && q.c>=-0.00001
                            && q.a<=1.00001 && q.b<=1.00001 && q.c<=1.00001) {return false}
                        let sum=q.a+q.b+q.c
                        if !(sum>0.99999 && sum<1.00001) {return false}
                        if strength==1.0 && twist==0.0 && (q.a!=p.a || q.b!=p.b || q.c!=p.c) {return false}
                    }
                }
            }
        }
    }
    c.interior_enabled=0.0
    let p=bary3f(0.2,0.3,0.5)
    let q=composite_atlas::model::interior_policy(c).apply(p)
    q.a==p.a && q.b==p.b && q.c==p.c
}
pub fn boundary_admission()->bool {
    for a in 0 .. 6 {
        for b in 0 .. 6 {
            for c in 0 .. 6 {
                let triangle=ChildTriangle {a:a.downcast_truncate(),b:b.downcast_truncate(),c:c.downcast_truncate()}
                let valid=a<5 && b<5 && c<5 && a!=b && b!=c && c!=a
                let resolved=triangle.resolve(SquareEdgeLods {levels:[0;10]})
                let request=match resolved {
                    Option::Some(request)=>{if !valid {return false}
                        request},
                    Option::None=>{if valid {return false}
                        continue},
                }
                let boundaries=[request.boundaries.ab,request.boundaries.bc,request.boundaries.ca]
                for side in 0 .. 3 {
                    let raw=triangle.boundary(side.downcast_truncate()).unwrap()
                    if boundaries[side].slot()!=raw.square_slot().unwrap()
                        || boundaries[side].reversed()!=raw.reversed {return false}
                }
            }
        }
    }
    ChildTriangle {a:0,b:1,c:0xffffffff}.square_boundaries().is_none()
}
/// Exercise the same orientation abstraction as GPU storage views, with a
/// canonical CPU table. Dyadic inputs are exactly representable through LoD8.
pub fn warped_boundary_case(_ code:u32)->bool {
    let mut c=initial_controls()
    c.bottom_lod=__f32_from_i32((code%9).downcast_unchecked())
    c.right_lod=__f32_from_i32(((code/9)%9).downcast_unchecked())
    c.top_lod=__f32_from_i32(((code/81)%9).downcast_unchecked())
    c.left_lod=__f32_from_i32(((code/729)%9).downcast_unchecked())
    c.center_x=0.17
    c.center_y=0.83
    for low in 0 .. 4 {
        for high in (low+1) .. 5 {
            let edge=BoundaryUse::between(low.downcast_truncate(),high.downcast_truncate())
            if edge.square_slot().is_none() {return false}
            let law=InverseCumulativeMap {samples:composite_atlas::model::edge_cdf(c,edge.low,edge.high)}
            let forward=OrientedIntervalMap {law:law,reversed:false}
            let reverse=OrientedIntervalMap {law:law,reversed:true}
            if forward.map(0.0)!=0.0 || forward.map(1.0)!=1.0
                || reverse.map(0.0)!=0.0 || reverse.map(1.0)!=1.0 {return false}
            let mut previous=0.0
            for i in 0 .. 257 {
                let t=__f32_from_i32(i.downcast_unchecked())/256.0
                let q=forward.canonical(t)
                if q!=reverse.canonical(1.0-t) {return false}
                if i>0 && !(q>previous) {return false}
                previous=q
                // Local-coordinate output is not the shared placement path.
                if reverse.map(1.0-t)!=1.0-q {return false}
            }
        }
    }
    true
}
/// Inverse of the represented CDF, not an exact-integral accuracy claim.
pub fn spacing_case(_ code:u32)->(f32,f32,bool) {
    let mut controls=initial_controls()
    controls.bottom_lod=__f32_from_i32((code%9).downcast_unchecked())
    controls.right_lod=__f32_from_i32(((code/9)%9).downcast_unchecked())
    controls.top_lod=__f32_from_i32(((code/81)%9).downcast_unchecked())
    controls.left_lod=__f32_from_i32(((code/729)%9).downcast_unchecked())
    let cdf=composite_atlas::model::edge_cdf(controls,0,4)
    let total=cdf.cumulative(16)
    let mut previous=0.0
    let mut residual=0.0
    let mut monotone=true
    for i in 0 .. 257 {
        let fraction=__f32_from_i32(i.downcast_unchecked())/256.0
        let t=inverse_length(cdf,fraction)
        if i>0 && !(t>previous) {monotone=false}
        previous=t
        let mut low: u32=0
        while low<15 && t>__f32_from_i32((low+1).downcast_unchecked())/16.0 {low+=1}
        let local=t*16.0-__f32_from_i32(low.downcast_unchecked())
        let observed=(cdf.cumulative(low)+(cdf.cumulative(low+1)-cdf.cumulative(low))*local)/total
        let delta=observed-fraction
        let error=if delta<0.0 {-delta} else {delta}
        if error>residual {residual=error}
    }
    (residual,inverse_length(cdf,0.5),monotone)
}
pub fn uniform_case(_ level:u32)->(f32,f32,u32,u32) {
    let value=__f32_from_i32(level.downcast_unchecked())
    let mut c=initial_controls()
    c.bottom_lod=value
    c.top_lod=value
    c.left_lod=value
    c.right_lod=value
    let edges=edge_lods(c)
    (edge_demand(c,0,2),edge_demand(c,0,4),edges.levels[4],edges.levels[6])
}
pub fn outer_integrals()->(f32,f32,f32,f32) {
    let mut c=initial_controls()
    c.bottom_lod=0.0
    c.right_lod=3.0
    c.top_lod=5.0
    c.left_lod=8.0
    (edge_demand(c,0,1),edge_demand(c,1,2),edge_demand(c,2,3),edge_demand(c,3,0))
}
pub fn manual_values_survive_automatic()->bool {
    let mut c=initial_controls()
    c.diagonal_lod=7.0
    c.spoke_0_lod=1.0
    if edge_lods(c).levels[4]!=5 {return false}
    c.automatic_interior=0.0
    let e=edge_lods(c)
    e.levels[4]==7 && e.levels[6]==1 && c.diagonal_lod==7.0 && c.spoke_0_lod==1.0
}
pub fn coherent_pending_selection()->bool {
    coherent_pending_for_split(0.0) && coherent_pending_for_split(2.0)
}
fn coherent_pending_for_split(_ split:f32)->bool {
    let mut state=composite_atlas::residency::initial()
    state.controls.split=split
    state=composite_atlas::residency::refresh(state)
    let handle:PoolHandle<4> = PoolHandle::from_address(state.address)
    let lease=match handle.claim(0) {Claim::Job(v)=>v,_=>return false}
    let k=handle.key(lease.ordinal)
    let expected:u32=if split<0.5 {5} else {4}
    if k.a!=4 || k.b!=4 || k.c!=expected {return false}
    if let Completion::Accepted = handle.finish(lease,packed_triangle(k.a,k.b,k.c,42)) {} else {return false}
    // A pending request must still resolve when the relevant worker completes.
    state=composite_atlas::residency::refresh_completion(state)
    if state.pending!=0 || state.scene.vertices==0 || state.required_words==0 {return false}
    let visible=state.scene
    let required=state.required_words
    let completed=state.completed
    // Unrelated cache growth updates progress but does not expand the visible
    // upload prefix, change topology, or rebuild its spacing snapshot.
    handle.prioritize(quilting_atlas_wasm::pool::TileKey {square:false,a:0,b:0,c:0,d:0})
    let background=match handle.claim(0) {Claim::Job(v)=>v,_=>return false}
    let key=handle.key(background.ordinal)
    if key.a!=0 || key.b!=0 || key.c!=0 {return false}
    if let Completion::Accepted = handle.finish(background,packed_triangle(0,0,0,42)) {} else {return false}
    state=composite_atlas::residency::refresh_completion(state)
    if state.completed!=completed+1 || state.pending!=0 || state.status!=0 || state.required_words!=required
        || state.scene.vertices!=visible.vertices || state.scene.first.offset!=visible.first.offset
        || state.scene.second.offset!=visible.second.offset || state.scene.spacing_revision!=visible.spacing_revision
        || state.scene.active_center_x!=visible.active_center_x || state.scene.active_skews.spoke0!=visible.active_skews.spoke0
        || state.scene.resolution.spoke_0_segments!=visible.resolution.spoke_0_segments {return false}
    let revision=state.scene.spacing_revision
    state=composite_atlas::residency::refresh(state)
    if revision==0 || state.scene.spacing_revision!=revision {return false}
    state.controls.interior_concentration=2.0
    state=composite_atlas::residency::refresh(state)
    if state.pending!=0 || state.scene.interior.map.concentration!=2.0
        || state.scene.spacing_revision!=revision {return false}
    state.controls.spoke_0_skew=2.0
    state=composite_atlas::residency::refresh(state)
    if state.scene.spacing_revision!=revision+1 || state.scene.active_skews.spoke0!=2.0 {return false}
    state.controls.boundary_reach=0.25
    state=composite_atlas::residency::refresh(state)
    if state.scene.active_boundary_reach!=0.25 || state.scene.spacing_revision!=revision+1 {return false}
    let before=state.scene
    state.controls.bottom_lod=8.0
    state.controls.center_x=0.2
    state.controls.interior_concentration=4.0
    state.controls.interior_twist=1.7
    state.controls.focus_a=4.0
    state.controls.spoke_0_skew=4.0
    state.controls.boundary_reach=4.0
    state=composite_atlas::residency::refresh(state)
    state.pending>0 && state.scene.vertices==before.vertices && state.scene.active_center_x==before.active_center_x
        && state.scene.spacing_revision==before.spacing_revision && state.scene.active_bottom==before.active_bottom
        && state.scene.active_skews.spoke0==before.active_skews.spoke0
        && state.scene.active_boundary_reach==before.active_boundary_reach
        && state.scene.interior.map.concentration==before.interior.map.concentration
        && state.scene.interior.map.twist==before.interior.map.twist && state.scene.interior.focus.a==before.interior.focus.a
        && state.scene.resolution.diagonal_02_segments==before.resolution.diagonal_02_segments
        && state.scene.resolution.spoke_0_segments==before.resolution.spoke_0_segments
        && state.scene.resolution.max_unmet_segments==before.resolution.max_unmet_segments
}
