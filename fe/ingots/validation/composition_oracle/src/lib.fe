//! Pure policy and real retained-selection Wasm acceptance exports.
use core::option::Option
use quilting_domain::bary3f
use composite_atlas::model::{initial_controls,edge_demand,edge_lods}
use quilting_atlas_wasm::{Claim,Completion,packed_triangle}
use quilting_atlas_wasm::pool::PoolHandle
use quilting_patch::arc_length::{CumulativeLengthSamples,inverse_length}
use quilting_patch::sampling_warp::{InverseCumulativeMap,OrientedIntervalMap,IntervalSamplingMap}
use quilting_atlas::composition::{BoundaryUse,ChildTriangle,SquareEdgeLods}
extern {const fn __f32_from_i32(_:i32)->f32}
pub fn resolution_reports_visible_counts_and_caps()->bool {
    let mut c=initial_controls()
    c.bottom_lod=8.0
    c.right_lod=8.0
    c.top_lod=8.0
    c.left_lod=8.0
    c.split=0.0
    let r=composite_atlas::model::edge_resolution(c,edge_lods(c))
    if r.diagonal_02_segments!=256 || r.diagonal_13_segments!=0 || r.spoke_0_segments!=0
        || r.capped_edges!=1 || r.unmet_edges!=1 || !(r.max_unmet_segments>106.0 && r.max_unmet_segments<107.0) {return false}
    c.split=2.0
    let fan=composite_atlas::model::edge_resolution(c,edge_lods(c))
    if fan.diagonal_02_segments!=0 || fan.diagonal_13_segments!=0 || fan.spoke_0_segments!=256
        || fan.spoke_1_segments!=256 || fan.spoke_2_segments!=256 || fan.spoke_3_segments!=256
        || fan.capped_edges!=0 || fan.unmet_edges!=0 {return false}
    c.split=0.0
    c.automatic_interior=0.0
    c.diagonal_lod=0.0
    let manual=composite_atlas::model::edge_resolution(c,edge_lods(c))
    manual.diagonal_02_segments==1 && manual.capped_edges==0 && manual.unmet_edges==1
        && manual.max_unmet_segments>361.0
}
pub fn interior_policy_preserves_boundaries()->bool {
    let mut c=initial_controls()
    for focus in 0 .. 4 {
        c.focus_a=if focus==1 {4.0} else if focus==2 {0.1} else {1.0}
        c.focus_b=if focus==2 {4.0} else if focus==3 {0.1} else {1.0}
        c.focus_c=if focus==3 {4.0} else if focus==1 {0.1} else {1.0}
        for strength in [0.25,1.0,4.0] {
            for twist in [-3.14159265,0.0,3.14159265] {
                c.interior_concentration=strength
                c.interior_twist=twist
                let policy=composite_atlas::model::interior_policy(c)
                for i in 0 .. 257 {
                    let t=__f32_from_i32(i.downcast_unchecked())/256.0
                    for p in [bary3f(0.0,1.0-t,t),bary3f(t,0.0,1.0-t),bary3f(1.0-t,t,0.0)] {
                        let q=policy.apply(p)
                        if q.a!=p.a || q.b!=p.b || q.c!=p.c {return false}
                    }
                }
                for i in 0 .. 33 {
                    for j in 0 .. (33-i) {
                        let b=__f32_from_i32(i.downcast_unchecked())/32.0
                        let d=__f32_from_i32(j.downcast_unchecked())/32.0
                        let p=bary3f(1.0-b-d,b,d)
                        let q=policy.apply(p)
                        if !(q.a>=-0.00001 && q.b>=-0.00001 && q.c>=-0.00001
                            && q.a<=1.00001 && q.b<=1.00001 && q.c<=1.00001) {return false}
                        let sum=q.a+q.b+q.c
                        if !(sum>0.99999 && sum<1.00001) {return false}
                        if strength==1.0 && twist==0.0 && (q.a!=p.a || q.b!=p.b || q.c!=p.c) {return false}
                    }
                }
            }
        }
    }
    c.interior_enabled=0.0
    let p=bary3f(0.2,0.3,0.5)
    let q=composite_atlas::model::interior_policy(c).apply(p)
    q.a==p.a && q.b==p.b && q.c==p.c
}
pub fn boundary_admission()->bool {
    for a in 0 .. 6 {
        for b in 0 .. 6 {
            for c in 0 .. 6 {
                let triangle=ChildTriangle {a:a.downcast_truncate(),b:b.downcast_truncate(),c:c.downcast_truncate()}
                let valid=a<5 && b<5 && c<5 && a!=b && b!=c && c!=a
                let resolved=triangle.resolve(SquareEdgeLods {levels:[0;10]})
                let request=match resolved {
                    Option::Some(request)=>{if !valid {return false}
                        request},
                    Option::None=>{if valid {return false}
                        continue},
                }
                let boundaries=[request.boundaries.ab,request.boundaries.bc,request.boundaries.ca]
                for side in 0 .. 3 {
                    let raw=triangle.boundary(side.downcast_truncate()).unwrap()
                    if boundaries[side].slot()!=raw.square_slot().unwrap()
                        || boundaries[side].reversed()!=raw.reversed {return false}
                }
            }
        }
    }
    ChildTriangle {a:0,b:1,c:0xffffffff}.square_boundaries().is_none()
}
/// Exercise the same orientation abstraction as GPU storage views, with a
/// canonical CPU table. Dyadic inputs are exactly representable through LoD8.
pub fn warped_boundary_case(_ code:u32)->bool {
    let mut c=initial_controls()
    c.bottom_lod=__f32_from_i32((code%9).downcast_unchecked())
    c.right_lod=__f32_from_i32(((code/9)%9).downcast_unchecked())
    c.top_lod=__f32_from_i32(((code/81)%9).downcast_unchecked())
    c.left_lod=__f32_from_i32(((code/729)%9).downcast_unchecked())
    c.center_x=0.17
    c.center_y=0.83
    for low in 0 .. 4 {
        for high in (low+1) .. 5 {
            let edge=BoundaryUse::between(low.downcast_truncate(),high.downcast_truncate())
            if edge.square_slot().is_none() {return false}
            let law=InverseCumulativeMap {samples:composite_atlas::model::edge_cdf(c,edge.low,edge.high)}
            let forward=OrientedIntervalMap {law:law,reversed:false}
            let reverse=OrientedIntervalMap {law:law,reversed:true}
            if forward.map(0.0)!=0.0 || forward.map(1.0)!=1.0
                || reverse.map(0.0)!=0.0 || reverse.map(1.0)!=1.0 {return false}
            let mut previous=0.0
            for i in 0 .. 257 {
                let t=__f32_from_i32(i.downcast_unchecked())/256.0
                let q=forward.canonical(t)
                if q!=reverse.canonical(1.0-t) {return false}
                if i>0 && !(q>previous) {return false}
                previous=q
                // Local-coordinate output is not the shared placement path.
                if reverse.map(1.0-t)!=1.0-q {return false}
            }
        }
    }
    true
}
/// Inverse of the represented CDF, not an exact-integral accuracy claim.
pub fn spacing_case(_ code:u32)->(f32,f32,bool) {
    let mut controls=initial_controls()
    controls.bottom_lod=__f32_from_i32((code%9).downcast_unchecked())
    controls.right_lod=__f32_from_i32(((code/9)%9).downcast_unchecked())
    controls.top_lod=__f32_from_i32(((code/81)%9).downcast_unchecked())
    controls.left_lod=__f32_from_i32(((code/729)%9).downcast_unchecked())
    let cdf=composite_atlas::model::edge_cdf(controls,0,4)
    let total=cdf.cumulative(16)
    let mut previous=0.0
    let mut residual=0.0
    let mut monotone=true
    for i in 0 .. 257 {
        let fraction=__f32_from_i32(i.downcast_unchecked())/256.0
        let t=inverse_length(cdf,fraction)
        if i>0 && !(t>previous) {monotone=false}
        previous=t
        let mut low: u32=0
        while low<15 && t>__f32_from_i32((low+1).downcast_unchecked())/16.0 {low+=1}
        let local=t*16.0-__f32_from_i32(low.downcast_unchecked())
        let observed=(cdf.cumulative(low)+(cdf.cumulative(low+1)-cdf.cumulative(low))*local)/total
        let delta=observed-fraction
        let error=if delta<0.0 {-delta} else {delta}
        if error>residual {residual=error}
    }
    (residual,inverse_length(cdf,0.5),monotone)
}
pub fn uniform_case(_ level:u32)->(f32,f32,u32,u32) {
    let value=__f32_from_i32(level.downcast_unchecked())
    let mut c=initial_controls()
    c.bottom_lod=value
    c.top_lod=value
    c.left_lod=value
    c.right_lod=value
    let edges=edge_lods(c)
    (edge_demand(c,0,2),edge_demand(c,0,4),edges.levels[4],edges.levels[6])
}
pub fn outer_integrals()->(f32,f32,f32,f32) {
    let mut c=initial_controls()
    c.bottom_lod=0.0
    c.right_lod=3.0
    c.top_lod=5.0
    c.left_lod=8.0
    (edge_demand(c,0,1),edge_demand(c,1,2),edge_demand(c,2,3),edge_demand(c,3,0))
}
pub fn manual_values_survive_automatic()->bool {
    let mut c=initial_controls()
    c.diagonal_lod=7.0
    c.spoke_0_lod=1.0
    if edge_lods(c).levels[4]!=5 {return false}
    c.automatic_interior=0.0
    let e=edge_lods(c)
    e.levels[4]==7 && e.levels[6]==1 && c.diagonal_lod==7.0 && c.spoke_0_lod==1.0
}
pub fn coherent_pending_selection()->bool {
    coherent_pending_for_split(0.0) && coherent_pending_for_split(2.0)
}
fn coherent_pending_for_split(_ split:f32)->bool {
    let mut state=composite_atlas::residency::initial()
    state.controls.split=split
    state=composite_atlas::residency::refresh(state)
    let handle:PoolHandle<4> = PoolHandle::from_address(state.address)
    let lease=match handle.claim(0) {Claim::Job(v)=>v,_=>return false}
    let k=handle.key(lease.ordinal)
    let expected:u32=if split<0.5 {5} else {4}
    if k.a!=4 || k.b!=4 || k.c!=expected {return false}
    if let Completion::Accepted = handle.finish(lease,packed_triangle(k.a,k.b,k.c,42)) {} else {return false}
    state=composite_atlas::residency::refresh(state)
    if state.pending!=0 || state.scene.vertices==0 || state.required_words==0 {return false}
    let revision=state.scene.spacing_revision
    state=composite_atlas::residency::refresh(state)
    if revision==0 || state.scene.spacing_revision!=revision {return false}
    state.controls.interior_concentration=2.0
    state=composite_atlas::residency::refresh(state)
    if state.pending!=0 || state.scene.interior.map.concentration!=2.0
        || state.scene.spacing_revision!=revision {return false}
    let before=state.scene
    state.controls.bottom_lod=8.0
    state.controls.center_x=0.2
    state.controls.interior_concentration=4.0
    state.controls.interior_twist=1.7
    state.controls.focus_a=4.0
    state=composite_atlas::residency::refresh(state)
    state.pending>0 && state.scene.vertices==before.vertices && state.scene.active_center_x==before.active_center_x
        && state.scene.spacing_revision==before.spacing_revision && state.scene.active_bottom==before.active_bottom
        && state.scene.interior.map.concentration==before.interior.map.concentration
        && state.scene.interior.map.twist==before.interior.map.twist && state.scene.interior.focus.a==before.interior.focus.a
        && state.scene.resolution.diagonal_02_segments==before.resolution.diagonal_02_segments
        && state.scene.resolution.spoke_0_segments==before.resolution.spoke_0_segments
        && state.scene.resolution.max_unmet_segments==before.resolution.max_unmet_segments
}
