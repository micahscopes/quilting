    _ px: f32,
    _ py: f32,
    _ pz: f32,
    _ cx: f32,
    _ cy: f32,
    _ cz: f32,
    _ radius: f32,
) -> i32 {
    if cga_reflection_sample(px, py, pz, cx, cy, cz, radius).conditioned {
        1
    } else {
