pub fn reparameterized_patch_lane(_ b: f32, _ c: f32, _ strength: f32, _ lane: u32) -> f32 {
    let domain = TriangleDomain2 { a: vec2f(0.0,0.0), b: vec2f(1.0,0.0), c: vec2f(0.43,0.58) }
    let controls = triangular_projective_controls(paper_clifford_patch(),domain)
    let transformed = ProjectiveTriangleMap { weights: bary3f(1.0,1.0,strength) }
        .quadratic_patch<IsotropicCliffordAlgebra>(controls)
    let differential = evaluate_triangular_projective_differential(
        transformed,bary3f(1.0-b-c,b,c),clifford_policy(),0.000000000001)
    if lane == 0 { differential.sample.position.x }
    else if lane == 1 { differential.sample.position.y }
    else if lane == 2 { differential.sample.position.z }
    else if lane == 3 { differential.normal.x }
    else if lane == 4 { differential.normal.y }
    else { differential.normal.z }
}

pub fn sampling_interval_bias(_ t:f32,_ strength:f32)->f32 {interval_bias(t,strength)}

pub fn sampling_warp_lane(_ domain:u32,_ x:f32,_ y:f32,
    _ ea:f32,_ eb:f32,_ ec:f32,_ ed:f32,
    _ twist:f32,_ fx:f32,_ fy:f32,_ concentration:f32,_ lane:u32)->f32 {
    if domain==0 {
        let focus=bary3f(1.0/(1.0+fx+fy),fx/(1.0+fx+fy),fy/(1.0+fx+fy))
        let boundary=TriangleBoundaryWarp {a:ea,b:eb,c:ec}.map(bary3f(1.0-x-y,x,y))
        let rotated=InteriorTwist {angle:twist}.triangle(boundary,focus)
        let result=InteriorConcentration {strength:concentration}.triangle(rotated,focus)
        if lane==0 {result.b} else {result.c}
    } else {
        let focus=vec2f(fx/(1.0+fx),fy/(1.0+fy))
        let boundary=QuadBoundaryWarp {bottom:ea,right:eb,top:ec,left:ed}.map(vec2f(x,y))
        let rotated=InteriorTwist {angle:twist}.quad(boundary,focus)
        let result=InteriorConcentration {strength:concentration}.quad(rotated,focus)
        if lane==0 {result.x} else {result.y}
    }
}

pub fn projective_triangle_lane(
    _ a: f32, _ b: f32, _ c: f32, _ wa: f32, _ wb: f32, _ wc: f32, _ lane: u32,
) -> f32 {
    let result = ProjectiveTriangleMap { weights: bary3f(wa,wb,wc) }.map(bary3f(a,b,c))
    if lane == 0 { result.a } else if lane == 1 { result.b } else { result.c }
}

/// Exercise the production affine fan restriction and exact control pullback.
pub fn nested_fan_sample_lane(
    _ half:u32,_ child:u32,_ fb:f32,_ fc:f32,_ strength:f32,
    _ a:f32,_ b:f32,_ lane:u32,
)->f32 {
    let parent=if half==0 {
        TriangleDomain2 {a:vec2f(0.0,0.0),b:vec2f(1.0,0.0),c:vec2f(1.0,1.0)}
    } else {
        TriangleDomain2 {a:vec2f(0.0,0.0),b:vec2f(1.0,1.0),c:vec2f(0.0,1.0)}
    }
    let total=1.0+fb+fc
    let domain=TriangleFan3 {interior:bary3f(1.0/total,fb/total,fc/total)}.domain(parent,child)
    let map=ProjectiveTriangleMap {weights:bary3f(strength,1.0,1.0)}
    let bary=bary3f(a,b,1.0-a-b)
    let uv=triangle_parameter(domain,map.map(bary))
    if lane==0 {return uv.x}
    if lane==1 {return uv.y}
    if lane>=8 {
        let direct=evaluate_isotropic_differential(paper_clifford_patch(),uv,clifford_policy(),0.000000000001)
        if lane==8 {return direct.sample.position.x}
        if lane==9 {return direct.sample.position.y}
        if lane==10 {return direct.sample.position.z}
        if lane==11 {return direct.normal.x}
        if lane==12 {return direct.normal.y}
        return direct.normal.z
    }
    let controls=map.quadratic_patch<IsotropicCliffordAlgebra>(triangular_projective_controls(paper_clifford_patch(),domain))
    let sample=evaluate_triangular_projective_differential(controls,bary,clifford_policy(),0.000000000001)
    if lane==2 {sample.sample.position.x}
    else if lane==3 {sample.sample.position.y}
    else if lane==4 {sample.sample.position.z}
    else if lane==5 {sample.normal.x}
    else if lane==6 {sample.normal.y}
    else {sample.normal.z}
}

pub fn radial_fan_lane(
    _ a: f32, _ b: f32, _ c: f32, _ strength: f32,
    _ focus_a: f32, _ focus_b: f32, _ focus_c: f32, _ child: u32, _ lane: u32,
) -> f32 {
    let local = RadialTriangleMap { focus_weight: strength }.map(bary3f(a,b,c))
    let result = TriangleFan3 { interior: bary3f(focus_a,focus_b,focus_c) }.map(child,local)
    if lane == 0 { result.a } else if lane == 1 { result.b } else { result.c }
}

pub fn radial_warp_lane(_ a: f32, _ b: f32, _ c: f32, _ strength: f32, _ lane: u32) -> f32 {
    let result = RadialTriangleMap { focus_weight: strength }.map(bary3f(a,b,c))
    if lane == 0 { result.a } else if lane == 1 { result.b } else { result.c }
}

pub fn resolved_corner_scale(
    _ a: f32, _ b: f32, _ c: f32, _ d: f32, _ index: i32,
) -> f32 {
    let weights = BilinearCornerScales { w00: a, w10: b, w01: c, w11: d }.separable()
    if index == 0 { weights.w00 } else if index == 1 { weights.w10 }
    else if index == 2 { weights.w01 } else { weights.w11 }
}

pub fn tensor_chart_lane(_ a:f32,_ b:f32,_ c:f32,_ u:f32,_ v:f32,_ inverse:bool,_ lane:u32)->f32 {
    let chart=BilinearCornerScales {w00:a,w10:b,w01:c,w11:b*c/a}.parameter_map()
    let p=if inverse {chart.inverse().map(vec2f(u,v))} else {chart.map(vec2f(u,v))}
    if lane==0 {p.x} else {p.y}
}

fn input_bary(_ a: f32, _ b: f32, _ c: f32) -> Bary3F {
    bary3f(a, b, c)
}

pub fn tangent_triangle_quality(
    _ bx: f32, _ by: f32, _ bz: f32, _ cx: f32, _ cy: f32, _ cz: f32,
) -> f32 {
    measure_tangent_triangle3(vec3f(bx, by, bz), vec3f(cx, cy, cz)).quality
}

pub fn tangent_triangle_area(
    _ bx: f32, _ by: f32, _ bz: f32, _ cx: f32, _ cy: f32, _ cz: f32,
) -> f32 {
    measure_tangent_triangle3(vec3f(bx, by, bz), vec3f(cx, cy, cz)).area
}

pub fn tangent_triangle_defined(
    _ bx: f32, _ by: f32, _ bz: f32, _ cx: f32, _ cy: f32, _ cz: f32,
) -> i32 {
    if measure_tangent_triangle3(vec3f(bx, by, bz), vec3f(cx, cy, cz)).defined { 1 } else { 0 }
}

pub fn domain_cartesian_x(_ a: f32, _ b: f32, _ c: f32) -> f32 {
    bary_to_cartesian(input_bary(a, b, c)).x
}
pub fn domain_cartesian_y(_ a: f32, _ b: f32, _ c: f32) -> f32 {
    bary_to_cartesian(input_bary(a, b, c)).y
}
pub fn domain_bary_a(_ x: f32, _ y: f32) -> f32 {
    cartesian_to_bary(vec2f(x, y)).a
}
pub fn domain_bary_b(_ x: f32, _ y: f32) -> f32 {
    cartesian_to_bary(vec2f(x, y)).b
}
pub fn domain_bary_c(_ x: f32, _ y: f32) -> f32 {
    cartesian_to_bary(vec2f(x, y)).c
}
pub fn domain_contains(_ a: f32, _ b: f32, _ c: f32, _ tolerance: f32) -> i32 {
    if contains(input_bary(a, b, c), tolerance) {
        1
    } else {
        0
    }
}
pub fn domain_edge_parameter(_ edge: u32, _ a: f32, _ b: f32, _ c: f32) -> f32 {
    match edge {
        0 => edge_parameter(EdgeId::BC, input_bary(a, b, c)),
        1 => edge_parameter(EdgeId::CA, input_bary(a, b, c)),
        _ => edge_parameter(EdgeId::AB, input_bary(a, b, c)),
    }
}
pub fn domain_admit_a(_ a: f32, _ b: f32, _ c: f32, _ epsilon: f32) -> f32 {
    admit_barycentric(input_bary(a, b, c), epsilon).value.a
}
pub fn domain_admit_b(_ a: f32, _ b: f32, _ c: f32, _ epsilon: f32) -> f32 {
    admit_barycentric(input_bary(a, b, c), epsilon).value.b
}
pub fn domain_admit_c(_ a: f32, _ b: f32, _ c: f32, _ epsilon: f32) -> f32 {
    admit_barycentric(input_bary(a, b, c), epsilon).value.c
}
pub fn domain_admit_valid(_ a: f32, _ b: f32, _ c: f32, _ epsilon: f32) -> i32 {
    if admit_barycentric(input_bary(a, b, c), epsilon).valid {
        1
    } else {
        0
    }
}

fn left_quat(_ w: f32, _ x: f32, _ y: f32, _ z: f32) -> QuatF {
    quatf(w, x, y, z)
}
fn right_quat(_ w: f32, _ x: f32, _ y: f32, _ z: f32) -> QuatF {
    quatf(w, x, y, z)
}
fn product(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> QuatF {
    multiply(left_quat(aw, ax, ay, az), right_quat(bw, bx, by, bz))
}
pub fn quaternion_multiply_w(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> f32 {
    product(aw, ax, ay, az, bw, bx, by, bz).w
}
pub fn quaternion_multiply_x(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> f32 {
    product(aw, ax, ay, az, bw, bx, by, bz).x
}
pub fn quaternion_multiply_y(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> f32 {
    product(aw, ax, ay, az, bw, bx, by, bz).y
}
pub fn quaternion_multiply_z(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> f32 {
    product(aw, ax, ay, az, bw, bx, by, bz).z
}

fn bounded_inverse(
    _ w: f32,
    _ x: f32,
    _ y: f32,
    _ z: f32,
    _ minimum: f32,
) -> quilting_quaternion::QuatInverse {
    inverse_bounded(quatf(w, x, y, z), minimum)
}
pub fn quaternion_inverse_w(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> f32 {
    bounded_inverse(w, x, y, z, minimum).value.w
}
pub fn quaternion_inverse_x(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> f32 {
    bounded_inverse(w, x, y, z, minimum).value.x
}
pub fn quaternion_inverse_y(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> f32 {
    bounded_inverse(w, x, y, z, minimum).value.y
}
pub fn quaternion_inverse_z(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> f32 {
    bounded_inverse(w, x, y, z, minimum).value.z
}
pub fn quaternion_inverse_valid(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> i32 {
    if bounded_inverse(w, x, y, z, minimum).valid {
        1
    } else {
        0
    }
}

fn curved_patch() -> QbTriPatch {
    patch(
        control(vec3f(-0.75, -0.25, 0.1), quatf(1.0, 0.2, -0.1, 0.05)),
        control(vec3f(0.8, -0.15, -0.2), quatf(0.9, -0.15, 0.25, 0.1)),
        control(vec3f(0.05, 0.9, 0.35), quatf(1.1, 0.1, 0.05, -0.2)),
    )
}

fn flat_patch() -> QbTriPatch {
    let identity = quatf(1.0, 0.0, 0.0, 0.0)
    patch(
        control(vec3f(0.0, 0.0, 0.0), identity),
        control(vec3f(1.0, 0.0, 0.0), identity),
        control(vec3f(0.0, 1.0, 0.0), identity),
    )
}

fn zero_weight_patch() -> QbTriPatch {
    let weight = zero()
    patch(
        control(vec3f(0.0, 0.0, 0.0), weight),
        control(vec3f(1.0, 0.0, 0.0), weight),
        control(vec3f(0.0, 1.0, 0.0), weight),
    )
}

fn curved(_ u: f32, _ v: f32) -> quilting_qb::QbDifferential {
    evaluate_uv_differential(
        curved_patch(),
        u,
        v,
        0.00000000000000000001,
        0.000000000001,
    )
}

fn curved_typed_patch(_ u: f32, _ v: f32) -> DenotationSample<Euclidean3Points> {
    denote(
        typed_qb_patch(curved_patch()),
        bary3f(1.0 - u - v, u, v),
        QbPolicy { minimum_denominator_norm_squared: 0.00000000000000000001 },
    )
}

fn zero_weight_typed_patch(_ u: f32, _ v: f32) -> DenotationSample<Euclidean3Points> {
    denote(
        typed_qb_patch(zero_weight_patch()),
        bary3f(1.0 - u - v, u, v),
        QbPolicy { minimum_denominator_norm_squared: 0.00000000000000000001 },
    )
}

pub fn patch_qb_position_x(_ u: f32, _ v: f32) -> f32 {
    curved_typed_patch(u, v).value.x
}
pub fn patch_qb_position_y(_ u: f32, _ v: f32) -> f32 {
    curved_typed_patch(u, v).value.y
}
pub fn patch_qb_position_z(_ u: f32, _ v: f32) -> f32 {
    curved_typed_patch(u, v).value.z
}
pub fn patch_qb_defined(_ u: f32, _ v: f32) -> i32 {
    if curved_typed_patch(u, v).defined {
        1
    } else {
        0
    }
}
pub fn patch_zero_weight_defined(_ u: f32, _ v: f32) -> i32 {
    if zero_weight_typed_patch(u, v).defined {
        1
    } else {
        0
    }
}
fn flat(_ u: f32, _ v: f32) -> quilting_qb::QbDifferential {
    evaluate_uv_differential(flat_patch(), u, v, 0.00000000000000000001, 0.000000000001)
}

pub fn qb_position_x(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).sample.position.x
}
pub fn qb_position_y(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).sample.position.y
}
pub fn qb_position_z(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).sample.position.z
}
pub fn qb_tangent_u_x(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_u.x
}
pub fn qb_tangent_u_y(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_u.y
}
pub fn qb_tangent_u_z(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_u.z
}
pub fn qb_tangent_v_x(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_v.x
}
pub fn qb_tangent_v_y(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_v.y
}
pub fn qb_tangent_v_z(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_v.z
}
pub fn qb_normal_x(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).normal.x
}
pub fn qb_normal_y(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).normal.y
}
pub fn qb_normal_z(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).normal.z
}
pub fn qb_denominator_norm_squared(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).sample.denominator_norm_squared
}
pub fn qb_flat_position_x(_ u: f32, _ v: f32) -> f32 {
    flat(u, v).sample.position.x
}
pub fn qb_flat_position_y(_ u: f32, _ v: f32) -> f32 {
