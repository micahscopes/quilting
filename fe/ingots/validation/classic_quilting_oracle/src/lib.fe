//! Thin Wasm scalar exports over the three production M1 ingots.

pub fn pole_patch_sample(_ quad:bool,_ u:f32,_ v:f32,_ px:f32,_ py:f32,_ pz:f32,
    _ reference:u32,_ lane:u32)->f32 {
    pole_patch::sample(quad,u,v,px,py,pz,reference,lane)
}
pub fn edge_patch_sample(_ quad:bool,_ u:f32,_ v:f32,_ first:usize,_ last:usize,
    _ mx:f32,_ my:f32,_ mz:f32,_ lane:u32)->f32 {
    pole_patch::edge_sample(quad,u,v,first,last,mx,my,mz,lane)
}

pub fn insertion_child_face_lane(_ a:u32,_ an:u32,_ b:u32,_ bn:u32,_ resident:u32,_ lane:u32)->u32 {
    let search=quilting_atlas::topology::child_face_search(a,an,b,bn,resident)
    if lane==0xffffffff {search.count()} else {search.face(lane)}
}

/// Bit 0 is the bounded query, bit 1 the unchanged exhaustive relation.
pub fn boundary_query_comparison(
    _ a:u32,_ b:u32,_ c:u32,_ d:u32,_ x:u32,_ y:u32,_ radius:u32,_ domain:u32,
)->u32 {
    if domain==0 {
        let key=quilting_atlas::AtlasKey {a:a,b:b,c:c}
        let sample=quilting_atlas::sampling::InteriorCandidate {
            point:quilting_atlas::sampling::FixedBarycentric {a:16384-x-y,b:x,c:y},
            radius_squared:radius,priority:0,slot:0,valid:true,
        }
        (if quilting_atlas::sampling::candidate_conflicts_boundary_nearest(key,sample) {1} else {0})
            +(if quilting_atlas::sampling::candidate_conflicts_boundary(key,sample) {2} else {0})
    } else {
        let key=quilting_atlas::quad::QuadAtlasKey {bottom:a,right:b,top:c,left:d}
        let sample=quilting_atlas::quad_sampling::QuadInteriorCandidate {
            point:quilting_atlas::planar::FixedPoint2 {x:x,y:y},
            radius_squared:radius,priority:0,slot:0,valid:true,
        }
        (if quilting_atlas::quad_sampling::candidate_conflicts_boundary_nearest(key,sample) {1} else {0})
            +(if quilting_atlas::quad_sampling::candidate_conflicts_boundary(key,sample) {2} else {0})
    }
}

pub fn candidate_window_lane(
    _ maximum_lod:u32,_ minimum_lod:u32,_ row:u32,_ column:u32,
    _ triangular:u32,_ index:u32,
)->u32 {
    let window=quilting_atlas::neighborhood::grid_window(
        2<<maximum_lod,minimum_lod,row,column,triangular!=0,
    )
    if index==0xffffffff {window.count()} else {window.slot(index)}
}

use quilting_patch::arc_authoring::{ArcAuthoringAlgebra,ArcConstruction,arc_through,arc_from_tangent,evaluate_arc}
use quilting_clifford_bezier::{CliffordOdd3F,Clifford3Policy}
use quilting_clifford_bezier::euclidean::EuclideanCliffordAlgebra

fn authored_arc_lane<A: ArcAuthoringAlgebra<Displacement=quilting_domain::Vec3F> + quilting_patch::ProjectiveAlgebra<Point=quilting_domain::Vec3F,Quotient=CliffordOdd3F,Policy=Clifford3Policy>>(
    _ algebra:A,_ kind:u32,_ a:quilting_domain::Vec3F,_ handle:quilting_domain::Vec3F,_ b:quilting_domain::Vec3F,_ t:f32,_ lane:u32,
) -> f32 {
    let construction=if kind==0 {arc_through(algebra,a,handle,b,0.000000000001)}
        else {arc_from_tangent(algebra,a,handle,b,0.000000000001)}
    match construction {
        ArcConstruction::Degenerate => -999.0,
        ArcConstruction::Ready(arc) => {
            let q=evaluate_arc(algebra,arc,t,Clifford3Policy {
                minimum_denominator_norm_squared:0.000000000001,maximum_trivector_residual:0.00001,
            })
            if lane==4 {if q.defined {1.0} else {0.0}}
            else if lane==0 {q.value.e1} else if lane==1 {q.value.e2}
            else if lane==2 {q.value.e3} else {q.value.e123}
        }
    }
}
pub fn authored_arc_sample(_ metric:u32,_ kind:u32,_ x:f32,_ y:f32,_ z:f32,_ t:f32,_ lane:u32)->f32 {
    let a=vec3f(-1.0,0.0,0.0)
    let b=vec3f(1.0,0.0,0.0)
    let handle=vec3f(x,y,z)
    if metric==0 {authored_arc_lane(EuclideanCliffordAlgebra {},kind,a,handle,b,t,lane)}
    else {authored_arc_lane(IsotropicCliffordAlgebra {},kind,a,handle,b,t,lane)}
}
pub fn authored_oblique_arc_sample(_ metric:u32,_ x:f32,_ y:f32,_ z:f32,_ t:f32,_ lane:u32)->f32 {
    let a=vec3f(-0.8,0.3,0.4)
    let b=vec3f(0.7,-0.6,1.1)
    let handle=vec3f(x,y,z)
    if metric==0 {authored_arc_lane(EuclideanCliffordAlgebra {},0,a,handle,b,t,lane)}
    else {authored_arc_lane(IsotropicCliffordAlgebra {},0,a,handle,b,t,lane)}
}
pub fn arc_segment_regular(_ exterior:u32,_ first:f32,_ last:f32)->u32 {
    let algebra=EuclideanCliffordAlgebra {}
    let h=if exterior==1 {vec3f(2.0,0.0,0.0)} else {vec3f(0.0,1.0,0.0)}
    match arc_through(algebra,vec3f(-1.0,0.0,0.0),h,vec3f(1.0,0.0,0.0),0.000000000001) {
        ArcConstruction::Degenerate=>0,
        ArcConstruction::Ready(arc)=>if quilting_patch::arc_authoring::arc_interval_regular(algebra,arc,first,last,0.00000001) {1} else {0},
    }
}

