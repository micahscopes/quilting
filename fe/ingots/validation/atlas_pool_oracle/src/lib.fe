//! Actual Wasm acceptance for retained pool ownership, not a host scheduler.
use core::BrowserPtr
use quilting_atlas_wasm::{Claim, Completion, packed_triangle, packed_square}
use quilting_atlas_wasm::pool
use quilting_atlas_wasm::pool::{AtlasPool, PoolSummary, TileEntry}

pub fn create(_ maximum_lod: u32) -> u32 { pool::create<4>(1, maximum_lod).address() }
pub fn create_primaries(_ invalid: bool) -> u32 {
    pool::create_jobs<4,2>(7,[
        pool::TileKey { square:false,a:0,b:0,c:0,d:0 },
        pool::TileKey { square:false,a:0,b:1,c:if invalid {9} else {1},d:0 },
    ]).address()
}
pub fn create_empty() -> u32 { pool::create_jobs<4,0>(8,[]).address() }
pub fn priority_preserves_live_leases() -> bool {
    let small = pool::TileKey { square:false,a:0,b:0,c:0,d:0 }
    let middle = pool::TileKey { square:false,a:0,b:1,c:1,d:0 }
    let large = pool::TileKey { square:false,a:0,b:2,c:2,d:0 }
    let p = pool::create_jobs<4,3>(9,[small,middle,large])
    let handle: pool::PoolHandle<4> = pool::PoolHandle::from_address(p.address())
    let a = match handle.claim(0) { Claim::Job(lease) => lease, _ => return false }
    if a.ordinal != 2 || handle.prioritize(large) { return false }
    if !handle.prioritize(small) || !handle.prioritize(small) { return false }
    if handle.find(small) != 1 || handle.find(middle) != 0 || handle.find(large) != 2 { return false }
    let b = match handle.claim(1) { Claim::Job(lease) => lease, _ => return false }
    if b.ordinal != 1 || handle.prioritize(small) { return false }
    // The first lease remains tied to the original key, even after promotion.
    let key = handle.key(a.ordinal)
    if key.b != 2 || key.c != 2 { return false }
    if let Completion::Accepted = handle.finish(b,packed_triangle(0,0,0,42)) {} else { return false }
    if let Completion::Accepted = handle.finish(a,packed_triangle(0,2,2,42)) {} else { return false }
    if !handle.prioritize(middle) { return false }
    let c = match handle.claim(2) { Claim::Job(lease) => lease, _ => return false }
    if c.ordinal != 0 { return false }
    if let Completion::Accepted = handle.finish(c,packed_triangle(0,1,1,42)) {} else { return false }
    handle.summary().completed == 3 && !handle.prioritize(middle)
}
pub fn summary(_ address: u32) -> PoolSummary {
    let p: BrowserPtr<AtlasPool<4>> = BrowserPtr::from_u32(address)
    with (p) { pool::summary<4>() }
}
pub fn entry(_ address: u32, _ ordinal: u32) -> TileEntry {
    let p: BrowserPtr<AtlasPool<4>> = BrowserPtr::from_u32(address)
    with (p) { pool::entry<4>(ordinal) }
}
pub fn storage(_ address: u32) -> u32 {
    let p: BrowserPtr<AtlasPool<4>> = BrowserPtr::from_u32(address)
    with (p) { pool::storage<4>() }
}
pub fn tile_info(_ address: u32, _ ordinal: u32) -> (u32, u32, u32, u32, u32) {
    let handle: pool::PoolHandle<4> = pool::PoolHandle::from_address(address)
    match handle.tile(ordinal) {
        pool::TileLookup::Ready(tile) => {
            (0, tile.points, tile.triangles, tile.words.ptr.address(), tile.words.len)
        },
        pool::TileLookup::NotReady => (1, 0, 0, 0, 0),
        pool::TileLookup::OutOfRange => (2, 0, 0, 0, 0),
    }
}
pub fn update_info(_ address: u32, _ epoch: u32, _ words: u32) -> (u32, u32, u32, u32, u32, u32) {
    let handle: pool::PoolHandle<4> = pool::PoolHandle::from_address(address)
    match handle.updates_since(pool::RetainedCursor { epoch: epoch, words: words }) {
        pool::RetainedUpdate::Unchanged => (1, 0, 0, 0, 0, 0),
        pool::RetainedUpdate::InvalidCursor => (2, 0, 0, 0, 0, 0),
        pool::RetainedUpdate::Ready(range) => (0, range.epoch, range.revision,
            range.word_offset, range.words.ptr.address(), range.words.len),
    }
}
pub fn generate_one(_ address: u32, _ slot: u32, _ cancel_before_finish: bool) -> u32 {
    let p: BrowserPtr<AtlasPool<4>> = BrowserPtr::from_u32(address)
    let claim = with (p) { pool::claim<4>(slot) }
    match claim {
        Claim::Job(lease) => {
            let key = with (p) { pool::key<4>(lease.ordinal) }
            let tile = if key.square { packed_square(key.a, key.b, key.c, key.d, 42) }
                else { packed_triangle(key.a, key.b, key.c, 42) }
            if cancel_before_finish { with (p) { pool::cancel<4>() } }
            with (p) {
                match pool::finish<4>(lease, tile) {
                    Completion::Accepted => 0,
                    Completion::Failed => 1,
                    Completion::Stale => 2,
                    Completion::Invalid => 3,
                }
            }
        },
        Claim::Complete => 4, Claim::Busy => 5, Claim::Cancelled => 6, Claim::Failed => 7,
    }
}
