//! Full canonical atlas in four persistent typed workers. All job policy is Fe.
use core::Worker
use core::actor::{ActorInstance, InitialState, ProjectState, ResidentTransition, ScopedTaskFamily}
use quilting_atlas_wasm::{packed_triangle, packed_square}
use quilting_atlas_wasm::pool
use quilting_atlas_wasm::pool::{PoolHandle, PoolSummary}
use quilting_atlas_workers::{Request, Response, CompletionMessage, supervise, run}

struct Slot<const I: u32> {}
const WORKERS: u32 = 4
const CAPACITY: usize = WORKERS as usize
actor AtlasWorker {
    fn generate(request: Request) -> Response uses (Worker) {
        let key = request.key
        let tile = if key.square { packed_square(key.a, key.b, key.c, key.d, 42) }
            else { packed_triangle(key.a, key.b, key.c, 42) }
        Response { lease: request.lease, tile: tile }
    }
}

pub struct State { pub address: u32, pub revision: u32 }
pub struct Event { pub cancel: bool }
impl CompletionMessage for Event { fn completed() -> Self { Self { cancel: false } } }
pub struct Projection { pub address: u32, pub revision: u32, pub batch: PoolSummary }


actor AtlasPoolRunner {
    address: u32,
    revision: u32,
    fn initial() -> State uses (InitialState) {
        State { address: pool::create<CAPACITY>(1, 8).address(), revision: 0 }
    }
    fn receive(self, event: Event) -> State uses (ResidentTransition) {
        if event.cancel && self.address != 0 {
            let handle: PoolHandle<CAPACITY> = PoolHandle::from_address(self.address)
            handle.cancel()
        }
        State { address: self.address, revision: self.revision + 1 }
    }
    fn project(self) -> Projection uses (ProjectState) {
        let batch = if self.address == 0 {
            PoolSummary { epoch: 1, total: 0, completed: 0, words: 0, points: 0, triangles: 0, status: 3 }
        } else {
            let handle: PoolHandle<CAPACITY> = PoolHandle::from_address(self.address)
            handle.summary()
        }
        Projection { address: self.address, revision: self.revision, batch: batch }
    }
    fn supervision<const I: u32>() -> u32 uses (ScopedTaskFamily<WORKERS>) {
        supervise(ActorInstance<AtlasWorker, Slot<I>> {})
    }
    fn work<const I: u32>(self) -> u32 uses (ScopedTaskFamily<WORKERS>) {
        run<CAPACITY, ActorInstance<AtlasWorker, Slot<I>>, Event>(self.address, I)
    }
}
