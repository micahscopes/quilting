//! Export-only acceptance adapter over the shared Wasm atlas job implementation.
use quilting_atlas_wasm::{AtlasProbe, ProbeStage, PackedTile}
use quilting_atlas::cpu_mesh::CpuMesh

pub fn triangle(_ a: u32, _ b: u32, _ c: u32, _ seed: u32, _ stage: ProbeStage) -> AtlasProbe {
    quilting_atlas_wasm::triangle(a, b, c, seed, stage)
}
pub fn square(_ bottom: u32, _ right: u32, _ top: u32, _ left: u32, _ seed: u32, _ stage: ProbeStage) -> AtlasProbe {
    quilting_atlas_wasm::square(bottom, right, top, left, seed, stage)
}
pub fn triangle_key(_ ordinal: u32) -> quilting_atlas::AtlasKey {
    quilting_atlas_wasm::triangle_key(ordinal)
}
pub fn quad_key(_ cursor: u32) -> quilting_atlas::quad::QuadKeyStep {
    quilting_atlas_wasm::quad_key(cursor)
}
pub fn packed_triangle(_ a: u32, _ b: u32, _ c: u32, _ seed: u32) -> PackedTile {
    quilting_atlas_wasm::packed_triangle(a, b, c, seed)
}
pub fn packed_square(_ bottom: u32, _ right: u32, _ top: u32, _ left: u32, _ seed: u32) -> PackedTile {
    quilting_atlas_wasm::packed_square(bottom, right, top, left, seed)
}

struct PackWords { words: [u32; 5], limit: u32 }
impl quilting_atlas::packed_tile::WordSink for PackWords {
    fn capacity(self) -> u32 { self.limit }
    fn write(mut self, _ index: u32, _ word: u32) { self.words[index as usize] = word }
}
pub struct PackedProbe { pub status: u32, pub a: u32, pub b: u32, pub c: u32, pub d: u32, pub e: u32 }

pub fn packing(_ mode: u32) -> PackedProbe {
    use quilting_atlas::cpu_cdt::PointCloud
    use quilting_atlas::planar::FixedPoint2
    use quilting_atlas::topology::Triangle
    use quilting_atlas::packed_tile::{PackStatus, pack_tile}
    let source = PointCloud { points: [FixedPoint2 { x: 0, y: 0 },
        FixedPoint2 { x: 16384, y: 0 }, FixedPoint2 { x: 0, y: if mode == 2 { 16385 } else { 16384 } }] }
    let mut mesh: CpuMesh<1> = CpuMesh::empty()
    mesh.seed(Triangle { first: 0, second: 1, third: if mode == 3 { 3 } else { 2 }, valid: true })
    let mut output = PackWords { words: [77; 5], limit: if mode == 1 { 4 } else { 5 } }
    let status = match pack_tile(source, 3, mesh, mut output) {
        PackStatus::Complete => 0, PackStatus::InvalidLayout => 1,
        PackStatus::InvalidPoint => 2, PackStatus::InvalidMesh => 3, PackStatus::Capacity => 4,
    }
    PackedProbe { status: status, a: output.words[0], b: output.words[1], c: output.words[2], d: output.words[3], e: output.words[4] }
}
