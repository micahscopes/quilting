# Large assets kept out of the repo. `horse.glb`, `ant.glb`, and
# `TextureSettingsTest.glb` stay tracked (the demo loads them), so there is
# deliberately no blanket `*.glb` rule here. Run `scripts/fetch-assets.sh` to
# pull the Khronos sample models back down.
/DragonAttenuation.glb
/IORTestGrid.glb
/TransmissionTest.glb
/food_cans.glb
/sardine_tin.glb
/violin.glb

# Local heavyweight models used for browser testing. Keep the directory itself
# so the development build's copy-dir directive also works in a clean checkout.
/local-glbs/*
!/local-glbs/.gitkeep
