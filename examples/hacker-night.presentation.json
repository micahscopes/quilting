    {
      "id": "e0000000-0000-4000-8000-000000000003",
      "scene": "b0000000-0000-4000-8000-000000000001",
      "view": "d0000000-0000-4000-8000-000000000001",
      "text": {
        "eyebrow": "The atlas",
        "heading": "One canonical topology, stamped across every face",
        "body": "WebGL2 cannot generate geometry in the shader. Quilting reuses prebuilt barycentric triangle patterns, then evaluates each face as an instanced curved patch."
      },
      "animations": [
        {
          "layer": "c0000000-0000-4000-8000-000000000001",
          "clip": "horse_A_",
          "playing": true,
          "speed": 1.0
        }
      ],
      "overlays": ["wireframe"],
      "transition": {
        "duration_seconds": 0.45,
        "easing": "smoother_step"
      }
    },
    {
      "id": "e0000000-0000-4000-8000-000000000004",
      "scene": "b0000000-0000-4000-8000-000000000001",
      "view": "d0000000-0000-4000-8000-000000000001",
      "text": {
        "eyebrow": "Crack-free LOD",
        "heading": "A shared edge chooses one resolution",
        "body": "Each color is a tessellation level. Neighboring faces resolve their common edge together, so the quilt changes density without opening T-junction cracks."
      },
      "animations": [
        {
          "layer": "c0000000-0000-4000-8000-000000000001",
          "clip": "horse_A_",
          "playing": true,
          "speed": 1.0
        }
      ],
      "overlays": ["lod"],
      "tessellation": {
        "density": 100.0,
        "screen_attenuation": true,
        "min_pixels_per_subdivision": 64.0
      },
      "transition": {
        "duration_seconds": 0.45,
        "easing": "smoother_step"
      }
    },
    {
      "id": "e0000000-0000-4000-8000-000000000005",
      "scene": "b0000000-0000-4000-8000-000000000001",
      "view": "d0000000-0000-4000-8000-000000000001",
      "text": {
        "eyebrow": "QB surfaces",
        "heading": "Curvature and normals are evaluated analytically",
        "body": "The vertex shader evaluates the rational quaternionic-Bezier surface and its derivatives. No CPU remeshing is needed when the conformal map changes."
      },
      "animations": [
        {
          "layer": "c0000000-0000-4000-8000-000000000001",
          "clip": "horse_A_",
          "playing": true,
          "speed": 1.0
        }
      ],
      "overlays": ["normals"],
